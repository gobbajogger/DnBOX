--- a/tests/host/native_hook_fixture_probe.h
+++ b/tests/host/native_hook_fixture_probe.h
@@ -0,0 +1,28 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+/* Observable dependency boundary for editor/OTA/sample unit fixtures only.
+ * Real editor bodies and ownership are tested; no remote protocol, queue,
+ * native engine, device or transport admission is claimed by this probe. */
+#ifndef NATIVE_HOOK_FIXTURE_PROBE_H
+#define NATIVE_HOOK_FIXTURE_PROBE_H
+#include <assert.h>
+#include <string.h>
+#include "../../firmware/src/app/dnr_remote/native_binding.h"
+static unsigned fixture_native_ticks, fixture_native_payloads;
+static uint32_t fixture_native_last_now;
+static int fixture_native_claim_next;
+void dnr_native_tick(uint32_t now)
+{ ++fixture_native_ticks; fixture_native_last_now = now; }
+int dnr_native_payload(const uint8_t *p, size_t n, uint32_t now,
+                      uint8_t out[DNR2_FRAME_BYTES], unsigned *reply_n)
+{
+    assert(fixture_native_ticks && now == fixture_native_last_now);
+    assert(p && n && out && reply_n);
+    ++fixture_native_payloads;
+    memset(out, 0, DNR2_FRAME_BYTES); /* initialized probe span, not a wire reply */
+    *reply_n = 0;
+    if (fixture_native_claim_next) { fixture_native_claim_next = 0; return 1; }
+    return 0; /* this legacy editor fixture has no remote-core state */
+}
+static void fixture_native_observed(void)
+{ assert(fixture_native_ticks && fixture_native_payloads); }
+#endif
