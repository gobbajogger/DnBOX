+static void fixed_bench_boundary(uint32_t sample)
+{
+    if (sample!=FIX_CONFIG && sample!=FIX_ON && sample!=FIX_OFF) return;
+    original_runtime_part *a=&original_bass[0], *b=&original_bass[1];
+    if (lab_delay_probe!=3 || lab_s1_probe!=2 || seq.playing ||
+            a->kind!=ORIGINAL_SOUND_JUNO || a->status!=ORIGINAL_RUNTIME_OK ||
+            b->kind!=ORIGINAL_SOUND_SYNTHONE || b->status!=ORIGINAL_RUNTIME_OK ||
+            a->dsp.juno.lab_delay.result!=2 || !a->dsp.juno.synth.delay24.enabled ||
+            a->arp.cfg.on || b->arp.cfg.on) { bench_fixed[0]=1; return; }
+    s1c *e=&b->dsp.synthone.e;
+    if (sample==FIX_CONFIG) {
+        if (!s1c_front_set(e,20,0.f) ||
+            !s1c_front_set(e,S1C_P_RVON,1.f) || !s1c_front_set(e,S1C_P_RVMIX,.25f) ||
+            !s1c_front_set(e,S1C_P_DLON,1.f) || !s1c_front_set(e,S1C_P_DLMIX,.30f) ||
+            !s1c_front_set(e,S1C_P_DLT,.30f)) { bench_fixed[0]=2; return; }
+        bench_fixed[3]=sample;
+        return;
+    }
+    if (!bench_fixed[3] || bench_fixed[0] || !e->t[S1C_P_DLON] || !e->t[S1C_P_RVON] ||
+            e->t[S1C_P_DLMIX]==0 || e->t[S1C_P_RVMIX]==0 ||
+            a->dsp.juno.synth.delay24.wet==0.f) { bench_fixed[0]=3; return; }
+    const uint8_t notes[7]={48,48,52,55,59,62,67};
+    const unsigned on=sample==FIX_ON;
+    const unsigned ch_a=seq.ch[TRK_BASS0],ch_b=seq.ch[TRK_BASS0+1];
+    if (ch_a!=1u || ch_b!=2u) { bench_fixed[0]=4;return; }
+    fix_sample=sample;
+    for (unsigned i=0;i<1u+FIX_VOICES;i++) {
+        const unsigned part=i!=0, ch=part?ch_b:ch_a, vel=on? (part?88u:86u):0u;
+        uint32_t count=bench_fixed[1];
+        fix_active=1;
+        midi_in((on?9u:8u)|(((on?0x90u:0x80u)|ch)<<8)|((uint32_t)notes[i]<<16)|(vel<<24));
+        fix_active=0;
+        if (bench_fixed[1]!=count+1u) { bench_fixed[0]=5; return; }
+    }
+    bench_fixed[on?4:5]=sample;
+    unsigned voices=0;
+    for (unsigned i=0;i<S1C_VOICES;i++) voices+=e->v[i].root!=-1 && e->v[i].stage && e->v[i].gate>0.f;
+    bench_fixed[on?6:7]=voices;
+}
