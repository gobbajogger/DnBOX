+#if DNBOX_S1_MORPH_SHARE
+typedef struct { int k; float f; } s1c_morph_blend;
+static inline s1c_morph_blend morph_decode(float pos)
+{
+    if (pos > 1.0f) pos -= (int)pos;
+    float f = pos * 3.0f; int k = (int)f; if (k > 2) k = 2;
+    f -= k;
+    return (s1c_morph_blend){k,f};
+}
+static inline float morph_cell(uint32_t *ph, float dt, uint32_t increment, s1c_morph_blend m, int bl)
+{
+    float t = (float)*ph * (1.0f / Q32);
+    int k = m.k; float f = m.f;
+    float y = shape(k, t, dt, bl);
+    if (f > 0.0f) y += f * (shape(k + 1, t, dt, bl) - y);
+    *ph += increment;
+    return y;
+}
+static float morph(uint32_t *ph,float dt,uint32_t increment,float pos,int bl)
+{
+    return morph_cell(ph,dt,increment,morph_decode(pos),bl);
+}
+#else
 static float morph(uint32_t *ph, float dt, uint32_t increment, float pos, int bl)
