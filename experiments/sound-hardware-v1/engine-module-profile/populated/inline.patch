 /* ---- envelope: one-pole ADSR, attack aims at 1 with tau*0.6 and turns to decay at 0.99 ---- */
 enum { E_CLEAR = S1U_E_CLEAR, E_ATK = S1U_E_ATK, E_DEC = S1U_E_DEC, E_REL = S1U_E_REL };
 static float pole(float t, float sr) { return t <= 0.0f ? 0.0f : expf(-1.0f / (t * sr)); }
+#if DNBOX_S1_HOT_INLINE
+static inline __attribute__((always_inline)) float s1u_env_step_hot(s1u_env *e, float gate, float atk, float dec, float sus, float rel, float sr)
+{
+    if (e->prev < gate && e->mode != S1U_E_DEC) { e->mode = S1U_E_ATK; e->a = pole(atk * 0.6f, sr); }
+    else if (e->prev > gate) { e->mode = S1U_E_REL; e->a = pole(rel, sr); }
+    e->prev = gate;
+    if (e->mode == S1U_E_CLEAR) return 0.0f;
+    float x = e->mode == S1U_E_ATK ? gate : gate * sus;
+    e->y = (1.0f - e->a) * x + e->a * e->y;
+    if (e->mode == S1U_E_ATK && e->y > 0.99f) { e->mode = S1U_E_DEC; e->a = pole(dec, sr); }
+    return e->y;
+}
+#define env_step s1u_env_step_hot
