+#if X0X_S1_USER_SCALE
+int s1_typed_user_import(unsigned owner,unsigned count,const uint8_t *name,const uint8_t *packed)
+{
+    if(!count || count>S1C_USER_NOTES || !scale_editable_owner(mot_base_snd,owner))return 2;
+    unsigned prev=0;
+    for(unsigned i=0;i<3u*count;i+=3u) {
+        const unsigned code=packed[i]|(unsigned)packed[i+1u]<<8|(unsigned)packed[i+2u]<<16;
+        if(code>=0x800000u || code<prev)return 1;
+        prev=code;
+    }
+    for(unsigned i=0;i<S1C_USER_NAME;i++)
+        if(name[i] && (unsigned)(name[i]-32u)>94u)return 1;
+    engine_project_hold(1);
+    int ok=!ui_project_busy() && s1_typed_tuple_editable() &&
+           scale_editable_owner(mot_base_snd,owner) && !engine_bass_preset_pending(owner);
+    if(ok){
+        sound_t *s=(sound_t *)mot_base_snd;
+        uint8_t *h=(uint8_t *)&s->v[s1_user_head_target(owner)]+S1_USER_ROW*NPARAMS_MAX;
+        uint8_t *t=(uint8_t *)&s->v[T_MIX]+s1_user_tail_row(owner)*NPARAMS_MAX;
+        unsigned n=count*3u;
+        unsigned head=n>S1_USER_HEAD?S1_USER_HEAD:n;
+        memcpy(h,packed,head);
+        memset(h+head,0,S1_USER_HEAD-head);
+        unsigned tail=n-head;
+        if(tail)memcpy(t,packed+head,tail);
+        memset(t+tail,0,S1_USER_TAIL-tail);
+        uint8_t *m=s->v[T_MST][S1_SCALE_ROW+owner];
+        memcpy(m+S1_USER_ID,name,S1C_USER_NAME);
+        m[S1_USER_COUNT]=(uint8_t)count;
+        m[S1_SCALE_BYTE]=S1C_SCALE_USER;
+        s1_typed_a4_apply(s,owner);
+    }
+    engine_project_hold(0);
+    return ok?0:2;
+}
