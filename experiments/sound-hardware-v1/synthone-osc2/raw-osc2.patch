diff --git a/tests/host/synthone_osc2_reference.c b/tests/host/synthone_osc2_reference.c
new file mode 100644
index 00000000..01683a31
--- /dev/null
+++ b/tests/host/synthone_osc2_reference.c
@@ -0,0 +1,36 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#include "s1_osc2.h"
+#include <assert.h>
+#include <stdio.h>
+#include <stdint.h>
+
+int main(int argc, char **argv)
+{
+    assert(argc == 2);
+    FILE *f = fopen(argv[1], "rb");
+    assert(f);
+    static float source[4][4097];
+    assert(fread(source, sizeof(float), 4*4097, f) == 4*4097 && !fclose(f));
+    unsigned comparisons = 0;
+    const unsigned offsets[] = {0, 1, 1024, 2048, 3072, 4095};
+    for (unsigned q = 0; q < 128; ++q) {
+        const float position = (float)q / 127.f;
+        const float row = 3.f * position;
+        const unsigned a = (unsigned)row;
+        const unsigned b = a < 3 ? a + 1 : a;
+        const float t = row - a;
+        const s1_osc2_morph morph = s1_osc2_morph_at(position);
+        for (unsigned idx = 0; idx < 4096; ++idx) {
+            const unsigned wrapped = (idx + 1u) % 4096u;
+            const float x = (1.f - t) * source[a][idx] + t * source[b][idx];
+            const float y = (1.f - t) * source[a][wrapped] + t * source[b][wrapped];
+            for (unsigned i = 0; i < sizeof offsets / sizeof offsets[0]; ++i) {
+                const float expected = x + (y-x) * ((float)offsets[i] / 4096.f);
+                assert(s1_osc2_wave(morph, (idx << 12) | offsets[i]) == expected);
+                ++comparisons;
+            }
+        }
+    }
+    printf("Raw oscillator 2: %u exact source interpolation comparisons, including both pulse edges and wrap.\n",
+           comparisons);
+}
