diff --git a/firmware/src/dsp/s1_osc2.h b/firmware/src/dsp/s1_osc2.h
new file mode 100644
index 00000000..a756ebb9
--- /dev/null
+++ b/firmware/src/dsp/s1_osc2.h
@@ -0,0 +1,42 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#pragma once
+#include <stdint.h>
+
+enum { S1_OSC2_SIZE = 4096, S1_OSC2_PHASE_BITS = 12 };
+
+typedef struct {
+    float fraction;
+    unsigned shape;
+} s1_osc2_morph;
+
+static inline s1_osc2_morph s1_osc2_morph_at(float position)
+{
+    float row = 3.f * position;
+    unsigned shape = (unsigned)row;
+    return (s1_osc2_morph){row - (float)shape, shape};
+}
+
+/* The four original unbandlimited rows are analytic at the sample knots.
+ * Interpolate adjacent knots, including both pulse edges and the wrap. */
+static inline float s1_osc2_knot(unsigned shape, unsigned index)
+{
+    switch (shape) {
+    case 0: return (float)(index <= 2048u ? index : 4096u - index) * (1.f / 1024.f) - 1.f;
+    case 1: return index < 2048u ? -1.f : 1.f;
+    case 2: return index < 512u ? -1.f : 1.f;
+    default: return (float)index * (1.f / 2048.f) - 1.f;
+    }
+}
+
+static inline float s1_osc2_wave(s1_osc2_morph morph, uint32_t phase)
+{
+    const unsigned a = phase >> S1_OSC2_PHASE_BITS;
+    const unsigned b = (a + 1u) & (S1_OSC2_SIZE - 1u);
+    const unsigned adjacent = morph.shape < 3u ? morph.shape + 1u : morph.shape;
+    const float x = (1.f - morph.fraction) * s1_osc2_knot(morph.shape, a) +
+                    morph.fraction * s1_osc2_knot(adjacent, a);
+    const float y = (1.f - morph.fraction) * s1_osc2_knot(morph.shape, b) +
+                    morph.fraction * s1_osc2_knot(adjacent, b);
+    const float fraction = (float)(phase & (S1_OSC2_SIZE - 1u)) * (1.f / 4096.f);
+    return x + (y - x) * fraction;
+}
