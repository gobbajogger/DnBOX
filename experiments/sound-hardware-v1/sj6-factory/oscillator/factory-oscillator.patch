+        float distance = .25f * (1.f - fm_fabsf(triangle));
+        if (distance < dt) {
+            /* Integrate the polynomial BLEP across the nearest slope reversal. */
+            float u = 1.f - distance / dt;
+            float correction = (4.f / 3.f) * dt * u * u * u;
