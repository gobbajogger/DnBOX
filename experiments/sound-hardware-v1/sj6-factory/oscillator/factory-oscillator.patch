+    first = phase_section(first, 0.31684510f, &voice->oscillator_history[1]);
+    second = phase_section(second, 0.58723765f, &voice->oscillator_history[2]);
+    first = phase_section(first, 0.85663281f, &voice->oscillator_history[3]);
