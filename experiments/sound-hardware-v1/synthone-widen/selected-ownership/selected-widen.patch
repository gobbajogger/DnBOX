--- /dev/null
+++ b/firmware/src/app/selected_widen.inc
@@ -0,0 +1,53 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#include "widen.h"
+
+enum { WIDEN_FIRST_FRAMES = WIDEN_FIRST_BYTES / 3 };
+_Static_assert(sizeof original_fx[0].arena >= WIDEN_FIRST_BYTES, "Chicago insert space");
+_Static_assert(WIDEN_FIRST_FRAMES * 3 == WIDEN_FIRST_BYTES, "whole frames");
+_Static_assert(WIDEN_FIRST_BYTES + WIDEN_TAIL_BYTES == S1_WIDEN_BYTES, "entire ring");
+
+static int widen_owns_storage(int v)
+{
+    return original_bass[v].kind == ORIGINAL_SOUND_SYNTHONE &&
+           original_bass[v].status == ORIGINAL_RUNTIME_OK && !original_fx[v].selected;
+}
+
+#ifdef X0X_WIDEN_PROBE
+extern void widen_probe_reset(int v);
+extern void widen_probe_frame(int v, float input, float delayed, float output, float wet);
+int widen_probe_set(int v, float wet)
+{
+    if ((unsigned)v >= NBASS || !widen_owns_storage(v)) return 0;
+    return original_runtime_param(&original_bass[v], 121u, wet);
+}
+#endif
+
+static void widen_adopt(int v, int status)
+{
+    if (status != ORIGINAL_RUNTIME_OK || !widen_owns_storage(v)) return;
+    /* original_runtime_init has zeroed the entire backend, including the
+     * tail, write index and applied mix. Chicago's cold release owns the
+     * other span until successful Synth One adoption. */
+    memset(&original_fx[v].arena, 0, WIDEN_FIRST_BYTES);
+#ifdef X0X_WIDEN_PROBE
+    widen_probe_reset(v);
+#endif
+}
+
+static void widen_render(int v, float *right, unsigned n)
+{
+    if (!widen_owns_storage(v)) return;
+    s1_wide_backend *backend = &original_bass[v].dsp.synthone;
+    uint8_t *first = (uint8_t *)&original_fx[v].arena;
+    unsigned index = backend->position;
+    float wet = backend->applied_widen;
+    for (unsigned i = 0; i < n; ++i) {
+        float input = right[i];
+        float delay = s1_widen_tap(first, WIDEN_FIRST_FRAMES, backend->tail, &index, input);
+        if (wet != 0.f) right[i] = wet * delay + (1.f - wet) * input;
+#ifdef X0X_WIDEN_PROBE
+        widen_probe_frame(v, input, delay, right[i], wet);
+#endif
+    }
+    backend->position = index;
+}
