+    }
+
+    #[inline]
+    fn observe_foreground_read(&mut self, addr: u32, width: u32, value: u32) {
+        if self.foreground_read_window() {
+            if let Some(observer) = &mut self.dnbox_observer {
+                observer.foreground_read(self.periph.cycles, addr, width, value, self.periph.spi1_done_at);
+            }
+        }
+    }
