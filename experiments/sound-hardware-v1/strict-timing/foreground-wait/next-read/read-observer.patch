+    pub fn foreground_read(&mut self, cycle: u64, address: u32, width: u32, value: u32, spi1_done_at: u64) {
+        let (name, offset) = match address {
+            0x10804 => ("timer4", 0),
+            0x13104 => ("adc", 0),
+            0x11d00 => ("spi1_status", 0),
+            _ => {
+                let Some(w) = self.watches.iter().find(|w| w.name.starts_with("scene_read_") && w.contains(address,width)) else { return };
+                (w.name.as_str(), address - w.address)
+            }
+        };
+        self.emit(format!("{{\"event\":\"foreground_read\",\"seq\":{},\"cycle\":{cycle},\"name\":\"{name}\",\"offset\":{offset},\"width\":{width},\"value\":{value},\"spi1_done_at\":{spi1_done_at}}}", self.dma_seq));
+    }
+
+    pub fn foreground_spi_start(&mut self, cycle: u64, spi1_done_at: u64, bytes: u32) {
+        self.emit(format!("{{\"event\":\"foreground_spi_start\",\"seq\":{},\"cycle\":{cycle},\"bytes\":{bytes},\"spi1_done_at\":{spi1_done_at}}}", self.dma_seq));
+    }
+
     pub fn foreground_context(&mut self, cycle: u64, interrupted_pc: u32, spi1_done_at: u64) {
         self.emit(format!("{{\"event\":\"foreground_context\",\"seq\":{},\"cycle\":{cycle},\"interrupted_pc\":{interrupted_pc},\"spi1_done_at\":{spi1_done_at}}}", self.dma_seq));
