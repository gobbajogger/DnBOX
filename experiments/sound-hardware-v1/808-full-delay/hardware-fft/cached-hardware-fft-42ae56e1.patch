+static inline float unfold(const float *c, unsigned t)
+{
+    float z = t < ECHO_HOP / 2       ? c[t + ECHO_HOP / 2]
+              : t < 3 * ECHO_HOP / 2 ? -c[3 * ECHO_HOP / 2 - 1 - t]
+                                     : -c[t - 3 * ECHO_HOP / 2];
+    return z * (2.f / ECHO_HOP) * echo_sine(2 * t + 1);
