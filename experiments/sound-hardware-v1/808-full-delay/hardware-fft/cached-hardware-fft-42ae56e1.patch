+/* Convert the original engine cursor into age before indexing the
+ * hop-aligned packet ring. Its 89,088 samples include the analysis guard. */
+static inline int echo_history_read(fx808_transform_t *p, unsigned idx)
+{
+    unsigned age = (p->source_cursor >= idx) ? p->source_cursor - idx : p->frames + p->source_cursor - idx;
+    unsigned physical_cursor = p->physical_cursor >= age ? p->physical_cursor - age
+                                                         : p->physical_frames + p->physical_cursor - age;
+    /* A decoded block needs its successor for overlap/add. Return the original
+       staged data until the following complete block has been encoded. */
+    if (age > 0 && age <= ECHO_RECENT)
+        return p->recent[physical_cursor % ECHO_RECENT];
+    return read_echo_sample(p,physical_cursor/ECHO_HOP,physical_cursor%ECHO_HOP);
