+static int read_echo_sample(fx808_transform_t *p,unsigned idx,unsigned i)
+{
+    unsigned blocks=p->physical_frames/ECHO_HOP;
+    uint8_t *data=p->packet_data+idx*PACKET_BYTES;
+    if(!(data[PACKET_BYTES-1]&(1u<<(i/(ECHO_HOP/8)))))return 0;
+    if(data[PACKET_BYTES-2]&128 && (data[0]&31)<30){
+        if(p->read_hop!=idx) {
+            if(onset_restore(p,idx))p->read_hop=idx;
+        }
+        if(p->read_hop==idx) return p->decoded_hop[i];
+    }
+    unsigned group=idx*(ECHO_HOP/8)+(i/8);
+    if(p->cache_group!=group){
+        unsigned prev=idx?idx-1:blocks-1;
+        const float *a=(p->packet_data[prev*PACKET_BYTES]&31)<30 ? lookup_spectrum(p,prev):0;
+        const float *b=(data[0]&31)<30 ? lookup_spectrum(p,idx):0;
