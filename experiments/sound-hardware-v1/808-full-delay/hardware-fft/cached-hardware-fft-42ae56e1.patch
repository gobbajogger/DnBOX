+/* Pair x[2m] with x[N-1-2m]. A positive N/2-point complex FFT after
+ * pre-rotation, followed by a post-rotation, produces the even DCT-IV bins
+ * in its real part and the reversed, odd bins in the imaginary part. */
+#if defined(__PI32V2__)
+#include "../../hal/fm1_fft128.h"
+#endif
+/* The forward unit uses the opposite imaginary sign. Pre- and post-rotation
+ * may share their buffer with the complex integer words. */
+static int echo_fft_fixed(fx808_transform_t *p)
+{
+#if defined(__PI32V2__)
+    /* Use a static DMA buffer. PI32v2 call frames guarantee word alignment;
+     * local objects with larger alignment may have a different DMA address. */
+    static int32_t words[ECHO_HOP] __attribute__((aligned(16),section(".pool")));
+#else
+    int32_t words[ECHO_HOP];
+#endif
+    float peak=0;
+    for(unsigned i=0;i<ECHO_HOP;i++){
+        float a=fm_fabsf(p->coefficients[i]);if(a>peak)peak=a;
+    }
+    if(peak==0)return 1;
+    union { float f; uint32_t u; } e={.f=peak};
+    unsigned exp=e.u>>23;
+    /* Clip the 128 complex sums below the signed 29-bit output range even
+     * when every input contributes its full real and imaginary parts. */
+    e.u=(272u-exp)<<23;float mult=e.f;
+    e.u=(exp-18u)<<23;float inverse=e.f;
+    for(unsigned i=0;i<128;i++){
+        words[2*i]=nearest_sample(p->coefficients[2*i]*mult);
+        words[2*i+1]=nearest_sample(-p->coefficients[255-2*i]*mult);
+    }
+#if defined(__PI32V2__)
+    if(!fm1_fft128_forward(words))return 0;
+#else
+    /* The host exercises the same input and output rounding and signs. */
+    for(unsigned i=0;i<128;i++){
+        p->coefficients[2*i]=(float)words[2*i];
+        p->coefficients[255-2*i]=(float)-words[2*i+1];
+    }
+    mdct_fft(p,1);
+    for(unsigned i=0;i<128;i++){
+        words[2*i]=nearest_sample(p->coefficients[2*i]);
+        words[2*i+1]=nearest_sample(-p->coefficients[255-2*i]);
+    }
+#endif
+    for(unsigned i=0;i<128;i++){
+        p->coefficients[2*i]=(float)words[2*i]*inverse;
+        p->coefficients[255-2*i]=(float)-words[2*i+1]*inverse;
+    }
+    return 1;
+}
+static __attribute__((noinline)) void echo_dct_iv(fx808_transform_t *p)
+{
+    for (unsigned m = 0; m < ECHO_HOP / 2; m++) {
+        float e = p->coefficients[2 * m], o = p->coefficients[ECHO_HOP - 1 - 2 * m];
+        float c = echo_cosine(4 * m), s = echo_sine(4 * m);
+        p->coefficients[2 * m] = e * c + o * s;
+        p->coefficients[ECHO_HOP - 1 - 2 * m] = e * s - o * c;
+    }
+    if(!echo_fft_fixed(p)) mdct_fft(p, 1);
+    for (unsigned m = 0; m < ECHO_HOP / 2; m++) {
+        float c = echo_cosine(4 * m + 1), s = echo_sine(4 * m + 1);
+        float re = p->coefficients[2 * m], im = p->coefficients[ECHO_HOP - 1 - 2 * m];
+        p->coefficients[2 * m] = re * c - im * s;
+        p->coefficients[ECHO_HOP - 1 - 2 * m] = re * s + im * c;
+    }
+}
+static inline float windowed(fx808_transform_t *p, unsigned base, unsigned i)
+{
+    return (float)p->recent[(base + i) % ECHO_RECENT] * echo_sine((int)(2 * i + 1));
+}
+typedef fx808_cache_t echo_cache_t;
+static inline echo_cache_t *echo_cache(const fx808_transform_t *p){return p->spectrum_cache;}
+static inline uint8_t *echo_widths(const fx808_transform_t *p,unsigned i){return (uint8_t *)(p->decoded_hop+ECHO_HOP)+10*i;}
+static __attribute__((noinline)) void encode_echo_packet(fx808_transform_t *p, unsigned index)
+{
+    if (!p->current_signal && !p->previous_signal) {
+        uint8_t *quiet = p->packet_data + index * PACKET_BYTES;
+        __builtin_memset(quiet, 0, PACKET_BYTES);
+        quiet[0] = 30;
+        return;
+    }
+    unsigned a = (p->physical_cursor + ECHO_RECENT - ECHO_WINDOW) % ECHO_RECENT;
+    for (unsigned j = 0; j < ECHO_HOP / 2; j++)
+        p->coefficients[j] =
+            -windowed(p, a, 3 * ECHO_HOP / 2 - 1 - j) - windowed(p, a, 3 * ECHO_HOP / 2 + j);
+    for (unsigned j = ECHO_HOP / 2; j < ECHO_HOP; j++)
+        p->coefficients[j] = windowed(p, a, j - ECHO_HOP / 2) - windowed(p, a, 3 * ECHO_HOP / 2 - 1 - j);
+    echo_dct_iv(p);
+    float maxb[ECHO_BANDS] = {0}, peak = 0;
+    for (unsigned k = 0; k < ECHO_HOP; k++) {
+        float mag = fm_fabsf(p->coefficients[k]);
+        if (mag > maxb[k / ECHO_BAND_BINS])
+            maxb[k / ECHO_BAND_BINS] = mag;
+        if (mag > peak)
+            peak = mag;
+    }
+    uint8_t *dst = p->packet_data + index * PACKET_BYTES;
+    __builtin_memset(dst, 0, PACKET_BYTES);
+    unsigned at = 0;
+    union {
+        uint32_t u;
+        float f;
+    } word;
+    word.f = peak;
+    int e = peak <= 1 ? 0 : (int)(word.u >> 23) - 127 + ((word.u & 8388607u) != 0);
+    if (peak == 0) {
+        dst[0] = 30;
+        return;
+    }
+    bit_put(dst, &at, (unsigned)e, 5);
+    unsigned rel[ECHO_BANDS], width[ECHO_BANDS];
+    for (unsigned b = 0; b < ECHO_BANDS; b++) {
+        unsigned r=31;
+        if(maxb[b]>0){
+            union {float f;unsigned u;} z={.f=maxb[b]};
+            int base=(int)(z.u>>23)-127;
+            z.u=(z.u&8388607u)|(127u<<23);
+            int relative=2*(e-base)-(z.f>=1.189207115f)-(z.f>=1.681792831f);
+            r=relative<0?0:relative<31?(unsigned)relative:31;
+        }
+        rel[b] = r;
+        bit_put(dst, &at, r, 5);
+    }
+    allocate_bit_planes(rel, width);
+    uint8_t *record=echo_widths(p,index);
+    for(unsigned j=0;j<10;j++)record[j]=0;
+    unsigned width_pos=0;
+    for(unsigned j=0;j<ECHO_BANDS;j++)bit_put(record,&width_pos,width[j],5);
+
+    for (unsigned b = 0; b < ECHO_BANDS; b++) {
+        unsigned w = width[b];
+        if (!w)
+            continue;
+        int max = (1 << (w - 1)) - 1;
+        float mult = (float)max / packet_scale((unsigned)e, rel[b]);
+        for (unsigned j = 0; j < ECHO_BAND_BINS; j++) {
+            int q = nearest_sample(p->coefficients[b * ECHO_BAND_BINS + j] * mult);
+            if (q > max)
+                q = max;
+            if (q < -max)
+                q = -max;
+            bit_put(dst, &at, (unsigned)q, w);
+        }
+    }
+
+    unsigned nz = 0;
+    for (unsigned i = 0; i < ECHO_HOP; i++)
+        if (p->recent[(a + i) % ECHO_RECENT] != 0)
+            nz |= 1u << (i / (ECHO_HOP / 8));
+    dst[PACKET_BYTES - 1] = (uint8_t)nz;
+    if (nz)
+        onset_store(p, index, a);
+}
+static __attribute__((noinline)) void decode_echo_spectrum(fx808_transform_t *p, unsigned idx)
+{
+    unsigned at = 0, rel[ECHO_BANDS], width[ECHO_BANDS];
+    const uint8_t *src = p->packet_data + idx * PACKET_BYTES;
+    unsigned e = bit_get(src, &at, 5);
+    if (e >= 30) {
+        __builtin_memset(p->coefficients, 0, sizeof p->coefficients);
+        return;
+    }
+    for (unsigned b = 0; b < ECHO_BANDS; b++)
+        rel[b] = bit_get(src, &at, 5);
+    const uint8_t *record=echo_widths(p,idx);
+    unsigned width_pos=0;
+    for(unsigned j=0;j<ECHO_BANDS;j++)width[j]=bit_get(record,&width_pos,5);
+    for (unsigned b = 0; b < ECHO_BANDS; b++) {
+        unsigned w = width[b];
+        float step = w > 1 ? packet_scale(e, rel[b]) / ((1 << (w - 1)) - 1) : 0;
+        for (unsigned j = 0; j < ECHO_BAND_BINS; j++) {
+            int q = 0;
+            if (w) {
+                unsigned h = 1u << (w - 1);
+                q = (int)(bit_get(src, &at, w) ^ h) - (int)h;
+            }
