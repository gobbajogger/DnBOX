+    0,     402,   804,   1206,  1608,  2009,  2410,  2811,  3212,  3612,  4011,  4410,  4808,  5205,  5602,
+    5998,  6393,  6786,  7179,  7571,  7962,  8351,  8739,  9126,  9512,  9896,  10278, 10659, 11039, 11417,
+    11793, 12167, 12539, 12910, 13279, 13645, 14010, 14372, 14732, 15090, 15446, 15800, 16151, 16499, 16846,
+    17189, 17530, 17869, 18204, 18537, 18868, 19195, 19519, 19841, 20159, 20475, 20787, 21096, 21403, 21705,
+    22005, 22301, 22594, 22884, 23170, 23452, 23731, 24007, 24279, 24547, 24811, 25072, 25329, 25582, 25832,
+    26077, 26319, 26556, 26790, 27019, 27245, 27466, 27683, 27896, 28105, 28310, 28510, 28706, 28898, 29085,
+    29268, 29447, 29621, 29791, 29956, 30117, 30273, 30424, 30571, 30714, 30852, 30985, 31113, 31237, 31356,
+    31470, 31580, 31685, 31785, 31880, 31971, 32057, 32137, 32213, 32285, 32351, 32412, 32469, 32521, 32567,
+    32609, 32646, 32678, 32705, 32728, 32745, 32757, 32765, 32767, 32767};
+static ECHO_SMALL float echo_sine(int step)
+{
+    unsigned p = (unsigned)step & (8 * ECHO_HOP - 1), q = p / (2 * ECHO_HOP), i = p % (2 * ECHO_HOP);
+    unsigned x = (q & 1) ? 2 * ECHO_HOP - i : i;
+    int base = mdct_lut[x / 4];
+    float s = (float)(4 * base + (mdct_lut[x / 4 + 1] - base) * (int)(x % 4)) * (1.f / (4 * 32767.f));
+    return q >= 2 ? -s : s;
+}
+static ECHO_SMALL float echo_cosine(int step) { return echo_sine(step + 2 * ECHO_HOP); }
+static ECHO_SMALL int nearest_sample(float x) { return (int)(x + (x < 0 ? -.5f : .5f)); }
+static ECHO_SMALL void mdct_fft(fx808_transform_t *p, int sign)
+{
+    for (unsigned i = 1, j = 0; i < (ECHO_HOP / 2); i++) {
+        unsigned bit = (ECHO_HOP / 2) / 2;
+        for (; j & bit; bit >>= 1)
+            j ^= bit;
+        j ^= bit;
+        if (i < j) {
+            float t = p->coefficients[2 * i];
+            p->coefficients[2 * i] = p->coefficients[2 * j];
+            p->coefficients[2 * j] = t;
+            t = p->coefficients[ECHO_HOP - 1 - 2 * i];
+            p->coefficients[ECHO_HOP - 1 - 2 * i] = p->coefficients[ECHO_HOP - 1 - 2 * j];
+            p->coefficients[ECHO_HOP - 1 - 2 * j] = t;
+        }
+    }
+    for (unsigned n = 2; n <= (ECHO_HOP / 2); n *= 2)
+        for (unsigned j = 0; j < n / 2; j++) {
+            int step = sign * (int)(8 * ECHO_HOP / n * j);
+            float wc = echo_cosine(step), ws = echo_sine(step);
+            for (unsigned a = j; a < (ECHO_HOP / 2); a += n) {
+                unsigned b = a + n / 2;
+                float r = wc * p->coefficients[2 * b] - ws * p->coefficients[ECHO_HOP - 1 - 2 * b],
+                      i = wc * p->coefficients[ECHO_HOP - 1 - 2 * b] + ws * p->coefficients[2 * b];
+                p->coefficients[2 * b] = p->coefficients[2 * a] - r;
+                p->coefficients[ECHO_HOP - 1 - 2 * b] = p->coefficients[ECHO_HOP - 1 - 2 * a] - i;
+                p->coefficients[2 * a] += r;
+                p->coefficients[ECHO_HOP - 1 - 2 * a] += i;
+            }
+        }
+}
+static ECHO_SMALL void bit_put(uint8_t *p, unsigned *at, unsigned x, unsigned bits)
+{
+    for (unsigned j = 0; j < bits; j++, (*at)++)
+        if (x & (1u << j))
+            p[*at / 8] |= (uint8_t)(1u << (*at % 8));
+}
+static ECHO_SMALL unsigned bit_get(const uint8_t *p, unsigned *at, unsigned bits)
+{
+    unsigned x = 0;
+    for (unsigned j = 0; j < bits; j++, (*at)++)
+        x |= ((unsigned)(p[*at / 8] >> (*at % 8)) & 1) << j;
+    return x;
+}
+/* Send one half-octave peak per band of coefficients and allocate whole bit planes. Both
+ * decoder and encoder derive the widths from these transmitted peaks. */
+static ECHO_SMALL void allocate_bit_planes(const unsigned *rel, unsigned *width)
+{
+    unsigned lo = rel[0], high = 31;
+    if (rel[1] < lo)
+        lo = rel[1];
+    for (unsigned b = ECHO_BANDS / 2; b < ECHO_BANDS; b++)
+        if (rel[b] < high)
+            high = rel[b];
+    unsigned weight = high >= lo + LOW_BAND_GAP ? LOW_BAND_WEIGHT : BAND_WEIGHT;
+    int priority[ECHO_BANDS];
+    for (unsigned b = 0; b < ECHO_BANDS; b++) {
+        width[b] = 0;
+        priority[b] = rel[b] == 31 ? -10000 : -(int)(rel[b] * weight);
+    }
+    for (unsigned i = 0; i < (PACKET_BITS - 5 - 5 * ECHO_BANDS) / ECHO_BAND_BINS; i++) {
+        int k = 0;
+        for (int b = 1; b < ECHO_BANDS; b++)
+            if (priority[b] > priority[k])
+                k = b;
+        if (priority[k] <= -10000)
+            break;
+        if (++width[k] >= 18)
+            priority[k] = -10000;
+        else
+            priority[k] -= ALLOCATION_STEP;
+    }
+}
+static ECHO_SMALL float packet_scale(unsigned e, unsigned r)
+{
+    union {
+        uint32_t u;
+        float f;
+    } p;
+    p.u = (unsigned)((int)e - (int)(r / 2) + 127) << 23;
+    return (r & 1) ? p.f * .7071067811865475244f : p.f;
+}
+/* A transient can borrow two previously silent packets. They remain live
+ * longer than any valid read of the enhanced hop at the maximum tap. */
+static ECHO_SMALL unsigned onset_bit(const uint8_t *a, const uint8_t *b, unsigned pos)
+{
+    const uint8_t *x = pos < (PACKET_BYTES - 1) * 8 ? a : b;
+    return (x[1 + (pos / 8) % (PACKET_BYTES - 1)] >> (pos & 7)) & 1;
+}
+static ECHO_SMALL void onset_put(uint8_t *a, uint8_t *b, unsigned *pos, unsigned val, unsigned n)
+{
+    for (unsigned i = 0; i < n; i++, (*pos)++) {
+        uint8_t *x = *pos < (PACKET_BYTES - 1) * 8 ? a : b;
+        if (val & (1u << i))
+            x[1 + (*pos / 8) % (PACKET_BYTES - 1)] |= 1u << (*pos & 7);
+    }
+}
+static ECHO_SMALL unsigned onset_get(const uint8_t *a, const uint8_t *b, unsigned *pos, unsigned n)
+{
+    unsigned v = 0;
+    for (unsigned i = 0; i < n; i++, (*pos)++)
+        v |= onset_bit(a, b, *pos) << i;
+    return v;
+}
+static ECHO_SMALL unsigned map_signed(int d) { return d < 0 ? (unsigned)(-2 * d - 1) : (unsigned)(2 * d); }
+static ECHO_SMALL int from_mapped(unsigned x) { return (x & 1) ? -(int)(x / 2) - 1 : (int)(x / 2); }
+static ECHO_SMALL unsigned prior_packet(unsigned idx, unsigned d, unsigned blocks)
+{
+    return (idx + blocks - d) % blocks;
+}
+static ECHO_SMALL void onset_store(fx808_transform_t *p, unsigned idx, unsigned start)
+{
+    unsigned blocks = p->physical_frames / ECHO_HOP;
+    uint8_t *two = p->packet_data + prior_packet(idx, 2, blocks) * PACKET_BYTES,
+            *three = p->packet_data + prior_packet(idx, 3, blocks) * PACKET_BYTES;
+    if ((two[0] & 31) != 30 || (three[0] & 31) != 30)
+        return;
+    if (p->physical_frames - (p->frames - 256) < 2 * ECHO_HOP)
+        return;
+    unsigned mode[ECHO_HOP / 32], opt[ECHO_HOP / 32], costsum = 0;
+    for (unsigned group = 0; group < ECHO_HOP / 32; group++) {
+        int v[32];
+        for (unsigned j = 0; j < 32; j++)
+            v[j] = p->recent[(start + 32 * group + j) % ECHO_RECENT];
+        unsigned best = ~0u, order = 0, kbest = 0;
+        int nz = 0;
+        for (int j = 0; j < 32; j++)
+            nz |= v[j] != 0;
+        if (!nz) {
+            best = 2;
+            order = 3;
+        } else
+            for (unsigned o = 0; o <= 2; o++)
+                for (unsigned k = 0; k <= 10; k++) {
+                    unsigned cost = 6 + 16 * o + (32 - o) * (1 + k);
+                    for (unsigned j = o; j < 32 && cost < best; j++) {
+                        int pred = o == 0 ? 0 : o == 1 ? v[j - 1] : 2 * v[j - 1] - v[j - 2];
+                        cost += map_signed(v[j] - pred) >> k;
+                    }
+                    if (cost < best) {
+                        best = cost;
+                        order = o;
+                        kbest = k;
+                    }
+                }
+        mode[group] = order;
+        opt[group] = kbest;
+        costsum += best;
+        if (costsum > 2 * (PACKET_BYTES - 1) * 8)
+            return;
+    }
+    __builtin_memset(two, 0, PACKET_BYTES);
+    __builtin_memset(three, 0, PACKET_BYTES);
+    two[0] = 31 | (2 << 5);
+    three[0] = 31 | (3 << 5);
+    unsigned pos = 0;
+    for (unsigned group = 0; group < ECHO_HOP / 32; group++) {
+        unsigned o = mode[group], k = opt[group];
+        onset_put(two, three, &pos, o, 2);
+        if (o == 3)
+            continue;
+        onset_put(two, three, &pos, k, 4);
+        int v[32];
+        for (unsigned j = 0; j < 32; j++)
+            v[j] = p->recent[(start + 32 * group + j) % ECHO_RECENT];
+        for (unsigned j = 0; j < o; j++)
+            onset_put(two, three, &pos, (unsigned)v[j] & 65535, 16);
+        for (unsigned j = o; j < 32; j++) {
+            int pred = o == 0 ? 0 : o == 1 ? v[j - 1] : 2 * v[j - 1] - v[j - 2];
+            unsigned x = map_signed(v[j] - pred);
+            pos += x >> k;
+            onset_put(two, three, &pos, 1, 1);
+            onset_put(two, three, &pos, x, k);
+        }
+    }
+    p->packet_data[idx * PACKET_BYTES + PACKET_BYTES - 2] |= 128;
+}
+static ECHO_SMALL void onset_restore(fx808_transform_t *p, unsigned idx)
+{
+    if (!(p->packet_data[idx * PACKET_BYTES + PACKET_BYTES - 2] & 128))
+        return;
+    unsigned blocks = p->physical_frames / ECHO_HOP, pos = 0;
+    const uint8_t *two = p->packet_data + prior_packet(idx, 2, blocks) * PACKET_BYTES,
+                  *three = p->packet_data + prior_packet(idx, 3, blocks) * PACKET_BYTES;
+    if (two[0] != (31 | (2 << 5)) || three[0] != (31 | (3 << 5)))
+        return;
+    for (unsigned group = 0; group < ECHO_HOP / 32; group++) {
+        unsigned o = onset_get(two, three, &pos, 2);
+        int16_t *v = p->decoded_hop + group * 32;
+        if (o == 3) {
+            __builtin_memset(v, 0, 64);
+            continue;
+        }
+        unsigned k = onset_get(two, three, &pos, 4);
+        for (unsigned j = 0; j < o; j++)
+            v[j] = (int16_t)onset_get(two, three, &pos, 16);
+        for (unsigned j = o; j < 32; j++) {
+            unsigned run = 0;
+            while (!onset_get(two, three, &pos, 1))
+                run++;
+            int pred = o == 0 ? 0 : o == 1 ? v[j - 1] : 2 * v[j - 1] - v[j - 2];
+            v[j] = (int16_t)(pred + from_mapped((run << k) | onset_get(two, three, &pos, k)));
+        }
+    }
+}
+
+/* Pair x[2m] with x[N-1-2m]. A positive N/2-point complex FFT after
+ * pre-rotation, followed by a post-rotation, produces the even DCT-IV bins
+ * in its real part and the reversed, odd bins in the imaginary part. */
+static ECHO_SMALL void echo_dct_iv(fx808_transform_t *p)
+{
+    for (unsigned m = 0; m < ECHO_HOP / 2; m++) {
+        float e = p->coefficients[2 * m], o = p->coefficients[ECHO_HOP - 1 - 2 * m];
+        float c = echo_cosine(4 * m), s = echo_sine(4 * m);
+        p->coefficients[2 * m] = e * c + o * s;
+        p->coefficients[ECHO_HOP - 1 - 2 * m] = e * s - o * c;
+    }
+    mdct_fft(p, 1);
+    for (unsigned m = 0; m < ECHO_HOP / 2; m++) {
+        float c = echo_cosine(4 * m + 1), s = echo_sine(4 * m + 1);
+        float re = p->coefficients[2 * m], im = p->coefficients[ECHO_HOP - 1 - 2 * m];
+        p->coefficients[2 * m] = re * c - im * s;
+        p->coefficients[ECHO_HOP - 1 - 2 * m] = re * s + im * c;
+    }
+}
+static ECHO_SMALL float windowed(fx808_transform_t *p, unsigned base, unsigned i)
+{
+    return (float)p->recent[(base + i) % ECHO_RECENT] * echo_sine((int)(2 * i + 1));
+}
+static ECHO_SMALL void encode_echo_packet(fx808_transform_t *p, unsigned index)
+{
+    if (!p->current_signal && !p->previous_signal) {
+        uint8_t *quiet = p->packet_data + index * PACKET_BYTES;
+        __builtin_memset(quiet, 0, PACKET_BYTES);
+        quiet[0] = 30;
+        return;
+    }
+    unsigned a = (p->physical_cursor + ECHO_RECENT - ECHO_WINDOW) % ECHO_RECENT;
+    for (unsigned j = 0; j < ECHO_HOP / 2; j++)
+        p->coefficients[j] =
+            -windowed(p, a, 3 * ECHO_HOP / 2 - 1 - j) - windowed(p, a, 3 * ECHO_HOP / 2 + j);
+    for (unsigned j = ECHO_HOP / 2; j < ECHO_HOP; j++)
+        p->coefficients[j] = windowed(p, a, j - ECHO_HOP / 2) - windowed(p, a, 3 * ECHO_HOP / 2 - 1 - j);
+    echo_dct_iv(p);
+    float maxb[ECHO_BANDS] = {0}, peak = 0;
+    for (unsigned k = 0; k < ECHO_HOP; k++) {
+        float mag = fm_fabsf(p->coefficients[k]);
+        if (mag > maxb[k / ECHO_BAND_BINS])
+            maxb[k / ECHO_BAND_BINS] = mag;
+        if (mag > peak)
+            peak = mag;
+    }
+    uint8_t *dst = p->packet_data + index * PACKET_BYTES;
+    __builtin_memset(dst, 0, PACKET_BYTES);
+    unsigned at = 0;
+    union {
+        uint32_t u;
+        float f;
+    } word;
+    word.f = peak;
+    int e = peak <= 1 ? 0 : (int)(word.u >> 23) - 127 + ((word.u & 8388607u) != 0);
+    if (peak == 0) {
+        dst[0] = 30;
+        return;
+    }
+    bit_put(dst, &at, (unsigned)e, 5);
+    unsigned rel[ECHO_BANDS], width[ECHO_BANDS];
+    for (unsigned b = 0; b < ECHO_BANDS; b++) {
+        unsigned r = 0;
+        float scale = packet_scale((unsigned)e, 0);
+        while (r < 31 && maxb[b] < scale * .8408964152537145f) {
+            scale *= .7071067811865475f;
+            r++;
+        }
+        rel[b] = r;
+        bit_put(dst, &at, r, 5);
+    }
+    allocate_bit_planes(rel, width);
+    for (unsigned b = 0; b < ECHO_BANDS; b++) {
+        unsigned w = width[b];
+        if (!w)
+            continue;
+        int max = (1 << (w - 1)) - 1;
+        float mult = (float)max / packet_scale((unsigned)e, rel[b]);
+        for (unsigned j = 0; j < ECHO_BAND_BINS; j++) {
+            int q = nearest_sample(p->coefficients[b * ECHO_BAND_BINS + j] * mult);
+            if (q > max)
+                q = max;
+            if (q < -max)
+                q = -max;
+            bit_put(dst, &at, (unsigned)q, w);
+        }
+    }
+
+    unsigned nz = 0;
+    for (unsigned i = 0; i < ECHO_HOP; i++)
+        if (p->recent[(a + i) % ECHO_RECENT] != 0)
+            nz |= 1u << (i / (ECHO_HOP / 8));
+    dst[PACKET_BYTES - 1] = (uint8_t)nz;
+    if (nz)
+        onset_store(p, index, a);
+}
+static ECHO_SMALL void decode_echo_spectrum(fx808_transform_t *p, unsigned idx)
+{
+    unsigned at = 0, rel[ECHO_BANDS], width[ECHO_BANDS];
+    const uint8_t *src = p->packet_data + idx * PACKET_BYTES;
+    unsigned e = bit_get(src, &at, 5);
+    if (e >= 30) {
+        __builtin_memset(p->coefficients, 0, sizeof p->coefficients);
+        return;
+    }
+    for (unsigned b = 0; b < ECHO_BANDS; b++)
+        rel[b] = bit_get(src, &at, 5);
+    allocate_bit_planes(rel, width);
+    for (unsigned b = 0; b < ECHO_BANDS; b++) {
+        unsigned w = width[b];
+        float step = w > 1 ? packet_scale(e, rel[b]) / ((1 << (w - 1)) - 1) : 0;
+        for (unsigned j = 0; j < ECHO_BAND_BINS; j++) {
+            int q = 0;
+            if (w) {
+                unsigned h = 1u << (w - 1);
+                q = (int)(bit_get(src, &at, w) ^ h) - (int)h;
+            }
+            p->coefficients[b * ECHO_BAND_BINS + j] = (float)q * step;
+        }
+    }
+    echo_dct_iv(p);
+}
+static ECHO_SMALL float unfold(const fx808_transform_t *p, unsigned t)
+{
+    float z = t < ECHO_HOP / 2       ? p->coefficients[t + ECHO_HOP / 2]
+              : t < 3 * ECHO_HOP / 2 ? -p->coefficients[3 * ECHO_HOP / 2 - 1 - t]
+                                     : -p->coefficients[t - 3 * ECHO_HOP / 2];
+    return z * (2.f / ECHO_HOP) * echo_sine(2 * t + 1);
+}
+/* The right half is only needed while reconstructing one hop. Preserve
+ * its fractional samples at quiet levels in the existing int16 read cache.
+ * A normal binary16 significand suffices within the quantized delay range. */
+static inline int16_t pack_overlap(float value)
+{
+    union {
+        float f;
+        uint32_t u;
+    } bits = {.f = value};
+    uint32_t mag = bits.u & 0x7fffffffu;
+    if (mag < 0x38800000u)
+        return 0;
+    unsigned half = ((mag + 0x1000u) >> 13) - (112u << 10);
+    return (int16_t)((bits.u >> 16 & 0x8000u) | half);
+}
+static inline float unpack_overlap(int16_t value)
+{
+    unsigned half = (uint16_t)value, mag = half & 0x7fffu;
+    union {
+        float f;
+        uint32_t u;
+    } bits;
+    bits.u = mag ? ((half & 0x8000u) << 16) | ((mag + (112u << 10)) << 13) : 0;
+    return bits.f;
+}
+/* A hop is the sum of the right half of its previous inverse transform and
+ * the left half of its own. Consecutive reads share the inverse overlap. */
+static ECHO_SMALL void load_echo_hop(fx808_transform_t *p, unsigned idx)
+{
+    unsigned blocks = p->physical_frames / ECHO_HOP;
+    if (p->read_hop == idx)
+        return;
+    unsigned prev = idx ? idx - 1 : blocks - 1;
+    if ((p->packet_data[idx * PACKET_BYTES] & 31) >= 30 &&
+        (p->packet_data[prev * PACKET_BYTES] & 31) >= 30) {
+        __builtin_memset(p->decoded_hop, 0, ECHO_HOP * sizeof(int16_t));
+        p->read_hop = idx;
+        return;
+    }
+    decode_echo_spectrum(p, prev);
+    for (unsigned i = 0; i < ECHO_HOP; i++) {
+        p->decoded_hop[i] = pack_overlap(unfold(p, ECHO_HOP + i));
+    }
+    decode_echo_spectrum(p, idx);
+    for (unsigned i = 0; i < ECHO_HOP; i++) {
+        int q = nearest_sample(unpack_overlap(p->decoded_hop[i]) + unfold(p, i));
+        if (q > 32767)
+            q = 32767;
+        if (q < -32767)
+            q = -32767;
+        p->decoded_hop[i] = (int16_t)q;
+        if (!(p->packet_data[idx * PACKET_BYTES + PACKET_BYTES - 1] & (1u << (i / (ECHO_HOP / 8)))))
+            p->decoded_hop[i] = 0;
+    }
+    if ((p->packet_data[idx * PACKET_BYTES] & 31) < 30)
+        onset_restore(p, idx);
+    p->read_hop = idx;
+}
+static ECHO_SMALL void echo_history_init(fx808_transform_t *p, void *arena)
+{
+    p->frames = FX_808_DELAY_FRAMES;
+    p->physical_frames = ((FX_808_DELAY_FRAMES + ECHO_RECENT - 1) / ECHO_RECENT) * ECHO_RECENT;
+    p->physical_cursor = p->source_cursor = 0;
+    p->read_hop = ~0u;
+    p->packet_data = (uint8_t *)arena;
+    __builtin_memset(arena, 0, (p->physical_frames / ECHO_HOP) * PACKET_BYTES);
+    __builtin_memset(p->recent, 0, sizeof p->recent);
+    for (unsigned j = 0; j < p->physical_frames / ECHO_HOP; j++)
+        p->packet_data[j * PACKET_BYTES] = 30;
+    p->decoded_hop = (int16_t *)(p->packet_data + (p->physical_frames / ECHO_HOP) * PACKET_BYTES);
+}
+/* Convert the original engine cursor into age before indexing the
+ * hop-aligned packet ring. Its 89,088 samples include the analysis guard. */
+static ECHO_SMALL int echo_history_read(fx808_transform_t *p, unsigned idx)
+{
+    unsigned age = (p->source_cursor >= idx) ? p->source_cursor - idx : p->frames + p->source_cursor - idx;
+    unsigned physical_cursor = p->physical_cursor >= age ? p->physical_cursor - age
+                                                         : p->physical_frames + p->physical_cursor - age;
+    /* A decoded block needs its successor for overlap/add. Return the original
+       staged data until the following complete block has been encoded. */
+    if (age > 0 && age <= ECHO_RECENT)
+        return p->recent[physical_cursor % ECHO_RECENT];
+    load_echo_hop(p, physical_cursor / ECHO_HOP);
+    return p->decoded_hop[physical_cursor % ECHO_HOP];
+}
+static ECHO_SMALL void echo_history_write(fx808_transform_t *p, int sample)
+{
+    p->current_signal |= sample != 0;
+    p->recent[p->physical_cursor % ECHO_RECENT] = (int16_t)sample;
+    if (++p->source_cursor == p->frames)
+        p->source_cursor = 0;
+    if (++p->physical_cursor == p->physical_frames)
+        p->physical_cursor = 0;
+    if (p->physical_cursor % ECHO_HOP == 0) {
+        unsigned blocks = p->physical_frames / ECHO_HOP, h = p->physical_cursor / ECHO_HOP,
+                 idx = (h + blocks - 2) % blocks;
+        encode_echo_packet(p, idx);
+        p->previous_signal = p->current_signal;
+        p->current_signal = 0;
+        if (p->read_hop == idx || p->read_hop == (idx + 1) % blocks)
+            p->read_hop = ~0u;
+    }
+}
