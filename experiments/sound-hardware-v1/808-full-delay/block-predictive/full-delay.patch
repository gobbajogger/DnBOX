index 00000000..4105ac3a
--- /dev/null
+++ b/firmware/src/dsp/fxbus_808_history.h
@@ -0,0 +1,214 @@
+#define CHUNK 16
+#define FORCEHF 0
+#pragma once
+#define ECHO_SMALL
+#ifndef SHAPE_ALPHA
+#define SHAPE_ALPHA 2
+#endif
+#ifndef PCM_BITS
+#define PCM_BITS 5
+#endif
+#ifndef PCM_GROUP
+#define PCM_GROUP 64
+#endif
+#ifndef PCM_RECENT
+#define PCM_RECENT 1536
+#endif
+enum {
+    BITS = PCM_BITS,
+    GROUP = PCM_GROUP,
+    RECENT = 1536,
+    PACK = (4 + 1 + ((GROUP - 2) * BITS + 7) / 8),
+    RANGE = (1u << (BITS - 1)) - 1
+};
+static unsigned pred_get(const uint8_t *d, unsigned j)
+{
+    unsigned a = j * BITS, o = a & 7u;
+    const uint8_t *p = d + a / 8;
+    unsigned v = p[0];
+    if (o + BITS > 8)
+        v |= p[1] << 8;
+    if (o + BITS > 16)
+        v |= p[2] << 16;
+    return (v >> o) & ((1u << BITS) - 1);
+}
+static void pred_put(uint8_t *d, unsigned j, unsigned q)
+{
+    unsigned a = j * BITS, o = a & 7u;
+    uint8_t *p = d + a / 8;
+    q = (q & ((1u << BITS) - 1)) << o;
+    if (o)
+        p[0] |= q;
+    else
+        p[0] = q;
+    if (o + BITS > 8)
+        p[1] = q >> 8;
+    if (o + BITS > 16)
+        p[2] = q >> 16;
+}
+static inline uint8_t *echo_group(fx808_history_t *p, unsigned g)
+{
+    return g < 43 ? p->prefix + g * PACK : p->packet_data + (g - 43) * PACK;
+}
+static void echo_history_init(fx808_history_t *p, void *arena)
+{
+    p->frames = FX_808_DELAY_FRAMES;
+    p->physical_frames = 89088;
+    p->source_cursor = p->physical_cursor = 0;
+    p->error[0] = p->error[1] = 0;
+    p->read_hop = ~0u;
+    p->packet_data = arena;
+    p->recent = (int16_t *)(p->packet_data + (1392 - 43) * PACK);
+    __builtin_memset(arena, 0, 2 * FX_808_DELAY_WORDS);
+    __builtin_memset(p->prefix, 0, sizeof p->prefix);
+}
+static inline int pred_base(int a, int b, unsigned order)
+{
+    return order == 0 ? 0 : order == 1 ? a : 2 * a - b;
+}
+static inline int pred_limit(int q) { return q < -32767 ? -32767 : q > 32767 ? 32767 : q; }
+static int echo_history_read(fx808_history_t *p, unsigned idx)
+{
+    unsigned age = p->source_cursor >= idx ? p->source_cursor - idx : p->frames + p->source_cursor - idx;
+    unsigned pos = p->physical_cursor >= age ? p->physical_cursor - age
+                                             : p->physical_cursor + p->physical_frames - age;
+    if (age && age <= (PCM_RECENT > GROUP ? PCM_RECENT : GROUP))
+        return p->recent[pos % RECENT];
+    unsigned group = pos / GROUP;
+    int16_t *v = p->decoded_hop;
+    if (p->read_hop != group) {
+        const uint8_t *t = echo_group(p, group);
+        if (t[0] == 240) {
+            for (unsigned i = 0; i < GROUP; i++) {
+                unsigned z = i >> (CHUNK == 16 ? 4 : 3), shift = (t[1 + z / 2] >> (4 * (z & 1))) & 15;
+                unsigned q = pred_get(t + 1 + GROUP / CHUNK / 2, i);
+                int res = (int)(q ^ (1u << (BITS - 1))) - (1 << (BITS - 1));
+                v[i] = (int16_t)(res * (1 << shift));
+            }
+        } else {
+            unsigned ord = t[0] >> 4, step = 1u << (t[0] & 15);
+            v[0] = (int16_t)(t[1] | t[2] << 8);
+            v[1] = (int16_t)(t[3] | t[4] << 8);
+            int a = v[1], b = v[0];
+            for (unsigned i = 2; i < GROUP; i++) {
+                unsigned q = pred_get(t + 5, i - 2);
+                int res = (int)(q ^ (1u << (BITS - 1))) - (1 << (BITS - 1));
+                int x = pred_limit(pred_base(a, b, ord) + res * (int)step);
+                v[i] = (int16_t)x;
+                b = a;
+                a = x;
+            }
+        }
+        p->read_hop = group;
+    }
+    return v[pos % GROUP];
+}
+static void echo_history_write(fx808_history_t *p, int sample)
+{
+    unsigned pos = p->physical_cursor;
+    p->recent[pos % RECENT] = (int16_t)sample;
+    if (++p->physical_cursor == p->physical_frames)
+        p->physical_cursor = 0;
+    if (++p->source_cursor == p->frames)
+        p->source_cursor = 0;
+    if (pos % GROUP != GROUP - 1)
+        return;
+    unsigned g = pos / GROUP;
+    int16_t *v = p->recent + (g * GROUP) % RECENT;
+    uint8_t *t = echo_group(p, g);
