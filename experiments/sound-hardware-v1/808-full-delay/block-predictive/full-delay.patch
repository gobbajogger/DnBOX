+                if (q < -(int)RANGE - 1)
+                    q = -(int)RANGE - 1;
+                pred_put(t + 1 + GROUP / CHUNK / 2, i, (unsigned)q);
+                e2 = e1;
+                e1 = req - q * step;
+                if (e1 > step)
+                    e1 = step;
+                if (e1 < -step)
+                    e1 = -step;
+            }
+        }
+        p->error[0] = e1;
+        p->error[1] = e2;
+        if (p->read_hop == g)
+            p->read_hop = ~0u;
+        return;
+    }
+    unsigned peak[3] = {0};
+    for (unsigned i = 2; i < GROUP; i++) {
+        for (unsigned j = 0; j < 3; j++) {
+            int d = v[i] - pred_base(v[i - 1], v[i - 2], j);
+            unsigned a = d < 0 ? -d : d;
+            if (a > peak[j])
+                peak[j] = a;
+        }
+    }
+    unsigned ord = 0;
+    for (unsigned j = 1; j < 3; j++)
+        if (peak[j] < peak[ord])
+            ord = j;
+    unsigned max = peak[ord], sh = 0;
+    while (((max + ((1u << sh) / 2)) >> sh) > RANGE)
+        sh++;
+    t[0] = ord * 16 + sh;
+    t[1] = (uint16_t)v[0];
+    t[2] = (uint16_t)v[0] >> 8;
+    t[3] = (uint16_t)v[1];
+    t[4] = (uint16_t)v[1] >> 8;
+    int a = v[1], b = v[0];
+    int err1 = (int)p->error[0], err2 = (int)p->error[1];
+    for (unsigned i = 2; i < GROUP; i++) {
+        int correction = 0;
+        int target = v[i] + correction, estimate = pred_base(a, b, ord), r = target - estimate;
+        unsigned mag = r < 0 ? -r : r;
+        int q = (int)((mag + ((1u << sh) / 2)) >> sh);
+        if (q > (int)RANGE)
+            q = RANGE;
+        if (r < 0)
+            q = -q;
+        pred_put(t + 5, i - 2, (unsigned)q);
+        b = a;
+        a = pred_limit(estimate + q * (1 << sh));
+        err2 = err1;
+        err1 = target - a;
+        int limit = 1 << sh;
+        if (err1 > limit)
+            err1 = limit;
+        if (err1 < -limit)
+            err1 = -limit;
+    }
+    p->error[0] = err1;
+    p->error[1] = err2;
+    if (p->read_hop == g)
+        p->read_hop = ~0u;
+}
