+            }
+            unsigned sh = 0;
+            while (((peak + ((1u << sh) / 2)) >> sh) > RANGE)
+                ++sh;
+            if (j % 2)
+                t[1 + j / 2] |= sh << 4;
+            else
+                t[1 + j / 2] = sh;
+            int step = 1 << sh;
+            for (unsigned k = 0; k < CHUNK; k++) {
+                unsigned i = j * CHUNK + k;
+                int req = v[i] + (SHAPE_ALPHA == 1 ? e1 : 2 * e1 - e2);
+                int q = req < 0 ? -((-req + step / 2) >> sh) : ((req + step / 2) >> sh);
