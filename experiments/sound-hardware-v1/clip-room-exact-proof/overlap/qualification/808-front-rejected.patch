+/* Two independent fixed-coefficient front filters and opamps. The narrower
+ * stage keeps the six feedback words live without the body/envelope spills. */
+static __attribute__((noinline)) void cy_opamp_front(d8_cy_t *restrict v,
+    const float *restrict bus, float *restrict first, float *restrict second, int m)
+{
+    const float c10 = k_cy_bp1[0], c11 = k_cy_bp1[1];
+    const float c14 = k_cy_bp1[4], c15 = k_cy_bp1[5], c16 = k_cy_bp1[6];
+    const float c20 = k_cy_bp2[0], c21 = k_cy_bp2[1];
+    const float c24 = k_cy_bp2[4], c25 = k_cy_bp2[5], c26 = k_cy_bp2[6];
+    float bp1z0 = v->bp1.z[0], bp1z1 = v->bp1.z[1], bp1z2 = v->bp1.z[2];
+    float bp2z0 = v->bp2.z[0], bp2z1 = v->bp2.z[1], bp2z2 = v->bp2.z[2];
+    for (int i=0;i<m;i++) {
+        const float x=bus[i];
+        float num0=c10*x, num1=c11*x;
+        float y=num0+bp1z0;
+        bp1z0=num1-c14*y+bp1z1;
+        bp1z1=(-num0)-c15*y+bp1z2;
+        bp1z2=(-num1)-c16*y;
+        first[i]=opamp_clip(y,14.0f,1.0f/14.0f);
+        num0=c20*x; num1=c21*x;
+        y=num0+bp2z0;
+        bp2z0=num1-c24*y+bp2z1;
+        bp2z1=(-num0)-c25*y+bp2z2;
+        bp2z2=(-num1)-c26*y;
+        second[i]=opamp_clip(y,14.0f,1.0f/14.0f);
+    }
+    v->bp1.z[0] = bp1z0; v->bp1.z[1] = bp1z1; v->bp1.z[2] = bp1z2;
+    v->bp2.z[0] = bp2z0; v->bp2.z[1] = bp2z1; v->bp2.z[2] = bp2z2;
+}
