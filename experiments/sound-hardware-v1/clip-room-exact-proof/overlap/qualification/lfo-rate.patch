+#if DNBOX_S1_EXACT_LFO_RATE
+void s1u_lfo_tick_step(s1u_lfo *l, float step, int shape, float amount, float c2, float c1)
+{
+    l->ph += step; if (l->ph >= 1.0f) l->ph -= 1.0f;
+    float ph = l->ph;
+    float x = shape == 0 ? s1u_sin((uint32_t)(ph * 4294967296.0f)) :
+              shape == 1 ? (ph > 0.5f ? 1.0f : -1.0f) : shape == 2 ? (ph - 0.5f) * 2.0f : (0.5f - ph) * 2.0f;
+    l->sm = c1 * x + c2 * l->sm;
+    l->o01 = 0.5f * (1.0f + l->sm) * amount; l->o10 = 1.0f - 0.5f * (1.0f - l->sm) * amount;
+}
+#endif
