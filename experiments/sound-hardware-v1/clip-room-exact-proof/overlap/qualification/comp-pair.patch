+#if DNBOX_S1_COMP_PAIR
+/* Each channel retains its scalar recurrence and rounding. Independent
+ * recurrences share one call and the gain-refresh branch. */
+void s1u_comp_pair(float st[2][4],float *l,float *r,const s1u_cc *k,int upd)
+{
+    float *a=st[0], *b=st[1];
+    float xl=*l, xr=*r, al=fabsf(xl), ar=fabsf(xr);
+    float cl=a[0]>al ? k->s4 : k->s3;
+    float cr=b[0]>ar ? k->s4 : k->s3;
+    a[0]=a[0]*cl+(1.f-cl)*al;
+    b[0]=b[0]*cr+(1.f-cr)*ar;
+    if (upd) {
+        for (unsigned ch=0;ch<2;++ch) {
+            float *s=st[ch];
+            float over=s[0]>0.f ? 6.02059991f*log2f(s[0])-k->thr : 0.f;
+            s[2]=over>0.f ? over : 0.f;
+            s[3]=s[1]!=0.f ? exp2f(0.166096405f*s[1]) : 1.f;
+        }
+    }
+    a[1]=k->s1*a[1]+k->s2*a[2];
+    b[1]=k->s1*b[1]+k->s2*b[2];
+    *l=xl*a[3]; *r=xr*b[3];
+}
+#endif
