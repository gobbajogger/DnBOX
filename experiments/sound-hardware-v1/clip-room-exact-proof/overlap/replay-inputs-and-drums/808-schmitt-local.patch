+/* If all six phases start at least five deltas from the next edge,
+ * the next four have no wrap, jitter, or polyBLEP terms. Previously each
+ * of their ordered sums added six exact +/-2.5 terms and multiplied by
+ * 1/21. Their identical result can be evaluated and stored once as a pack.
+ * Distances and phase changes use the original full uint32 representation. */
+__attribute__((noinline,minsize)) static int bank_quiet_four(d8_bank_t *b, const uint32_t dt[6], float *bus, float *pair, int cb_on)
+{
+    if (b->drift_cnt <= 4 || b->pend_wrap) return 0;
+    unsigned signs=0, count=0;
+    for (unsigned i=0; i<6; ++i) {
+        const uint32_t t=b->ph[i], d=dt[i];
+        const unsigned positive=t<BANK_DUTY;
+        const uint32_t distance=(positive?BANK_DUTY:0u)-t;
+        /* Five steps fit a uint32 at every supported oscillator tuning. */
+        if (!d || d>UINT32_MAX/5u || distance<5u*d) return 0;
+        signs=(signs<<1)|positive;
+        count+=positive;
+    }
+    #pragma clang loop unroll(disable)
+    for (unsigned i=0;i<6;++i) {
+        b->ph[i]+=dt[i]<<2;
+    }
+    b->drift_cnt-=4;
+    const float sample=((float)((int)(count<<1)-6)*2.5f)*(1.0f/21.0f);
+    bus[0]=bus[1]=bus[2]=bus[3]=sample;
+    if (cb_on) {
+        const float two=((float)((int)((signs&1u)+((signs>>1)&1u))-1))*2.5f;
+        pair[0]=pair[1]=pair[2]=pair[3]=two;
+    }
+    return 1;
+}
