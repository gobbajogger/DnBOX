 /* phase increment in q32 for a cycles-per-sample value (any sign/size: wrapped to [0, 1)) */
 static uint32_t ph_inc(float dt) { dt -= fm_floorf(dt); return (uint32_t)(int32_t)(dt * 2147483520.0f) << 1; }
 
+/* A clamped oscillator only steps 0..0.5 cycles. Its integer part is
+ * zero, so discard the redundant floor call, not any phase bits. FM
+ * carrier uses the unrestricted function because modulation can cross 0. */
+static uint32_t ph_inc_bounded(float dt) { return (uint32_t)(int32_t)(dt * 2147483520.0f) << 1; }
+
 enum { I1, I2, BAL, SEMI1, SEMI2, VOL1, VOL2, SUBV, SUBOCT, SUBSQ, FMV, FMA, NOISEV, L1I, L1A, L1R,
