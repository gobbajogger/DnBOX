+/* SPDX-License-Identifier: GPL-3.0-only */
+#ifndef X0X_ASSET_BLOB_H
+#define X0X_ASSET_BLOB_H
+#include <stdint.h>
+#include "../crc32_nibble.h"
+
+static uint32_t asset_rd32(const uint8_t *p)
+{
+    return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+/* Common 16-byte header: magic, length, CRC and content identity. */
+static __attribute__((noinline)) int asset_blob_valid(const uint8_t *p, uint32_t room,
+                                                     uint32_t magic, uint32_t size, uint32_t id)
+{
+    if (!p || room < 16u || size > room - 16u || asset_rd32(p) != magic ||
+        asset_rd32(p + 4) != size || asset_rd32(p + 12) != id ||
+        asset_rd32(p + 8) != id)
+        return 0;
+    return x0x_crc32(p + 16u, size) == id;
+}
+#endif
