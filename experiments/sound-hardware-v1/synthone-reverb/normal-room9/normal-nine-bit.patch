+    {0x1.66e1480000000p+2f,-0x1.0ccccc0000000p+4f,0x0.0p+0f,0x1.0a3d700000000p-5f,0x1.e8f5c20000000p-1f},
+    {0x1.0000000000000p+0f,0x0.0p+0f,0x0.0p+0f,0x0.0p+0f,0x1.71eb860000000p+0f},
