+    {0x1.0000000000000p+0f,0x0.0p+0f,0x0.0p+0f,0x0.0p+0f,0x1.23851e0000000p+0f},
+    {0x1.0000000000000p+0f,0x0.0p+0f,0x0.0p+0f,0x0.0p+0f,0x1.ac28f60000000p+0f},
+    {0x1.0000000000000p+0f,0x0.0p+0f,0x0.0p+0f,0x0.0p+0f,0x1.b7ae140000000p-1f},
+    {0x1.a9c2900000000p+2f,0x0.0p+0f,0x0.0p+0f,0x1.2666660000000p-3f,0x1.3333340000000p+0f},
+};
+static const float room_wet_presets[10][5]={
+    {0x1.0000000000000p+0f,0x0.0p+0f,0x0.0p+0f,0x0.0p+0f,0x1.0000000000000p-1f},
+    {0x1.a000000000000p+3f,-0x1.0000000000000p+3f,0x1.0624de0000000p-10f,0x1.3333340000000p-3f,0x1.e147ae0000000p+0f},
+    {0x1.0000000000000p+0f,-0x1.f333340000000p+1f,0x0.0p+0f,0x1.70a3d80000000p-4f,0x1.08a3d80000000p+0f},
