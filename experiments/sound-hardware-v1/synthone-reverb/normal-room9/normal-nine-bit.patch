diff --git a/firmware/synthone-room.ld b/firmware/synthone-room.ld
new file mode 100644
index 0000000000000000000000000000000000000000..ad9739a1efe01807651bcbe40e781df7cb6bf198
--- /dev/null
+++ b/firmware/synthone-room.ld
@@ -0,0 +1,15 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+/* Seven data ways and two instruction ways provide 36 KiB of direct SRAM. */
+MEMORY {
+    ROOMLOW (rw) : ORIGIN = 0x01C00000, LENGTH = 0x1800
+    AUDIOCACHE (rw) : ORIGIN = 0x01F26000, LENGTH = 0x9000
+}
+SECTIONS {
+    .audiolow ADDR(.c1_text) + SIZEOF(.c1_text) (NOLOAD) : {
+        _audiolow_start = .; *(.audiolow*) . = ALIGN(4); _audiolow_end = .;
+    } > ROOMLOW
+    .audiocache (NOLOAD) : {
+        _audiocache_start = .; *(.audiocache*) . = ALIGN(4); _audiocache_end = .;
+    } > AUDIOCACHE
+    ASSERT(_audiolow_end <= 0x01C01800, "low audio history reaches the Bluetooth controller RAM")
+} INSERT AFTER .c1_text;
