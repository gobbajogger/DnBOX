+/* Original post-clamp factory compressor settings in fixed selector order. */
+static const float room_input_presets[9][5]={
+    {0x1.0000000000000p+0f,0x0.0p+0f,0x0.0p+0f,0x0.0p+0f,0x1.0000000000000p-1f},
