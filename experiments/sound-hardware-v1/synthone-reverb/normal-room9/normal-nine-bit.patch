@@ -0,0 +1,27 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#pragma once
+
+#if X0X_HIGH_AUDIO_RAM
+/* AC79NN SDK 1.2.14 cache_way_config, specialized for seven free data ways and
+ * two free instruction ways. This must execute from direct SRAM. */
+RAMINL void fm1_cache_clear(uint32_t base, uint32_t end)
+{
+    for (; base < end; base += 4)
+        REG32(base) = 0;
+}
+
+static RAMFN void fm1_audio_cache_init(void)
+{
+    fl_cache_idle();
+    CACHE_CON &= ~(3u << 8);
+    REG32(0x1EEE00Cu) = (REG32(0x1EEE00Cu) & 0xff000000u) | 0x00808080u;
+    REG32(0x1EEE010u) = (REG32(0x1EEE010u) & 0xffff0000u) | 0x00003f3fu;
+    fm1_cache_clear(0x01f00000u, 0x01f04000u);
+    fm1_cache_clear(0x01f08000u, 0x01f0a000u);
+    fm1_cache_clear(0x01f0a000u, 0x01f0a200u);
+    fm1_cache_clear(0x01f0b000u, 0x01f0b200u);
+    CACHE_CON |= 1u << 8;
+    if ((REG32(0x40400u) & (1u << 11)) || (REG32(0x40500u) & 1u))
+        CACHE_CON |= 1u << 9;
+}
+#endif
