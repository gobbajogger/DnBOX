+/* If all six phases start at least five deltas from the next edge,
+ * the next four have no wrap, jitter, or polyBLEP terms. Previously each
+ * of their ordered sums added six exact +/-2.5 terms and multiplied by
+ * 1/21. Their identical result can be evaluated and stored once as a pack.
+ * Distances and phase changes use the original full uint32 representation. */
+__attribute__((noinline,minsize)) static int bank_quiet_four(d8_bank_t *b, float *bus, float *pair, int cb_on)
+{
+    static const float sums[]={-15.f*(1.f/21.f),-10.f*(1.f/21.f),-5.f*(1.f/21.f),0.f,
+                                  5.f*(1.f/21.f), 10.f*(1.f/21.f),15.f*(1.f/21.f)};
+    static const float pairs[]={-2.5f,0.f,2.5f};
+    if (b->drift_cnt <= 4 || b->pend_wrap) return 0;
+    uint32_t next[6];
+    unsigned count=0;
+    #pragma clang loop unroll(disable)
+    for (unsigned i=0;i<6;++i) {
+        const uint32_t t=b->ph[i],d=b->dt[i];
+        const unsigned pos=t<BANK_DUTY;
+        if ((pos?BANK_DUTY:0u)-t<5u*d) return 0;
+        count+=pos;
+        next[i]=t+(d<<2);
+    }
+    __builtin_memcpy(b->ph,next,sizeof next);
+    b->drift_cnt-=4;
+    bus[0]=bus[1]=bus[2]=bus[3]=sums[count];
+    if(cb_on) {
+        const unsigned k=(next[4]<BANK_DUTY)+(next[5]<BANK_DUTY);
+        pair[0]=pair[1]=pair[2]=pair[3]=pairs[k];
+    }
+    return 1;
+}
