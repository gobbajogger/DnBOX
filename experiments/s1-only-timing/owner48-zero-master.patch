+/* The stereo compressor reads only pre-filter input and its own state.
+ * Keeping it in one pass lets the next pass carry only filter/limiter
+ * registers, rather than swapping both latched sets through the stack. */
+static __attribute__((noinline)) float master_comp_st_span(master_t *m, float *xl, float *xr, int n, float grmax)
+{
+    const float det_in = 1.0f - m->a_det, att_in = 1.0f - m->a_att;
+    const float rel_in = 1.0f - m->a_rel, pump_in = 1.0f - m->a_pump;
+    for (int i = 0; i < n; ++i) {
+        float s = xl[i], sr = xr[i], wet;
+        m->ms = fm_flush(m->a_det * m->ms + 0.5f * (det_in * s * s + det_in * sr * sr));
+        comp_tick(m, &grmax, att_in, rel_in, pump_in);
+        wet = s * m->g_lin;
+        xl[i] = s + (wet - s) * m->mix;
+        wet = sr * m->g_lin;
+        xr[i] = sr + (wet - sr) * m->mix;
+    }
+    return grmax;
+}
