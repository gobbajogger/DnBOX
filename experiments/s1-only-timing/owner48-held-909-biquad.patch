+/* All these low/high passes come from d9_biquad_set with equal b0/b2.
+ * Cache only that already-rounded input product. The original add/sub
+ * order, the independent b1 product and all published histories stay. */
+typedef struct { float p1, p2; } d9_sym_prod;
+D9_INLINE d9_sym_prod d9_sym_init(const d9_biquad_t *f)
+{
+    return (d9_sym_prod){f->b2*f->x1,f->b2*f->x2};
+}
+D9_INLINE float d9_sym_tick(d9_biquad_t *f,d9_sym_prod *p,float in)
+{
+    const float first=f->b0*in;
+    const float y=first+f->b1*f->x1+p->p2-f->a1*f->y1-f->a2*f->y2;
+    p->p2=p->p1;p->p1=first;
+    f->x2=f->x1;f->x1=in;f->y2=f->y1;f->y1=y;
+    return y;
+}
