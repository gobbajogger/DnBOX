+/* Exact floor(n * s / 32), for s in [0,32]. The quotient and remainder
+ * split keeps every intermediate in uint32_t without a wide divide. A
+ * boundary is only needed when decoding metadata or selecting a slice,
+ * never for each sample. Snapshots therefore need no 33-word offset table. */
+static inline uint32_t bank_start(const brk_bank_t *k, unsigned s)
+{
+    const uint32_t n = k->n;
+    return (n >> 5) * s + ((n & 31u) * s >> 5);
+}
