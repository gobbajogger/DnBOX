+/* During a tom render only the next level and remaining ramp are
+ * recurrent. The last returned level is externally observed at the next
+ * boundary, so defer publishing it while retaining the exact ramp math. */
+D9_INLINE float d9_tom_tick(d9_env_t *e)
+{
+    const float o = e->v;
+    if (e->left) {
+        if (--e->left) e->v *= e->r;
+        else e->v = e->v1;
+    }
+    return o;
+}
+
 /* Toms (er99_tom909_render): three VCOs on their own envelopes + stick noise.
