+/* Move the two exact powers of two (2 and 128) into the
+ * triangle coordinate before its subtraction. For the unsigned
+ * folded phase's finite range this has the same binary32 rounding. */
+D9_INLINE float d9_diode20_phase(uint32_t ph)
+{
+    const uint32_t folded = ph ^ (uint32_t)((int32_t)ph >> 31);
+    fm_bits_t u = {.f=(float)(int32_t)folded * (1.f/4194304.f)-256.f};
+    const uint32_t sign=u.u & 0x80000000u;
+    u.u &= 0x7fffffffu;
+    fm_bits_t t = {.f=d9_tanh_table(u.f)};
+    t.u |= sign;
+    return t.f * D9_INV_TANH_2_0;
+}
