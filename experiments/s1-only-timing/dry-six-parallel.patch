+
+static void six_worker(uint32_t n) { six_render_lane(&six_shadow,NULL,NULL,n,2u); }
+
+void s1c_render(s1c *s, float *outl, float *outr, unsigned n)
+{
+    /* Only this isolated, fixed six-held-note dry fixture can use the worker.
+     * The shadow can fail without touching the owner's voice or bus state. */
+    if (!bench_six_parallel_idle() || n>256u || n<64u ||
+        P(MONO)!=0.f || s->mono_prev || plat_cpu2_busy()!=0) {
+        six_render_lane(s,outl,outr,n,0u); return;
+    }
+    unsigned active=0, lower=0, upper=0;
+    for(unsigned j=0;j<S1C_VOICES;++j) {
+        const s1c_voice *v=&s->v[j];
+        if(v->root==-1 || v->stage==0 || (v->stage==2 && v->amp<0.01f)) continue;
+        active|=1u<<j;
+        if(j<3u) ++lower; else ++upper;
+    }
+    if(lower+upper<4u || !lower || !upper) {
+        six_render_lane(s,outl,outr,n,0u); return;
+    }
+    memcpy(&six_seed,s,sizeof *s);
+    memcpy(&six_shadow,s,sizeof *s);
+    plat_cpu2_sync();
+    if(!plat_cpu2_run(six_worker,n)) { six_render_lane(s,outl,outr,n,0u); return; }
+    six_render_lane(s,outl,outr,n,1u);
+    if(plat_cpu2_wait()) {
+        /* The HAL has held the failed core. Replay the isolated original state. */
+        ++bench_six_parallel[1];
+        memcpy(s,&six_seed,sizeof *s);
+        six_render_lane(s,outl,outr,n,0u);
+        return;
+    }
+    if(six_shadow.rnd!=s->rnd) {
+        ++bench_six_parallel[2];
+        memcpy(s,&six_seed,sizeof *s);
+        six_render_lane(s,outl,outr,n,0u);
+        return;
+    }
+    for(unsigned j=3;j<6;++j)s->v[j]=six_shadow.v[j];
+    for(unsigned f=0;f<n;++f) {
+        float y=outl[f];
+        for(unsigned j=0;j<3;++j) if(active&(8u<<j)) y+=six_voices[j][f];
