+/* Both envelopes are a deterministic function of these bits and shared
+ * controls. Compare at render-span ownership boundaries, never per sample.
+ * These structs include three explicitly initialized padding bytes. */
+static int s1c_share_envelopes(const s1c *s)
+{
+    const s1c_voice *v = s->v;
+    if (s->mono_prev || s->t[MONO] != 0.f || v->root < 0 || !v->stage)
+        return 0;
+    for (unsigned j = 1; j < S1C_VOICES; ++j) {
+        const s1c_voice *w = &s->v[j];
+        if (w->root < 0 || !w->stage ||
+            (s1c_fb){.f=v->gate}.u != (s1c_fb){.f=w->gate}.u ||
+            memcmp(&v->ea, &w->ea, sizeof v->ea) ||
+            memcmp(&v->ef, &w->ef, sizeof v->ef))
+            return 0;
+    }
+    return 1;
+}
+#endif
