+static UI_DRAW void replay_lg(int band,const void *snapshot)
+{
+    const lg_scene *s=snapshot;
+    for(unsigned i=band?s->end[band-1]:0;i<s->end[band];){
+        lg_op op;
+        const unsigned char *d=lg_data()+i;
+        memcpy(&op,d,sizeof op);i+=sizeof op;d+=sizeof op;
+        switch(op.kind){
+        case LG_POINT:cv_pset(op.x,op.y,op.color);break;
+        case LG_RECT:cv_rect(op.x,op.y,op.a,op.b,op.color);break;
+        case LG_BLEND:px_blend(op.x,op.y,op.color,op.z);break;
+        case LG_LINE:cv_line(op.x,op.y,op.a,op.b,op.color);break;
+        case LG_TEXT: {
+            const char *t=(const char *)d+1;
+            cv_text_clip(op.x,op.y,lg_font[op.z],t,op.color,op.a,op.b);
+            i+=(unsigned)*d+1;
+        } break;
+        case LG_ROUND:rounded_box(op.x,op.y,op.a,op.b,*d,op.color,op.z);i++;break;
+        case LG_DISC: {
+            float xy[3];memcpy(xy,d,sizeof xy);
+            disc(xy[0],xy[1],xy[2],op.color);i+=sizeof xy;
+        } break;
+        }
+    }
+}
+/* Capture all three logical bands before the first input opportunity. The
+ * protected tape occupies the tail of the same buffer, beyond a 32-row raster. */
+static UI_DRAW int draw_legacy_matrix_frame(void)
+{
+    lg_scene shot={0};
+    const uint16_t bg=C_BLACK;
+    lcd_sync();
+    lg_record=&shot;
+    for(unsigned band=0;band<3u;++band){
+        cv_w=240;
+        cv_h=cv_y1=band==2u?KNOB_H:BAND_H;
+        cv_row_base=cv_y0=cv_oy=0;
+        draw_part_sound((int)band);
+        shot.end[band]=shot.used;
+    }
+    lg_record=0;
+    if(shot.failed)return 0;
+    int force=cv_claim_scene_footer();
+    for(unsigned band=0;band<2u;++band)for(unsigned first=0;first<BAND_H;first+=LEGACY_RASTER_ROWS){
+        unsigned rows=BAND_H-first;if(rows>LEGACY_RASTER_ROWS)rows=LEGACY_RASTER_ROWS;
+        cv_window(240,BAND_H,first,rows,bg);
+        replay_lg((int)band,&shot);
+        cv_commit_main_window(band,first,rows);
+    }
+    cv_draw_scene_footer(bg,&shot,replay_lg,force,LEGACY_RASTER_ROWS);
+    return 1;
+}
