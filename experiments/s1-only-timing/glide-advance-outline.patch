+/* A matrix snapshot can advance this once, then paint all LCD windows with
+ * the same fraction. Keep separate history for each synth part. */
+typedef struct { float from,to; uint8_t seen; } matrix_glide_history;
+static float matrix_glide_advance(matrix_glide_history *h,int known,float current,float target)
+{
+    float f=1.f;
+    if(known) {
+        if(!h->seen || target!=h->to) {
+            h->from=h->seen?current:target;
+            h->to=target;
+            h->seen=1;
+        }
+        if(h->to!=h->from)f=(current-h->from)/(h->to-h->from);
+    }
+    if(f<0.f)f=0.f;
+    if(f>1.f)f=1.f;
+    return f;
+}
+static matrix_glide_history matrix_glide[NBASS];
