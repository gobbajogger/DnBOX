 /* one job, render and mix; core 1: not timed by the cycle counter (core 0's) */
+__attribute__((noinline)) static float bass_prepare_mix(int part,float *mono,const float *left,const float *right,unsigned n)
+{
+    float pk=part_peak[part], g=mix_level[part];
+    for(unsigned i=0;i<n;++i) {
+        const float l=left[i], r=right[i];
+        float a=fm_fabsf(l)*g;
+        if(a>pk) pk=a;
+        a=fm_fabsf(r)*g;
+        if(a>pk) pk=a;
+        mono[i]=.5f*(l+r);
+    }
+    return pk;
+}
