+/* Common check for both the staged reader and mapped read-only sectors.
+ * A zero length is never a valid boot record. */
+static __attribute__((noinline)) uint32_t boot_header_length(const uint8_t *h)
+{
+    if (boot_u32(h) != BOOT_MAGIC || boot_u16(h + 4) != BOOT_VERSION ||
+        boot_u32(h + 24) || boot_u32(h + 28) ||
+        boot_crc(h, 20) != boot_u32(h + 20))
+        return 0;
+    uint32_t len = boot_u32(h + 12);
+    return len >= BOOT_PAY_FIXED && len <= BOOT_REC_MAX ? len : 0u;
+}
