+/* Active lines contain printable ASCII; the rest of each fixed field is zero. */
+static __attribute__((noinline)) int boot_line_ok(const uint8_t *line, uint32_t active, uint32_t cap)
+{
+    for (uint32_t i = 0; i < active; ++i)
+        if ((uint32_t)line[i] - 32u > 94u)
+            return 0;
+    for (uint32_t i = active; i < cap; ++i)
+        if (line[i])
+            return 0;
+    return 1;
+}
