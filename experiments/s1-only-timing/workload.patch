+#include "../dsp/s1c/s1c_front.h"
+extern volatile uint32_t bench_owner;
+volatile uint32_t bench_s1_only[9];
+uint32_t bench_s1_samples(void) { return d8_frame; }
+
+static void bench_s1_inputs(uint32_t n)
+{
+    enum { CONFIG=65536u, ON=98304u, OFF=163840u };
+    if (d8_frame!=CONFIG && d8_frame!=ON && d8_frame!=OFF) return;
+    original_runtime_part *a=&original_bass[0], *b=&original_bass[1];
+    if (bench_owner!=2 || n!=256 || seq.playing ||
+        a->kind!=ORIGINAL_SOUND_SYNTHONE || a->status!=ORIGINAL_RUNTIME_OK ||
+        a->arp.cfg.on || original_runtime_active(b)) { bench_s1_only[0]=1;return; }
+    s1c *e=&a->dsp.synthone.e;
+    if(d8_frame==CONFIG){
+        if(original_runtime_retire(b)!=ORIGINAL_RUNTIME_OK ||
+            !s1c_front_set(e,20,0.f) ||
+            !s1c_front_set(e,S1C_P_RVON,1.f) || !s1c_front_set(e,S1C_P_RVMIX,.25f) ||
+            !s1c_front_set(e,S1C_P_DLON,1.f) || !s1c_front_set(e,S1C_P_DLMIX,.30f) ||
+            !s1c_front_set(e,S1C_P_DLT,.30f)){bench_s1_only[0]=2;return;}
+        e->ddec=0; /* scratch only: allocate for the wet test while silent */
+        bench_s1_only[1]=d8_frame;return;
+    }
+    if(!bench_s1_only[1] || bench_s1_only[0] || b->status==ORIGINAL_RUNTIME_OK ||
+         !e->t[S1C_P_DLON] || !e->t[S1C_P_RVON] || !e->t[S1C_P_DLMIX] || !e->t[S1C_P_RVMIX]){
+         bench_s1_only[0]=3;return;
+    }
+    const unsigned on=d8_frame==ON;
+    const uint8_t notes[]={48,52,55,59};
+    if(seq.ch[TRK_BASS0]!=1u || seq.ch[TRK_BASS0+1]==1u){bench_s1_only[0]=4;return;}
+    for(unsigned i=0;i<4;++i){
+        const unsigned before=a->keys[ORIGINAL_INPUT_USB][notes[i]];
+        midi_in((on?9u:8u)|((on?0x91u:0x81u)<<8)|((uint32_t)notes[i]<<16)|((on?88u:0u)<<24));
+        if(!!a->keys[ORIGINAL_INPUT_USB][notes[i]]!=on || !!before==on){bench_s1_only[0]=5;return;}
+        ++bench_s1_only[2];
+    }
+    unsigned held=0;
+    for(unsigned i=0;i<S1C_VOICES;++i) held+=e->v[i].root!=-1 && e->v[i].stage && e->v[i].gate>0.f;
+    bench_s1_only[on?3:4]=d8_frame;
+    bench_s1_only[on?5:6]=held;
+    bench_s1_only[7]=b->status==ORIGINAL_RUNTIME_OK;
+    bench_s1_only[8]=e->ddec;
+}
