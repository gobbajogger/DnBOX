 /* No frozen snapshot layout is reinterpreted as ordinary motion or endpoints.
  * Streams 1/2/3 never assigned the upper flags nibble. */
+static __attribute__((noinline)) int project_lane_duplicate(const lane_t *lanes, int k, int match_parameter)
+{
+    const lane_t *l = &lanes[k];
+    for (int j = 0; j < k; ++j) {
+        const lane_t *a = &lanes[j];
+        if (a->used && a->t == l->t && a->pat == l->pat && a->part == l->part &&
+            a->v == l->v && (!match_parameter || a->i == l->i))
+            return 1;
+    }
+    return 0;
+}
