+/* Fixed low/high-pass numerators have n2 == n0. Reuse the same
+ * rounded product, preserving every recurrence operation's grouping. */
+static inline __attribute__((always_inline)) float bq_run_sym(d8_bq_t *f, float x)
+{
+    float bx = f->n0 * x;
+    float y = bx + f->z1;
+    f->z1 = (f->n1 * x + (y + y + f->z2)) - f->e1 * y;
+    f->z2 = (bx - y) - f->e2 * y;
+    return y;
+}
