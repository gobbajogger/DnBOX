+/* Room-for-two fast path for ordinary sequencer output. Overflow still
+ * takes the existing per-packet priority logic; never use BREAK's
+ * matched-pair-or-drop admission for a sequencer event. */
+void plat_midi_drum_pair(uint8_t channel,uint8_t note,uint8_t velocity)
+{
+#if BOARD_SMK37
+    extern uint8_t smk_clip_mode_on(void);
+    if(smk_clip_mode_on()) return;
+#endif
+    const uint32_t head=((uint32_t)channel<<8)|((uint32_t)note<<16);
+    const uint32_t on=0x9009u|head|((uint32_t)velocity<<24),off=0x8008u|head;
+    const uint32_t irq=fm1_irq_mask_save(FM1_IRQ_TIMER5);
+    int fast=usb.config && mo_w-mo_r<=MQ-2u;
+    if(fast) {
+        uint32_t w=mo_w;
+        midi_out_q[w%MQ]=on;
+        midi_out_q[(w+1u)%MQ]=off;
+        fm1_data_sync();
+        mo_w=w+2u;
+    }
+    fm1_irq_mask_restore(FM1_IRQ_TIMER5,irq);
+    if(!fast) { plat_midi_out(on); plat_midi_out(off); return; }
+#if X0X_BLE
+    ble_out(on);
+    ble_out(off);
+#endif
+}
