+uint8_t smk_ck_panel(uint32_t *last, uint32_t force)
+{
+    CK_BASE;
+    CK_SET;
+    uint8_t out[CK_MAXN];
+    ck_chord_input_t chord;
+    uint32_t latched = ck_chord_state(&chord);
+    uint32_t k, i, n, snd = 0, sig = 2166136261u, m = ck_mask(sp->ck_scale, sp->ck_root);
+    uint32_t arp = cp->on & CK_M_ARP, rh = sp->ck_x2 & 15u, len = rh ? (CK_RHY_T[rh] & 15u) + 1u : 8u;
+    uint32_t pos = arp && cp->nk && cp->step ? (cp->step - 1u) % len + 1u : 0u;
+    for (k = 0; k < CK_NKEY; k++)
+        if (CK_BIT(cp->snd, k) || (cp->nk && cp->korder[0] == k)) {
+            n = ck_key_notes(k, out);
+            for (i = 0; i < n && !arp; i++)
+                snd |= 1u << out[i] % 12u;
+        }
+    if (cp->arp_note)
+        snd |= 1u << (cp->arp_note - 1u) % 12u;
+    for (i = 0; i < 12u; i++)
+        sig = (sig ^ (&sp->ck_ch)[i]) * 16777619u;
+    sig = (sig ^ (cp->on | (cp->fl & CK_F_LATCH) << 3 | snd << 4 | (uint32_t)cp->pg << 20)) * 16777619u;
+    sig = (sig ^ ((uint32_t)chord.pcs | (uint32_t)chord.upper_pcs << 16)) * 16777619u;
+    sig = (sig ^ (chord.bass | (uint32_t)chord.upper_bass << 8 | latched << 16)) * 16777619u;
+    sig = (sig ^ pos) * 16777619u;
+    if (!(force & 1u) && sig == *last)
+        return 0u;
+    *last = sig;
+    /* Capture the painter's inputs before the first SPI operation that may
+     * service keys, switch screens, or change the theme. */
+    const ck_panel_scene scene={
+        .set=*sp,.chord=chord,.latched=latched,.snd=snd,.m=m,.arp=arp,
+        .rh=rh,.len=len,.pos=pos,.black=C_BLACK,.white=C_WHITE,.gray=C_GRAY,
+        .line=C_LINE,.dim=C_DIM,.amb=C_AMB,.on=cp->on,.fl=cp->fl,.pg=cp->pg
+    };
+#if X0X_UI_SMALL_CANVAS
+    if (force & 2u) {
+        /* 63 rows is an exact 3-row full-width DMA boundary. */
+        blit_hash[2]=1u;
+        cv_tile_valid[2]=0;
+        for (unsigned offset=0;offset<82u;offset+=63u) {
+            cv_window(240,82,offset,63,scene.black);
+            ck_panel_paint(&scene);
+            cv_lcd_full(0,KNOB_Y+offset);
+        }
+        return 0u;                         /* LCD already owns this frame */
+    }
+#endif
+    cv_begin(240,82,scene.black);
+    ck_panel_paint(&scene);
     return 1u;
 }
