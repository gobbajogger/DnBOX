+         * All additions/subtractions below preserve their old grouping. */
+        /* bq3 bp1 + opamp: the same ops as bq3_run(&v->bp1, k_cy_bp1, bus) */
+        bx = c10 * bus_x; nx = c11 * bus_x;
+        y = bx + bp1z0;
+        bp1z0 = nx - c14 * y + bp1z1;
+        bp1z1 = -bx - c15 * y + bp1z2;
+        bp1z2 = -nx - c16 * y;
