+/* Render one partial across its active samples. The pitch copy is cheap
+ * when the sweep is settled and allows phase/envelope to remain local.
+ * Partial stems accumulate in the original order on each sample. */
+__attribute__((noinline)) static void d9_tom_vco(float *restrict y,
+                    d9_env_t *restrict e, uint32_t *restrict p,
+                    d9_env_t *restrict pitch, int m, float ratio)
+{
+    uint32_t ph = *p;
+    float ev=e->v, old=e->cur;
+    int32_t left=e->left;
+    const float mul=e->r, end=e->v1;
+    const int sweeping = pitch->left < m ? pitch->left : m;
+    const uint32_t steady = d9_inc(pitch->v1 * ratio);
+    int i = 0;
+    for (; i < sweeping; ++i) {
+        ph += d9_inc(d9_env_tick(pitch) * ratio);
+        old=ev;
+        if (left) ev=--left ? ev*mul : end;
+        y[i] += d9_diode20(d9_tri(ph))*old;
+    }
+    if (i < m) {
+        pitch->cur = pitch->v;
+        for (;i < m;++i)  {
+            ph += steady;
+            old=ev;
+            if (left) ev=--left ? ev*mul : end;
+            y[i] += d9_diode20(d9_tri(ph))*old;
+        }
+    }
+    *p=ph; e->v=ev; e->cur=old; e->left=left;
+}
