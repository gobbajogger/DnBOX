+def code_cost(record, entries):
+    degree, width = record[0] >> 5, record[0] & 31
+    if degree > 3 or record[5] > 18:
+        raise ValueError("Invalid FAST32 hint header")
+    p = 6
+    for _ in range(degree + 1):
+        start = p
+        while record[p] & 128:
+            p += 1
+        if p - start > 4 or (p - start == 4 and record[p] > 15):
+            raise ValueError("Invalid FAST32 hint varint")
+        p += 1
+    if len(record) != p + (entries * width + 7) // 8:
+        raise ValueError("Invalid FAST32 hint length")
+    return degree, p - 6, bool(record[5]), width
+
