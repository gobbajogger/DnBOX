 }
 
 /* ---- LFO ---- */
-void s1u_lfo_tick(s1u_lfo *l, float step, int shape, float amount, float c2)
+static inline void lfo_advance(s1u_lfo *l, float step, int shape, float c2)
 {
     l->ph += step; if (l->ph >= 1.0f) l->ph -= 1.0f;
     float ph = l->ph;
     float x = shape == 0 ? s1u_sin((uint32_t)(ph * 4294967296.0f)) :
               shape == 1 ? (ph > 0.5f ? 1.0f : -1.0f) : shape == 2 ? (ph - 0.5f) * 2.0f : (0.5f - ph) * 2.0f;
     l->sm = (1.0f - c2) * x + c2 * l->sm;
+}
+
+void s1u_lfo_tick(s1u_lfo *l, float step, int shape, float amount, float c2)
+{
+    lfo_advance(l,step,shape,c2);
     l->o01 = 0.5f * (1.0f + l->sm) * amount; l->o10 = 1.0f - 0.5f * (1.0f - l->sm) * amount;
 }
+void s1u_lfo_tick_idle_span(s1u_lfo *l, float step, int shape, float c2, unsigned n)
+{
+    s1u_lfo local=*l;
+    while(n--) lfo_advance(&local,step,shape,c2);
+    l->ph=local.ph; l->sm=local.sm;
+}
 
