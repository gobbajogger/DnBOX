+     * touch the five staged rows at the end of the previous raster. */
+    cv_window(240,KNOB_H,ORDINARY_KNOB_FIRST,KNOB_H-ORDINARY_KNOB_FIRST,bg);
+    memcpy(cv_px,cv_px+240u*ORDINARY_KNOB_FIRST,
+        (MATRIX_ROWS-ORDINARY_KNOB_FIRST)*240u*sizeof(*cv_px));
+    if(paint) {
+        const uint8_t light=ui_theme_light;
