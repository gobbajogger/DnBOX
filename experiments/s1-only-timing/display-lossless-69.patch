+     * service keys, switch screens, or change the theme. */
+    const ck_panel_scene scene={
+        .set=*sp,.chord=chord,.latched=latched,.snd=snd,.m=m,.arp=arp,
+        .rh=rh,.len=len,.pos=pos,.black=C_BLACK,.white=C_WHITE,.gray=C_GRAY,
+        .line=C_LINE,.dim=C_DIM,.amb=C_AMB,.on=cp->on,.fl=cp->fl,.pg=cp->pg
