+/* The ordered wait contains only RAM loads, CSYNC and the original watchdog.
+ * Avoid fetching polling instructions from XIP while the worker renders there. */
+__attribute__((section(".ram_text.eng_stage_wait"),noinline))
+static int fm1_stage_poll(const volatile uint32_t *stage, uint32_t target, int worker)
+{
+    uint32_t t0 = worker ? 0 : FM1_C1_T4;
+    for (;;) {
+        FM1_C1_SYNC();
+        if (*stage >= target) return 1;
+        if (!worker && (fm1_c1_mb.bad || fm1_c1_mb.done == fm1_c1_mb.job ||
+                        FM1_C1_T4 - t0 > 24000u * 24u))
+            return 0;
+    }
+}
