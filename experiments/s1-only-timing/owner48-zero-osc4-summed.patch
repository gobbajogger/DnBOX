+#if S1C_OSC4
+static __attribute__((always_inline)) inline float osc4_pulse(uint32_t q, float f)
+{
+    float t=(float)q*(1.0f/Q32);
+    float y=t<0.125f?-1.0f:1.0f;
+    return y+f*((2.0f*t-1.0f-0.0f)-y);
+}
+static __attribute__((noinline)) void osc4_fill(const s1c *s, float f0, float f1,
+                                                float (*out)[S1C_VOICES])
+{
+    float vol0=P(VOL1),vol1=P(VOL2);
+    for(unsigned v=0;v<S1C_VOICES;++v) {
+        const s1c_voice *w=&s->v[v];
+        uint32_t p=w->ph[0], q=w->ph[1], d0=w->kstep[0],d1=w->kstep[1];
+        float amp=w->vamp, bal=w->kbal, anti=1.0f-bal;
+        for(unsigned k=0;k<4;++k) {
+            float a=osc4_pulse(p,f0)*amp*vol0;
+            float b=osc4_pulse(q,f1)*amp*vol1;
+            out[k][v]=anti*a+bal*b;
+            p+=d0;q+=d1;
+        }
+    }
+}
+#endif
