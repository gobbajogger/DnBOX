@@ -86,13 +86,21 @@
 #ifndef X0X_UI_SMALL_CANVAS
 #define X0X_UI_SMALL_CANVAS 0
 #endif
+#ifndef DNBOX_LCD_CANVAS_48
+#define DNBOX_LCD_CANVAS_48 0
+#endif
 #if X0X_UI_SMALL_CANVAS
