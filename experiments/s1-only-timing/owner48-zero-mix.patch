+/* The kit sends are often off and all four bus gains stationary. In that
+ * case only the meter consumes the unscaled mono result; publish its very
+ * same reduction while scaling the disjoint output buses, not via scratch. */
+__attribute__((noinline)) static int kit909_settled_mix(float *l, float *r,
+                                                        float *rv, float *dl, uint32_t n)
+{
+    const glide_t *gl = mix_glide[PART_909];
+    if (gl[GL_REV].cur != 0.0f || gl[GL_REV].tgt != 0.0f ||
+        gl[GL_DLY].cur != 0.0f || gl[GL_DLY].tgt != 0.0f)
+        return 0;
+    const float a = gl[GL_L].cur, b = gl[GL_R].cur;
+    const float c = gl[GL_VREV].cur, d = gl[GL_VDLY].cur;
+    if (a != gl[GL_L].tgt || b != gl[GL_R].tgt ||
+        c != gl[GL_VREV].tgt || d != gl[GL_VDLY].tgt ||
+        a == 1.0f || b == 1.0f || c == 1.0f || d == 1.0f)
+        return 0;
+    const float g = mix_level[PART_909];
+    float peak = part_peak[PART_909];
+    for (uint32_t i = 0; i < n; ++i) {
+        const float x = l[i], y = r[i];
+        const float p = fm_fabsf((x + y) * 0.5f) * g;
+        if (p > peak) peak = p;
+        l[i] = x * a; r[i] = y * b;
+        rv[i] *= c; dl[i] *= d;
+    }
+    part_peak[PART_909] = peak;
+    return 1;
+}
