+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-3.0-only
+"""Exercise the exact runner's generated-header lock; callback is only a scheduling probe."""
+import re,subprocess,tempfile,unittest
+from pathlib import Path
+ROOT=Path(__file__).resolve().parents[2]
+def function(text,name,next_marker):
+ match=re.search(r'(?m)^'+re.escape(name)+r'\(\) \{',text)
+ if not match:raise ValueError('missing actual function: '+name)
+ start=match.start();end=text.index(next_marker,start)
+ return text[start:end]
+def script(jobs):
+ t=(ROOT/'tests/run_tests.sh').read_text()
+ selected=[function(t,'test_class','# Prepare fixtures'),function(t,'needs_gen','gen_wait()'),function(t,'gen_wait','gen_lock()'),function(t,'gen_lock','gen_unlock()').replace('gen_lock()','original_gen_lock()',1),function(t,'gen_unlock','gen_nonfont()'),function(t,'run','note()')]
+ # Exact run()/class/wait/lock bodies; only the work callback is an explicit spy.
+ setup=r"""
+set -eu
+OUT=build/host;RES=$OUT/.results;X0X_TESTS=host-catalog-profiles
+GEN_FAILED=0;JOBS=@@JOBS@@;PHASE=1;T_SEQ=0;X0X_PYTHONUSERBASE=fixture
+mkdir -p "$OUT/iso/.lock-gen" "$RES"
+mkfifo slots
+exec 3<>slots
+printf 'slot\n' >&3
+"""
+ finish=r"""
+gen_lock() { : > attempted-lock; original_gen_lock; }
+run_one() { [ -d "$OUT/iso/.lock-gen" ] || : > missing-lock; echo entered >> callback; }
+run host-catalog-profiles true
+n=0
+while [ ! -e attempted-lock ] && [ ! -e callback ] && [ $n -lt 250 ]; do sleep 0.02; n=$((n+1)); done
+if [ -e callback ]; then echo 'FAIL catalog callback entered while generation lock held' >&2; exit 1; fi
+[ -e attempted-lock ] || { echo 'FAIL catalog worker never reached generation lock' >&2; exit 1; }
+rmdir "$OUT/iso/.lock-gen"
+wait
+[ -e callback ] && [ "$(wc -l < callback)" = 1 ] && [ ! -e missing-lock ] && [ ! -d "$OUT/iso/.lock-gen" ] || { echo 'FAIL catalog lock ownership/release' >&2; exit 1; }
+test_class host-catalog-profiles
+[ "$TEST_CLASS" = G ]
+printf 'PASS actual runner catalog serialization and lock release\n'
+"""
+ return setup.replace('@@JOBS@@',str(jobs))+'\n'.join(selected)+finish
+class Scheduling(unittest.TestCase):
+ def test_catalog_waits_for_existing_generation_owner(self):
+  for jobs in (2,4):
+   with self.subTest(jobs=jobs),tempfile.TemporaryDirectory(prefix='dnbox-catalog-scheduler-')as td:
+    p=Path(td)/'probe.sh';p.write_text(script(jobs));q=subprocess.run(['sh',str(p)],cwd=td,capture_output=True,timeout=10)
+    self.assertEqual(q.returncode,0,q.stderr.decode());self.assertIn(b'PASS actual runner',q.stdout)
+if __name__=='__main__':unittest.main()
