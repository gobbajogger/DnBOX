+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-3.0-only
+"""Compile the real catalog pin: historical opt-in is host-test-only, never native."""
+import os,shlex,subprocess,tempfile
+from pathlib import Path
+ROOT=Path(__file__).resolve().parents[2]
+HEADER='firmware/src/app/dnr_remote/native_catalog_pin.h'
+def main():
+ cases=[('shipping-host',['-DX0X_HOST','-DX0X_DRONE_RUNTIME_ENABLED=0'],0,395,0x0d0db2c8),('shipping-native',['-DX0X_DRONE_RUNTIME_ENABLED=0'],0,395,0x0d0db2c8),('qualified-historical-host',['-DX0X_HOST','-DX0X_DRONE_RUNTIME_ENABLED=1','-DDNR_HOST_HISTORICAL_CATALOG=1'],0,407,0x26c95557),('unqualified-historical-host',['-DX0X_HOST','-DX0X_DRONE_RUNTIME_ENABLED=1'],1,0,0),('historical-native',['-DX0X_DRONE_RUNTIME_ENABLED=1','-DDNR_HOST_HISTORICAL_CATALOG=1'],1,0,0),('wrong-profile-value',['-DX0X_HOST','-DX0X_DRONE_RUNTIME_ENABLED=1','-DDNR_HOST_HISTORICAL_CATALOG=0'],1,0,0),('profile-without-historical',['-DX0X_HOST','-DX0X_DRONE_RUNTIME_ENABLED=0','-DDNR_HOST_HISTORICAL_CATALOG=1'],1,0,0)]
+ for name,flags,reject,count,crc in cases:
+  text='#include <stdint.h>\n#include "'+HEADER+'"\n'
+  if not reject:text+='typedef char count_pin[(DNR_NATIVE_CATALOG_COUNT=='+str(count)+')?1:-1];\ntypedef char crc_pin[(DNR_NATIVE_CATALOG_CRC==UINT32_C('+str(crc)+'))?1:-1];\n'
+  q=subprocess.run(shlex.split(os.environ.get('CC','cc'))+['-std=c99','-fsyntax-only','-x','c','-I'+str(ROOT),*flags,'-'],input=text.encode(),capture_output=True)
+  if bool(q.returncode)!=bool(reject):raise SystemExit(name+' expected reject='+str(reject)+' got '+str(q.returncode)+'\n'+q.stderr.decode())
+  if reject and b'error:'not in q.stderr:raise SystemExit('not an actual preprocessor rejection:'+name)
+  print(name+': PASS')
+if __name__=='__main__':main()
