     sp_vdelay_compute(p->sp,p->line[1],&r,&o);
-    sp_vdelay_compute(p->sp,p->line[2],&r,&fill);
-    sp_vdelay_compute(p->sp,p->line[3],&o,right);
+    short_vdelay(p,0,r,&fill);
+    short_vdelay(p,1,o,right);
     *right+=fill;
