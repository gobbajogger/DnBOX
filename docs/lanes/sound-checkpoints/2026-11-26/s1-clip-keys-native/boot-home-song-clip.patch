+typedef void (*full_strip_painter)(const void *view);
+static UI_DRAW void commit_full_strips(uint16_t bg, full_strip_painter paint, const void *view)
+{
+    const int force = !blit_hash[1] || !cv_tile_valid[1];
+    blit_hash[1] = cv_tile_valid[1] = 1u;
+    for (unsigned top = 0; top < MAIN_ROWS; top += HOME_STRIP_SPLIT) {
+        const unsigned rows = MAIN_ROWS-top > HOME_STRIP_SPLIT ? HOME_STRIP_SPLIT : MAIN_ROWS-top;
+        cv_begin(240, rows, bg);   /* waits for prior asynchronous transfer */
+        cv_oy = -(int)top;
+        cv_y0 = 0;
+        cv_y1 = (int)rows;
+        paint(view);
+        const cv_lcd_pos_t pos = {0, MAIN_Y + top};
+        x0x_lcd_tile_commit(cv_px, rows, main_tileh + (top / X0X_LCD_TILE_H) * X0X_LCD_TILE_COLS,
+                            force, cv_lcd_emit, (void *)&pos);
+        /* A callback can invalidate the region. Don't re-arm before strip 2. */
+    }
