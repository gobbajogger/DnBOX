+#include <string.h>
+static __attribute__((noinline)) void initphaser(phaser* p,int rate){
+    /* Source outer wrapper only initializes from a cold zeroed owner.
+     * Fill shared zero state, then exactly the original unmodified fields.
+     * Width/rate/feedback are written before the first compute call. */
+    memset(p,0,sizeof *p);
+    p->fSamplingFreq=rate;
+    p->iConst0=min(192000,max(1,rate));
+    p->fConst1=1.f/(float)p->iConst0;
+    p->fConst2=.10472f/(float)p->iConst0;
+    p->fHslider1=1.f;
+    p->fHslider3=1.5f;
+    p->fHslider4=100.f;
+    p->fHslider5=800.f;
+}
+#else
