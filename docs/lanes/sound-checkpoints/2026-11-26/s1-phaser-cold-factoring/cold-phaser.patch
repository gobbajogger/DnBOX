+#if DNBOX_S1_MATCHED_PHASER_F32
+static inline float ph_cosprod(float v,float x,int lane){
+    (void)lane;
+    const unsigned ux=ph_word(x)&0x7fffffffu, uv=ph_word(v)&0x7fffffffu;
+    if(ux<=0x3f200000u && !(ux && ux<0x00800000u) && uv<0x7f800000u){
+        const float c=fc_lowcos(x);
+        /* Coefficient is >= cos(.625) and positive. A full normal
+         * recurrence operand cannot produce a tiny result here. */
+        if(uv>=0x01000000u)return v*c;
+        return fc_product(v,c);
+    }
+    return fc_product(v,fc_full(x));
+}
