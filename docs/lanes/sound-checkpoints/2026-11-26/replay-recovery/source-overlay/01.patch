+       including unedited 0.1. No change of mode on the first detent. */
+    e->delay_feedback_direct=1;
+    (void)s1c_front_set(e,S1C_P_DLFB,code?.9f*(float)(code-1u)/127.f:s1c_front_init(S1C_P_DLFB));
