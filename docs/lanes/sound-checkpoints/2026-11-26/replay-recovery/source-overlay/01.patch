+            uint8_t *q=sj6_classic_native_payload((sound_t*)mot_base_snd,v)+k-1u;
+            unsigned old=*q?*q-1u:sj6_classic_default(&original_bass[v].dsp.juno.chorus,k);
+            if(old!=p){*q=(uint8_t)(p+1u);ok=1;}
+            plat_cq_unlock(lock);return ok;
+        }
+#endif
+        uint8_t *b=sj6_j60_payload((sound_t*)mot_base_snd,v);
+        unsigned old=k?(b[k]?b[k]-1u:sj6_j60_default(k)):b[0];
+        if(p!=old){b[k]=(uint8_t)(p+!!k);ok=1;}
+    }
+    plat_cq_unlock(lock);return ok;
+}
+#endif
+static __attribute__((noinline)) int sj6_semi_storage_ready(unsigned owner)
+{
+    return original_sound_sj6_semi_ready(mot_base_snd->v[T_303][owner],
+                                         mot_base_snd->v[T_303][ORIGINAL_SJ6_EXTRA_ROW + owner]);
+}
