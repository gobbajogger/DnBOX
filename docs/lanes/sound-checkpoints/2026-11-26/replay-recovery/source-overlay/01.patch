+X0X_COLD __attribute__((noinline)) int engine_superj6_knob_turn(unsigned owner, unsigned slot, int value, int relative)
+{
+#if X0X_SJ6_ALT3_NATIVE
+    if(owner<NBASS && slot>=SJ6_TREM_DEPTH && slot<=SJ6_TREM_RATE){
+        uint32_t lock=plat_cq_lock();int changed=0;
+        if(sj6_typed_knob_can_turn(owner)&&original_typed_edit_open(owner)){
+            const unsigned k=slot-SJ6_TREM_DEPTH;
+            uint8_t *b=sj6_trem_write((sound_t*)mot_base_snd,owner);
+            const int before=(int)sj6_trem_position(b,k);
+            const int next=sj6_knob_target(before,value,127,relative);
+            if(next!=before){b[k]=(uint8_t)(k&&next!=64?next+1:k?0:next);changed=1;}
+        }
+        plat_cq_unlock(lock);return changed;
+    }
+#endif
+#if X0X_SJ6_SEQ_SETTINGS_NATIVE
+    if (owner<NBASS && SJ6_SEQ_SETTING_SLOT(slot)) {
+        uint32_t lock=plat_cq_lock();int changed=0;
+        if (sj6_typed_knob_can_turn(owner) &&
+            !ui_project_busy() && s1_typed_tuple_editable()) {
+            unsigned top=1u;
+            uint8_t *b;
+#if X0X_SJ6_SEQ_DEST_NATIVE
+            if(slot==SJ6_SEQ_DEST) {
+                b=sj6_dest_write((sound_t *)mot_base_snd,owner);top=2u;
+            } else
+#endif
+                b=sj6_seq_settings_write((sound_t *)mot_base_snd,owner)+slot-SJ6_SEQ_START_SNAP;
+            int next=sj6_knob_target(*b,value,top,relative);
+            if (next!=*b) {*b=(uint8_t)next;changed=1;}
+        }
+        plat_cq_unlock(lock);return changed;
+    }
+#endif
+#if X0X_SJ6_NOISE_SUB_NATIVE
+    if (owner<NBASS && (slot==SJ6_NOISE_LEVEL || slot==SJ6_SUB_LEVEL)) {
+        uint32_t lock=plat_cq_lock();int changed=0;
+        if (sj6_typed_knob_can_turn(owner) &&
+            !ui_project_busy() && s1_typed_tuple_editable()) {
+            uint8_t *b=sj6_sources_write((sound_t *)mot_base_snd,owner)+slot-SJ6_NOISE_LEVEL;
+            int next=sj6_knob_target(*b,value,127,relative);
+            if (next!=*b) {*b=(uint8_t)next;changed=1;}
+        }
+        plat_cq_unlock(lock);return changed;
+    }
+#endif
+#if X0X_SJ6_LFO1_WAVE_NATIVE
+    if(owner<NBASS && (slot==SJ6_LFO1_ENABLE || slot==SJ6_LFO1_SNAPBACK)) {
+        uint32_t lock=plat_cq_lock();int changed=0;
+        const unsigned k=slot-SJ6_LFO1_ENABLE;
+        if(sj6_typed_knob_can_turn(owner) &&
+           original_typed_edit_open(owner) && sj6_lfo1_wave_allowed(mot_base_snd->v[T_303][owner])) {
+            const int old=(int)(sj6_lfo1_option(mot_base_snd,owner,k)^(k==0u));
+            const int next=sj6_knob_target(old,value,1,relative);
+            if(next!=old){sj6_lfo1_option_store((sound_t*)mot_base_snd,owner,k,(unsigned)next^(k==0u));changed=1;}
+        }
+        plat_cq_unlock(lock);return changed;
+    }
+    if(owner<NBASS && slot==SJ6_LFO1_WAVE) {
+        uint32_t lock=plat_cq_lock();int changed=0;
+        if(sj6_typed_knob_can_turn(owner) && !ui_project_busy() &&
+           s1_typed_tuple_editable() && sj6_lfo1_wave_allowed(mot_base_snd->v[T_303][owner])) {
+            int before=(int)sj6_lfo1_wave_read(mot_base_snd,owner);
+            int next=sj6_knob_target(before,value,SJ6_LFO1_WAVE_MAX,relative);
+            if(next!=before){sj6_lfo1_wave_write((sound_t*)mot_base_snd,owner,(unsigned)next);changed=1;}
+        }
+        plat_cq_unlock(lock);return changed;
+    }
+#endif
+#if X0X_SJ6_LFO1_DELAY_PORT
+    if (owner<NBASS && slot==SJ6_LFO1_DELAY) {
+        uint32_t lock=plat_cq_lock();int changed=0;
+        if (sj6_typed_knob_can_turn(owner) &&
+            !ui_project_busy() && s1_typed_tuple_editable()) {
+            int before=sj6_lfo1_delay_read(mot_base_snd,owner);
+            int next=sj6_knob_target(before,value,SJ6_LFO1_DELAY_MAX,relative);
+            if (next!=before) {
+                sj6_lfo1_delay_write((sound_t *)mot_base_snd,owner,(uint8_t)next);
+                changed=1;
+            }
+        }
+        plat_cq_unlock(lock);return changed;
+    }
+#endif
+#if (defined(X0X_HOST) && defined(X0X_SJ6_DELAY_WITNESS)) || X0X_SJ6_NATIVE_DELAY
+    if(owner<NBASS && slot>=SJ6_DELAY24 && slot<=SJ6_DELAYSYNC){
+        uint32_t lock=plat_cq_lock();int changed=0;
+        if(sj6_typed_knob_can_turn(owner) &&
+           !ui_project_busy() && s1_typed_tuple_editable() &&
+           original_bass[owner].dsp.juno.synth.delay24.tap){
+            uint8_t *b=slot137((sound_t *)mot_base_snd,owner)+SJ6_DELAY_BYTE;
+            unsigned before=sj6_delay_read(slot,b);
+            unsigned bit=slot==SJ6_DELAY24?SJ6_DELAY_ENABLE_BIT:slot==SJ6_DELAYSYNC?SJ6_DELAY_SYNC_BIT:0;
+            unsigned next=(unsigned)sj6_knob_target((int)before,value,bit?1:127,relative);
+            unsigned sync=slot==SJ6_DELAYSYNC?next:!!(b[0]&SJ6_DELAY_SYNC_BIT);
+            unsigned raw=slot==SJ6_DELAY25?next:b[1];
+            if(next!=before && ((slot!=SJ6_DELAYSYNC&&slot!=SJ6_DELAY25) ||
+                juno6_delay25_can(&original_bass[owner].dsp.juno.synth,raw,seq_tempo(&seq),sync))){
+                if(bit)b[0]=(uint8_t)((b[0]&~bit)|(next?bit:0));
+                else b[sj6_delay_byte(slot)]=(uint8_t)next;
+                changed=1;
+            }
+
+        }
+        plat_cq_unlock(lock);return changed;
+    }
+#endif
+    if (owner >= NBASS || slot > SJ6_LFO2_PWM_BASE) return 0;
+    uint32_t lock = plat_cq_lock();
+    int changed = 0;
+    if (sj6_knob_can_turn(owner) && ((slot != SJ6_OSC2_LEVEL && slot != SJ6_OSC1_LEVEL) || bass_named_preset[owner] == 0)) {
+        slot = sj6_panel_slot(owner, slot);
+        int before = sj6_knob_position(owner, slot);
+#if (defined(X0X_HOST) && defined(X0X_SJ6_FILTER_VEL_PROBE)) || (DNBOX_TYPED_CONTROLS_NATIVE_TEST && X0X_SJ6_VELOCITY_PORT)
+        if (slot == SJ6_FILTER_VELOCITY && before < 0) { plat_cq_unlock(lock); return 0; }
+#endif
+#if X0X_SJ6_VCF_PORT
+        if(slot==SJ6_VCF_LFO1_AMOUNT &&
+           (before<0 || note_lock_applied[owner] || !s1_typed_tuple_editable())) {
+            plat_cq_unlock(lock);return 0;
+        }
+#endif
+        value = sj6_knob_target(before, value, (int)original_sound_sj6_max(slot), relative);
+        if (value != before && (slot < SJ6_VIBRATO_DEPTH || slot == SJ6_LFO2_SHAPE ||
+            (slot >= SJ6_LAYER1_FINE ? original_sound_valid(mot_base_snd->v[T_303][owner]) :
+             slot >= SJ6_LAYER1_SEMI ? sj6_semi_storage_ready(owner) :
+             sj6_wire_storage_ready(owner, slot != SJ6_A_REFERENCE, slot == SJ6_A_REFERENCE)))) {
+            sj6_knob_post(owner, slot, value);
+            changed = 1;
+        }
+    }
+    plat_cq_unlock(lock);
+    return changed;
+}
