+__attribute__((noinline)) X0X_COLD int sj6_aux_get(unsigned v,unsigned k)
+{
+    if(k==14u){
+        if(v>=NBASS || !original_typed_sj6_carrier(mot_base_snd,v) || !sj6_aux_init(mot_base_snd,v) ||
+           original_bass[v].kind!=ORIGINAL_SOUND_JUNO)return -1;
+        unsigned route=sj6_aux_lfo1_read(mot_base_snd,v)[0];
