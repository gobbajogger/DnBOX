+__attribute__((noinline)) X0X_COLD int sj6_aux_choose(unsigned v,unsigned k,unsigned pos)
+{
+    if(k==14u){
+        if(!juno6_aux_destination_supported(pos) || sj6_aux_get(v,k)<0)return 0;
+        engine_project_hold(1);
+        int before=sj6_aux_get(v,k);
+        int ok=before>=0 && (unsigned)before!=pos && original_typed_edit_open(v);
+        if(ok){
+            uint8_t *r=(uint8_t*)sj6_aux_lfo1_read(mot_base_snd,v);
+            float base=pos?sj6_aux_authored_base(mot_base_snd,v,pos):0.f;
+            r[0]=(uint8_t)(pos?pos:SJ6_AUX_LFO1_NONE);
+            r[2]=(uint8_t)(fm_clampf(base,0.f,1.f)*127.f+.5f);
+            sj6_aux_apply(mot_base_snd,v);
+        }
+        engine_project_hold(0);
+        return ok;
+    }
+#if X0X_SJ6_LFO_TRIGGER_NATIVE
+    if(k>=14u || pos>(k>=9u?k<12u?3u:1u:sj6_aux_max(k)) || sj6_aux_get(v,k)<0)return 0;
+#else
+    if(k>=9u || pos>sj6_aux_max(k) || sj6_aux_get(v,k)<0)return 0;
+#endif
+    if(k>=5u && k<9u && !juno6_aux_destination_supported(pos))return 0;
+    engine_project_hold(1);
+    int before=sj6_aux_get(v,k);
+    int ok=before>=0 && (unsigned)before!=pos && original_typed_edit_open(v);
+    if(ok){
+        uint8_t *row=sj6_aux_write((sound_t*)mot_base_snd,v);
+#if X0X_SJ6_LFO_TRIGGER_NATIVE
+        if(k>=9u)row[k>=12u?k+18u:k+4u]=(uint8_t)pos;else {
+#endif
+        row[k]=(uint8_t)(k<2u?pos+1u:pos);
+        if(k>=5u) {
+            /* Original captures the chosen receiver's base before modulation. */
+            float base=pos?sj6_aux_authored_base(mot_base_snd,v,pos):0.f;
+            if(base<0.f)base=0.f;
+            row[k+4u]=(uint8_t)(base*127.f+.5f);
+        }
+#if X0X_SJ6_LFO_TRIGGER_NATIVE
+        }
+#endif
+        sj6_aux_apply(mot_base_snd,v);
+    }
+    engine_project_hold(0);
+    return ok;
+}
