+    case 0:return fm_clampf(original_bass[v].dsp.juno.synth.master_gain*(1.f/.404f),0.f,1.f);
+#if X0X_SJ6_NATIVE_LIMITER
+    /* This original compound control starts at zero; Threshold/Gain edits
+     * are independent, never interpreted as a new Rage Amount. */
+    case 17:{unsigned c=sj6_rage_read(sound,v);return c?(c-1u)*(1.f/127.f):0.f;}
+#endif
+#if (defined(X0X_HOST) && defined(X0X_SJ6_ALT3_WITNESS)) || X0X_SJ6_ALT3_NATIVE
+    case 103:return sj6_trem_position(sj6_trem_read(sound,v),0u)*(1.f/127.f);
+    case 104:return sj6_trem_position(sj6_trem_read(sound,v),1u)*(1.f/127.f);
+#endif
+#if X0X_SJ6_NATIVE_ROOM
+    case 13:return sj6_room_read(sound,v)[SJ6_ROOM_SIZE]*(1.f/127.f);
+    case 14:return sj6_room_read(sound,v)[SJ6_ROOM_LOCUT]*(1.f/127.f);
+    case 15:return sj6_room_read(sound,v)[SJ6_ROOM_MIX]*(1.f/127.f);
+    case 22:return sj6_room_read(sound,v)[SJ6_ROOM_RATE]*(1.f/127.f);
+    case 23:return sj6_room_read(sound,v)[SJ6_ROOM_DEPTH]*(1.f/127.f);
+    case 108:return sj6_crush_code(sound,v)[1]*(1.f/127.f);
+#endif
+#if X0X_SJ6_NATIVE_DELAY
+    case 25:case 26:case 27:return read137(sound,v)[SJ6_DELAY_BYTE+(unsigned)id-24u]*(1.f/127.f);
+#endif
+#if X0X_SJ6_NATIVE_UNISON
+    case 60:{const unsigned b=sj6_unison_code(sound,v)[1];return b?(b-1u)*(1.f/127.f):.20912791f;}
+    case 61:return sj6_unison_code(sound,v)[2]*(1.f/127.f);
+#endif
+    default:
+#if X0X_SJ6_AUX_SEQ_NATIVE
+        if(sj6_aux_seq_id((unsigned)id))return sj6_aux_arp_base(&original_bass[v],(unsigned)id);
+#endif
