+/* The normal (non-OTA) build-9 direct cutoff target. Source computes
+ * normalized division and square in Float, then multiplies and adds in Double. */
+#if DNBOX_TYPED_CONTROLS_NATIVE_TEST
+#include "sj6_cutoff_port.h"
+#include "sj6_lfo_double_port.h"
+#endif
+static float sj6_normal_cutoff_hz(float x)
+{
+    static const float hi[]={.1f,.3f,.5f,.7f,.9f};
+    static const uint16_t base[]={20,30,200,600,4100,14400,20000};
+    unsigned seg=0;
+    while (seg<5u && x>hi[seg]) ++seg;
+    float u=(x-(seg ? hi[seg-1u]:0.f))/((seg==0u||seg==5u)?.1f:.2f);
+    float squared=u*u;
+#if DNBOX_TYPED_CONTROLS_NATIVE_TEST
+    return sj6_cutoff_port_round(squared,base[seg],base[seg+1u]-base[seg]);
+#else
+    return (float)((double)base[seg]+(double)squared*(base[seg+1u]-base[seg]));
+#endif
+}
+
+float juno6_mod_cutoff_hz(unsigned value)
+{ return value<=127u ? sj6_normal_cutoff_hz((float)value/127.f):0.f; }
+
+#if X0X_SJ6_OTA_NATIVE
+/* Build9 direct cutoff target 0x1000ee3bc. OTA continues from the normal
+ * Hz target through a rational transfer and both squared end trims. */
+static float sj6_ota_cutoff_hz(float normal)
+{
+#if defined(X0X_HOST) && !DNBOX_TYPED_CONTROLS_NATIVE_TEST
+    const double z=(double)normal-20.0;
+    const double lo=normal<30.f ? (30.0-normal)/10.0 : 0.0;
+    const double hi=normal>10000.f ? (normal-10000.0)/10000.0 : 0.0;
+    return (float)(20.0+(z*1.4795969434284197)/(1.0+(z*.47959694342841974)/19980.0)+
+                   hi*(hi*10000.0)-lo*(lo*17.0));
+#else
+    /* Native destination remains Float; do not link software Double. */
+    const float z=normal-20.f;
+    const float lo=normal<30.f ? (30.f-normal)*.1f : 0.f;
+    const float hi=normal>10000.f ? (normal-10000.f)*.0001f : 0.f;
+    return 20.f+(z*1.4795969434284197f)/(1.f+(z*.47959694342841974f)*(1.f/19980.f))+
+           hi*(hi*10000.f)-lo*(lo*17.f);
+#endif
+}
+/* Build9 ENV134 OTA branch. Derive the effective target in octaves, while
+ * retaining ordinary A/S knobs in their independent authored domains. */
+void juno6_refresh_ota_sustain(juno6_t *s,float raw)
+{
+    if(raw>=0.f && raw<=1.f)s->sj6_live_raw_cutoff=raw;
+    if(!s->core.sj6_ota) {
+        if(raw>=0.f)return; /* just remember unchanged-model cutoff controls */
+        for(unsigned l=0;l<DNBX_LAYERS;++l)
+            dnbx_set_sj6_ota_filter_sustain(&s->core,l,0.f);
+        return;
+    }
+    float amount=s->macro[4];
+    (void)dnbx_read_raw(&s->core,136u,&amount);
+    float lo=0.f,ratio=0.f,inv_cut=0.f,inv_amount=0.f;
+    if(amount>0.f) {
+        lo=sj6_normal_cutoff_hz(s->sj6_live_raw_cutoff);
+        inv_cut=1.f/sj6_ota_cutoff_hz(lo);
+        ratio=(22050.f-lo)*fm_powf(amount,3.03f);
+        inv_amount=1.f/(14.f*amount);
+    }
+    for(unsigned l=0;l<DNBX_LAYERS;++l) {
+        const dnbx_layer_params *p=&s->core.layer[l].params;
+        const float u=s->core.filter_link ? p->amp.sustain : p->filter.sustain;
+        const float v=amount>0.f ?
+            fm_clampf(fm_log2f((lo+ratio*u)*inv_cut)*inv_amount,0.f,1.f) : 0.f;
+        dnbx_set_sj6_ota_filter_sustain(&s->core,l,v);
+    }
+}
+#endif
+
+/* Direct CUTOFF and the live modulation receivers use Build9 ID7's
+ * same effect-model transfer instead of the old compact approximation. */
+#if X0X_SJ6_OTA_NATIVE
+__attribute__((noinline)) float juno6_sj6_panel_cutoff_hz(float raw,unsigned mode)
+{
+    float hz=sj6_normal_cutoff_hz(raw);
+    return mode?sj6_ota_cutoff_hz(hz):hz;
+}
+#define sj6_cutoff_hz(s,raw) juno6_sj6_panel_cutoff_hz((raw),(s)->core.sj6_ota)
+#else
+#define sj6_cutoff_hz(s,raw) sj6_normal_cutoff_hz(raw)
+#endif
+#if X0X_SJ6_OTA_NATIVE
+void juno6_sj6_set_ota(juno6_t *s,unsigned mode)
+{
+    if(mode==s->core.sj6_ota || !dnbx_set_sj6_ota(&s->core,mode))return;
+    /* Original model selection re-evaluates the real knob/current target. */
+    const float hz=sj6_cutoff_hz(s,s->macro[2]);
+    s->core.layer[0].params.cutoff_hz=s->core.layer[1].params.cutoff_hz=hz;
+    if(s->lfo1_cut_active)s->mod_wheel_cutoff_hz=sj6_cutoff_hz(s,s->lfo1_cut_current);
+    juno6_refresh_ota_sustain(s,-1.f);
+}
+#endif
+
+int juno6_configure_lfo1_cutoff(juno6_t *s,float base,float current,float amount)
+{
+    if(!s||!s->typed||!(base>=0.f&&base<=1.f&&current>=0.f&&current<=1.f&&amount>=0.f&&amount<=1.f))
+        return 0;
+    s->lfo1_pwm_route=3; /* selector 1 goes to global cutoff, not an oscillator PWM */
+    s->lfo1_pwm_base=base;
+    s->wheel_lfo1_amount=0;
+    s->lfo1_cut_current=s->lfo1_cut_target=current;
+    s->lfo1_cut_until=(int32_t)s->sample_rate;
+    s->lfo1_cut_active=s->lfo1_cut_force=0;
+    (void)dnbx_store_raw(&s->core,89u,amount);
+    return 1;
+}
+
+#if X0X_SJ6_VCF_PORT
+/* JNO2's lfo1Amt2FilterSlider outlet actually binds lfo1AmountControl
+ * (Build9 ID89), not ID90. This writer changes only the active shared
+ * depth, never the independently selected destination or its base. */
+int juno6_set_vcf_lfo1_amount(juno6_t *s,unsigned position)
+{
+    if (!s || !s->typed || position>127u) return 0;
+    const float amount=(float)position/127.f;
+    if(dnbx_store_raw(&s->core,89u,amount)!=DNBX_RAW_STORED_ONLY)return 0;
+    /* CC1 and the panel write the same original receiver. The panel's
+     * explicit edit supersedes CC1 without saving performance state. */
+    s->wheel_lfo1_amount=0;
+    return 1;
+}
+#endif
+int juno6_configure_lfo1_pwm(juno6_t *s,unsigned selector,unsigned enabled,float base,float amount)
+{
+    if(!s || !s->typed || (selector!=69u && selector!=70u) || enabled>1u ||
+       !(base>=0.f && base<=1.f && amount>=0.f && amount<=1.f)) return 0;
+    s->lfo1_pwm_route=enabled ? (uint8_t)(selector-68u):0;
+    s->lfo1_pwm_base=base;
+    s->wheel_lfo1_amount=0;
+    (void)dnbx_store_raw(&s->core,89u,amount);
+    return 1;
+}
+
+#if (defined(X0X_HOST) && defined(X0X_SJ6_ALT3_WITNESS)) || X0X_SJ6_ALT3_NATIVE
+static float sj6_alt3_rate(float normalized,int synced,float tempo)
+{
+    if (!synced) return 16.0f*fm_powf(normalized,3.33f);
+#ifdef X0X_HOST
+    static const double grid[18]={
+        64,48,32,24,16,12,8,6,4,3,2,1.5,1,.5,.3333,.25,.1667,.125
+    };
+    const unsigned index=(unsigned)roundf((1.f-normalized)*17.f);
+    return (float)(((double)tempo/60.0*grid[index])*.25);
+#else
+    /* Native PI32v2 has no floating-point widening runtime. */
+    static const float grid[18]={
+        64,48,32,24,16,12,8,6,4,3,2,1.5f,1,.5f,.3333f,.25f,.1667f,.125f
+    };
+    const unsigned index=(unsigned)((1.f-normalized)*17.f+.5f);
+    return (tempo*(1.f/240.f))*grid[index];
+#endif
+}
+int juno6_arm_alt3_running(juno6_t *s,unsigned verified_ramp_frames,int tempo_sync)
+{
+    /* Only constructor-default ramp profile has a source witness. Do not
+     * choose it for an unknown live AU event or an unverified graph. */
+    if (!s || !s->typed || s->alt3.armed || verified_ramp_frames!=10000u ||
+        (unsigned)tempo_sync>1u || (tempo_sync && !(s->lfo_tempo>0.f))) return 0;
+    s->alt3.duration=verified_ramp_frames;
+    s->alt3.elapsed=s->alt3.depth_elapsed=verified_ramp_frames;
+    /* KoFMInstrument initialization sends frequency=3. Depth starts zero. */
+    s->alt3.rate=s->alt3.to_rate=3.f;
+    s->alt3.tempo_sync=(uint8_t)tempo_sync;
+    s->alt3.armed=1;
+    return 1;
+}
+int juno6_arm_alt3_free(juno6_t *s,unsigned verified_ramp_frames,int tempo_sync)
+{
+    return !tempo_sync && juno6_arm_alt3_running(s,verified_ramp_frames,0);
+}
+static void sj6_alt3_set_rate(juno6_t *s,float normalized)
+{
+    float rate=sj6_alt3_rate(normalized,s->alt3.tempo_sync,s->lfo_tempo);
+    if(rate!=s->alt3.to_rate){s->alt3.to_rate=rate;s->alt3.dirty|=1u;}
+}
+float juno6_alt3_panel_hz(unsigned rate,unsigned sync,float bpm)
+{ return sj6_alt3_rate((float)rate*(1.f/127.f),!!sync,bpm); }
+int juno6_alt3_set_panel(juno6_t *s,unsigned depth,unsigned rate,unsigned sync)
+{
+    if(!s || !s->typed || depth>127u || rate>127u || sync>1u)return 0;
+    /* Periodic prepare must not replay knobs after a real SMK MOD event. */
+    if(s->alt3.armed && s->alt3.panel_rate==rate+1u &&
+       s->alt3.panel_depth==depth+1u && s->alt3.tempo_sync==sync)return 1;
+    s->alt3.panel_depth=(uint8_t)(depth+1u);
+    if(!s->alt3.armed && !juno6_arm_alt3_running(s,10000u,sync && s->lfo_tempo>0.f))return 0;
+    const float u=(float)depth*(1.f/127.f);
+    s->alt3.tempo_sync=(uint8_t)sync;
+    s->alt3.panel_rate=(uint8_t)(rate+1u);
+    s->alt3.last_wheel_code=0;
+    if(!sync || s->lfo_tempo>0.f)sj6_alt3_set_rate(s,(float)rate*(1.f/127.f));
+    if(u!=s->alt3.to_depth){s->alt3.to_depth=u;s->alt3.dirty|=2u;}
+    return 1;
+}
+static void sj6_alt3_target(juno6_t *s,unsigned value)
+{
+    float u=(float)value/127.f;
+    sj6_alt3_set_rate(s,.9f*u);
+    if(u!=s->alt3.to_depth){s->alt3.to_depth=u;s->alt3.dirty|=2u;}
+    s->alt3.last_wheel_code=(uint8_t)(value+1u);
+}
+static float sj6_alt3_table(unsigned i)
+{
+    i &= 4095u;
+    float x=(float)i*(FM_TWO_PI/4096.f);
+    return .5f*fm_sin_pi(i>2048u ? x-FM_TWO_PI : x)+.5f;
+}
+static inline float sj6_alt3_madd(float m,float x,float a)
+{
+#ifdef X0X_HOST
+    return fmaf(m,x,a);
+#else
+    /* Supported production instructions, no unprovided libm symbol. */
+    return m*x+a;
+#endif
+}
+static inline uint32_t sj6_alt3_round(float x)
+{
+#ifdef X0X_HOST
+    return (uint32_t)nearbyintf(x);
+#else
+    /* Original FE_TONEAREST for bounded nonnegative phase increments. */
+    const uint32_t whole=(uint32_t)x;
+    const float part=x-(float)whole;
+    return whole+(part>.5f || (part==.5f && (whole&1u)));
+#endif
+}
+void juno6_alt3_process_mod(juno6_t *s,float *left,float *right,unsigned n,
+                            float depth_override,float normalized_rate)
+{
+    if (!s->alt3.armed && depth_override<0.f) return;
+    const float mod_rate=normalized_rate>=0.f?
+        sj6_alt3_rate(normalized_rate,s->alt3.tempo_sync,s->lfo_tempo):
+        s->alt3.armed?-1.f:sj6_alt3_rate(.5f,0,s->lfo_tempo);
+    const uint32_t mod_increment=mod_rate>=0.f?
+        sj6_alt3_round((mod_rate*.5f)*(0x1p24f/s->sample_rate)):0u;
+    for(unsigned i=0;i<n;i++){
+        if (!s->alt3.tick) {
+            if(s->alt3.dirty&1u){
+                s->alt3.from_rate=s->alt3.rate;
+                s->alt3.elapsed=0;
+            }
+            if(s->alt3.dirty&2u){
+                s->alt3.from_depth=s->alt3.depth;
+                s->alt3.depth_elapsed=0;
+            }
+            s->alt3.dirty=0;
+            if(s->alt3.elapsed>=s->alt3.duration)s->alt3.rate=s->alt3.to_rate;
+            else {
+                float u=(float)s->alt3.elapsed/(float)s->alt3.duration;
+                s->alt3.rate=sj6_alt3_madd(s->alt3.to_rate-s->alt3.from_rate,u,s->alt3.from_rate);
+                s->alt3.elapsed+=8u;
+            }
+            if(s->alt3.depth_elapsed>=s->alt3.duration)s->alt3.depth=s->alt3.to_depth;
+            else {
+                float u=(float)s->alt3.depth_elapsed/(float)s->alt3.duration;
+                s->alt3.depth=sj6_alt3_madd(s->alt3.to_depth-s->alt3.from_depth,u,s->alt3.from_depth);
+                s->alt3.depth_elapsed+=8u;
+            }
+            s->alt3.increment=sj6_alt3_round((s->alt3.rate*.5f)*(0x1p24f/s->sample_rate));
+        }
+        s->alt3.tick=(uint8_t)((s->alt3.tick+1u)&7u);
+        float *channel[2]={left+i,right+i};
+        const float depth=depth_override>=0.f?depth_override:s->alt3.depth;
+        const uint32_t increment=mod_rate>=0.f?mod_increment:s->alt3.increment;
+        for(unsigned ch=0;ch<2;ch++){
+            if(depth){
+                unsigned p=s->alt3.phase,ind=p>>12;
+                float a=sj6_alt3_table(ind),b=sj6_alt3_table(ind+1u);
+                float wave=sj6_alt3_madd(b-a,(p&4095u)*(1.f/4096.f),a);
+                *channel[ch]*=(1.f-depth*wave);
+            }
+            s->alt3.phase=(s->alt3.phase+increment)&0xffffffu;
+        }
+    }
+}
+void juno6_alt3_process(juno6_t *s,float *left,float *right,unsigned n)
+{ juno6_alt3_process_mod(s,left,right,n,-1.f,-1.f); }
+
+#endif
+
+static int sj6_mod_lfo1_routed(const juno6_t *s)
+{
+#if X0X_SJ6_AUX_LFO_NATIVE
+    if(s->lfo1_aux_route)return s->lfo1_aux_route!=7u;
+#endif
+    return !!s->lfo1_pwm_route;
+}
+
+__attribute__((noinline)) int juno6_set_mod_destination(juno6_t *s,unsigned selected)
+{
+    if (selected==6u) selected=0; /* Build-9 final segment aliases the default. */
+    if (!s || !s->typed) return 0;
+#if defined(DNBOX_137_HOST_WITNESS) && defined(X0X_SJ6_MOD_TYPED_PROBE)
+    if(selected>5u)return 0;
+    /* Selection is configuration, not a performance event. Gate actual
+     * wheel dispatch separately from restoring stored owner choice. */
+    s->mod_destination=(uint8_t)selected;
+    return 1;
+#endif
+#if (defined(X0X_HOST) && defined(X0X_SJ6_ALT3_WITNESS)) || X0X_SJ6_ALT3_NATIVE
+    if(selected==3u) { if(!s->alt3.armed)return 0; }
+    else
+#endif
+    if(selected>1u && selected!=4u && selected!=5u && (selected!=2u || !sj6_mod_lfo1_routed(s))) return 0;
+    s->mod_destination=(uint8_t)selected;
+    return 1;
+}
+
+__attribute__((noinline)) int juno6_set_mod_wheel(juno6_t *s,unsigned value)
+{
+    if (!s || !s->typed || value>127u) return 0;
+#if (defined(X0X_HOST) && defined(X0X_SJ6_ALT3_WITNESS)) || X0X_SJ6_ALT3_NATIVE
+    if (s->mod_destination==3u) {
+        if(!s->alt3.armed || (s->alt3.tempo_sync && !(s->lfo_tempo>0.f)))return 0;
+        sj6_alt3_target(s,value);
+        return 1;
+    }
+#else
+    if(s->mod_destination==3u)return 0;
+#endif
+    if (s->mod_destination==1u) {
+        s->vibrato_depth=sj6_vibrato_depth((float)value/127.f);
+        return 1;
+    }
+    if (s->mod_destination==2u) {
+        if(!sj6_mod_lfo1_routed(s))return 0;
+        s->wheel_lfo1_amount=(uint8_t)(value+1u);
+        return 1;
+    }
+    if (s->mod_destination==5u) {
+        float u=(float)value/127.f;
+        s->mod_wheel_cutoff_hz=sj6_cutoff_hz(s,u);
+#if X0X_SJ6_OTA_NATIVE
+        juno6_refresh_ota_sustain(s,u);
+#endif
+        if(s->lfo1_pwm_route==3) {
+            s->lfo1_cut_force=s->lfo1_cut_active;
+            s->lfo1_cut_active=0;
+            s->lfo1_cut_current=s->lfo1_cut_target=u;
+        }
+        return 1;
+    }
+    const unsigned lfo = s->mod_destination==4u;
+    uint8_t *effective = lfo ? &s->mod_wheel_lfo2 : &s->mod_wheel_lfo1;
+    if (*effective!=value+1u) {
+        *effective=(uint8_t)(value+1u);
+        prepare_lfo_step(s,lfo);
+    }
+    return 1;
+}
+
+void juno6_set_lfo_tempo(juno6_t *s, float bpm)
+{
+    if (bpm == s->lfo_tempo || bpm < 0.f || !sj6_lfo_finite(bpm)) return;
+    s->lfo_tempo = bpm;
+#if X0X_SJ6_NATIVE_DELAY && X0X_SJ6_AUX_LFO_NATIVE
+    if(bpm>0.f)juno6_delay_native_route_refresh(s,bpm);
+#endif
+#if (defined(X0X_HOST) && defined(X0X_SJ6_ALT3_WITNESS)) || X0X_SJ6_ALT3_NATIVE
+    if (s->alt3.armed && s->alt3.tempo_sync && s->alt3.last_wheel_code && bpm>0.f)
+        sj6_alt3_set_rate(s,.9f*((float)(s->alt3.last_wheel_code-1u)/127.f));
+    else if(s->alt3.armed && s->alt3.tempo_sync && s->alt3.panel_rate && bpm>0.f)
+        sj6_alt3_set_rate(s,(float)(s->alt3.panel_rate-1u)*(1.f/127.f));
+#endif
+    for (unsigned i = 0, sync = s->lfo_sync; sync; ++i, sync >>= 1)
+        if (sync & 1u) prepare_lfo_step(s, i);
+}
+
+#if X0X_SJ6_LFO1_DELAY_PORT
+/* Build9 ID91 setter: 0x1000f73c0..7404 -> 3 * pow(unit,1.21).
+ * Its nominal 80 Hz worker starts the shared phase only once elapsed is
+ * strictly larger than the selected delay; it does not reset on the edit. */
+float juno6_lfo1_delay_seconds(unsigned position)
+{
+    return position ? 3.f*fm_powf((float)position/127.f,1.21f) : 0.f;
+}
+void juno6_lfo1_delay_set(juno6_t *s,unsigned position)
+{
+    if (!s->typed || position>127u || s->lfo1_delay_raw==position) return;
+    s->lfo1_delay_raw=(uint8_t)position;
+    unsigned ticks=(unsigned)(juno6_lfo1_delay_seconds(position)*80.f)+1u;
+    s->lfo1_delay_frames=position?(ticks*(unsigned)s->sample_rate+79u)/80u:0u;
+}
+static int sj6_lfo1_waiting(const juno6_t *s)
+{
+    return s->typed && s->lfo1_delay_raw && !s->lfo1_delay_started;
+}
+#endif
+#if X0X_SJ6_LFO1_WAVE_NATIVE
+/* Build9 ID87: 0x1000f5da4 raw>0 gates LFO1. ID198: 0x1000f5d44
+ * independently stores snapback, used on the non-Loop terminal event.
+ * The wire stores disabled so existing zero-carriage keeps its behavior. */
+void juno6_lfo1_controls(juno6_t *s,unsigned wave,unsigned disabled,unsigned snapback)
+{
+    s->lfo1_wave=(uint8_t)wave;
+    if(s->lfo1_disabled!=disabled && s->lfo1_pwm_route==3u && s->mod_destination!=5u) {
+        s->lfo1_cut_active=0;
+        s->lfo1_cut_force=(uint8_t)!disabled;
+        if(disabled) {
+            s->mod_wheel_cutoff_hz=0.f;
+            s->lfo1_cut_target=s->lfo1_cut_current=s->lfo1_pwm_base;
+        }
+    }
+    s->lfo1_disabled=(uint8_t)disabled;
+    s->lfo1_snapback=(uint8_t)snapback;
+}
+#endif
+__attribute__((noinline)) void juno6_set_lfo_words(juno6_t *s, const juno6_lfo_words *words, int reset_phase)
+{
+    if (reset_phase) {
+#if X0X_SJ6_AUX_LFO_NATIVE
+        s->aux_lfo3_age=s->aux_lfo_until[0]=s->aux_lfo_until[1]=0;
+#if X0X_SJ6_LFO_TRIGGER_NATIVE
+        s->trigger_active=s->trigger_done=0;
+#endif
+        s->aux_lfo3_entropy=s->aux_lfo3_held_turn=0;
+#endif
+#if X0X_SJ6_LFO1_DELAY_PORT
+        s->lfo1_delay_age=0;
+        s->lfo1_delay_started=0;
+#endif
+        s->mod_wheel_lfo1=s->mod_wheel_lfo2=0;
+        s->mod_wheel_cutoff_hz=0.f;
+        s->wheel_lfo1_amount=0;
+        s->lfo1_pwm_until_tick=0;
+        s->lfo1_cut_active=s->lfo1_cut_force=0;
+        s->lfo1_cut_until=(int32_t)s->sample_rate;
+        s->lfo2_hold_sample = s->lfo2_hold_elapsed = 0.f;
+        s->lfo2_pwm_until_tick = 0;
+    }
+    for (unsigned lfo = 0; lfo < SJ6_LFO_COUNT; ++lfo) {
+        unsigned mask = words ? words->present >> lfo : 0u;
+        unsigned presence = (mask & 1u) | ((mask >> 2u) & 2u);
+        set_lfo_word(&s->core, sj6_lfo_rate_id[lfo], presence & 1u, words ? words->word[lfo] : 0.f);
+        set_lfo_word(&s->core, 195u + lfo, presence & 2u,
+                     words ? words->word[SJ6_LFO_COUNT + lfo] : 0.f);
+        prepare_lfo_step(s, lfo);
+        if (reset_phase) s->lfo_phase_q40[lfo] = 0;
+    }
+}
+
+__attribute__((noinline)) void juno6_set_panel_lfo(juno6_t *s, unsigned lfo, int position, unsigned hz_mode)
+{
+    if (position >= 0) {
+        if (lfo==0) s->mod_wheel_lfo1=0;
+        if (lfo==1) s->mod_wheel_lfo2=0;
+        (void)dnbx_store_raw(&s->core, sj6_lfo_rate_id[lfo], position * (1.f / 127.f));
+    }
+    float old_mode;
+    /* Leave an equal authored mode word intact, including signed zero. */
+    if (dnbx_read_raw(&s->core, 195u + lfo, &old_mode) != DNBX_OK || old_mode != hz_mode)
+        (void)dnbx_store_raw(&s->core, 195u + lfo, (float)hz_mode);
+    prepare_lfo_step(s, lfo);
+}
+
+void juno6_set_lfo2_pwm(juno6_t *s, uint16_t setting)
+{
+    const unsigned mask = SJ6_LFO2_PWM_DEPTH_MASK | SJ6_LFO2_PWM_ROUTE_MASK;
+    if ((s->lfo2_pwm >> SJ6_LFO2_PWM_SHAPE_SHIFT) != SJ6_LFO_HELD &&
+        (!(setting & SJ6_LFO2_PWM_DEPTH_MASK) || !(setting & SJ6_LFO2_PWM_ROUTE_MASK)))
+        s->lfo2_pwm_until_tick = 0;
+    s->lfo2_pwm = (s->lfo2_pwm & ~mask) | (setting & mask);
+}
+
+void juno6_set_lfo2_shape(juno6_t *s, unsigned shape)
+{
+    const unsigned mask = SJ6_LFO2_SHAPE_MASK << SJ6_LFO2_PWM_SHAPE_SHIFT;
+    if (shape <= SJ6_LFO2_SHAPE_MAX)
+        s->lfo2_pwm = (s->lfo2_pwm & ~mask) | (shape << SJ6_LFO2_PWM_SHAPE_SHIFT);
+}
+
+static const uint8_t sj6_knob_ids[SJ6_OSC_KNOBS] = {82, 83, 86, 210, 78, 211, 79};
+
+__attribute__((noinline,minsize)) static float sj6_knob_raw(const juno6_t *s, unsigned slot)
+{
+    float raw = slot <= SJ6_WAVE2 ? 0x1.555556p-1f : slot == SJ6_RANGE ? .5f : 0.f;
+    (void)dnbx_read_raw(&s->core, sj6_knob_ids[slot], &raw);
+    return raw;
+}
+
+__attribute__((noinline,minsize)) static float sj6_stage_raw(const dnbx_envelope_params *e,unsigned stage,unsigned filter)
+{
+    if(stage==2u)return fm_powf(e->sustain,.4f);
+    float t=stage==0u?e->attack_s:stage==1u?e->decay_s:e->release_s;
+    return fm_clampf(fm_powf(fm_maxf(t-(filter && stage==3u?.202f:.002f),0.f)/
+                     (stage?23.998f:15.998f),1.f/(stage?3.35f:3.33f)),0.f,1.f);
+}
+
+unsigned juno6_knob_position(const juno6_t *s, unsigned slot)
+{
+    if (slot == SJ6_LFO2_PWM_DEPTH) return s->lfo2_pwm & SJ6_LFO2_PWM_DEPTH_MASK;
+    if (slot == SJ6_LFO2_PWM_ROUTE)
+        return (s->lfo2_pwm & SJ6_LFO2_PWM_ROUTE_MASK) >> SJ6_LFO2_PWM_ROUTE_SHIFT;
+    if (slot == SJ6_LFO2_SHAPE) return s->lfo2_pwm >> SJ6_LFO2_PWM_SHAPE_SHIFT;
+    if (slot >= SJ6_LFO1_MODE && slot <= SJ6_LFO3_MODE) {
+        float hz = 1.f;
+        (void)dnbx_read_raw(&s->core, 195u + slot - SJ6_LFO1_MODE, &hz);
+        return hz == 1.f;
+    }
+    if (slot >= SJ6_LFO1_RATE && slot <= SJ6_LFO3_RATE) {
+        float raw = 0.f;
+        (void)dnbx_read_raw(&s->core, sj6_lfo_rate_id[slot - SJ6_LFO1_RATE], &raw);
+        return (unsigned)(raw * 127.f + .5f);
+    }
+    if (slot == SJ6_FILTER_LINK) return s->core.filter_link;
+    if (slot == SJ6_MASTER_LEVEL) {
+        float raw;
+        if (dnbx_read_raw(&s->core, 0, &raw) != DNBX_OK) return SJ6_MASTER_INIT;
+        return (unsigned)(raw * (127.f / JUNO6_FACTORY_MASTER_MAX) + .5f);
+    }
+    if (slot >= SJ6_AMP_ATTACK) {
+        const dnbx_layer_params *p = &s->core.layer[0].params;
+        unsigned filter = slot >= SJ6_FILTER_ATTACK;
+        unsigned stage = slot - (filter ? SJ6_FILTER_ATTACK : SJ6_AMP_ATTACK);
+        const float v=sj6_stage_raw(filter?&p->filter:&p->amp,stage,filter);
+        return (unsigned)(fm_clampf(v,0.f,1.f)*127.f+.5f);
+    }
+    float raw = sj6_knob_raw(s, slot);
+    if (slot <= SJ6_WAVE2)
+        return (raw >= 0x1.555556p-2f) + (raw >= 0x1.555556p-1f) + (raw == 1);
+    if (slot == SJ6_RANGE) return (unsigned)(raw * 2.f);
+    if (slot == SJ6_PWM1_ON || slot == SJ6_PWM2_ON) return raw > .5f;
+    return (unsigned)(raw * SJ6_PWM_STEPS + .5f);
+}
+
+/* Only apply the touched controls. Read neighboring authored words at the
+ * audio boundary so a panel detent never re-quantizes another control. */
+void juno6_apply_knobs(juno6_t *s, unsigned mask, const uint8_t p[SJ6_OSC_KNOBS])
+{
+    for (unsigned layer = 0; layer < DNBX_LAYERS; ++layer) {
+        unsigned wave = SJ6_WAVE1 + layer, on = SJ6_PWM1_ON + 2u * layer, amount = on + 1u;
+        if (!(mask & ((1u << wave) | (1u << on) | (1u << amount)))) continue;
+        juno6_oscillator_edit e = {
+            mask & (1u << wave) ? p[wave] * (1.f / SJ6_WAVE_STOPS) : sj6_knob_raw(s, wave),
+            mask & (1u << amount) ? p[amount] * (1.f / SJ6_PWM_STEPS) : sj6_knob_raw(s, amount),
+            mask & (1u << on) ? p[on] : sj6_knob_raw(s, on)
+        };
+        juno6_apply_pre_note_wave(s, layer, &e);
+    }
+    if (mask & (1u << SJ6_RANGE)) juno6_apply_pre_note_range(s, p[SJ6_RANGE] * .5f);
+}
+
+__attribute__((noinline,minsize)) static void apply_adsr(dnbx_envelope_params *env, unsigned mask, const float *physical)
+{
+    if (mask & 1u) env->attack_s = physical[0];
+    if (mask & 2u) env->decay_s = physical[1];
+    if (mask & 4u) env->sustain = physical[2];
+    if (mask & 8u) env->release_s = physical[3];
+}
+
+void juno6_apply_panel_envelopes(juno6_t *s, unsigned mask, const uint8_t p[SJ6_EXTRA_COUNT], int reset)
+{
+    float physical[8];
+    for (unsigned i = 0; i < 8; ++i) if (mask & (1u << i)) {
+        float u = (p[i] & 127u) * (1.f / 127.f);
+        /* Build9's filter ADSR shares the AMP taper, but the filter-release
+         * receiver adds 200 ms after converting the authored slider value. */
+        physical[i] = amp_stage_from_unit(i & 3u, u) + (i == 7 ? .2f : 0.f);
+    }
+    unsigned linked = mask & (1u << 8) ? p[8] & 1u : reset ? 0 : s->core.filter_link;
+    dnbx_layer_params defaults;
+    if (reset) dnbx_default_layer_params(&defaults);
+    for (unsigned l = 0; l < DNBX_LAYERS; ++l) {
+        const dnbx_layer_params *layer = reset ? &defaults : &s->core.layer[l].params;
+        dnbx_envelope_params amp = layer->amp, filter = layer->filter;
+        apply_adsr(&amp, mask, physical);
+        apply_adsr(&filter, mask >> 4, physical + 4);
+        dnbx_apply_panel_envelopes(&s->core, l, &amp, &filter, linked);
+    }
+#if X0X_SJ6_OTA_NATIVE
+    if(s->core.sj6_ota && (reset || (mask&0x144u)))juno6_refresh_ota_sustain(s,-1.f);
+#endif
+}
+#endif
