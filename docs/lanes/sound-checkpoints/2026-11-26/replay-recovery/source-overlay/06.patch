+    if (dnbx_read_raw(&s->core, sj6_lfo_rate_id[lfo], &out->rate) == DNBX_OK) out->present |= 1u;
+    if (dnbx_read_raw(&s->core, 195u + lfo, &out->mode) == DNBX_OK) out->present |= 2u;
