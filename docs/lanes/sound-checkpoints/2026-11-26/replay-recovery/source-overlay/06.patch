+ * typed-render split, so muted/invalid routes do not change audio work. */
+#if X0X_SJ6_AUX_LFO_NATIVE
+#if X0X_SJ6_LFO_TRIGGER_NATIVE
+static int sj6_trigger_live(const juno6_t *,unsigned);
+static int sj6_trigger_done(const juno6_t *,unsigned,uint64_t);
+#endif
+#include "juno6_aux_fx.h"
+float juno6_aux_delay_seconds(unsigned code)
+{ return 3.f*fm_powf((float)code*(1.f/127.f),1.21f); }
+#include "juno6_aux_catalog.h"
+#include "juno6_aux_core.inc"
+#include "juno6_aux_servo.inc"
+int juno6_aux_destination_supported(unsigned route)
+{
+    if(!route)return 1;
+    const int id=sj6_aux_destination_id(route);
+    return id>=0 && (route<7u || id==1 || id==3 || id==78 || id==79 ||
+           sj6_aux_fx_supported(id) || juno6_aux_core_supported((unsigned)id) ||
+           sj6_aux_servo_slot((unsigned)id)>=0
+#if X0X_SJ6_AUX_SEQ_NATIVE
+           || sj6_aux_seq_id((unsigned)id)
+#endif
+#if X0X_SJ6_MONO32_PROBE
+           || id==35
+#endif
+           );
+}
+float juno6_aux_master_gain(float raw){return master_from_raw(raw);}
+__attribute__((noinline)) float juno6_aux_capture_base(const juno6_t *s,unsigned route)
+{
+    if(route>=7u){
+        const int id=sj6_aux_destination_id(route);
+        switch(id){
+        case 78:route=1u;break;case 79:route=2u;break;
+        case 1:route=4u;break;case 3:route=5u;break;
+        default:{
+            if(id<0)return -1.f;
+#if X0X_SJ6_MONO32_PROBE
+            if(id==35)return s->glide35_detent*(1.f/127.f);
+#endif
+            const float base=sj6_aux_servo_base(s,(unsigned)id);
+            return base>=0.f?base:juno6_aux_core_base(s,(unsigned)id);
+        }
+        }
+    }
+    static const uint8_t target[]={0,78,79,129,1,3,57};
+    if(!route || route>=sizeof target)return 0.f;
+    float raw;
+    if(route==6u) {
+#if X0X_SJ6_PITCH_ENV_NATIVE
+        return (float)s->core.sj6_pitch_depth*(1.f/60.f);
+#else
+        return 0.f;
+#endif
+    }
+    if(dnbx_read_raw(&s->core,target[route],&raw)==DNBX_OK)return fm_clampf(raw,0.f,1.f);
+    if(route==3u)return sj6_aux_infer_cutoff(s->core.layer[0].params.cutoff_hz);
+    if(route==4u || route==5u)return 1.f;
+    return .5f;
+}
+__attribute__((noinline)) void juno6_set_aux_lfo(juno6_t *s,const uint8_t *code)
+{
+#if X0X_SJ6_LFO_TRIGGER_NATIVE
+    for(unsigned l=0;l<3u;l++)if(s->aux_lfo[13u+l]!=code[13u+l]){
+        s->trigger_active&=(uint8_t)~(1u<<l);s->trigger_done&=(uint8_t)~(1u<<l);
+        s->lfo_phase_q40[l]=0;
+    }
+#endif
+    for(unsigned i=0;i<sizeof s->aux_lfo;i++)s->aux_lfo[i]=code[i];
+#if X0X_SJ6_PITCH_ENV_NATIVE
+    const unsigned pitched2=code[0]!=1u && (code[5]==6u || code[6]==6u);
+    const unsigned pitched3=code[1]==2u && (code[7]==6u || code[8]==6u);
+    dnbx_route_sj6_pitch_env(&s->core,pitched2 || pitched3);
+#endif
+    unsigned timers=(unsigned)(juno6_aux_delay_seconds(code[4])*80.f)+1u;
+    s->aux_delay_frames=code[4]?(timers*(unsigned)s->sample_rate+79u)/80u:0u;
+#if X0X_SJ6_NATIVE_DELAY
+    juno6_delay_native_route_refresh(s,s->lfo_tempo);
+#endif
+}
+void juno6_set_aux_lfo1(juno6_t *s,unsigned route,unsigned base)
+{
+    if(s->lfo1_aux_route==route && s->lfo1_aux_base==base)return;
+    s->lfo1_aux_route=(uint8_t)route;
+    s->lfo1_aux_base=(uint8_t)base;
+    s->lfo1_aux_until=0u;
+#if X0X_SJ6_NATIVE_DELAY
+    juno6_delay_native_route_refresh(s,s->lfo_tempo);
+#endif
+    if(s->mod_destination!=5u){
+        s->mod_wheel_cutoff_hz=0.f;
+        s->lfo1_cut_active=0;
+    }
+}
+static int sj6_extra_lfo_on(const juno6_t *s,unsigned loop)
+{
+    return s->aux_lfo[loop-1u]==2u ||
+        (loop==1u && !s->aux_lfo[0] && (s->lfo2_pwm & SJ6_LFO2_PWM_ROUTE_MASK));
+}
+static int sj6_extra_lfo_route(const juno6_t *s,unsigned loop)
+{
+    unsigned k=(loop-1u)*2u+5u;
+    return s->aux_lfo[k] || s->aux_lfo[k+1u];
+}
+#if X0X_SJ6_AUX_SEQ_NATIVE
+/* Audio worker already evaluates the AU wave/delay/trigger state in its
+ * 80 Hz spans. Route those very values into the separate scheduler. */
+__attribute__((noinline)) unsigned juno6_aux_seq_values(const juno6_t *s,uint8_t ids[5],float values[5])
+{
+    unsigned n=0;
+    const unsigned first=(unsigned)sj6_aux_destination_id(s->lfo1_aux_route);
+    if(sj6_aux_seq_id(first)
+#if X0X_SJ6_LFO1_DELAY_PORT
+       && !sj6_lfo1_waiting(s)
+#endif
+#if X0X_SJ6_LFO_TRIGGER_NATIVE
+       && sj6_trigger_live(s,0u)
+#endif
+#if X0X_SJ6_LFO1_WAVE_NATIVE
+       && !s->lfo1_disabled
+#endif
+      ){
+        const float a=sj6_effective_lfo_amount(s,0u);
+        if(a!=0.f){
+            ids[n]=(uint8_t)first;
+            values[n++]=fm_clampf(s->lfo1_aux_base*(1.f/127.f)+s->lfo1_aux_delta*a,0.f,1.f);
+        }
+    }
+    for(unsigned i=0;i<2u;i++){
+        const unsigned loop=i+1u;
+        if(!sj6_extra_lfo_on(s,loop) || !s->lfo_step_q40[loop] ||
+           (i && s->aux_lfo3_age<s->aux_delay_frames))continue;
+#if X0X_SJ6_LFO_TRIGGER_NATIVE
+        if(!sj6_trigger_live(s,loop))continue;
+#endif
+        float a=(float)(i?s->aux_lfo[2]:(s->lfo2_pwm&SJ6_LFO2_PWM_DEPTH_MASK))*(1.f/127.f);
+        if(a==0.f)continue;
+        for(unsigned k=i*2u;k<i*2u+2u;k++){
+            const unsigned id=(unsigned)sj6_aux_destination_id(s->aux_lfo[5u+k]);
+            if(!sj6_aux_seq_id(id))continue;
+            ids[n]=(uint8_t)id;
+            values[n++]=fm_clampf((float)s->aux_lfo[9u+k]*(1.f/127.f)+s->aux_lfo_delta[i]*a,0.f,1.f);
+        }
+    }
+    return n;
+}
+#endif
+static float sj6_held3_next(juno6_t *s)
+{
+    uint32_t x=s->aux_lfo3_entropy;
+    if(!x)x=(uint32_t)(s->lfo2_entropy_state ^ 0x9e3779b9u);
+    x^=x<<13;x^=x>>17;x^=x<<5;
+    s->aux_lfo3_entropy=x;
+    return (float)(x>>8)*(1.f/8388608.f)-1.f;
+}
+static void sj6_aux_schedule_fx(juno6_t *s,const uint8_t word[SJ6_AUX_FX_ROUTES])
+{
+    sj6_aux_fx_schedule *q=s->aux_fx_schedule;
+    if(!q)return;
+    if(q->count>=SJ6_AUX_FX_EVENTS)return;
+    const uint8_t *last=q->count?q->event[q->count-1u].code:0;
+    unsigned different=0;
+    for(unsigned i=0;i<SJ6_AUX_FX_ROUTES;i++)different|=word[i]^(last?last[i]:0u);
+    if(!different)return;
+    sj6_aux_fx_event *e=&q->event[q->count++];
+    e->at=(uint8_t)s->aux_lfo_cursor;
+    for(unsigned i=0;i<SJ6_AUX_FX_ROUTES;i++)e->code[i]=word[i];
+}
+static int render_typed_span(juno6_t *s,float *left,float *right,unsigned frames)
+{
+    const unsigned sr=(unsigned)s->sample_rate;
+    const int first=sj6_aux_destination_id(s->lfo1_aux_route);
+    const int on1=first>=0 &&
+#if X0X_SJ6_LFO1_DELAY_PORT
+        !sj6_lfo1_waiting(s) &&
+#endif
+#if X0X_SJ6_LFO_TRIGGER_NATIVE
+        sj6_trigger_live(s,0u) &&
+#endif
+#if X0X_SJ6_LFO1_WAVE_NATIVE
+        !s->lfo1_disabled &&
+#endif
+        first!=7;
+    const int on2=sj6_extra_lfo_on(s,1u) && sj6_extra_lfo_route(s,1u) &&
+#if X0X_SJ6_LFO_TRIGGER_NATIVE
+        sj6_trigger_live(s,1u) &&
+#endif
+        s->lfo_step_q40[1];
+    const int on3=sj6_extra_lfo_on(s,2u) && sj6_extra_lfo_route(s,2u) &&
+#if X0X_SJ6_LFO_TRIGGER_NATIVE
+        sj6_trigger_live(s,2u) &&
+#endif
+        s->lfo_step_q40[2];
+    if(!(on1 || on2 || on3) || !frames || frames>DNBX_MAX_FRAMES || !left || !right || left==right) {
+        static const uint8_t empty[SJ6_AUX_FX_ROUTES]={0};
+        if(frames)sj6_aux_schedule_fx(s,empty);
+        sj6_aux_servo_commit(s,0u,0,s->aux_lfo_cursor,s->aux_lfo_cursor);
+        s->aux_lfo_cursor+=(uint16_t)frames;
+        return render_typed_span_raw(s,left,right,frames);
+    }
+    while(frames) {
+        unsigned n=frames;
+        const uint32_t age=s->aux_lfo3_age+s->aux_lfo_cursor;
+        if(on3 && age<s->aux_delay_frames) {
+            uint32_t rem=s->aux_delay_frames-age;
+            if(n>rem)n=rem;
+        }
+        const unsigned phase3=age>=s->aux_delay_frames?
+            s->aux_lfo_cursor-(s->aux_lfo3_age<s->aux_delay_frames ? s->aux_delay_frames-s->aux_lfo3_age : 0u):0u;
+        const int enabled[3]={on1,on2,on3 && age>=s->aux_delay_frames};
+        uint8_t fx_words[SJ6_AUX_FX_ROUTES]={0};
+        unsigned servo_mask=0;
+        float servo_value[6]={0};
+#if X0X_SJ6_MONO32_PROBE
+        const float saved_glide=s->core.sj6_glide_secs;
+#endif
+        unsigned wrote=0;
+        sj6_aux_core_saved core_save;core_save.active=0;
+        float saved_width[2],saved_depth[2];
+        const uint8_t saved_level1=s->osc1_level_code,saved_level2=s->osc2_level_code;
+        const float saved_cutoff[2]={s->core.layer[0].params.cutoff_hz,s->core.layer[1].params.cutoff_hz};
+#if X0X_SJ6_PITCH_ENV_NATIVE
+        const uint8_t saved_pitch=s->core.sj6_pitch_depth;
+#endif
+        for(unsigned k=0;k<3u;k++)if(enabled[k]){
+            unsigned i=k?k-1u:0u;
+            const uint64_t phase=s->lfo_phase_q40[k]+s->lfo_step_q40[k]*(k==2u?phase3:s->aux_lfo_cursor);
+            uint32_t *const until=k?&s->aux_lfo_until[i]:&s->lfo1_aux_until;
+            float *const delta=k?&s->aux_lfo_delta[i]:&s->lfo1_aux_delta;
+            uint32_t rem=*until;
+            if(rem<80u){
+                unsigned ix=(uint8_t)(phase>>32);
+                unsigned shape=k==2u?s->aux_lfo[3]:k?s->lfo2_pwm>>SJ6_LFO2_PWM_SHAPE_SHIFT:SJ6_LFO_TRI;
+#if X0X_SJ6_LFO1_WAVE_NATIVE
+                if(!k)shape=s->lfo1_wave;
+#endif
+#if X0X_SJ6_LFO_TRIGGER_NATIVE
+                if(sj6_trigger_done(s,k,phase))
+                    *delta=shape==SJ6_LFO_UP?1.f:shape==SJ6_LFO_DOWN?-1.f:0.f;
+                else
+#endif
+                if(shape==SJ6_LFO_HELD) {
+#if X0X_SJ6_LFO1_WAVE_NATIVE
+                    if(!k){sj6_held1_80hz(s);*delta=s->lfo1_hold_sample*.5f;}
+                    else
+#endif
+                    if(k==1u) {
+                        sj6_held_80hz(s);
+                        *delta=s->lfo2_hold_sample*.5f;
+                    } else {
+                        unsigned turn=ix;
+                        if(!s->aux_lfo3_entropy || turn<s->aux_lfo3_held_turn)
+                            *delta=sj6_held3_next(s)*.5f;
+                        s->aux_lfo3_held_turn=turn;
+                    }
+                } else *delta=lfo2_pwm_delta(shape,ix,1.f);
+                rem+=sr;
+                *until=rem;
+            }
+            unsigned span=rem/80u;
+            if(n>span)n=span;
+            const float amount=sj6_effective_lfo_amount(s,k);
+            const unsigned start=k?1u+(k-1u)*2u:0u;
+            for(unsigned j=start;j<start+(k?2u:1u);j++){
+                unsigned route=juno6_aux_fx_route(s,j);
+                if(!route || amount==0.f)continue;
+                const unsigned base=k?s->aux_lfo[8u+j]:s->lfo1_aux_base;
+                const float raw=fm_clampf(base*(1.f/127.f)+*delta*amount,0.f,1.f);
+                const int target=sj6_aux_destination_id(route);
+                if(s->aux_fx_schedule && sj6_aux_fx_supported(target)) {
+                    fx_words[j]=(uint8_t)(raw*127.f+.5f)+1u;
+                    continue;
+                }
+                switch(target) {
+                case 78:case 79:{
+                    const unsigned dst=(unsigned)target-78u,bit=1u<<dst;
+                    dnbx_layer_params *p=&s->core.layer[dst].params;
+                    if(p->waveform!=1.f || s->core.raw[210u+dst]<=.5f)break;
+                    if(!(wrote&bit)){saved_width[dst]=p->pulse_width;saved_depth[dst]=p->lfo_pwm_depth;}
+                    wrote|=bit;
+                    (void)dnbx_pwm_from_unit(raw,&p->pulse_width);
+                    p->lfo_pwm_depth=0.f;
+                    break;
+                }
+                case 129:{
+                    const float hz=sj6_normal_cutoff_hz(raw);
+                    s->core.layer[0].params.cutoff_hz=s->core.layer[1].params.cutoff_hz=hz;
+                    break;
+                }
+                case 1:s->osc1_level_code=(uint8_t)(raw*127.f+.5f)+1u;break;
+                case 3:s->osc2_level_code=(uint8_t)(raw*127.f+.5f)+1u;break;
+#if X0X_SJ6_PITCH_ENV_NATIVE
+                case 57:s->core.sj6_pitch_depth=(uint8_t)(raw*60.f+.5f);break;
+#endif
+#if X0X_SJ6_MONO32_PROBE
+                case 35:s->core.sj6_glide_secs=.5f*raw;break;
+#endif
+                default:
+                    if(juno6_aux_core_supported((unsigned)target))
+                        juno6_aux_core_apply(s,&core_save,(unsigned)target,raw);
+                    else {
+                        const int slot=sj6_aux_servo_slot((unsigned)target);
+                        if(slot>=0){servo_value[slot]=raw;servo_mask|=1u<<(unsigned)slot;}
+                    }
+                }
+            }
+        }
+        sj6_aux_schedule_fx(s,fx_words);
+        sj6_aux_servo_commit(s,servo_mask,servo_value,s->aux_lfo_cursor,phase3);
+        juno6_aux_core_bends(s,&core_save);
+        int rc=render_typed_span_raw(s,left,right,n);
+#if X0X_SJ6_MONO32_PROBE
+        s->core.sj6_glide_secs=saved_glide;
+#endif
+        juno6_aux_core_restore(s,&core_save);
+        s->osc1_level_code=saved_level1;s->osc2_level_code=saved_level2;
+        s->core.layer[0].params.cutoff_hz=saved_cutoff[0];
+        s->core.layer[1].params.cutoff_hz=saved_cutoff[1];
+#if X0X_SJ6_PITCH_ENV_NATIVE
+        s->core.sj6_pitch_depth=saved_pitch;
+#endif
+        for(unsigned k=0;k<2u;k++){
+            if(wrote&(1u<<k)){s->core.layer[k].params.pulse_width=saved_width[k];s->core.layer[k].params.lfo_pwm_depth=saved_depth[k];}
+            if(enabled[k+1u])s->aux_lfo_until[k]-=(uint32_t)(n*80u);
+        }
+        if(enabled[0])s->lfo1_aux_until-=n*80u;
+        if(rc!=DNBX_OK)return rc;
+        s->aux_lfo_cursor+=(uint16_t)n;
+        frames-=n;left+=n;right+=n;
+    }
+    return DNBX_OK;
+}
+#endif
+#if X0X_SJ6_LFO_TRIGGER_NATIVE
+/* Build9 192–194 modes, 199–200 snapback. Keys and Saga advances are distinct. */
+static unsigned sj6_trigger_mode(const juno6_t *s,unsigned l){return s->aux_lfo[13u+l];}
+static int sj6_trigger_live(const juno6_t *s,unsigned l){return !sj6_trigger_mode(s,l)||(s->trigger_active&(1u<<l));}
+static int sj6_trigger_done(const juno6_t *s,unsigned l,uint64_t phase){
+    return sj6_trigger_mode(s,l)>=2u && ((s->trigger_done&(1u<<l)) || phase>=SJ6_LFO_TURN);
+}
+int juno6_lfo_snapback_active(const juno6_t *s)
+{
+#if X0X_SJ6_LFO1_WAVE_NATIVE
+ if(s->aux_lfo[13] && s->lfo1_snapback)return 1;
+#endif
+ return (s->aux_lfo[14]&&s->aux_lfo[16]) || (s->aux_lfo[15]&&s->aux_lfo[17]);
+}
+__attribute__((noinline)) void juno6_lfo_trigger(juno6_t *s,unsigned event)
+{
+    for(unsigned l=0;l<SJ6_LFO_COUNT;l++){
+        const unsigned mode=sj6_trigger_mode(s,l),bit=1u<<l;
+        if(!mode)continue;
+        if(event==SJ6_LFO_EVENT_EMPTY) {
+            if(l&&s->aux_lfo[15u+l])s->trigger_active&=(uint8_t)~bit;
+#if X0X_SJ6_LFO1_WAVE_NATIVE
+            if(!l && s->lfo1_snapback) {
+                s->trigger_active&=(uint8_t)~bit;
+                if(s->lfo1_pwm_route==3u && s->mod_destination!=5u) {
+                    s->lfo1_cut_active=s->lfo1_cut_force=0;
+                    s->lfo1_cut_target=s->lfo1_cut_current=s->lfo1_pwm_base;
+                    s->mod_wheel_cutoff_hz=sj6_cutoff_hz(s,s->lfo1_pwm_base);
+#if X0X_SJ6_OTA_NATIVE
+                    juno6_refresh_ota_sustain(s,s->lfo1_pwm_base);
+#endif
+                }
+            }
+#endif
+            continue;
+        }
+        if((event==SJ6_LFO_EVENT_ARP)!=(mode==2u))continue;
+        s->trigger_active|=(uint8_t)bit;s->trigger_done&=(uint8_t)~bit;
+        s->lfo_phase_q40[l]=0;
+        if(!l){
+            s->lfo1_pwm_until_tick=0;s->lfo1_cut_until=0;
+#if X0X_SJ6_LFO1_DELAY_PORT
+            s->lfo1_delay_age=0;s->lfo1_delay_started=0;
+#endif
+        } else {
+            s->aux_lfo_until[l-1u]=0;
+            if(l==1u){s->lfo2_pwm_until_tick=0;s->lfo2_hold_elapsed=0.f;}
+            else s->aux_lfo3_age=0;
+        }
+    }
+}
+#endif
+static void sj6_held_bypass(juno6_t *s, unsigned frames)
+{
+    unsigned until = s->lfo2_pwm_until_tick;
+    while (frames) {
+        if (until < 80u) {sj6_held_80hz(s); until += (unsigned)s->sample_rate;}
+        unsigned count = until / 80u;
+        if (count > frames) count = frames;
+        frames -= count;
+        until -= count * 80u;
+    }
+    s->lfo2_pwm_until_tick = until;
+}
+
+/* Sample the existing audio clock on the nominal 80 Hz control grid. */
+/* At the cutoff controller's nominal 80 Hz tick, target submission
+ * precedes the exponential smoother. Original Float update order retained. */
+static void sj6_cutoff_tick(juno6_t *s,uint64_t phase)
+{
+    const float amount=sj6_effective_lfo_amount(s,0u);
+    float lfo_base=s->lfo1_pwm_base;
+#if X0X_SJ6_AUX_LFO_NATIVE
+    if(s->lfo1_aux_route)lfo_base=s->lfo1_aux_base*(1.f/127.f);
+#endif
+    const float eps=0x1.0624dep-11f;
+#if DNBOX_TYPED_CONTROLS_NATIVE_TEST
+    if(amount>.01f) {
+#else
+    if((double)amount>.01) {
+#endif
+        float target;
+#if X0X_SJ6_LFO1_WAVE_NATIVE
+        if(s->lfo1_wave)target=sj6_lfo1_shaped(s,(uint8_t)(phase>>32),lfo_base,amount);
+        else
+#endif
+        {
+        unsigned index=((unsigned)(phase>>32)+64u)&255u;
+        float wave=index<128u ? index*(1.f/64.f)-1.f:3.f-index*(1.f/64.f);
+#if DNBOX_TYPED_CONTROLS_NATIVE_TEST
+        target=sj6_lfo_port(lfo_base,amount,(int)(wave*64.f));
+#else
+        double candidate=(double)lfo_base+(double)wave*(double)amount*.5;
+        target=(float)(candidate<0. ? 0.:candidate>1. ? 1.:candidate);
+#endif
+        }
+        s->lfo1_cut_target=target;
+        if(s->lfo1_cut_force) {
+            s->lfo1_cut_force=s->lfo1_cut_active=0;
+            s->lfo1_cut_current=target;
+            s->mod_wheel_cutoff_hz=sj6_cutoff_hz(s,target);
+#if X0X_SJ6_OTA_NATIVE
+            juno6_refresh_ota_sustain(s,target);
+#endif
