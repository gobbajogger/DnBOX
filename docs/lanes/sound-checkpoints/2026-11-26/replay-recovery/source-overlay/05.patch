+static inline float sj6_ota_stage(float input,float *state,float g)
+{
+    float v=g*fm_tanhf(input-*state);
+    float y=*state+v;
+    *state=y+v;
+    return y;
+}
+static __attribute__((noinline)) float sj6_ota_filter(dnbx_layer_voice *v,float x,
+                                                       float rad,float resonance)
+{
+    /* Original OTA mode is a nonlinear, resonance-fed four-stage ladder,
+     * not the normal two-stage recurrence or the independent ID28 HPF.
+     * Compact discrete-time approximation: reused cutoff/envelope path,
+     * bounded resonance, and a single update per stage at board rate. */
+    float g=.5f*rad/(1.f+.5f*rad);
+    float input=x-(3.85f*fm_clampf(resonance,0.f,1.f))*v->ota_tail[1];
+    float y=sj6_ota_stage(input,&v->filter_first,g);
+    y=sj6_ota_stage(y,&v->filter_second,g);
+    y=sj6_ota_stage(y,&v->ota_tail[0],g);
+    return sj6_ota_stage(y,&v->ota_tail[1],g);
+}
