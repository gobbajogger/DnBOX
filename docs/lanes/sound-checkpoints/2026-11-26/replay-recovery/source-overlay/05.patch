+/* Prepare outside the sample loop. Link the four ADSR settings only;
+ * keep the filter's own hold policy and independent per-voice history. */
+static const dnbx_envelope_params *filter_params(const dnbx_part *s,unsigned layer,
+                                                dnbx_envelope_params *tmp)
+{
+    const dnbx_layer_params *p=&s->layer[layer].params;
+    if (!s->filter_link
+#if X0X_SJ6_OTA_NATIVE
+        && !s->sj6_ota
+#endif
+       ) return &p->filter;
+    *tmp=p->filter;
+    if(s->filter_link) {
+        tmp->attack_s=p->amp.attack_s; tmp->decay_s=p->amp.decay_s;
+        tmp->release_s=p->amp.release_s;
+    }
+    tmp->sustain=filter_sustain(s,layer);
+    return tmp;
+}
