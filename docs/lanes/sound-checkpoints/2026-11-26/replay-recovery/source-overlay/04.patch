+static unsigned sj6_aux_route_detent(unsigned code)
+{
+    int id=sj6_aux_destination_id(code);
+    if(id<0)return 0;
+    unsigned shown=0;
+    for(unsigned j=SJ6_AUX_ORIGINAL_FIRST;j<=SJ6_AUX_ORIGINAL_LAST;++j){
+        int other=sj6_aux_destination_id(j);
+        if(other<0)continue;
+        ++shown;
+        if(id==other)return shown;
+    }
+    return 0;
+}
+static int sj6_aux_route_wire(unsigned detent)
+{
+    if(!detent)return 0;
+    for(unsigned j=SJ6_AUX_ORIGINAL_FIRST;j<=SJ6_AUX_ORIGINAL_LAST;++j)
+        if(sj6_aux_destination_id(j)>=0 && !--detent)return (int)j;
+    return -1;
+}
