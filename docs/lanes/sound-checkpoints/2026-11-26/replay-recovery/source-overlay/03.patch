+/* Whole-carrier canonical admission occurs at stage validation. Audio only
+   does a constant-size candidate check at the existing owner boundary. */
+static inline int live137(const sound_t *s,unsigned v) {
+ if(s!=&proj.sound || proj.set.snd_rev!=REV137 || v>=NBASS) return 0;
+ const uint8_t *r=read137(s,v);
+ return r[0]==137u && r[1]==v && r[2]<=127u &&
+        s->v[T_303][v][29]==ORIGINAL_SOUND_JUNO &&
+        !original_sound_sj6_factory(s->v[T_303][v]);
+}
+static inline int valid_rev137(unsigned r) {return r==PROJ_SND_REV || r==REV137;}
+
+static inline int s1_typed_init_cell(const uint8_t *b){
+ return b[29]==ORIGINAL_SOUND_SYNTHONE && !original_sound_s1_program(b);
+}
+static inline int live_s1_mod(const sound_t *s,unsigned v) {
+ if(s!=&proj.sound || proj.set.snd_rev!=REV137 || v>=NBASS)return 0;
+ const uint8_t *r=read137(s,v);
+ return r[0]==137u && r[1]==v && r[3]<=2 && s1_typed_init_cell(s->v[T_303][v]);
+}
