+    const uint8_t *head=(const uint8_t *)&s->v[s1_user_head_target(v)]+S1_USER_ROW*NPARAMS_MAX;
+    const uint8_t *tail=(const uint8_t *)&s->v[T_MIX]+s1_user_tail_row(v)*NPARAMS_MAX;
