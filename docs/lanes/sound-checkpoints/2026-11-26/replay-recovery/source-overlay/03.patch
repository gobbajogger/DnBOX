+/* SPDX-License-Identifier: GPL-3.0-only */
+/* DNR3 Remote protocol (REMOTE-FW-PROTOCOL v3.0): the firmware's entry points. The platform (usb.c on
+ * the device, the host harness or the web emulator) supplies remote_dnr3_out(). */
+#pragma once
+#include <stdint.h>
+
+/* 1: the firmware answers DNR3. host/x0x_host.c and x0x.c turn it on before ui.c; other units that
+ * pull ui.c or editor.c alone (host fixtures) keep it off and need no remote_dnr3.c. */
+#ifndef X0X_REMOTE_DNR3
+#define X0X_REMOTE_DNR3 0
+#endif
+
+int remote_dnr3_frame(const uint8_t *p, uint32_t n);    /* p: a SysEx frame without F0/F7. 0 handled, -1 not DNR */
+int remote_dnr3_frame_on(const uint8_t *p, uint32_t n, uint32_t wire); /* nonzero: BLE link epoch */
+void remote_dnr3_tick(uint32_t now_ms);                 /* main loop: lease, revision, notifications */
+void remote_dnr3_out(const uint8_t *frame, uint32_t n); /* platform: send one frame F0 .. F7, n <= 256 */
+/* firmware: a state change (main loop only). kind = NOTIFY kind, at = its address, one byte each from
+ * bit 0 (0 PARAM: kind,a,b,c, a pref_t; 1 STEP: part,pat,step; 127 = any); REMOTE_TOUCH_ALL: everything,
+ * the Remote re-reads. Rev bumps once per main-loop pass however many sites touch. */
+void remote_touch(int kind, uint32_t at);
+#define REMOTE_TOUCH_ALL 127
