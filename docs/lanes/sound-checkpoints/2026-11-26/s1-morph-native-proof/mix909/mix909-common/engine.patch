+#include "mix909.inc"
+__attribute__((noinline)) static int mix909_common(unsigned n)
+{
+    glide_t *s=mix_glide[PART_909];
+    float c=s[GL_L].cur,t=s[GL_L].tgt;
+    if ((c==1.f && t==1.f) || c!=c || t!=t ||
+        s[GL_REV].cur!=0.f || s[GL_REV].tgt!=0.f || s[GL_DLY].cur!=0.f || s[GL_DLY].tgt!=0.f) return 0;
+    unsigned bc=fm1_mix_bits(c),bt=fm1_mix_bits(t);
+    for(unsigned j=GL_R;j<GL_N;j++){
+        if(j==GL_REV||j==GL_DLY)continue;
+        if(fm1_mix_bits(s[j].cur)!=bc || fm1_mix_bits(s[j].tgt)!=bt)return 0;
+    }
+    part_peak[PART_909]=fm1_909_mix_common(dry_l,dry_r,rev,dly,n,&c,t,
+                    mix_level[PART_909],part_peak[PART_909]);
+    s[GL_L].cur=s[GL_R].cur=s[GL_VREV].cur=s[GL_VDLY].cur=c;
+    return 1;
+}
