+#include "mix909.inc"
+__attribute__((noinline)) static int mix909_settled(unsigned n)
+{
+    const glide_t *s=mix_glide[PART_909];
+    float g[GL_N];
+    for(unsigned j=0;j<GL_N;j++){
+        float c=s[j].cur;
+        if(c!=s[j].tgt)return 0;
+        g[j]=c;
+    }
+    if (g[GL_L]==1.f || g[GL_R]==1.f || g[GL_VREV]==1.f || g[GL_VDLY]==1.f)
+        return 0;                           /* original fast skips are cheaper at unity */
+    part_peak[PART_909]=fm1_909_mix_settled(dry_l,dry_r,rev,dly,n,g,
+                    mix_level[PART_909],part_peak[PART_909]);
+    return 1;
+}
