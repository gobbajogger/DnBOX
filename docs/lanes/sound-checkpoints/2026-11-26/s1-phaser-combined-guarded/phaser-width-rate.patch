+        const float a=dsp->fConst1*(0.f-(3.14159f*width));
+#if DNBOX_PH_FASTCTL
+        dsp->pole=ph_pole(a);
+#else
+        dsp->pole=exp(a);
+#endif
         dsp->tags[1]=w;
     }
     if(!dsp->valid||b!=dsp->tags[2]){
         const float angle=dsp->fConst2*bpm;
+#if DNBOX_PH_FASTCTL
+        ph_rotation(angle,&dsp->rsin,&dsp->rcos);
+#else
         dsp->rsin=sin(angle);dsp->rcos=cos(angle);
+#endif
         dsp->tags[2]=b;
     }
     dsp->valid=1;
