+++ b/firmware/src/dsp/drum909.c
@@ -36,7 +36,19 @@
 D9_INLINE float d9_triangle_diode(float x, float drive, float gain)
 {
     const float u = drive * x;
+#if X0X_TANH_SPLIT_LAB
+    /* All callers here supply the bounded triangle and drive at most 2. */
+    _Static_assert(2 * (int)X0X_TANH_SCALE + 2 <= X0X_TANH_LAB_SPLIT,
+                   "fixed-drive triangle uses only the head");
+    const float index = fm_fabsf(u) * X0X_TANH_SCALE;
+    const int32_t i=(int32_t)index;
+    const float f=index-(float)i;
+    const float a=x0x_tanh_lab_head[(unsigned)i];
+    const float b=x0x_tanh_lab_head[(unsigned)i+1u];
+    const float t=a+(b-a)*f;
+#else
     const float t = d9_tanh_table(fm_fabsf(u) * X0X_TANH_SCALE);
+#endif
     return (u < 0.0f ? -t : t) * gain;
 }
 D9_INLINE float d9_diode16(float x) { return d9_triangle_diode(x, 1.6f, D9_INV_TANH_1_6); }
