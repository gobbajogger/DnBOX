+    const float fr=abscoord-(float)i;
+    const float t0=x0x_tanh_lab_head[(unsigned)i];
+    const float t1=x0x_tanh_lab_head[(unsigned)i+1u];
+    const float result=t0+(t1-t0)*fr;
+#else
     const float result = d9_tanh_table(fm_fabsf(coordinate));
+#endif
     return (coordinate < 0.0f ? -result : result) * D9_INV_TANH_2_0;
