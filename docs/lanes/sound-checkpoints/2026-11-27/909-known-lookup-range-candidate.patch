         return d9_triangle_diode(d9_tri(phase), 2.0f, D9_INV_TANH_2_0);
     const uint32_t folded = phase ^ (uint32_t)((int32_t)phase >> 31);
     const float coordinate = (float)(int32_t)folded * 0x1p-22f - 256.0f;
+#if X0X_TANH_SPLIT_LAB
+    /* With the proved 128 scale path, integer folding and FP32 casting
+     * keep absolute coordinate in [0, 256], including the endpoint. */
+    _Static_assert(X0X_TANH_LAB_SPLIT >= 258, "both samples inside head");
+    const float abscoord=fm_fabsf(coordinate);
