+/* Exact Q8 no-edge admission: retain the original reaction at every boundary. */
+static unsigned s1_skip_quiet(S1Sequencer *s,const S1SequencerParams *p,int held,unsigned n)
+{
+    if(!n || n>256u || p->arpBeatsPerSample!=S1_SAMPLE_TICKS ||
+       s->previousHeldNoteNumbersAECount!=held) return 0;
+    if(p->arpIsOn!=1 && !s->sequencerLastNotesCount) return n;
+    uint32_t limit=p->arpSeqTempoMultiplier, beat=s->mBeatTime;
+    if(s->gateOpen){
+        uint32_t g=gateLength(s,p);
+        if(g<limit)limit=g;
+    }
+    if(beat>=limit)return 0;
+    const uint32_t span=(limit-1u-beat)>>8;
+    if(n>span)n=span;
+    s->mBeatTime=beat+(n<<8);
+    return n;
+}
