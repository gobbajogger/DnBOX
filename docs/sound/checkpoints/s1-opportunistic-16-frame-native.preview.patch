+    h->c2=c2;h->rvi=rvi;h->sr=s->sr;h->ftype=P(FTYPE);h->dict=P(DICT);
+    h->crg=P(CRG);h->cmg=P(CMG);h->cwg=P(CWG);h->rvfb=s->t[RVFB];
