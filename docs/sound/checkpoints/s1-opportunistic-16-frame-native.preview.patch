+        }
+        if(concurrent){while(wet_ready[qi])plat_cpu2_sync();plat_cpu2_sync();}
+        const unsigned last=first+16<n?first+16:n;
+        for(f=first;f<last;f++){
+#if S1C_FAST
+        int cu = (f & 3) == 0;
+#if S1C_CSM
+#if S1C_NO_SEQ
