+            s1u_crush *cr = &s->crush;
+            if (cr->idx <= cr->n) {
+#ifdef X0X_HOST
+                float bsr = (float)log2(P(BCSR)) + 4.0f*lfo01(s,crush_route);
+                s1u_crush_clock(cr,clampf((float)exp2(bsr),2048.0f,48000.0f),s->sr);
+#else
+                float bsr = log2f(P(BCSR)) + 4.0f*lfo01(s,crush_route);
+                s1u_crush_clock(cr,clampf(exp2f(bsr),2048.0f,48000.0f),s->sr);
+#endif
+                cr->v = y;
+                cr->idx += cr->inc;
+                cr->idx -= cr->n;
+                cr->n = 0.f;
+            } else y = cr->v;
+            cr->n += 1.f;
+        } else
+#endif
+        {
+#if S1C_FAST
+        if ((f & 7) == 0)
+#endif
+        {
+            float bsr = log2f(P(BCSR)) + 4.0f * lfo01(s, P(LBC));
+            s1u_crush_clock(&s->crush, clampf(exp2f(bsr), 2048.0f, 48000.0f), s->sr);
+        }
+        y = s1u_crush_run(&s->crush, y);
+        }
+        y *= lfo10(s, P(LTREM));
+        /* autopan, equal power */
+        float L, R;
+#if defined(X0X_S1_AUTOPAN_PROBE) && X0X_S1_AUTOPAN_PROBE
+        if(s->pan_authored) s1u_autopan_authored(&s->pan_ph, y, P(PANF), P(PANA), s->sr, &L, &R);
+        else
+#endif
+        s1u_autopan(&s->pan_ph, y, P(PANF), P(PANA), s->sr, &L, &R);
+        /* phaser */
+        s1u_phaser_run(&s->ph, &L, &R, P(PHMIX), P(PHRATE), P(PHW), P(PHFB), s->sr);
+        const unsigned t=f-first;
+        slot->samples[t].l=L;slot->samples[t].r=R;
+        slot->samples[t].verb_scale=lfo10(s,P(LRVMIX));
+        if(!(f&7u))slot->cut[t>>3]=P(CUT);
+        }
+
+        if(concurrent){
+            plat_cpu2_sync();
+            wet_ready[qi]=1;
+            plat_cpu2_sync();
+        } else consume_tile(h,slot,first);
+    }
+    if(concurrent)while(wet_phase!=2)plat_cpu2_sync();
+    if(seq){
+        plat_cpu2_sync(); wet_offer=0;
+        plat_cpu2_sync(); wet_current=0;
+    }
 }
