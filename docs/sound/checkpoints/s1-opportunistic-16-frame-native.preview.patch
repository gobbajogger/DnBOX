+/* Host-only experiment; room and delay now have independent histories.
+ * Step table is the existing DnBOX IMA codec table, GPL-3.0-only. */
+/* Existing target table and exact rounding primitive; stand-alone host
+ * component can instantiate a private table from the same canonical header. */
+#include "../ima_adpcm.h"
+typedef struct {
+  float y[8], interp[2][4];
+  uint16_t w[8];
+  int16_t pred[2][8];
+  uint8_t si[2][8], samples[1724];
+} rv8_owner;
+_Static_assert(sizeof(rv8_owner)<=S1C_RVB_BYTES,"independent reverb region");
+static const uint16_t rv8_lengths[8]={354,396,460,508,558,590,306,276};
+static __attribute__((noinline)) void rv8_step(unsigned c,int16_t *pred,uint8_t *index)
+{
+    int32_t p=*pred,i=*index;
+    (void)ima_decode_code(c,&p,&i);
+    *pred=(int16_t)p;*index=(uint8_t)i;
+}
+static unsigned rv8_encode(float x,int16_t *pred,uint8_t *ix){
+ x*=4096.f; int target=(int)(x< -32768.f?-32768.f:x>32767.f?32767.f:x);
+ int diff=target-*pred,k=IMA_STEP_T[*ix]; unsigned c=0;
+ if(diff<0){c=8;diff=-diff;}
+ if(diff>=k){c|=4;diff-=k;} if(diff>=k>>1){c|=2;diff-=k>>1;} if(diff>=k>>2)c|=1;
+ rv8_step(c,pred,ix); return c;
+}
+static void rv8(s1c *s,float il,float ir,float *ol,float *orr,float fb){
+ rv8_owner *q=(void *)s->rv.m; float pressure=0,l=0,r=0;
+ for(unsigned i=0;i<8;++i)pressure+=q->y[i];
+ pressure*=.25f;
+ const float taper=fb<.5f?fb*2.f:1.f, gain=fb+.29f*(1.f-fb)*taper;
+ unsigned at=0;
+ for(unsigned i=0;i<8;++i){
+  unsigned w=q->w[i], shift=(w&1u)*4u; uint8_t *n=&q->samples[at+(w>>1)];
+  rv8_step((*n>>shift)&15u,&q->pred[0][i],&q->si[0][i]);
+  float x=q->pred[0][i]*(1.f/4096.f);
+  unsigned code=rv8_encode(pressure+((i&1)?ir:il)-q->y[i],&q->pred[1][i],&q->si[1][i]);
+  *n=(uint8_t)((*n&~(15u<<shift))|(code<<shift));
+  x*=gain; x+=.171572875f*(q->y[i]-x); q->y[i]=x; if(i&1)r+=x;else l+=x;
+  q->w[i]=(uint16_t)(w+1u==rv8_lengths[i]?0:w+1u);at+=rv8_lengths[i]>>1;
+ }
+ *ol=.35f*l;*orr=.35f*r;
+}
+
+/* Four cheap one-poles suppress reconstructed multirate images, not dry. */
+static float rv8_antimage(s1c *s, unsigned channel,float input)
+{
+    rv8_owner *q=(void *)s->rv.m;
+    float *z=q->interp[channel];
+    for(unsigned i=0;i<4;++i){z[i]+=.38f*(input-z[i]);input=z[i];}
+    return input;
+}
