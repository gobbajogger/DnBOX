+/* Core 0 only, from the existing ordered-mix wait. The producer owns all
+ * wet history until it acknowledges this same offer between whole tiles. */
+__attribute__((noinline,minsize)) void s1_diagnostic_try_wet(void)
+{
+    const uint32_t seq=wet_offer;
+    if(!seq || wet_request==seq)return;
+    wet_request=seq;
+    while(wet_offer==seq && !wet_phase && plat_cpu2_busy()>0)
+        plat_cpu2_sync();
+    if(wet_offer!=seq || wet_phase!=1)return;
+    plat_cpu2_sync();
+    const s1_wet_job *j=wet_current;
+    const unsigned n=j->header.n;
+    for(unsigned f=wet_start;f<n;f+=16u){
+        const unsigned q=(f>>4)&1u;
+        while(!wet_ready[q]){
+            if(plat_cpu2_busy()<=0){++lab_wet_native[3];return;}
+            plat_cpu2_sync();
+        }
+        plat_cpu2_sync();
+        consume_tile(&j->header,&j->slots[q],f);
+        ++lab_wet_native[2];
+        plat_cpu2_sync();
+        wet_ready[q]=0;
+        plat_cpu2_sync();
+    }
+    wet_phase=2;plat_cpu2_sync();
+}
+__attribute__((minsize)) void s1c_render(s1c *s, float *outl, float *outr, unsigned n)
+{
+    unsigned f, i;
+#if X0X_S1_DELAY_HISTORY_NATIVE
+    /* Existing boot/inactive paths may render before FX is attached. The
+     * real fixed-arena device binds before audio; keep a dry fallback. */
+    if(s->pool && s->pool_bytes>=60){
+        if(!s->ddec){
+            uint32_t mix;
+            __builtin_memcpy(&mix, &s->t[RVMIX], sizeof mix);
+            /* attach cleared the whole shared room arena. Adopt only on
+             * first partition of the immutable authored program, not on
+             * live mix/enable/delay edits. Floats here use canonical [0,1]. */
+            if(mix && mix<=0x3f800000u && s->rv.fb==-1.f && s->t[DLON]==0.f && s->t[RVON]!=0.f)
