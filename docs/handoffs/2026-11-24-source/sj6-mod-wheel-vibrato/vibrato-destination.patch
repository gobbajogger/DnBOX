+int juno6_set_mod_destination(juno6_t *s,unsigned selected)
+{
+    if (selected==6u) selected=0; /* Build-9 final segment aliases the default. */
+    if (!s || !s->typed || selected>1u) return 0;
+    s->mod_destination=(uint8_t)selected;
+    return 1;
+}
