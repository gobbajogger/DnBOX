+/* SPDX-License-Identifier: GPL-3.0-only */
+#pragma once
+#include "sj6_note_amp.h"
+
+/* Intentionally no defaults/stubs. Product must leave the opt-in disabled
+ * until a complete receiver implements this interface. Called under the
+ * existing audio/capture serialization. No allocating, blocking or edits. */
+enum { SJ6_NOTE_AMP_UNAVAILABLE = -1, SJ6_NOTE_AMP_ABSENT = 0, SJ6_NOTE_AMP_PRESENT = 1 };
+int sj6_note_amp_snapshot(unsigned owner, int effective, sj6_note_amp_t *out);
+/* Atomic nonfallible receiver adoption after the old cell/extra/mix writes,
+ * without invoking ordinary link-ON semantics or writing any stored base.
+ * NULL clears the applied overlay to the receiver-owned base. */
+void sj6_note_amp_apply(unsigned owner, const sj6_note_amp_t *snapshot);
