+/* Host witness. Search only A/B candidates in the same recognized typed
+ * wire. The streams that matter are those actually consumed by LZ. */
+static int read_typed_tuple(project_t *pr,unsigned mask,uint8_t independent_bt)
+{
+    settings_t set;
+    stream_previous=(uint8_t)mask;
+    int rc=load_settings(&set);
+    if (rc || set.snd_rev!=REV137) return -9;
+    uint8_t part_off=io_buf[4u+sizeof set];
+    pr->set=set;
+    *part_off_of(pr)=part_off;
+    rc=load_sound(&pr->sound,REV137);
+    if (rc) return -9;
+    int n=load_stream_object(0);
+    if (n<(int)STREAM_HDR || get32(io_buf)!=STREAM137) return -9;
+    rc=load_stream(pr,n,STREAM137);
+    if (rc) return rc;
+    pr->set.bt=(uint8_t)((pr->set.bt&~1u)|(independent_bt&1u));
+    return project_validate_for(pr);
+}
