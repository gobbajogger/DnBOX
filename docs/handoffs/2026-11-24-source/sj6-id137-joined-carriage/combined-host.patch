+/* Disposable HOST proof only. No shipping opt-in. */
+#if !defined(X0X_HOST) || !defined(DNBOX_137_HOST_WITNESS)
+#error Host-only witness
+#endif
+#pragma once
+#include "x0x.h"
+enum { REV137=0x70u, SOUND137=0x584a3656u, STREAM137=16u, NOTE137=2u };
+static inline uint8_t *slot137(sound_t *s,unsigned v) {return s->v[T_303][8+2*v];}
+static inline const uint8_t *read137(const sound_t *s,unsigned v) {return s->v[T_303][8+2*v];}
+static inline int canonical137(const sound_t *s) {
+ for (unsigned v=0;v<2;++v) {
+  const uint8_t *b=read137(s,v);
+  if (b[0]!=137 || b[1]!=v || b[2]>127) return 0;
+  for(unsigned i=3;i<64;i++) if (s->v[T_303][8+2*v+i/32][i%32]) return 0;
+ }
+ return 1;
+}
+/* Whole-carrier canonical admission occurs at stage validation. Audio only
+   does a constant-size candidate check at the existing owner boundary. */
+static inline int live137(const sound_t *s,unsigned v) {
+ if(s!=&proj.sound || proj.set.snd_rev!=REV137 || v>=NBASS) return 0;
+ const uint8_t *r=read137(s,v);
+ return r[0]==137u && r[1]==v && r[2]<=127u &&
+        s->v[T_303][v][29]==ORIGINAL_SOUND_JUNO &&
+        !original_sound_sj6_factory(s->v[T_303][v]);
+}
+static inline int valid_rev137(unsigned r) {return r==PROJ_SND_REV || r==REV137;}
