+#!/bin/sh
+# Full production UI/project/engine + SMC input/render regression. No device I/O.
+# Optional CC, SAN_FLAGS, SMC_UI_OUT and SMC_UI_SOURCE_FILE support independent replay.
+set -eu
+# These inventories describe the shipping Elite/Pro Synth One pages.
+case ${SMC_UI_TEST_FILE:-} in
+    tests/ui_geometry/capture.c|tests/host/ui_screen_walk.c)
+        export X0X_SYNTHONE_PATCH=1
+        X0X_HOST_DEFS="${X0X_HOST_DEFS:-} -DX0X_SYNTHONE_PATCH=1"
+        ;;
+esac
+OUT=${SMC_UI_OUT:-build/host/smc-ui}
+mkdir -p "$OUT"
+awk '/^static const char CK_FLD_N\[\] = /{print}
+     /^static uint32_t ck_page_on\(void\)$/ || /^int smk_ck_smc_(turn|nav)\(/{on=1}
+     on{print} on && /^}/{on=0}' firmware/src/app/main_fm1.c > "$OUT/clip_smc.inc"
+test -s "$OUT/clip_smc.inc"
+test -s build/gen/x0x_break_bank.h
+. tests/host/original_build.sh
+U=$ORIGINAL_SOURCES
+DARWIN=
+[ "$(uname -s)" != Darwin ] || DARWIN=-D_DARWIN_C_SOURCE
+# Linux host needs POSIX clock APIs from x0x_host.c under -std=c99.
+POSIX_DEFS=-D_POSIX_C_SOURCE=200809L
+SOURCE=${SMC_UI_SOURCE_FILE:-$PWD/firmware/src/app/smc_mixer.c}
+# shellcheck disable=SC2086
+${CC:-cc} -O0 -ffp-contract=off -std=c99 -Wall -Wextra -Wno-unused-function -Wno-unused-parameter \
+    -DX0X_HOST $POSIX_DEFS $DARWIN ${X0X_HOST_DEFS:-} ${SAN_FLAGS:-} \
+    -DSMC_SOURCE_FILE=\"$SOURCE\" -Ifirmware/src -Ifirmware/src/app -Ifirmware/src/dsp -Ibuild/gen -I"$OUT" \
+    ${SMC_UI_TEST_FILE:-tests/host/smc_ui_test.c} $ORIGINAL_FLAGS $U -lm -o "$OUT/test"
+SMC_UI_SHOTS="$OUT" "$OUT/test"
diff --git a/tests/host/sj6_sync_oracle.h b/tests/host/sj6_sync_oracle.h
new file mode 100644
index 0000000000000000000000000000000000000000..1726e18355e88304969fd4718d0c44ce683f91a3
--- /dev/null
+++ b/tests/host/sj6_sync_oracle.h
@@ -0,0 +1,19 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#pragma once
+#include <math.h>
+
+/* Independent host calculation of the pinned Build-9 staged binary32 law. */
+static float sync_reference(float raw, float bpm, unsigned *division)
+{
+    static const float factor[] = {
+        64, 48, 32, 24, 16, 12, 8, 6, 4, 3, 2, 1.5f,
+        1, .5f, .3333f, .25f, .1667f, .125f
+    };
+    volatile float reversed = 1.f - raw;
+    volatile float index = reversed * 17.f;
+    unsigned stop = (unsigned)floorf(index + .5f);
+    if (division) *division = stop;
+    volatile float quarter_notes = bpm / 60.f;
+    volatile float rate = quarter_notes * factor[stop];
+    return rate / 4.f;
+}
