index 0000000000000000000000000000000000000000..c7178230c02821ba7dcb8dd91f6b7312e3bbecbf
--- /dev/null
+++ b/tests/host/ui_arp_keyboard_test.c
@@ -0,0 +1,95 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#define X0X_ARP_KEYBOARD_TEST 1
+#define ARP_FIXTURE_MAIN retained_arp_fixture_main
+#include "ui_arp_engine_test.c"
+
+static uint32_t test_pads;
+static uint64_t test_keyboard;
+uint32_t plat_arp_input(uint64_t *keyboard)
+{
+    *keyboard = test_keyboard;
+    return test_pads;
+}
+static void gesture(uint32_t pads, uint64_t keyboard)
+{
+    test_pads = pads;
+    test_keyboard = keyboard;
+    held_keys = pads | (uint32_t)(keyboard >> 5);
+    ++now_ms;
+    input();
+    render(4);
+}
+static void keyboard_case(int kind)
+{
+    const unsigned owner = 0;
+    const uint32_t step = 1u << WHITE_KEY[5];
+    const uint64_t e = UINT64_C(1) << (52 - 36);
+    const uint64_t c = UINT64_C(1) << (48 - 36);
+    engine_arp_steps before, after;
+    uint8_t peer[ARP_BLOCK_BYTES];
+    engine_arp_cfg saved;
+    engine_arp_settings settings;
+    setup(V_SEQ, PART_303A);
+    EXPECT(!engine_bass_select_preset(owner, kind, 0, &proj.sound));
+    for (int n=0; n<1024 && engine_bass_preset_pending(owner); ++n) render(1);
+    EXPECT(engine_bass_bank(owner)==kind);
+    *page_of(V_SEQ)=3;
+    ui.oct=0;
+    build_pages();
+    EXPECT(arp_seq_page());
+    EXPECT(engine_arp_settings_read(owner,&settings));
+    const unsigned gate=settings.gate;
+    gesture(0,0);
+    EXPECT(engine_arp_steps_read(owner,&before));
+    memcpy(peer, proj.sound.v[T_303][ARP_BLOCK_VOICE0+1], sizeof peer);
+    gesture(0,c); /* no write from a key alone */
+    gesture(step,c); /* do not capture a key that was already down */
+    EXPECT(engine_arp_steps_read(owner,&after) && after.offset[5]==before.offset[5]);
+    gesture(step,0);
+    gesture(step,e);
+    EXPECT(engine_arp_steps_read(owner,&after) && after.offset[5]==4);
+    gesture(step,0);
+    gesture(step,UINT64_C(1) << (WHITE_KEY[5]+5)); /* same alias as the held pad */
+    EXPECT(engine_arp_steps_read(owner,&after) && after.offset[5]==41+WHITE_KEY[5]-48);
+    gesture(0,UINT64_C(1) << (WHITE_KEY[5]+5)); /* releasing pad before the key is safe */
+    gesture(0,0);
+    EXPECT(engine_arp_steps_read(owner,&after) && after.on_mask==before.on_mask);
+    EXPECT(engine_arp_block_decode(proj.sound.v[T_303][ARP_BLOCK_VOICE0],&saved) &&
+           saved.offset[5]==after.offset[5] && saved.on_mask==before.on_mask);
+    for (int i=0; i<ARP_STEPS; ++i)
+        if (i!=5) EXPECT(after.offset[i]==before.offset[i]);
+    EXPECT(!memcmp(peer, proj.sound.v[T_303][ARP_BLOCK_VOICE0+1], sizeof peer));
+    gesture(step,0); gesture(0,0);
+    EXPECT(engine_arp_steps_read(owner,&after) && after.on_mask==(before.on_mask ^ (1u<<5)));
+    unsigned off_mask=after.on_mask;
+    gesture(step,0);
+    gesture(step,UINT64_C(1)<<36); /* High end of the physical keybed, beyond central lanes */
+    gesture(0,0);
+    EXPECT(engine_arp_steps_read(owner,&after) &&
+           after.offset[5]==(kind==ORIGINAL_SOUND_JUNO?24:12) && after.on_mask==off_mask);
+    EXPECT(engine_arp_settings_read(owner,&settings) && settings.gate==gate);
+    EXPECT(pg.r[cur_page()][2].kind==R_ARP && pg.r[cur_page()][2].a==ARP_F_GATE);
+    now_ms += 160;
+    turn(2, gate > 1u ? -1 : 1);
+    unsigned adjusted_gate = gate > 1u ? gate - 1u : gate + 1u;
+    EXPECT(engine_arp_settings_read(owner,&settings) && settings.gate==adjusted_gate);
+    EXPECT(engine_arp_block_decode(proj.sound.v[T_303][ARP_BLOCK_VOICE0],&saved) &&
+           saved.gate==adjusted_gate && saved.on_mask==off_mask);
+    gesture(step,0);
+    set_view(V_PART);
+    gesture(step,e); /* no capture in a different view */
+    set_view(V_SEQ);
+    *page_of(V_SEQ)=3;build_pages();
+    gesture(step,e); /* pre-held pad does not re-arm on re-entry */
+    gesture(0,0);
+    EXPECT(engine_arp_steps_read(owner,&after) &&
+           after.offset[5]==(kind==ORIGINAL_SOUND_JUNO?24:12) && after.on_mask==off_mask);
+}
+int main(void)
+{
+    keyboard_case(ORIGINAL_SOUND_JUNO);
+    keyboard_case(ORIGINAL_SOUND_SYNTHONE);
+    if (failures) return 1;
+    printf("PASS ARP SEQ held-pad keyboard pitch: %u checks\n",expectations);
+    return 0;
+}
diff --git a/tests/host/ui_superj6_envelopes_test.c b/tests/host/ui_superj6_envelopes_test.c
new file mode 100644
index 0000000000000000000000000000000000000000..bf9751068454c0dcbb9333e3f2c72a4a911865a7
--- /dev/null
+++ b/tests/host/ui_superj6_envelopes_test.c
@@ -0,0 +1,260 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#define ARP_FIXTURE_MAIN retained_arp_main
+#include "ui_arp_engine_test.c"
+
+enum { FRAMES = 8192, BLOCK = 256 };
+static int32_t pcm[3][FRAMES * 2];
+
+static void select_part(unsigned owner)
+{
+    setup(V_PART, PART_303A + owner);
+    proj.set.bt |= PROJ_BT_CLK_IN;
+    CHECK(!engine_bass_select_preset(owner, ORIGINAL_SOUND_JUNO, 0, &proj.sound));
+    for (unsigned n = 0; n < 1024 && engine_bass_preset_pending(owner); ++n) render(1);
+    CHECK(engine_bass_bank(owner) == ORIGINAL_SOUND_JUNO);
+    build_pages();
+}
+
+static void visit(const char *title)
+{
+    CHECK(page_named(title) >= 0);
+    for (int i = 0; i < pg.n; ++i) {
+        if (!strcmp(pg.title[cur_page()], title)) return;
+        now_ms += 160;
+        enc_acc[EN_SELECT] = 1;
+        input();
+    }
+    CHECK(0);
+}
+
+static void move(unsigned knob, int position, unsigned slot)
+{
+    pref_t p = pg.r[cur_page()][knob];
+    CHECK(p.kind == R_SJ6KNOB && p.c == slot);
+    int detents = position - pref_get(p);
+    now_ms += 160u + 70u * (unsigned)abs(detents);
+    turn(knob, detents);
+    CHECK(pref_get(p) == position);
+}
+
+static juno6_envelope_snapshot envelope(unsigned owner, unsigned filter, unsigned expected_link)
+{
+    juno6_envelope_snapshot out;
+    unsigned link;
+    CHECK(engine_superj6_panel_envelope(owner, filter, &out, &link) && link == expected_link);
+    return out;
+}
+
+static unsigned delta(const int32_t *a, const int32_t *b)
+{
+    unsigned result = 0;
+    for (unsigned i = 0; i < FRAMES * 2; ++i) result += a[i] != b[i];
+    return result;
+}
+
+static void capture(unsigned owner, int32_t *out)
+{
+    engine_apply_sound(&proj.sound);
+    render(4);
+    engine_bass_on(owner, 57, 0, 0);
+    for (unsigned i = 0; i < FRAMES; i += BLOCK) {
+        if (i == FRAMES / 2) engine_bass_off(owner);
+        engine_render(out + i * 2, BLOCK);
+    }
+    render(256);
+}
+
+static void check_adsrs(unsigned owner)
+{
+    const unsigned origins[] = {SJ6_AMP_ATTACK, SJ6_FILTER_ATTACK};
+    const char *pages[] = {"AMP ADSR", "FILTER ADSR"};
+    const int values[] = {7, 11, 82, 15};
+    for (unsigned f = 0; f < 2; ++f) {
+        visit(pages[f]);
+        CHECK(adsr_stage_slots(cur_page(), NULL) == 15);
+        for (unsigned i = 0; i < 4; ++i) move(i, values[i], origins[f] + i);
+    }
+    for (unsigned f = 0; f < 2; ++f) {
+        visit(pages[f]);
+        for (unsigned i = 0; i < 4; ++i) {
+            capture(owner, pcm[0]);
+            move(i, values[i] + 14, origins[f] + i);
+            capture(owner, pcm[1]);
+            unsigned changed = delta(pcm[0], pcm[1]);
+            CHECK(changed > 64);
+            printf("owner=%u %s stage=%u changed PCM samples=%u/%u\n",
+                   owner, pages[f], i, changed, FRAMES * 2);
+            move(i, values[i], origins[f] + i);
+        }
+    }
+}
+
+static void check_link(unsigned owner)
+{
+    visit("FILTER ADSR");
+    move(2, 36, SJ6_FILTER_SUSTAIN);
+    capture(owner, pcm[2]); /* Exact independent contour to restore. */
+    juno6_envelope_snapshot remembered = envelope(owner, 1, 0);
+    visit("FILTER");
+    memcpy(pcm[0], pcm[2], sizeof pcm[0]);
+    engine_bass_on(owner, 57, 0, 0);
+    render(38);
+    juno6_envelope_snapshot before = envelope(owner, 1, 0);
+    CHECK(before.active && before.gate && before.stage == 3 && before.level == remembered.adsr[2]);
+    move(3, 1, SJ6_FILTER_LINK);
+    juno6_envelope_snapshot amp = envelope(owner, 0, 1);
+    juno6_envelope_snapshot filter = envelope(owner, 1, 1);
+    CHECK(filter.stage == 3 && filter.level == amp.level && filter.level != before.level);
+    CHECK(!memcmp(filter.adsr, remembered.adsr, sizeof filter.adsr));
+    engine_set(T_303, owner, 7, 103); /* Previously stored AMP sustain automation. */
+    render(4);
+    amp = envelope(owner, 0, 1);
+    filter = envelope(owner, 1, 1);
+    CHECK(filter.level == amp.level && !memcmp(filter.adsr, remembered.adsr, sizeof filter.adsr));
+
+    visit("FILTER ADSR");
+    move(2, 26, SJ6_FILTER_SUSTAIN);
+    filter = envelope(owner, 1, 1);
+    CHECK(filter.level == amp.level && filter.adsr[2] != remembered.adsr[2]);
+    visit("AMP ADSR");
+    move(2, 94, SJ6_AMP_SUSTAIN);
+    amp = envelope(owner, 0, 1);
+    filter = envelope(owner, 1, 1);
+    CHECK(amp.stage == 3 && amp.level == amp.adsr[2] && filter.level == amp.level);
+    visit("FILTER ADSR");
+    move(2, 36, SJ6_FILTER_SUSTAIN);
+    visit("AMP ADSR");
+    move(2, 82, SJ6_AMP_SUSTAIN);
+    engine_bass_off(owner);
+    render(256);
+    capture(owner, pcm[1]);
+    CHECK(delta(pcm[0], pcm[1]) > 1000);
+    CHECK(!ui_project_save());
+    sound_t saved = proj.sound;
+    CHECK(!project_load() && !memcmp(&saved, &proj.sound, sizeof saved));
+    capture(owner, pcm[0]);
+    CHECK(!delta(pcm[0], pcm[1]));
+    filter = envelope(owner, 1, 1);
+    CHECK(!memcmp(filter.adsr, remembered.adsr, sizeof filter.adsr));
+
+    engine_bass_on(owner, 57, 0, 0);
+    render(38);
+    visit("FILTER");
+    move(3, 0, SJ6_FILTER_LINK);
+    filter = envelope(owner, 1, 0);
+    CHECK(filter.active && filter.gate && filter.stage == 3 && filter.level == remembered.adsr[2]);
+    CHECK(!memcmp(filter.adsr, remembered.adsr, sizeof filter.adsr));
+    engine_bass_off(owner);
+    render(256);
+    capture(owner, pcm[0]);
+    CHECK(!delta(pcm[0], pcm[2]));
+    CHECK(!ui_project_save() && !project_load());
+    capture(owner, pcm[1]);
+    CHECK(!delta(pcm[0], pcm[1]));
+    printf("owner=%u held LINK ON/OFF and sustain, retained FILTER, exact linked and unlinked reload PCM\n", owner);
+}
+
+static void check_timed_and_history(unsigned owner)
+{
+    visit("AMP ADSR");
+    move(0, 48, SJ6_AMP_ATTACK);
+    engine_bass_on(owner, 57, 0, 0);
+    render(4);
+    juno6_envelope_snapshot before = envelope(owner, 0, 0);
+    CHECK(before.active && before.gate && before.stage == 1);
+    move(0, 0, SJ6_AMP_ATTACK);
+    juno6_envelope_snapshot changed = envelope(owner, 0, 0);
+    CHECK(changed.stage == 1 && changed.level > before.level && changed.adsr[0] == .002f);
+    engine_bass_off(owner);
+    render(256);
+    engine_bass_on(owner, 57, 0, 0);
+    render(4);
+    changed = envelope(owner, 0, 0);
+    CHECK(changed.active && changed.gate && changed.stage != 1);
+    engine_bass_off(owner);
+    render(256);
+    move(0, 7, SJ6_AMP_ATTACK);
+
+    visit("FILTER ADSR");
+    move(2, 31, SJ6_FILTER_SUSTAIN);
+    undo_commit_stable();
+    move(2, 37, SJ6_FILTER_SUSTAIN);
+    do_undo(0);
+    CHECK(engine_superj6_knob_position(owner, SJ6_FILTER_SUSTAIN) == 31);
+    do_undo(1);
+    CHECK(engine_superj6_knob_position(owner, SJ6_FILTER_SUSTAIN) == 37);
+    move(2, 82, SJ6_FILTER_SUSTAIN);
+    printf("owner=%u running attack retains entry rate, retrigger uses new rate, undo/redo recalls FILTER sidecar\n", owner);
+}
+
+static void check_note_lock(unsigned owner)
+{
+    const unsigned pat = 4;
+    bpart_t *line = &proj.pat[pat].bass[owner];
+    for (unsigned i = 0; i < NSTEPS; ++i) line->step[i].flags = G_REST;
+    line->len = 16;
+    line->rate = RATE_16;
+    line->dir = DIR_FWD;
+    line->transpose = 24;
+    line->step[0].flags = line->step[4].flags = G_NOTE;
+    line->step[0].note = 36;
+    line->step[4].note = 43;
+    line->step[0].velocity = line->step[4].velocity = 100;
+    engine_note_lock_capture(1);
+    CHECK(!engine_bass_note_capture(proj.arr.lane, pat, owner, 0, &proj.sound));
+    engine_note_lock_capture(0);
+    engine_note_lock_refresh();
+
+    visit("FILTER");
+    move(3, 1, SJ6_FILTER_LINK);
+    CHECK(!project_save() && !project_load());
+    engine_apply_sound(&proj.sound);
+    seq.ppat[TRK_BASS0 + owner] = pat;
+    seq_start(&seq);
+    unsigned linked = 1;
+    juno6_envelope_snapshot state;
+    for (unsigned n = 0; n < 2000 && linked; ++n) {
+        render(1);
+        CHECK(engine_superj6_panel_envelope(owner, 1, &state, &linked));
+    }
+    CHECK(!linked);
+    CHECK(!engine_superj6_knob_turn(owner, SJ6_FILTER_LINK, 1, 0));
+    seq_stop(&seq);
+    render(256);
+    state = envelope(owner, 1, 1);
+    CHECK(state.adsr[2] > .28f && state.adsr[2] < .29f);
+    move(3, 0, SJ6_FILTER_LINK);
+    printf("owner=%u saved note lock applied captured LINK OFF and transport stop restored base LINK ON\n", owner);
+}
+
+static void journey(unsigned owner)
+{
+    select_part(owner);
+    uint8_t peer[NPARAMS_MAX], peer_extra[NPARAMS_MAX], arp[NPARAMS_MAX];
+    memcpy(peer, proj.sound.v[T_303][1-owner], sizeof peer);
+    memcpy(peer_extra, proj.sound.v[T_303][ORIGINAL_SJ6_EXTRA_ROW + 1-owner], sizeof peer_extra);
+    memcpy(arp, proj.sound.v[T_303][ARP_BLOCK_VOICE0 + owner], sizeof arp);
+    check_adsrs(owner);
+    check_timed_and_history(owner);
+    check_link(owner);
+    check_note_lock(owner);
+    CHECK(!memcmp(peer, proj.sound.v[T_303][1-owner], sizeof peer));
+    CHECK(!memcmp(peer_extra, proj.sound.v[T_303][ORIGINAL_SJ6_EXTRA_ROW + 1-owner], sizeof peer_extra));
+    CHECK(!memcmp(arp, proj.sound.v[T_303][ARP_BLOCK_VOICE0 + owner], sizeof arp));
+    CHECK(engine_superj6_knob_turn(owner, SJ6_FILTER_LINK, 1, 0));
+    CHECK(project_save() == -8);
+    CHECK(!engine_bass_select_preset(owner, ORIGINAL_SOUND_JUNO, 1, &proj.sound));
+    for (unsigned n = 0; n < 1024 && engine_bass_preset_pending(owner); ++n) render(1);
+    CHECK(!engine_bass_preset_pending(owner));
+    CHECK(!original_sound_edit_mask(proj.sound.v[T_303][owner]));
+    CHECK(!engine_superj6_knob_position(owner, SJ6_FILTER_LINK));
+    CHECK(!original_sound_sj6_extra_mask(proj.sound.v[T_303][ORIGINAL_SJ6_EXTRA_ROW + owner]));
+}
+
+int main(void)
+{
+    journey(0);
+    journey(1);
+    printf("PASS SuperJ6 ADSR and LINK %u checks\n", checks);
+    return 0;
+}
diff --git a/tests/host/ui_superj6_hz_test.c b/tests/host/ui_superj6_hz_test.c
new file mode 100644
index 0000000000000000000000000000000000000000..9fc6418474d6b1b815cd6f07178583e6314886e3
--- /dev/null
+++ b/tests/host/ui_superj6_hz_test.c
@@ -0,0 +1,251 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#define ARP_FIXTURE_MAIN retained_arp_main
+#include "ui_arp_engine_test.c"
+#include "sj6_sync_oracle.h"
+
+#define TURN_Q40 (UINT64_C(1) << 40)
+static const unsigned ids[] = {88, 96, 100, 195, 196, 197};
+
+static uint32_t bits(float f)
+{
+    uint32_t u;
+    memcpy(&u, &f, sizeof u);
+    return u;
+}
+static float word(uint32_t u)
+{
+    float f;
+    memcpy(&f, &u, sizeof f);
+    return f;
+}
+static void select_owner(unsigned owner, unsigned preset)
+{
+    CHECK(!engine_bass_select_preset(owner, ORIGINAL_SOUND_JUNO, preset, &proj.sound));
+    for (unsigned n = 0; n < 1024 && engine_bass_preset_pending(owner); ++n) render(1);
+    CHECK(engine_bass_bank(owner) == ORIGINAL_SOUND_JUNO && !engine_bass_preset_pending(owner));
+}
+static juno6_lfo_view lfo(unsigned owner, unsigned index)
+{
+    juno6_lfo_view out;
+    CHECK(engine_superj6_lfo_view(owner, index, &out));
+    return out;
+}
+static void visit_lfo(void)
+{
+    build_pages();
+    for (unsigned i = 0; i < (unsigned)pg.n; ++i) {
+        if (!strcmp(pg.title[cur_page()], "LFO RATE")) return;
+        now_ms += 160;
+        enc_acc[EN_SELECT] = 1;
+        input();
+    }
+    CHECK(0);
+}
+static void move_rate(unsigned index, int position)
+{
+    pref_t ref = pg.r[cur_page()][index];
+    CHECK(ref.kind == R_SJ6KNOB && ref.c == SJ6_LFO1_RATE + index);
+    int detents = position - pref_get(ref);
+    now_ms += 160u + (unsigned)abs(detents) * 70u;
+    enc_acc[EN_K1 + index] = detents;
+    input();
+    CHECK(pref_get(ref) == position && project_save() == -8);
+}
+static uint64_t advance(uint64_t phase, float hz)
+{
+    uint32_t step = (uint32_t)(hz * ((float)TURN_Q40 / 44100.f) + .5f);
+    return (phase + (uint64_t)step * 256u) & (TURN_Q40 - 1u);
+}
+static void sounding_block(void)
+{
+    int32_t pcm[512], nonzero = 0;
+    engine_render(pcm, 256);
+    for (unsigned i = 0; i < 512; ++i) nonzero |= pcm[i];
+    CHECK(nonzero);
+}
+static void check_panel(unsigned owner)
+{
+    const int positions[] = {32, 64, 127};
+    setup(V_PART, PART_303A + owner);
+    proj.set.bt |= PROJ_BT_CLK_IN;
+    select_owner(owner, 0);
+    select_owner(1-owner, 0);
+    uint8_t peer[NPARAMS_MAX];
+    memcpy(peer, proj.sound.v[T_303][1-owner], sizeof peer);
+    visit_lfo();
+    engine_bass_on(owner, 57, 0, 0);
+    render(8);
+    float hz[3];
+    for (unsigned i = 0; i < 3; ++i) {
+        CHECK(!lfo(owner, i).present);
+        move_rate(i, positions[i]);
+        CHECK(!lfo(owner, i).present);
+        sounding_block();
+        juno6_lfo_view after = lfo(owner, i);
+        float raw = positions[i] * (1.f / 127.f);
+        CHECK(after.present == 3u && after.mode == 1.f && bits(after.rate) == bits(raw));
+        CHECK(fabsf(after.hz - 16.f * powf(raw, 3.33f)) < .001f);
+        CHECK(after.phase == advance(0, after.hz) && after.phase);
+        hz[i] = after.hz;
+        CHECK(!lfo(1-owner, i).present);
+        printf("owner=%u LFO%u SMK position=%d Hz=%.8f phase=%llu after 256 sounding frames\n",
+               owner, i + 1u, positions[i], hz[i], (unsigned long long)after.phase);
+    }
+    juno6_lfo_view prior = lfo(owner, 0);
+    move_rate(0, 1);
+    sounding_block();
+    juno6_lfo_view slow = lfo(owner, 0);
+    CHECK(slow.phase != prior.phase && slow.phase == advance(prior.phase, slow.hz));
+    move_rate(0, 0);
+    render(1);
+    uint64_t stopped = lfo(owner, 0).phase;
+    render(2);
+    CHECK(lfo(owner, 0).phase == stopped);
+    move_rate(0, positions[0]);
+    render(1);
+    engine_bass_off(owner);
+    render(256);
+    CHECK(!ui_project_save());
+    sound_t saved = proj.sound;
+    CHECK(!project_load() && !memcmp(&saved, &proj.sound, sizeof saved));
+    engine_apply_sound(&proj.sound);
+    for (unsigned i = 0; i < 3; ++i) CHECK(lfo(owner, i).hz == hz[i] && !lfo(owner, i).phase);
+    CHECK(!memcmp(peer, proj.sound.v[T_303][1-owner], sizeof peer));
+    select_owner(owner, 1);
+    for (unsigned i = 0; i < 3; ++i) CHECK(!lfo(owner, i).present);
+    printf("owner=%u Hz panel save/reload, phase continuity, zero, smallest detent, peer and replacement PASS\n", owner);
+}
+static sj6_factory_row factory_row(const uint32_t input[6], unsigned mask)
+{
+    const unsigned core_ids[] = {119, 120, 121, 122, 0, 82, 83};
+    sj6_factory_row row = {0};
+    for (unsigned i = 0; i < sizeof core_ids / sizeof *core_ids; ++i)
+        sj6_factory_add_word(&row, core_ids[i], UINT32_C(0x3f000000));
+    for (unsigned i = 0; i < 6; ++i) if (mask & (1u << i)) {
+        sj6_factory_add_word(&row, ids[i], input[i]);
+        sj6_factory_add_word(&row, ids[i], UINT32_C(0x7fc00000));
+    }
+    return row;
+}
+static void exact(unsigned owner, const uint32_t words[6], unsigned mask)
+{
+    const uint8_t *cell = proj.sound.v[T_303][owner];
+    const uint8_t *extra = proj.sound.v[T_303][ORIGINAL_SJ6_EXTRA_ROW + owner];
+    juno6_lfo_words stored;
+    CHECK(!!(original_sound_edit_mask(cell) & ORIGINAL_SJ6_AUTHORED_LFO_BIT) == !!mask);
+    if (mask) CHECK(original_sound_sj6_lfo_words(extra, &stored) && stored.present == mask);
+    for (unsigned i = 0; i < 3; ++i) {
+        juno6_lfo_view v = lfo(owner, i);
+        unsigned have_rate = (mask >> i) & 1u, have_mode = (mask >> (i + 3u)) & 1u;
+        CHECK(v.present == (have_rate | (have_mode << 1)));
+        if (have_rate) CHECK(bits(v.rate) == words[i] && bits(stored.word[i]) == words[i]);
+        if (have_mode) CHECK(bits(v.mode) == words[3+i] && bits(stored.word[3+i]) == words[3+i]);
+        if (!have_rate || !have_mode) CHECK(v.hz == 0.f);
+        else if (v.mode == 0.f) {
+            unsigned division;
+            CHECK(v.hz == sync_reference(v.rate, seq_tempo(&seq), &division) && v.division == division);
+        }
+    }
+}
+static void check_authored(unsigned owner)
+{
+    const uint32_t words[] = {0x80000000, 0x3eb7a15c, 0x3f267aff, 0x3f800000, 0x80000000, 0x3f800000};
+    select_owner(owner, 0);
+    sj6_factory_row row = factory_row(words, 63);
+    CHECK(engine_superj6_factory_load(owner, &row));
+    CHECK(project_save() == -8);
+    render(1);
+    exact(owner, words, 63);
+    CHECK(!project_save() && !project_load());
+    engine_apply_sound(&proj.sound);
+    exact(owner, words, 63);
+
+    ui.part = (uint8_t)(PART_303A + owner);
+    set_view(V_PART);
+    visit_lfo();
+    engine_bass_on(owner, 57, 0, 0);
+    render(4);
+    juno6_lfo_view sync = lfo(owner, 1);
+    CHECK(sync.hz == sync_reference(sync.rate, seq_tempo(&seq), NULL) &&
+          sync.phase && bits(sync.mode) == UINT32_C(0x80000000));
+    move_rate(1, 60);
+    sounding_block();
+    juno6_lfo_view edited = lfo(owner, 1);
+    CHECK(edited.hz == sync_reference(edited.rate, seq_tempo(&seq), NULL) &&
+          edited.phase == advance(sync.phase, edited.hz));
+    CHECK(bits(edited.mode) == UINT32_C(0x80000000));
+    CHECK(bits(lfo(owner, 2).rate) == words[2]);
+    juno6_lfo_words saved;
+    CHECK(original_sound_sj6_lfo_words(proj.sound.v[T_303][ORIGINAL_SJ6_EXTRA_ROW + owner], &saved));
+    CHECK(bits(saved.word[1]) == words[1] && bits(saved.word[4]) == words[4]);
+    engine_bass_off(owner);
+    render(256);
+    CHECK(!project_save() && !project_load());
+    engine_apply_sound(&proj.sound);
+    render(1); /* Complete the existing AMP2 recall mailbox before a new factory transaction. */
+    CHECK(bits(lfo(owner, 1).mode) == words[4] && lfo(owner, 1).rate == 60.f * (1.f / 127.f));
+    CHECK(bits(lfo(owner, 2).rate) == words[2]);
+
+    /* An older project used a local rate override to explicitly select Hz. */
+    uint8_t *extra = proj.sound.v[T_303][ORIGINAL_SJ6_EXTRA_ROW + owner];
+    extra[1] &= (uint8_t)~(1u << (ORIGINAL_SJ6_MODE_INDEX + 1u - 8u));
+    extra[2 + ORIGINAL_SJ6_RATE_INDEX + 1] &= 127u;
+    CHECK(engine_bass_sound_bank(&proj.sound, owner) == ORIGINAL_SOUND_JUNO);
+    engine_apply_sound(&proj.sound);
+    render(1);
+    CHECK(lfo(owner, 1).mode == 1.f && lfo(owner, 1).rate == 60.f * (1.f / 127.f));
+    CHECK(original_sound_sj6_lfo_words(extra, &saved) && bits(saved.word[4]) == words[4]);
+
+    row.value[SJ6_ROW_LFO_HZ] = .5f;
+    CHECK(!engine_superj6_factory_load(owner, &row));
+    CHECK(!engine_superj6_factory_pending());
+    row = factory_row(words, 2u | 8u);
+    CHECK(engine_superj6_factory_load(owner, &row));
+    render(1);
+    exact(owner, words, 2u | 8u);
+    row = factory_row(words, 63);
+    CHECK(engine_superj6_factory_load(owner, &row));
+    select_owner(owner, 1);
+    exact(owner, words, 0);
+    printf("owner=%u first-match, signed zero, missing mode, sync and legacy Hz overlays, and stale factory cancellation PASS\n", owner);
+}
+#ifdef SJ6_HZ_AUTHORED
+#include "rate_words.inc"
+static void check_bank(void)
+{
+    float max_error = 0.f;
+    unsigned programs = sizeof authored_rates / sizeof authored_rates[0];
+    CHECK(programs == 640);
+    for (unsigned p = 0; p < programs; ++p) {
+        unsigned owner = p & 1u;
+        sj6_factory_row row = factory_row(authored_rates[p], 63);
+        CHECK(engine_superj6_factory_load(owner, &row));
+        render(1);
+        exact(owner, authored_rates[p], 63);
+        for (unsigned i = 0; i < 3; ++i) if (word(authored_rates[p][3+i]) == 1.f) {
+            float want = 16.f * powf(word(authored_rates[p][i]), 3.33f);
+            float error = fabsf(lfo(owner, i).hz - want);
+            if (error > max_error) max_error = error;
+        }
+    }
+    CHECK(max_error < .001f);
+    CHECK(!project_save() && !project_load());
+    engine_apply_sound(&proj.sound);
+    exact(0, authored_rates[638], 63);
+    exact(1, authored_rates[639], 63);
+    printf("authored programs=%u exact binary32 words=%u max Hz error vs binary32 libm=%.9f PASS\n",
+           programs, programs * 6u, max_error);
+}
+#endif
+int main(void)
+{
+    check_panel(0);
+    check_panel(1);
+    check_authored(0);
+    check_authored(1);
+#ifdef SJ6_HZ_AUTHORED
+    check_bank();
+#endif
+    printf("PASS SuperJ6 Hz clocks %u checks\n", checks);
+    return 0;
+}
diff --git a/tests/host/ui_superj6_knobs_test.c b/tests/host/ui_superj6_knobs_test.c
new file mode 100644
index 0000000000000000000000000000000000000000..ea39db294d283c09ea16f2399e53351a66b064d7
--- /dev/null
+++ b/tests/host/ui_superj6_knobs_test.c
@@ -0,0 +1,104 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#define ARP_FIXTURE_MAIN retained_arp_main
+#include "ui_arp_engine_test.c"
+
+enum { FRAMES = 4096 };
+static int32_t pcm[2][FRAMES * 2];
+
+static void capture(unsigned owner, int32_t *out, int knob, int delta)
+{
+    engine_apply_sound(&proj.sound);
+    render(4);
+    engine_bass_on(owner, 57, 0, 0);
+    render(4);
+    if (knob >= 0) {
+        now_ms += 160;
+        turn(knob, delta);
+    } else {
+        render(4);
+    }
+    for (unsigned i = 0; i < FRAMES; i += 256)
+        engine_render(out + i * 2, 256);
+    engine_bass_off(owner);
+    render(8);
+}
+
+static void select_page(const char *title)
+{
+    for (int i = 0; i < pg.n; ++i) {
+        if (!strcmp(pg.title[cur_page()], title)) return;
+        now_ms += 160;
+        enc_acc[EN_SELECT] = 1;
+        input();
+    }
+}
+
+static void change(unsigned owner, unsigned knob, int delta, const char *label)
+{
+    pref_t p = pg.r[cur_page()][knob];
+    CHECK(pref_desc(p) && !strcmp(pref_desc(p)->name, label));
+    int before = pref_get(p);
+    capture(owner, pcm[0], -1, 0);
+    capture(owner, pcm[1], (int)knob, delta);
+    CHECK(pref_get(p) != before);
+    unsigned changed = 0;
+    for (unsigned i = 0; i < FRAMES * 2; ++i)
+        changed += pcm[0][i] != pcm[1][i];
+    CHECK(changed > FRAMES);
+    printf("owner=%u %s position=%d->%d changed PCM samples=%u/%u\n",
+           owner, label, before, pref_get(p), changed, FRAMES * 2);
+}
+
+static void journey(unsigned owner)
+{
+    setup(V_PART, PART_303A + owner);
+    proj.set.bt |= PROJ_BT_CLK_IN;
+    CHECK(!engine_bass_select_preset(owner, ORIGINAL_SOUND_JUNO, 0, &proj.sound));
+    for (unsigned n = 0; n < 1024 && engine_bass_preset_pending(owner); ++n) render(1);
+    CHECK(engine_bass_bank(owner) == ORIGINAL_SOUND_JUNO);
+    build_pages();
+    sound_t before = proj.sound;
+    select_page("OSCILLATOR");
+    change(owner, 0, 1, "WAVE 1");
+    change(owner, 1, 1, "WAVE 2");
+    change(owner, 2, 1, "RANGE");
+    if (!owner) { ui_frame(); shot("oscillator-smk"); }
+    select_page("PULSE WIDTH");
+    now_ms += 160; turn(1, 20);
+    now_ms += 160; turn(3, 25);
+    change(owner, 0, 1, "PWM 1 ON");
+    change(owner, 2, 1, "PWM 2 ON");
+    change(owner, 1, -8, "PWM 1");
+    change(owner, 3, -10, "PWM 2");
+    CHECK(!memcmp(before.v[T_303][1-owner], proj.sound.v[T_303][1-owner], ORIGINAL_SOUND_BYTES));
+    CHECK(!memcmp(before.v[T_303][ARP_BLOCK_VOICE0 + owner],
+                  proj.sound.v[T_303][ARP_BLOCK_VOICE0 + owner], sizeof proj.sound.v[T_303][0]));
+    if (!owner) { ui_frame(); shot("pwm-smk"); }
+    CHECK(!project_save());
+    sound_t saved = proj.sound;
+    capture(owner, pcm[0], -1, 0);
+    CHECK(!project_load());
+    CHECK(!memcmp(&saved, &proj.sound, sizeof saved));
+    capture(owner, pcm[1], -1, 0);
+    CHECK(!memcmp(pcm[0], pcm[1], sizeof pcm[0]));
+    CHECK(engine_superj6_knob_turn(owner, SJ6_PWM1_ON, -1, 1));
+    CHECK(project_save() == -8);
+    CHECK(!engine_bass_select_preset(owner, ORIGINAL_SOUND_JUNO, 1, &proj.sound));
+    CHECK(!engine_superj6_knob_turn(owner, SJ6_PWM2_ON, -1, 1));
+    for (unsigned n = 0; n < 1024 && engine_bass_preset_pending(owner); ++n) render(1);
+    CHECK(!engine_bass_preset_pending(owner));
+    CHECK(engine_superj6_knob_position(owner, SJ6_PWM1_ON) == 0);
+    CHECK(!original_sound_edit_mask(proj.sound.v[T_303][owner]));
+    printf("owner=%u exact project reload PCM and preset reset PASS\n", owner);
+}
+
+int main(void)
+{
+    journey(0);
+    journey(1);
+    engine_case(ORIGINAL_SOUND_SYNTHONE, "s1");
+    engine_case(ORIGINAL_SOUND_JUNO, "sj6");
+    CHECK(!failures);
+    printf("PASS SuperJ6 knob playback/project %u and existing arp %u checks\n", checks, expectations);
+    return 0;
+}
diff --git a/tests/host/ui_superj6_legacy_pcm_test.c b/tests/host/ui_superj6_legacy_pcm_test.c
new file mode 100644
index 0000000000000000000000000000000000000000..5f051dc82d3081a4ea4a35c2f18031cfb8129aa0
--- /dev/null
+++ b/tests/host/ui_superj6_legacy_pcm_test.c
@@ -0,0 +1,35 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#define ARP_FIXTURE_MAIN retained_arp_main
+#include "ui_arp_engine_test.c"
+
+/* This test has no new receiver API dependencies so the same source runs
+ * against the preimage. It writes only external build-output PCM. */
+int main(void)
+{
+    const char *dir = getenv("SMC_UI_SHOTS");
+    char path[1024];
+    CHECK(dir && snprintf(path, sizeof path, "%s/legacy.pcm", dir) < (int)sizeof path);
+    FILE *stream = fopen(path, "wb");
+    CHECK(stream);
+    const unsigned banks[] = {ORIGINAL_SOUND_JUNO, ORIGINAL_SOUND_SYNTHONE,
+                              ORIGINAL_SOUND_CHICAGO, ORIGINAL_SOUND_MIAMI};
+    for (unsigned b = 0; b < sizeof banks / sizeof banks[0]; ++b) for (unsigned owner = 0; owner < 2; ++owner) {
+        setup(V_PART, PART_303A + owner);
+        proj.set.bt |= PROJ_BT_CLK_IN;
+        CHECK(!engine_bass_select_preset(owner, banks[b], 0, &proj.sound));
+        for (unsigned n = 0; n < 1024 && engine_bass_preset_pending(owner); ++n) render(1);
+        CHECK(engine_bass_bank(owner) == (int)banks[b] && !engine_bass_preset_pending(owner));
+        engine_bass_on(owner, 57, 0, 0);
+        int32_t pcm[512], nonzero = 0;
+        for (unsigned n = 0; n < 24; ++n) {
+            if (n == 16) engine_bass_off(owner);
+            engine_render(pcm, 256);
+            for (unsigned i = 0; i < sizeof pcm / sizeof pcm[0]; ++i) nonzero |= pcm[i];
+            CHECK(fwrite(pcm, sizeof pcm, 1, stream) == 1);
+        }
+        CHECK(nonzero);
+    }
+    CHECK(!fclose(stream));
+    puts("PASS 49,152 stereo frames across two owners and four legacy sound paths");
+    return 0;
+}
diff --git a/tests/host/ui_superj6_master_test.c b/tests/host/ui_superj6_master_test.c
new file mode 100644
index 0000000000000000000000000000000000000000..4db687d34532df80c410dd830780cab37a7671e3
--- /dev/null
+++ b/tests/host/ui_superj6_master_test.c
@@ -0,0 +1,107 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#define ARP_FIXTURE_MAIN retained_arp_main
+#include "ui_arp_engine_test.c"
+
+enum { FRAMES = 4096 };
+static int32_t pcm[2][FRAMES * 2];
+
+static void start_note(unsigned owner, int wet)
+{
+    engine_apply_sound(&proj.sound);
+    if (wet) {
+        engine_set(T_303, owner, 13, 24);
+        engine_set(T_303, owner, 14, 86);
+    }
+    render(4);
+    engine_bass_on(owner, 57, 0, 0);
+    render(4);
+}
+
+static void record(unsigned owner, int32_t *out)
+{
+    for (unsigned i = 0; i < FRAMES; i += 256) engine_render(out + 2 * i, 256);
+    engine_bass_off(owner);
+    render(128);
+}
+
+static void level(int position)
+{
+    pref_t r = pg.r[cur_page()][1];
+    CHECK(r.kind == R_SJ6KNOB && r.c == SJ6_MASTER_LEVEL);
+    int detents = position - pref_get(r);
+    now_ms += 160u + (unsigned)abs(detents) * 70u;
+    turn(1, detents);
+    CHECK(pref_get(r) == position);
+}
+
+static void journey(unsigned owner)
+{
+    setup(V_PART, PART_303A + owner);
+    proj.set.bt |= PROJ_BT_CLK_IN;
+    CHECK(!engine_bass_select_preset(owner, ORIGINAL_SOUND_JUNO, 0, &proj.sound));
+    for (unsigned n = 0; n < 1024 && engine_bass_preset_pending(owner); ++n) render(1);
+    build_pages();
+    for (int n = 0; n < pg.n && strcmp(pg.title[cur_page()], "OUTPUT"); ++n) {
+        now_ms += 160;
+        enc_acc[EN_SELECT] = 1;
+        input();
+    }
+    CHECK(!strcmp(pg.title[cur_page()], "OUTPUT"));
+    CHECK(pg.r[cur_page()][0].kind == R_ENG && pg.r[cur_page()][0].c == 9);
+    float gain, peer_before = 0, peer_after;
+    int peer_juno = engine_superj6_panel_master(1-owner, &peer_before);
+    CHECK(engine_superj6_panel_master(owner, &gain) && gain == 1.f);
+    const unsigned q[] = {64, 127, 0};
+    const float words[] = {64.f * (JUNO6_FACTORY_MASTER_MAX / 127.f), JUNO6_FACTORY_MASTER_MAX, 0.f};
+    for (unsigned i = 0; i < 3; ++i) {
+        start_note(owner, 1);
+        CHECK(engine_superj6_edit(owner, ENGINE_SJ6_MASTER_VOLUME, words[i]));
+        render(4);
+        record(owner, pcm[0]);
+        if (i == 0) {
+            start_note(owner, 0);
+            CHECK(engine_superj6_edit(owner, ENGINE_SJ6_MASTER_VOLUME, words[i]));
+            render(4);
+            record(owner, pcm[1]);
+            CHECK(memcmp(pcm[0], pcm[1], sizeof pcm[0]));
+        }
+        start_note(owner, 1);
+        level((int)q[i]);
+        record(owner, pcm[1]);
+        CHECK(!memcmp(pcm[0], pcm[1], sizeof pcm[0]));
+        CHECK(engine_superj6_panel_master(owner, &gain));
+        CHECK(gain == (float)((double)words[i] * .404));
+        if (!q[i]) {
+            int32_t nonzero = 0;
+            for (unsigned f = 0; f < FRAMES * 2; ++f) nonzero |= pcm[1][f];
+            CHECK(!nonzero);
+        }
+        printf("owner=%u held LEVEL position=%u raw=%.8f gain=%.8f and %u PCM frames match typed post-FX entry with active chorus\n",
+               owner, q[i], words[i], gain, FRAMES);
+    }
+
+    level(127);
+    start_note(owner, 1);
+    render(4);
+    record(owner, pcm[0]);
+    CHECK(!ui_project_save() && !project_load());
+    start_note(owner, 1);
+    render(4);
+    record(owner, pcm[1]);
+    CHECK(!memcmp(pcm[0], pcm[1], sizeof pcm[0]));
+    level(SJ6_MASTER_INIT);
+    CHECK(engine_superj6_panel_master(owner, &gain) && gain == 1.f);
+    CHECK(!ui_project_save() && !project_load());
+    engine_apply_sound(&proj.sound);
+    CHECK(engine_superj6_panel_master(owner, &gain) && gain == 1.f);
+    if (peer_juno) CHECK(engine_superj6_panel_master(1-owner, &peer_after) && peer_before == peer_after);
+    printf("owner=%u full authored range and INIT gain restored after save/load\n", owner);
+}
+
+int main(void)
+{
+    journey(0);
+    journey(1);
+    printf("PASS SuperJ6 LEVEL %u checks\n", checks);
+    return 0;
+}
diff --git a/tests/host/ui_superj6_pwm1_lfo2_test.c b/tests/host/ui_superj6_pwm1_lfo2_test.c
new file mode 100644
index 0000000000000000000000000000000000000000..1438ccdf77a2d872cab23104d04e0c3342ed85b7
--- /dev/null
+++ b/tests/host/ui_superj6_pwm1_lfo2_test.c
@@ -0,0 +1,284 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#define ARP_FIXTURE_MAIN retained_arp_main
+#include "ui_arp_engine_test.c"
+
+enum { COUNT = 8192, RATE = 44100 };
+static int32_t pcm[2][COUNT * 2];
+static const int32_t silence[COUNT * 2];
+static float actual[2][COUNT], expected[2][COUNT];
+
+static void select_owner(unsigned owner, unsigned preset)
+{
+    CHECK(!engine_bass_select_preset(owner, ORIGINAL_SOUND_JUNO, preset, &proj.sound));
+    for (unsigned n = 0; n < 1024 && engine_bass_preset_pending(owner); ++n) render(1);
+    CHECK(engine_bass_bank(owner) == ORIGINAL_SOUND_JUNO && !engine_bass_preset_pending(owner));
+}
+
+static void visit(const char *name)
+{
+    build_pages();
+    for (int n = 0; n < pg.n && strcmp(pg.title[cur_page()], name); ++n) {
+        now_ms += 200;
+        enc_acc[EN_SELECT] = 1;
+        input();
+    }
+    CHECK(!strcmp(pg.title[cur_page()], name));
+    smc_peek_cancel();
+    smc_page_set(cur_page());
+}
+
+static void panel_turn(unsigned col, unsigned slot, int pos)
+{
+    pref_t ref = pg.r[cur_page()][col];
+    CHECK(ref.kind == R_SJ6KNOB && ref.c == slot);
+    int delta = pos - pref_get(ref);
+    CHECK(delta && smc_same(ref, smc_knob_target(col)));
+    while (delta) {
+        int limit = pref_desc(ref)->max <= 3 ? 1 : 32;
+        int step = delta < -limit ? -limit : delta > limit ? limit : delta;
+        now_ms += 200u + (unsigned)abs(step) * 70u;
+        knob(col, step);
+        delta -= step;
+    }
+    int readback = pref_get(ref);
+    if (readback != pos) fprintf(stderr, "SMC slot %u expected %d read %d\n", slot, pos, readback);
+    CHECK(readback == pos && project_save() == -8);
+}
+
+static void begin_pair(void)
+{
+    engine_apply_sound(&proj.sound);
+    render(24);
+    engine_bass_on(0, 57, 0, 0);
+    engine_bass_on(1, 62, 0, 0);
+    render(4);
+}
+
+static void capture(int32_t *samples)
+{
+    for (unsigned n = 0; n < COUNT; n += 256) engine_render(samples + n * 2, 256);
+}
+
+static unsigned changed(const int32_t *a, const int32_t *b, unsigned ch)
+{
+    unsigned differences = 0;
+    for (unsigned n = 0; n < COUNT; ++n) differences += a[n * 2 + ch] != b[n * 2 + ch];
+    return differences;
+}
+
+static void save_and_reload(void)
+{
+    sound_t expected_sound = proj.sound;
+    engine_bass_off(0);
+    engine_bass_off(1);
+    for (unsigned n = 0; n < 1024 && ui_boot_flash_busy(); ++n) render(1);
+    CHECK(!ui_boot_flash_busy());
+    int saved = ui_project_save();
+    int loaded = saved ? 0 : project_load();
+    if (saved || loaded)
+        fprintf(stderr, "save=%d load=%d unsupported=%d bank0=%d bank1=%d\n",
+                saved, loaded, project_storage_unsupported(),
+                engine_bass_sound_bank(&proj.sound, 0), engine_bass_sound_bank(&proj.sound, 1));
+    CHECK(!saved && !loaded);
+    CHECK(!memcmp(&expected_sound, &proj.sound, sizeof expected_sound));
+}
+
+static void isolate_dry_pair(void)
+{
+    proj.sound.v[T_MIX][PART_303A][MX_PAN] = 0;
+    proj.sound.v[T_MIX][PART_303B][MX_PAN] = 127;
+    proj.sound.v[T_MIX][PART_303A][MX_REV] = proj.sound.v[T_MIX][PART_303B][MX_REV] = 0;
+    proj.sound.v[T_MIX][PART_303A][MX_DLY] = proj.sound.v[T_MIX][PART_303B][MX_DLY] = 0;
+    proj.sound.v[T_MST][0][MST_RATIO] = proj.sound.v[T_MST][0][MST_PUMP] = 0;
+    proj.sound.v[T_MST][0][MST_LIMIT] = proj.sound.v[T_MST][0][MST_MODE] = 0;
+    engine_fx_mute(3u);
+}
+
+static void verify_panel(unsigned owner, unsigned layer)
+{
+    const unsigned amount_slot = layer ? SJ6_PWM2 : SJ6_PWM1;
+    const unsigned other_amount = layer ? SJ6_PWM1 : SJ6_PWM2;
+    const unsigned route = layer + 1;
+    setup(V_PART, PART_303A + owner);
+    proj.set.bt |= PROJ_BT_CLK_IN;
+    select_owner(owner, 0);
+    select_owner(1-owner, 0);
+    isolate_dry_pair();
+    visit("OSCILLATOR");
+    panel_turn(layer, SJ6_WAVE1 + layer, 3);
+    render(1);
+    visit("PULSE WIDTH");
+    panel_turn(2u * layer, layer ? SJ6_PWM2_ON : SJ6_PWM1_ON, 1);
+    render(1);
+    visit("LFO2 PWM");
+    panel_turn(0, SJ6_LFO2_RATE, 127);
+    panel_turn(2, SJ6_LFO2_PWM_ROUTE, (int)route);
+    panel_turn(3, SJ6_LFO2_PWM_BASE, 61); /* Follows the route before commit. */
+    CHECK(engine_superj6_knob_position(owner, amount_slot) == 61);
+    CHECK(engine_superj6_knob_position(owner, other_amount) == 0);
+    render(1);
+    sound_t armed = proj.sound;
+    begin_pair();
+    capture(pcm[0]); /* Route on, depth zero. */
+    CHECK(changed(pcm[0], silence, owner) > COUNT / 2);
+    CHECK(changed(pcm[0], silence, 1-owner) > COUNT / 2);
+    begin_pair();
+    panel_turn(1, SJ6_LFO2_PWM_DEPTH, 100); /* Editor input while both notes sound. */
+    CHECK(original_sound_sj6_lfo2_pwm(proj.sound.v[T_303][owner]) ==
+          original_sound_sj6_lfo2_pwm(armed.v[T_303][owner]));
+    capture(pcm[1]);
+    unsigned delta = changed(pcm[0], pcm[1], owner);
+    unsigned peer_delta = changed(pcm[0], pcm[1], 1-owner);
+    printf("part=%u PWM%u held depth changed %u target frames, %u peer frames\n",
+           owner, route, delta, peer_delta);
+    CHECK(delta > COUNT / 2 && !peer_delta);
+    CHECK(!memcmp(armed.v[T_303][1-owner], proj.sound.v[T_303][1-owner], ORIGINAL_SOUND_BYTES));
+    sound_t active = proj.sound;
+    begin_pair();
+    capture(pcm[0]);
+    save_and_reload();
+    begin_pair();
+    CHECK(pref_get(pg.r[cur_page()][1]) == 100 && pref_get(pg.r[cur_page()][2]) == (int)route);
+    CHECK(pref_get(pg.r[cur_page()][3]) == 61 && engine_superj6_knob_position(owner, other_amount) == 0);
+    capture(pcm[1]);
+    CHECK(!memcmp(pcm[0], pcm[1], sizeof pcm[0]));
+
+    begin_pair();
+    panel_turn(2, SJ6_LFO2_PWM_ROUTE, 0);
+    render(1);
+    save_and_reload();
+    begin_pair();
+    CHECK(pref_get(pg.r[cur_page()][1]) == 100 && pref_get(pg.r[cur_page()][2]) == 0);
+    CHECK(pref_get(pg.r[cur_page()][3]) == (layer ? 0 : 61)); /* OFF falls back to PWM1. */
+    capture(pcm[0]);
+    proj.sound = armed;
+    begin_pair();
+    capture(pcm[1]);
+    CHECK(!memcmp(pcm[0], pcm[1], sizeof pcm[0]));
+    proj.sound = active;
+    begin_pair();
+    panel_turn(1, SJ6_LFO2_PWM_DEPTH, 71);
+    CHECK(!engine_bass_select_preset(owner, ORIGINAL_SOUND_JUNO, 1, &proj.sound));
+    engine_bass_off(owner);
+    for (unsigned n = 0; n < 1024 && engine_bass_preset_pending(owner); ++n) render(1);
+    CHECK(!engine_bass_preset_pending(owner));
+    CHECK(engine_superj6_knob_position(owner, SJ6_LFO2_PWM_DEPTH) == 0);
+    CHECK(engine_superj6_knob_position(owner, SJ6_LFO2_PWM_ROUTE) == 0);
+    CHECK(!memcmp(armed.v[T_303][1-owner], proj.sound.v[T_303][1-owner], ORIGINAL_SOUND_BYTES));
+    printf("part=%u PWM%u save/reload, routed base, depth-zero and route-off PCM, preset isolation PASS\n",
+           owner, route);
+}
+
+static void verify_cell(void)
+{
+    uint8_t cell[ORIGINAL_SOUND_BYTES];
+    CHECK(original_sound_init(cell, ORIGINAL_SOUND_JUNO, 0));
+    for (unsigned state = 0; state < 384; ++state) {
+        original_sound_sj6_lfo2_pwm_store(cell, (uint16_t)state);
+        CHECK(original_sound_valid(cell) && original_sound_sj6_lfo2_pwm(cell) == state);
+        CHECK(cell[ORIGINAL_SJ6_LFO2_PWM_BYTE] == (uint8_t)state);
+        CHECK(!!(original_sound_edit_mask(cell) & ORIGINAL_SJ6_LFO2_PWM2_BIT) == (state >= 256));
+        cell[25] ^= ORIGINAL_SJ6_LFO2_PWM_BIT >> 24;
+        CHECK(!original_sound_valid(cell));
+        cell[25] ^= ORIGINAL_SJ6_LFO2_PWM_BIT >> 24;
+    }
+    original_sound_sj6_lfo2_pwm_store(cell, 128u);
+    cell[25] |= ORIGINAL_SJ6_LFO2_PWM2_BIT >> 24;
+    CHECK(!original_sound_valid(cell)); /* Both route bits set. */
+}
+
+static void verify_receiver(unsigned layer)
+{
+    const unsigned route = layer + 1, setting = route << SJ6_LFO2_PWM_ROUTE_SHIFT;
+    const float base = layer ? .2f : .5f;
+    juno6_t synth;
+    juno6_init(&synth, RATE);
+    juno6_oscillator_edit square = {1.f, base, 1.f};
+    juno6_apply_pre_note_wave(&synth, layer, &square);
+    square.amount = .37f;
+    juno6_apply_pre_note_wave(&synth, 1-layer, &square);
+    synth.core.layer[1-layer].params.lfo_pwm_depth = .05f;
+    synth.core.layer[1-layer].params.lfo_hz = 3.f;
+    juno6_set_panel_lfo_rate(&synth, 1, 127);
+    CHECK(juno6_note_on(&synth, 57, 127));
+    juno6_t baseline = synth;
+    juno6_lfo_view lfo;
+    juno6_read_lfo(&synth, 1, &lfo);
+    CHECK(lfo.hz == 16.f);
+
+    /* The reference stream uses the archived rotation, depth and PWM laws,
+     * with exact integer boundaries on the nominal 80 Hz control grid. */
+    uint64_t turn = UINT64_C(1) << 40;
+    uint64_t step = (uint64_t)(16.f * ((float)turn / RATE) + .5f);
+    const unsigned uneven[] = {137, 87, 257, 311};
+    juno6_t bypass = synth;
+    juno6_set_lfo2_pwm(&bypass, setting);
+    for (unsigned n = 0, i = 0; n < COUNT; ++i) {
+        unsigned span = uneven[i % 4];
+        if (span > COUNT - n) span = COUNT - n;
+        CHECK(juno6_render_stereo(&baseline, actual[0]+n, actual[1]+n, span));
+        CHECK(juno6_render_stereo(&bypass, expected[0]+n, expected[1]+n, span));
+        n += span;
+    }
+    CHECK(!memcmp(actual, expected, sizeof actual));
+
+    /* At the enable threshold both receivers must retain legacy PCM with
+     * depth on. Setting one receiver must leave the peer layer untouched. */
+    bypass = synth;
+    square.amount = base;
+    square.enable = .5f;
+    juno6_apply_pre_note_wave(&bypass, layer, &square);
+    baseline = bypass;
+    juno6_set_lfo2_pwm(&bypass, setting | 127u);
+    CHECK(juno6_render_stereo(&bypass, actual[0], actual[1], 256));
+    CHECK(juno6_render_stereo(&baseline, expected[0], expected[1], 256));
+    for (unsigned channel = 0; channel < 2; ++channel)
+        CHECK(!memcmp(actual[channel], expected[channel], 256 * sizeof(float)));
+
+    baseline = synth;
+    juno6_set_lfo2_pwm(&synth, setting | 127u);
+    for (unsigned n = 0, i = 0; n < COUNT; ++i) {
+        unsigned span = uneven[i % 4];
+        if (span > COUNT - n) span = COUNT - n;
+        CHECK(juno6_render_stereo(&synth, actual[0]+n, actual[1]+n, span));
+        n += span;
+    }
+    unsigned clipped_ticks = 0;
+    for (unsigned tick = 0, n = 0; n < COUNT; ++tick) {
+        unsigned end = (tick + 1u) * RATE / 80u;
+        if (end > COUNT) end = COUNT;
+        unsigned index = (unsigned)(((n * step) % turn) >> 32);
+        unsigned p = (index + 64u) % 256u;
+        float wave = p < 128u ? (float)p / 64.f - 1.f : 3.f - (float)p / 64.f;
+        float raw = base + wave / 2.f;
+        if (raw < 0.f) { raw = 0.f; ++clipped_ticks; }
+        baseline.core.layer[layer].params.pulse_width = .5f - .47f * raw;
+        CHECK(juno6_render_stereo(&baseline, expected[0]+n, expected[1]+n, end-n));
+        n = end;
+    }
+    CHECK(!memcmp(actual, expected, sizeof actual));
+    CHECK(clipped_ticks == (layer ? 3u : 0u));
+    CHECK(synth.core.layer[layer].params.pulse_width == .5f - .47f * base);
+    CHECK(synth.core.layer[1-layer].params.pulse_width == .5f - .47f * .37f);
+    CHECK(synth.core.layer[1-layer].params.lfo_pwm_depth == .05f);
+    float raw;
+    CHECK(dnbx_read_raw(&synth.core, 78u + layer, &raw) == DNBX_OK && raw == base);
+    CHECK(dnbx_read_raw(&synth.core, 79u - layer, &raw) == DNBX_OK && raw == .37f);
+    printf("PWM%u Build-9 transfer oracle exact over %u stereo frames with %u clipped ticks; depth-zero and enable-threshold PCM PASS\n",
+           route, COUNT, clipped_ticks);
+}
+
+#ifndef PWM_FIXTURE_MAIN
+#define PWM_FIXTURE_MAIN main
+#endif
+int PWM_FIXTURE_MAIN(void)
+{
+    verify_cell();
+    for (unsigned layer = 0; layer < DNBX_LAYERS; ++layer) {
+        verify_receiver(layer);
+        verify_panel(0, layer);
+        verify_panel(1, layer);
+    }
+    printf("PASS SuperJ6 LFO2 PWM %u checks\n", checks);
+    return 0;
+}
diff --git a/tests/host/ui_superj6_sync_test.c b/tests/host/ui_superj6_sync_test.c
new file mode 100644
index 0000000000000000000000000000000000000000..4beee2bf9311fc70f222a93c660d3aa5f2c62dd4
--- /dev/null
+++ b/tests/host/ui_superj6_sync_test.c
@@ -0,0 +1,213 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#define PWM_FIXTURE_MAIN retained_pwm_main
+#include "ui_superj6_pwm1_lfo2_test.c"
+#include "sj6_sync_oracle.h"
+
+#define CLOCK_TURN (UINT64_C(1) << 40)
+
+static juno6_lfo_view clock_view(unsigned owner, unsigned index)
+{
+    juno6_lfo_view view;
+    CHECK(engine_superj6_lfo_view(owner, index, &view));
+    return view;
+}
+
+static void tempo(unsigned bpm)
+{
+    pref_set_impl(PR(R_TEMPO, 0, 0, 0), (int)bpm - 20, 0);
+    CHECK(seq.bpm == (float)bpm);
+}
+
+static uint64_t phase_after(uint64_t phase, float hz, unsigned frames, float sample_rate)
+{
+    uint64_t step = (uint64_t)(hz * ((float)CLOCK_TURN / sample_rate) + .5f);
+    return (phase + step * frames) % CLOCK_TURN;
+}
+
+static void check_sync_clock(unsigned owner, unsigned clock, float raw, float bpm)
+{
+    unsigned division;
+    float hz = sync_reference(raw, bpm, &division);
+    juno6_lfo_view view = clock_view(owner, clock);
+    CHECK(view.present == 3u && view.mode == 0.f && view.rate == raw);
+    CHECK(view.division == division && view.hz == hz);
+}
+
+static void check_laws(void)
+{
+    const float bpms[] = {20, 125, 275};
+    const float rates[] = {8001, 44100, 192000};
+    unsigned seen = 0;
+    for (unsigned rate = 0; rate < 3; ++rate) {
+        juno6_t s;
+        juno6_init(&s, rates[rate]);
+        for (unsigned t = 0; t < 3; ++t) {
+            juno6_set_lfo_tempo(&s, bpms[t]);
+            for (unsigned p = 0; p < 128; ++p) {
+                /* Different rates on the three clocks exercise independent cached steps. */
+                for (unsigned clock = 0; clock < 3; ++clock)
+                    juno6_set_panel_lfo(&s, clock, (p + clock) & 127u, 0);
+                uint64_t phases[3];
+                for (unsigned clock = 0; clock < 3; ++clock) phases[clock] = s.lfo_phase_q40[clock];
+                CHECK(juno6_render_stereo(&s, actual[0], actual[1], 13));
+                for (unsigned clock = 0; clock < 3; ++clock) {
+                    juno6_lfo_view v;
+                    juno6_read_lfo(&s, clock, &v);
+                    unsigned division;
+                    float raw = ((p + clock) & 127u) * (1.f / 127.f);
+                    float hz = sync_reference(raw, bpms[t], &division);
+                    CHECK(v.present == 3u && v.rate == raw && v.mode == 0.f);
+                    CHECK(v.hz == hz && v.division == division);
+                    CHECK(v.phase == phase_after(phases[clock], hz, 13, rates[rate]));
+                    seen |= 1u << division;
+                }
+            }
+        }
+    }
+    CHECK(seen == (1u << SJ6_LFO_DIVISIONS) - 1);
+    /* Neighbors of every normalized division boundary use exact authored words. */
+    juno6_t s;
+    juno6_init(&s, 44100);
+    juno6_set_lfo_tempo(&s, 123.25f);
+    juno6_lfo_words words = {.present = 9};
+    for (unsigned i = 0; i < 17; ++i) {
+        float boundary = 1.f - (i + .5f) / 17.f;
+        const float neighbors[] = {nextafterf(boundary, 0.f), boundary, nextafterf(boundary, 1.f)};
+        for (unsigned n = 0; n < 3; ++n) {
+            words.word[0] = neighbors[n];
+            juno6_set_lfo_words(&s, &words, 0);
+            juno6_lfo_view v;
+            juno6_read_lfo(&s, 0, &v);
+            unsigned division;
+            float hz = sync_reference(words.word[0], 123.25f, &division);
+            CHECK(v.present == 3u && v.hz == hz && v.division == division);
+        }
+    }
+    puts("PASS all 18 Build-9 divisions, binary32 boundaries and exact three-clock steps at 8001 to 192000 Hz");
+}
+
+static void require_pcm_change(unsigned owner, const char *change)
+{
+    unsigned signal = changed(pcm[0], pcm[1], owner);
+    unsigned peer = changed(pcm[0], pcm[1], 1-owner);
+    CHECK(signal > COUNT / 2 && peer == 0);
+    printf("part=%u %s changed %u/%u dry target frames, %u peer frames\n",
+           owner, change, signal, COUNT, peer);
+}
+
+static void check_held(unsigned owner)
+{
+    setup(V_PART, PART_303A + owner);
+    proj.set.bt |= PROJ_BT_CLK_IN;
+    select_owner(owner, 0);
+    select_owner(1-owner, 0);
+    isolate_dry_pair();
+    tempo(120);
+    visit("OSCILLATOR");
+    panel_turn(owner, SJ6_WAVE1 + owner, 3);
+    render(1);
+    visit("PULSE WIDTH");
+    panel_turn(2u * owner, owner ? SJ6_PWM2_ON : SJ6_PWM1_ON, 1);
+    render(1);
+    visit("LFO2 PWM");
+    panel_turn(0, SJ6_LFO2_RATE, 127);
+    panel_turn(1, SJ6_LFO2_PWM_DEPTH, 100);
+    panel_turn(2, SJ6_LFO2_PWM_ROUTE, (int)owner + 1);
+    panel_turn(3, SJ6_LFO2_PWM_BASE, 61);
+    render(1);
+
+    begin_pair();
+    capture(pcm[0]);
+    begin_pair();
+    visit("LFO MODE");
+    juno6_lfo_view before = clock_view(owner, 1);
+    CHECK(before.hz == 16.f && before.mode == 1.f);
+    panel_turn(1, SJ6_LFO2_MODE, 0);
+    CHECK(clock_view(owner, 1).mode == 1.f); /* Audio boundary owns the pending turn. */
+    engine_render(pcm[1], 256);
+    check_sync_clock(owner, 1, 1.f, 120.f);
+    CHECK(clock_view(owner, 1).phase == phase_after(before.phase, 32.f, 256, RATE));
+    for (unsigned n = 256; n < COUNT; n += 256) engine_render(pcm[1] + 2*n, 256);
+    require_pcm_change(owner, "held SMK Hz to sync");
+
+    /* Rate edits retain sync, and the other two mode knobs are independent. */
+    panel_turn(0, SJ6_LFO1_MODE, 0);
+    panel_turn(2, SJ6_LFO3_MODE, 0);
+    visit("LFO RATE");
+    panel_turn(0, SJ6_LFO1_RATE, 32);
+    panel_turn(1, SJ6_LFO2_RATE, 110);
+    panel_turn(2, SJ6_LFO3_RATE, 101);
+    render(1);
+    const float raw = 110.f * (1.f / 127.f);
+    check_sync_clock(owner, 0, 32.f * (1.f / 127.f), 120.f);
+    check_sync_clock(owner, 1, raw, 120.f);
+    check_sync_clock(owner, 2, 101.f * (1.f / 127.f), 120.f);
+    char num[24], unit[24];
+    pref_t rate = pg.r[cur_page()][1];
+    pref_value_of(rate, pref_get(rate), num, unit);
+    CHECK(!strcmp(num, "1/32") && !strcmp(unit, "bar"));
+    CHECK(!clock_view(1-owner, 1).present);
+
+    begin_pair();
+    capture(pcm[0]);
+    begin_pair();
+    tempo(90);
+    before = clock_view(owner, 1);
+    engine_render(pcm[1], 256);
+    check_sync_clock(owner, 1, raw, 90.f);
+    CHECK(clock_view(owner, 1).phase == phase_after(before.phase, sync_reference(raw, 90.f, NULL), 256, RATE));
+    for (unsigned n = 256; n < COUNT; n += 256) engine_render(pcm[1] + 2*n, 256);
+    require_pcm_change(owner, "held 120 to 90 BPM");
+
+    begin_pair();
+    capture(pcm[0]);
+    save_and_reload();
+    CHECK(proj.set.bpm_x10 == 900);
+    begin_pair();
+    check_sync_clock(owner, 1, raw, 90.f);
+    capture(pcm[1]);
+    CHECK(!memcmp(pcm[0], pcm[1], sizeof pcm[0]));
+
+    /* The live MIDI clock path owns effective tempo while following 24 PPQN. */
+    pref_set_impl(PR(R_CLKSRC, 0, 0, 0), SEQ_CLK_EXT, 0);
+    ui_frame();
+    for (unsigned tick = 0; tick < 32; ++tick) {
+        host_midi_put(0xf80fu);
+        render(4);
+    }
+    CHECK(seq.ext && fabsf(seq_tempo(&seq) - 107.666015625f) < .01f);
+    check_sync_clock(owner, 1, raw, seq_tempo(&seq));
+    before = clock_view(owner, 1);
+    render(1);
+    CHECK(clock_view(owner, 1).phase == phase_after(before.phase, before.hz, 256, RATE));
+    printf("part=%u accepted external 24 PPQN clock at %.6f BPM and %.6f Hz\n",
+           owner, seq_tempo(&seq), before.hz);
+    pref_set_impl(PR(R_CLKSRC, 0, 0, 0), SEQ_CLK_INT, 0);
+    ui_frame();
+    render(1);
+    CHECK(!seq.ext);
+
+    /* With depth zero, sync still advances and changing BPM leaves audio exact. */
+    visit("LFO2 PWM");
+    panel_turn(1, SJ6_LFO2_PWM_DEPTH, 0);
+    render(1);
+    tempo(120);
+    begin_pair();
+    capture(pcm[0]);
+    tempo(90);
+    begin_pair();
+    check_sync_clock(owner, 1, raw, 90.f);
+    capture(pcm[1]);
+    CHECK(!memcmp(pcm[0], pcm[1], sizeof pcm[0]));
+    CHECK(changed(pcm[1], silence, owner) > COUNT / 2);
+    printf("part=%u active save/reload, retained sync on rate edit, zero-depth PCM and peer clock isolation PASS\n", owner);
+}
+
+int main(void)
+{
+    check_laws();
+    check_held(0);
+    check_held(1);
+    printf("PASS SuperJ6 LFO sync %u checks\n", checks);
+    return 0;
+}
diff --git a/tests/host/ui_synthone_filter_link_test.c b/tests/host/ui_synthone_filter_link_test.c
new file mode 100644
index 0000000000000000000000000000000000000000..0e082493ba50be6d217f1721c0659579d812eb6d
--- /dev/null
+++ b/tests/host/ui_synthone_filter_link_test.c
@@ -0,0 +1,103 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#define ARP_FIXTURE_MAIN retained_arp_main
+#include "ui_arp_engine_test.c"
+
+enum { FRAMES = 4096 };
+static int32_t dry[FRAMES * 2], linked[FRAMES * 2], replay[FRAMES * 2];
+
+static void visit(const char *title)
+{
+    for (int i = 0; i < pg.n; ++i) {
+        if (!strcmp(pg.title[cur_page()], title)) return;
+        now_ms += 160;
+        enc_acc[EN_SELECT] = 1;
+        input();
+    }
+    CHECK(0);
+}
+
+static void edit(int knob, int delta)
+{
+    now_ms += 160;
+    turn(knob, delta);
+}
+
+static void capture(unsigned owner, int32_t *pcm)
+{
+    engine_apply_sound(&proj.sound);
+    render(4);
+    engine_bass_on(owner, 57, 0, 0);
+    for (unsigned i = 0; i < FRAMES; i += 256) engine_render(pcm + i * 2, 256);
+    engine_bass_off(owner);
+    render(8);
+}
+
+static unsigned delta_pcm(const int32_t *a, const int32_t *b)
+{
+    unsigned changed = 0;
+    for (unsigned i = 0; i < FRAMES * 2; ++i) changed += a[i] != b[i];
+    return changed;
+}
+
+static void journey(unsigned owner)
+{
+    setup(V_PART, PART_303A + owner);
+    proj.set.bt |= PROJ_BT_CLK_IN;
+    CHECK(!engine_bass_select_preset(owner, ORIGINAL_SOUND_SYNTHONE, 0, &proj.sound));
+    for (unsigned n = 0; n < 1024 && engine_bass_preset_pending(owner); ++n) render(1);
+    CHECK(engine_bass_bank(owner) == ORIGINAL_SOUND_SYNTHONE);
+    build_pages();
+    visit("FILTER");
+    pref_t link = pg.r[cur_page()][3];
+    CHECK(pref_desc(link) && !strcmp(pref_desc(link)->name, "LINK"));
+    CHECK(pref_get(link) == 0);
+    uint8_t original[ORIGINAL_SOUND_BYTES];
+    memcpy(original, proj.sound.v[T_303][owner], sizeof original);
+    /* A LINK-only edit must survive recognition of historical slot-2 cells. */
+    edit(3, 1);
+    CHECK(!engine_bass_sound_validate(&proj.sound));
+    CHECK(!project_save());
+    CHECK(!project_load());
+    engine_apply_sound(&proj.sound);
+    CHECK(pref_get(link) == 1);
+    edit(3, -1);
+    CHECK(!memcmp(original, proj.sound.v[T_303][owner], sizeof original));
+
+    edit(2, 70);                 /* audible filter envelope depth */
+    visit("FILTER ADSR");
+    edit(0, 40);
+    capture(owner, dry);
+    s1_patch_snapshot before, on, after;
+    CHECK(engine_s1_patch_snapshot(owner, &before));
+    CHECK(before.physical[S1_FILTER_FIRST] != before.physical[S1_AMP_FIRST]);
+    uint8_t peer[ORIGINAL_SOUND_BYTES];
+    memcpy(peer, proj.sound.v[T_303][1-owner], sizeof peer);
+
+    visit("FILTER");
+    edit(3, 1);
+    CHECK(engine_s1_patch_snapshot(owner, &on) && on.filter_link);
+    CHECK(!memcmp(before.physical, on.physical, sizeof before.physical));
+    capture(owner, linked);
+    unsigned changed = delta_pcm(dry, linked);
+    CHECK(changed > FRAMES && !memcmp(peer, proj.sound.v[T_303][1-owner], sizeof peer));
+    CHECK(!project_save());
+    CHECK(!project_load());
+    capture(owner, replay);
+    CHECK(!delta_pcm(linked, replay));
+
+    edit(3, -1);
+    CHECK(engine_s1_patch_snapshot(owner, &after) && !after.filter_link);
+    CHECK(!memcmp(before.physical, after.physical, sizeof before.physical));
+    capture(owner, replay);
+    CHECK(!delta_pcm(dry, replay));
+    printf("owner=%u filter LINK changed %u/%u PCM samples, reload and unlink bit-exact\n",
+           owner, changed, FRAMES * 2);
+}
+
+int main(void)
+{
+    journey(0);
+    journey(1);
+    printf("PASS Synth One envelope LINK %u checks\n", checks);
+    return 0;
+}
