+    SJ6_ROW_AMOUNT = 7, SJ6_ROW_ENABLE = 9, SJ6_ROW_RANGE = 11, SJ6_ROW_FILTER_LINK = 12,
+#if X0X_SUPERJ6_BUILTIN_INIT
+    SJ6_ROW_LFO_RATE = 13, SJ6_ROW_LFO_HZ = 16, SJ6_ROW_COUNT = 19
