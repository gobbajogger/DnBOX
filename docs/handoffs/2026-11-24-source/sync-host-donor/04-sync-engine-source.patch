 static inline void sj6_factory_add_word(sj6_factory_row *row, unsigned id, uint32_t bits)
 {
     unsigned slot;
+    if (id == 40 || id == 41) {
+        unsigned mb = 1u << (id - 40), pb = mb << 2;
+        if (!(row->chorus_flags & pb)) {
+            row->chorus_flags |= (uint8_t)pb;
+            if (bits == UINT32_C(0x3f800000)) row->chorus_flags |= (uint8_t)mb;
+            else if (bits != 0) row->chorus_flags |= 16u;
+        }
+        return;
+    }
     if (id == 0) slot = SJ6_ROW_MASTER;
     else if (id >= 119 && id <= 122) slot = SJ6_ROW_AMP2 + id - 119;
     else if (id == 82 || id == 83) slot = SJ6_ROW_WAVE + id - 82;
     else if (id == 78 || id == 79) slot = SJ6_ROW_AMOUNT + id - 78;
     else if (id == 210 || id == 211) slot = SJ6_ROW_ENABLE + id - 210;
+    else if (id == 86) slot = SJ6_ROW_RANGE;
+    else if (id == 116) slot = SJ6_ROW_FILTER_LINK;
+#if X0X_SUPERJ6_BUILTIN_INIT
+    else if (id == 88 || id == 96 || id == 100) slot = SJ6_ROW_LFO_RATE + (id == 88 ? 0u : id == 96 ? 1u : 2u);
+    else if (id >= 195 && id <= 197) slot = SJ6_ROW_LFO_HZ + id - 195;
+#endif
     else return;
     unsigned bit = 1u << slot;
     if (!(row->present & bit)) {
         __builtin_memcpy(&row->value[slot], &bits, sizeof bits);
-        row->present |= (uint16_t)bit;
+        row->present |= bit;
     }
 }
+
+/* Zero means old record, then dry/I/II/I+II; active modes still unqualified. */
+static inline int sj6_factory_chorus_mode(const sj6_factory_row *row)
+{
+    unsigned mask = row->chorus_flags;
+    if (!mask) return 0;
+    if ((mask & ~3u) != 12u) return -1;
+    return 1 + (mask & 3u);
+}
