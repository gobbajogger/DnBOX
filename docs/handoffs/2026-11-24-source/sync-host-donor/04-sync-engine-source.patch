+    unsigned bit = 1u << lfo;
+    s->lfo_running = (uint8_t)(step ? s->lfo_running | bit : s->lfo_running & ~bit);
+    s->lfo_sync = (uint8_t)(view.present == 3u && view.mode == 0.f ?
+                          s->lfo_sync | bit : s->lfo_sync & ~bit);
