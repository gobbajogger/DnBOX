+static void test_help_copy(void)
+{
+    const char *lines[HELP_LINES];
+    const int buttons[] = {B_FX, B_LFO, B_EDIT, B_GLO, B_ARP, B_SEQ};
+    setup(V_FX, PART_909);
+    int page = cur_page();
+    held_btn = 1u << B_FX;
+    ++now_ms;
+    ui_input_only();
+    now_ms += HELP_HOLD + 1;
+    ui_input_only();
+    CHECK(ui.help == B_FX + 1);
+    ui_frame();
+    shot("help-fx-held");
+    CHECK(help_lines(B_FX, lines) == 1);
+    CHECK(!strcmp(lines[0], "REVERB / DELAY"));
+    held_btn = 0;
+    ++now_ms;
+    ui_input_only();
+    CHECK(!ui.help && ui.view == V_FX && cur_page() == page);
+    ui_frame();
+    shot("help-fx-released");
+    button_tap(B_FX);
+    CHECK(cur_page() != page);
+
+    for (unsigned i = 0; i < sizeof buttons / sizeof buttons[0]; i++) {
+        int n = help_lines(buttons[i], lines);
+        for (int row = 0; row < n; row++) {
+            CHECK(strcmp(lines[row], "TAP: NEXT PAGE"));
+            CHECK(strcmp(lines[row], "TAP: CLOSE"));
+        }
+    }
+    setup(V_HOME, PART_909);
+    int count = help_lines(B_GLO, lines);
+    int clear = 0, copy = 0;
+    for (int row = 0; row < count; row++) {
+        clear |= !strcmp(lines[row], "+ PAD: CLEAR PART");
+        copy |= !strcmp(lines[row], "+ HOLD PAD + PAD: COPY PART");
+    }
+    CHECK(clear && copy);
+    puts("PASS help: compact cards, unique chords, hold/release, and FX paging");
+}
