+"""Init-only development packaging never touches the reserved factory data."""
+import os
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+from tools import build
+
+build.BOARD = 'smk37'
+build.MODEL = 'elite'
+old_lo, old_hi = build.fdata_region()
+assert old_hi > old_lo
+
+def unexpected_factory_read():
+    raise AssertionError('Init-only build tried to read or generate the Synth One factory bank')
+
+os.environ.pop('X0X_SYNTH_CONTROLS_INIT_ONLY',None)
+os.environ['X0X_SUPERJ6_BUILTIN_INIT'] = '1'
+os.environ['X0X_SYNTHONE_PATCH'] = '1'
+build.SUPERJ6_FACTORY = '1'
+build.enable_compact_synthone()
+build.fdata_payload = unexpected_factory_read
+assert build.fdata_image() is None, 'Init-only build must omit, not erase, FDATA'
+assert build.fdata_region() == (old_lo, old_hi), 'Reserved addressing must not change'
+for model in ('elite','pro'):
+    build.MODEL=model
+    assert build.synth_controls_init_only()
+    commands, *_ = build.app_compile_commands([], True, "0")
+    assert any('-DX0X_SYNTH_CONTROLS_INIT_ONLY=1' in command for command in commands)
+    assert not any(str(arg).endswith('/s1pack.c') for command in commands for arg in command)
+print('Init-only package avoids factory payload and preserves original FDATA geometry')
