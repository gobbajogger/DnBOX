            (!(flags & ORIGINAL_SJ6_EXTRA_BIT) || original_sound_sj6_extra_valid(extra)) &&
            (!(flags & ORIGINAL_SJ6_AUTHORED_LFO_BIT) || original_sound_sj6_lfo_words(extra, &words));
 }
