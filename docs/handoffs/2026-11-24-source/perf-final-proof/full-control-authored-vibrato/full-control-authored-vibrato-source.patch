+int original_sound_sj6_vibrato_words(const uint8_t *cell, const uint8_t *wire, float values[2])
+{
+    unsigned present = original_sound_sj6_vibrato_mask(cell);
+    if (!present) return 0;
+    for (unsigned i = 0; i < 2; ++i) {
+        uint32_t word = 0;
+        for (unsigned b = 0; b < 4; ++b) word |= (uint32_t)wire[4u * i + b] << (8u * b);
+        if (present & (1u << i) ? !juno6_vibrato_word_valid(word) : word != 0) return -1;
+        memcpy(&values[i], &word, sizeof word);
+    }
+    return (int)present;
+}
+
+int original_sound_sj6_vibrato_available(const uint8_t *cell, const uint8_t *wire)
+{
+    if (cell[29] != ORIGINAL_SOUND_JUNO || cell[31] > 4u) return 0;
+    if (original_sound_sj6_vibrato_mask(cell)) {
+        float values[2];
+        return original_sound_sj6_vibrato_words(cell, wire, values) > 0;
+    }
+    for (unsigned i = 0; i < ORIGINAL_SJ6_VIBRATO_WIRE_BYTES; ++i)
+        if (wire[i]) return 0;
+    return 1;
+}
+
+void original_sound_sj6_vibrato_store(uint8_t *cell, uint8_t *wire, const float values[2], unsigned present)
+{
+    cell[31] = (uint8_t)(present ? present + 1u : 0u);
+    for (unsigned i = 0; i < 2; ++i) {
+        uint32_t word = 0;
+        if (present & (1u << i)) memcpy(&word, &values[i], sizeof word);
+        for (unsigned b = 0; b < 4; ++b) wire[4u * i + b] = (uint8_t)(word >> (8u * b));
+    }
+}
+
