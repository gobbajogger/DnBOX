+/* Two seven-bit detents in the otherwise forbidden MSBs of Juno panel
+ * bytes 0..12 and 15. No FX bytes, shape tag or shared/extra row used.
+ * Zero is the exact old neutral representation, 101..127 are invalid. */
+static unsigned sj6_fine_byte(unsigned layer, unsigned bit)
+{
+    unsigned i = layer * 7u + bit;
+    return i == 13u ? 15u : i;
+}
+unsigned original_sound_sj6_fine_code(const uint8_t *cell, unsigned layer)
+{
+    unsigned code = 0;
+    for (unsigned i = 0; i < 7u; ++i) code |= (unsigned)(cell[sj6_fine_byte(layer, i)] >> 7) << i;
+    return code;
+}
+unsigned original_sound_sj6_fine(const uint8_t *cell, unsigned layer)
+{
+    unsigned code = original_sound_sj6_fine_code(cell, layer);
+    return code ? code - (code <= SJ6_FINE_CENTER) : SJ6_FINE_CENTER;
+}
+void original_sound_sj6_fine_store(uint8_t *cell, unsigned layer, unsigned pos)
+{
+    unsigned code = pos == SJ6_FINE_CENTER ? 0u : pos + (pos < SJ6_FINE_CENTER);
+    for (unsigned i = 0; i < 7u; ++i) {
+        uint8_t *byte = cell + sj6_fine_byte(layer, i);
+        *byte = (*byte & 127u) | (((code >> i) & 1u) << 7);
+    }
+}
