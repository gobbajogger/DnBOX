+static int sj6_knob_target(int before, int value, int max, int relative)
+{
+    if (relative) {
+        if (value < -before) return 0;
+        if (value > max - before) return max;
+        return before + value;
+    }
+    return value < 0 ? 0 : value > max ? max : value;
+}
