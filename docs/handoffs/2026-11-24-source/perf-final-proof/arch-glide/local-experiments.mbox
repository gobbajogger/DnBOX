Date: Tue, 24 Nov 2026 02:36:27 -0500
Subject: [PATCH 1/2] Bound Synth One delay wrapping without moving the tap

Keep legacy allocator, fractional interpolation and feedback history, but fold exact whole wraps once. Host DSP matches every factory-program audio digest; native real playing and strict heavy gates are still red. Local experiment only.
---
 firmware/src/dsp/s1c/s1c.c | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/firmware/src/dsp/s1c/s1c.c b/firmware/src/dsp/s1c/s1c.c
index db818b71..47c56cc2 100644
--- a/firmware/src/dsp/s1c/s1c.c
+++ b/firmware/src/dsp/s1c/s1c.c
@@ -571,8 +571,18 @@ static float dl_tick_c(s1c_dline *d, float in, float del, float fb, float c)
 /* Device memory model (smallest): exact-size half-float lines carved from a caller-owned pool. */
 static float xl_read(const s1c_dline *d, float del)
 {
+    const uint32_t len = (uint32_t)d->len;   /* device partitions use positive integer lengths */
+    const float ring = (float)len;
     float pos = (float)d->w - del;
-    while (pos < 0.0f) pos += (float)d->len;
+    /* Fold whole negative wraps at once. Within the exact-integer float
+     * range these additions are exact while the position is negative:
+     * each integer shift reduces its magnitude. Keep the final fractional
+     * wrap in the original order; the tap and interpolation are unchanged. */
+    if (pos < -4.0f * ring && pos >= -16777216.0f) {
+        const uint32_t wraps = (uint32_t)(-pos) / len;
+        pos += (float)(wraps * len);
+    }
+    while (pos < 0.0f) pos += ring;
     int i = (int)pos; float f = pos - (float)i;
     int j = i + 1 == d->len ? 0 : i + 1;
     const uint16_t *b = (const uint16_t *)d->buf;
-- 
