+++ b/tests/host/ui_superj6_layer1_prior_reader_test.c
@@ -0,0 +1,25 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+/* Build this unchanged on the prior and new readers; no new API required. */
+#define ARP_FIXTURE_MAIN retained_arp_main
+#include "ui_arp_engine_test.c"
+
+int main(void)
+{
+    uint8_t cell[ORIGINAL_SOUND_BYTES], row[NPARAMS_MAX] = {0};
+    CHECK(original_sound_init(cell, ORIGINAL_SOUND_JUNO, 0));
+    const uint8_t attack = 31;
+    uint8_t positions[SJ6_EXTRA_COUNT] = {attack};
+    original_sound_sj6_extra_store(cell, row, 1u, positions, 0, 0);
+    CHECK(original_sound_sj6_ext_valid(cell, row));
+    row[2] |= 0x80; /* ID72 signed position -12 alongside old AMP1 data. */
+    const unsigned expect_new = !!getenv("SJ6_NEW_READER");
+    CHECK(original_sound_sj6_ext_valid(cell, row) == expect_new);
+    row[0] = 0;
+    row[2] &= 0x80; /* ID72-only extension; mask zero was invalid before. */
+    CHECK(original_sound_sj6_ext_valid(cell, row) == expect_new);
+    for (unsigned i = 2; i <= 6; ++i) row[i] = 0x80; /* Forbidden code 31. */
+    CHECK(!original_sound_sj6_ext_valid(cell, row));
+    puts(expect_new ? "PASS new reader exact plane admission and malformed refusal" :
+           "PASS unmodified prior reader refuses both tuned saves; old extension loads");
+    return 0;
+}
