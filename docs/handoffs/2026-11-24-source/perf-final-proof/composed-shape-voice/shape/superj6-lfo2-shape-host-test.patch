+++ b/tests/host/ui_superj6_lfo2_shape_test.c
@@ -0,0 +1,278 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#define PWM_FIXTURE_MAIN retained_pwm_main
+#include "ui_superj6_pwm1_lfo2_test.c"
+
+/* Build-9 waveform constructors and first-route law, kept out of the DSP. */
+static float source_raw(unsigned shape, unsigned phase, float base, float depth)
+{
+    float wave, amount;
+    switch (shape) {
+    case 0: {
+        const unsigned bin = (phase + 64) % 256;
+        wave = bin < 128 ? 4.f * bin / 256.f - 1.f : 3.f - 4.f * bin / 256.f;
+        amount = wave * depth * .5f;
+        break;
+    }
+    case 1:
+        wave = (phase + phase) / 256.f - 1.f;
+        amount = depth * ((wave + 1.f) / 2.f);
+        break;
+    case 2:
+        wave = 1.f - (phase + phase) / 256.f;
+        amount = depth * ((wave - 1.f) / 2.f);
+        break;
+    default:
+        wave = (phase + 128) % 256 < 128 ? -1.f : 1.f;
+        amount = wave * depth * .5f;
+        break;
+    }
+    const float value = amount + base;
+    return value < 0.f ? 0.f : value > 1.f ? 1.f : value;
+}
+
+static float captured_raw;
+static unsigned captures;
+int __real_dnbx_pwm_from_unit(float raw, float *duty);
+int __wrap_dnbx_pwm_from_unit(float raw, float *duty)
+{
+    captured_raw = raw;
+    ++captures;
+    return __real_dnbx_pwm_from_unit(raw, duty);
+}
+
+static void exact_receiver(unsigned layer, unsigned shape)
+{
+    const float base = layer ? .8f : .2f;
+    const unsigned depth = 109;
+    const float amount = depth * (1.f / 127.f);
+    const unsigned setting = (layer + 1u) << SJ6_LFO2_PWM_ROUTE_SHIFT;
+    juno6_t voice;
+    juno6_init(&voice, RATE);
+    juno6_oscillator_edit square = {1.f, base, 1.f};
+    juno6_apply_pre_note_wave(&voice, layer, &square);
+    juno6_set_panel_lfo_rate(&voice, 1, 127);
+    CHECK(juno6_note_on(&voice, 57, 127));
+    for (unsigned bin = 0; bin < 256; ++bin) {
+        juno6_t probe = voice;
+        probe.lfo_phase_q40[1] = (uint64_t)bin << 32;
+        juno6_set_lfo2_pwm(&probe, setting | depth);
+        juno6_set_lfo2_shape(&probe, shape);
+        captures = 0;
+        CHECK(juno6_render_stereo(&probe, actual[0], actual[1], 1));
+        CHECK(captures == 1 && captured_raw == source_raw(shape, bin, base, amount));
+    }
+    juno6_t oracle = voice;
+    juno6_set_lfo2_pwm(&voice, setting | depth);
+    juno6_set_lfo2_shape(&voice, shape);
+    const unsigned uneven[] = {137, 87, 257, 311};
+    for (unsigned n = 0, i = 0; n < COUNT; ++i) {
+        unsigned span = uneven[i % 4];
+        if (span > COUNT - n) span = COUNT - n;
+        CHECK(juno6_render_stereo(&voice, actual[0]+n, actual[1]+n, span));
+        n += span;
+    }
+    uint64_t turn = UINT64_C(1) << 40;
+    uint64_t step = (uint64_t)(16.f * ((float)turn / RATE) + .5f);
+    for (unsigned n = 0, tick = 0; n < COUNT; ++tick) {
+        unsigned end = (tick + 1u) * RATE / 80u;
+        if (end > COUNT) end = COUNT;
+        unsigned bin = (unsigned)(((n * step) % turn) >> 32);
+        float raw = source_raw(shape, bin, base, amount);
+        oracle.core.layer[layer].params.pulse_width = .5f - .47f * raw;
+        CHECK(juno6_render_stereo(&oracle, expected[0]+n, expected[1]+n, end-n));
+        n = end;
+    }
+    CHECK(!memcmp(actual, expected, sizeof actual));
+    CHECK(voice.core.layer[layer].params.pulse_width == .5f - .47f * base);
+    CHECK(juno6_knob_position(&voice, SJ6_LFO2_PWM_ROUTE) == layer + 1u);
+    CHECK(juno6_knob_position(&voice, SJ6_LFO2_PWM_DEPTH) == depth);
+    CHECK(juno6_knob_position(&voice, SJ6_LFO2_SHAPE) == shape);
+}
+
+static void check_markers(void)
+{
+    const unsigned old[] = {0, 1, 2, 3, 4, 8, 9, 10, 11, 12};
+    for (unsigned i = 0; i < sizeof old / sizeof old[0]; ++i) {
+        uint8_t cell[ORIGINAL_SOUND_BYTES];
+        CHECK(original_sound_init(cell, ORIGINAL_SOUND_JUNO, 0));
+        cell[31] = (uint8_t)old[i];
+        CHECK(original_sound_valid(cell) && original_sound_sj6_shape(cell) == SJ6_LFO_TRI);
+        for (unsigned shape = 1; shape <= SJ6_LFO2_SHAPE_MAX; ++shape) {
+            original_sound_sj6_shape_store(cell, shape);
+            CHECK(original_sound_valid(cell) && original_sound_sj6_shape(cell) == shape);
+            CHECK((cell[31] & 15u) == old[i]);
+        }
+        original_sound_sj6_shape_store(cell, 0);
+        CHECK(cell[31] == old[i]);
+    }
+    uint8_t cell[ORIGINAL_SOUND_BYTES], wire[NPARAMS_MAX] = {0};
+    CHECK(original_sound_init(cell, ORIGINAL_SOUND_JUNO, 0));
+    original_sound_sj6_shape_store(cell, SJ6_LFO_UP);
+    const float vib[2] = {.23f, .67f};
+    original_sound_sj6_vibrato_store(cell, wire, vib, 3);
+    original_sound_sj6_a_reference_store(cell, wire, .71f, 1);
+    CHECK(original_sound_bass_shared_size(cell, wire) == ORIGINAL_SJ6_TUNING_WIRE_BYTES);
+    CHECK(original_sound_sj6_shape(cell) == SJ6_LFO_UP);
+    float found[2], a;
+    CHECK(original_sound_sj6_vibrato_words(cell, wire, found) == 3 && !memcmp(found, vib, sizeof vib));
+    CHECK(original_sound_sj6_a_reference_word(cell, wire, &a) == 1 && a == .71f);
+    original_sound_sj6_shape_store(cell, SJ6_LFO_DOWN);
+    CHECK(original_sound_sj6_vibrato_words(cell, wire, found) == 3 && !memcmp(found, vib, sizeof vib));
+    CHECK(original_sound_sj6_a_reference_word(cell, wire, &a) == 1 && a == .71f);
+    const unsigned invalid[] = {16, 32, 48, 64, 128, 144 + 5, 192, 240, 255};
+    for (unsigned i = 0; i < sizeof invalid / sizeof invalid[0]; ++i) {
+        cell[31] = (uint8_t)invalid[i];
+        CHECK(!original_sound_valid(cell) && original_sound_bass_shared_size(cell, wire) < 0);
+    }
+    CHECK(original_sound_init(cell, ORIGINAL_SOUND_SYNTHONE, 0));
+    cell[31] = 144;
+    CHECK(!original_sound_valid(cell));
+    puts("old Juno marks and exact vibrato/A REF wire coexist, invalid and foreign marks refused");
+}
+
+static void edit_shape(int position)
+{
+    visit("LFO RATE");
+    pref_t ref = pg.r[cur_page()][3];
+    const x0x_param_t *desc = pref_desc(ref);
+    CHECK(desc && desc->names && !strcmp(desc->name, "LFO 2 SHAPE"));
+    CHECK(desc->max == 3 && !strcmp(desc->names[position],
+          ((const char *const[]){"TRI", "RAMP UP", "RAMP DOWN", "SQUARE"})[position]));
+    panel_turn(3, SJ6_LFO2_SHAPE, position);
+}
+
+static int panel_shape(unsigned owner)
+{ return engine_superj6_knob_position(owner, SJ6_LFO2_SHAPE); }
+
+static void check_note_lock(unsigned owner)
+{
+    CHECK(panel_shape(owner) == SJ6_LFO_SQUARE);
+    engine_note_lock_capture(1);
+    CHECK(!engine_bass_note_capture(proj.arr.lane, 0, owner, 0, &proj.sound));
+    engine_note_lock_capture(0);
+    CHECK(!engine_bass_note_validate(&proj.arr.lane[0]));
+    edit_shape(SJ6_LFO_UP);
+    render(1);
+    CHECK(panel_shape(owner) == SJ6_LFO_UP);
+    bpart_t *line = &proj.pat[0].bass[owner];
+    for (unsigned n = 0; n < NSTEPS; ++n) line->step[n].flags = G_REST;
+    line->len = 16;
+    line->rate = RATE_16;
+    line->dir = DIR_FWD;
+    line->transpose = 24;
+    line->step[0].flags = G_NOTE;
+    line->step[0].note = 45;
+    line->step[0].velocity = 100;
+    seq.ppat[TRK_BASS0 + owner] = 0;
+    engine_note_lock_refresh();
+    engine_bass_edit_hold(1);
+    edit_shape(SJ6_LFO_DOWN);
+    seq_start(&seq);
+    for (unsigned n = 0; n < 2000 && panel_shape(owner) != SJ6_LFO_SQUARE; ++n) render(1);
+    CHECK(panel_shape(owner) == SJ6_LFO_SQUARE && !engine_superj6_knob_pending());
+    CHECK(!engine_superj6_knob_turn(owner, SJ6_LFO2_SHAPE, SJ6_LFO_TRI, 0));
+    seq_stop(&seq);
+    engine_bass_edit_hold(0);
+    render(4);
+    CHECK(panel_shape(owner) == SJ6_LFO_UP);
+    CHECK(panel_shape(1 - owner) == SJ6_LFO_TRI);
+}
+
+static void playback(unsigned owner, unsigned layer)
+{
+    setup(V_PART, PART_303A + owner);
+    proj.set.bt |= PROJ_BT_CLK_IN;
+    select_owner(owner, 0);
+    select_owner(1 - owner, 0);
+    isolate_dry_pair();
+    visit("OSCILLATOR");
+    panel_turn(layer, SJ6_WAVE1 + layer, 3);
+    render(1);
+    visit("PULSE WIDTH");
+    panel_turn(2u * layer, layer ? SJ6_PWM2_ON : SJ6_PWM1_ON, 1);
+    render(1);
+    visit("LFO2 PWM");
+    panel_turn(0, SJ6_LFO2_RATE, 127);
+    panel_turn(2, SJ6_LFO2_PWM_ROUTE, (int)layer + 1);
+    panel_turn(3, SJ6_LFO2_PWM_BASE, 63);
+    render(1);
+    const sound_t zero_depth = proj.sound;
+    begin_pair();
+    capture(pcm[0]);
+    for (int shape = 1; shape <= SJ6_LFO2_SHAPE_MAX; ++shape) {
+        proj.sound = zero_depth;
+        begin_pair();
+        edit_shape(shape);
+        capture(pcm[1]);
+        CHECK(!memcmp(pcm[0], pcm[1], sizeof pcm[0]));
+    }
+
+    proj.sound = zero_depth;
+    begin_pair();
+    visit("LFO2 PWM");
+    panel_turn(1, SJ6_LFO2_PWM_DEPTH, 101);
+    render(1);
+    const sound_t triangle = proj.sound;
+    begin_pair();
+    capture(pcm[0]);
+    CHECK(changed(pcm[0], silence, owner) > COUNT / 2);
+    CHECK(changed(pcm[0], silence, 1 - owner) > COUNT / 2);
+    for (int shape = 1; shape <= SJ6_LFO2_SHAPE_MAX; ++shape) {
+        proj.sound = triangle;
+        begin_pair();
+        edit_shape(shape);
+        CHECK(original_sound_sj6_shape(proj.sound.v[T_303][owner]) == SJ6_LFO_TRI);
+        capture(pcm[1]);
+        CHECK(changed(pcm[0], pcm[1], owner) > COUNT / 2);
+        CHECK(!changed(pcm[0], pcm[1], 1 - owner));
+        CHECK(panel_shape(owner) == shape && panel_shape(1 - owner) == SJ6_LFO_TRI);
+        printf("part=%u PWM%u held shape=%d changed=%u peer=0\n",
+               owner, layer + 1, shape, changed(pcm[0], pcm[1], owner));
+    }
+    begin_pair();
+    capture(pcm[0]);
+    save_and_reload();
+    begin_pair();
+    capture(pcm[1]);
+    CHECK(!memcmp(pcm[0], pcm[1], sizeof pcm[0]) && panel_shape(owner) == SJ6_LFO_SQUARE);
+    visit("LFO2 PWM");
+    panel_turn(2, SJ6_LFO2_PWM_ROUTE, 0);
+    render(1);
+    const sound_t bypass = proj.sound;
+    begin_pair();
+    capture(pcm[0]);
+    begin_pair();
+    edit_shape(SJ6_LFO_UP);
+    capture(pcm[1]);
+    CHECK(!memcmp(pcm[0], pcm[1], sizeof pcm[0]) && panel_shape(owner) == SJ6_LFO_UP);
+    proj.sound = bypass;
+    begin_pair();
+    edit_shape(SJ6_LFO_UP);
+    CHECK(!engine_bass_select_preset(owner, ORIGINAL_SOUND_JUNO, 1, &proj.sound));
+    engine_bass_off(owner);
+    for (unsigned n = 0; n < 1024 && engine_bass_preset_pending(owner); ++n) render(1);
+    CHECK(!engine_bass_preset_pending(owner) && panel_shape(owner) == SJ6_LFO_TRI);
+    proj.sound = bypass;
+    engine_apply_sound(&proj.sound);
+    render(8);
+    check_note_lock(owner);
+    printf("part=%u PWM%u zero depth, route OFF, exact reload, old marker, preset and note locks PASS\n",
+           owner, layer + 1);
+}
+
+int main(void)
+{
+    const char *which = getenv("SJ6_SHAPE_CASE");
+    CHECK(which && strlen(which) == 2);
+    if (!strcmp(which, "or")) {
+        check_markers();
+        for (unsigned layer = 0; layer < 2; ++layer)
+            for (unsigned shape = 0; shape <= SJ6_LFO2_SHAPE_MAX; ++shape)
+                exact_receiver(layer, shape);
+        puts("2048 phase/shape/receiver raw comparisons and 65536 stereo frames matched the Build-9 law");
+    } else {
+        CHECK(which[0] >= '0' && which[0] <= '1' && which[1] >= '0' && which[1] <= '1');
+        playback((unsigned)(which[0] - '0'), (unsigned)(which[1] - '0'));
+    }
+    return 0;
+}
