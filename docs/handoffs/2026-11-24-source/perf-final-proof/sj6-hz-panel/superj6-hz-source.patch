+/* Rates occupy three exact little-endian binary32 words. Each accepted Hz
+ * mode is encoded as absent, +0, -0, or +1, preserving all authored bits. */
+int original_sound_sj6_lfo_words(const uint8_t *extra, juno6_lfo_words *out)
+{
+    *out = (juno6_lfo_words){0};
+    const uint8_t *p = extra + ORIGINAL_SJ6_EXTRA_SIZE;
+    unsigned tags = p[12] | (unsigned)p[13] << 8;
+    if (!tags || tags >> 9) return 0;
+    for (unsigned i = 0; i < SJ6_LFO_COUNT; ++i) {
+        uint32_t bits = 0;
+        for (unsigned b = 0; b < 4; ++b) bits |= (uint32_t)p[4 * i + b] << (8 * b);
+        if (tags & (1u << i)) {
+            memcpy(&out->word[i], &bits, sizeof bits);
+            if (!(out->word[i] >= 0.f && out->word[i] <= 1.f)) return 0;
+            out->present |= 1u << i;
+        } else if (bits) return 0;
+        unsigned mode = (tags >> (3u + 2u * i)) & 3u;
+        if (mode) {
+            const uint32_t exact[] = {0, 0, UINT32_C(0x80000000), UINT32_C(0x3f800000)};
+            memcpy(&out->word[SJ6_LFO_COUNT + i], &exact[mode], sizeof bits);
+            out->present |= 1u << (SJ6_LFO_COUNT + i);
+        }
+    }
+    return 1;
+}
+
+void original_sound_sj6_lfo_store(uint8_t *cell, uint8_t *extra, const juno6_lfo_words *words)
+{
+    uint32_t flags = original_sound_edit_mask(cell);
+    /* A cold authored selection supersedes only the previous rate overrides. */
+    if (flags & ORIGINAL_SJ6_EXTRA_BIT) {
+        const unsigned first_rate = SJ6_LFO1_RATE - SJ6_OSC_KNOBS;
+        unsigned mask = original_sound_sj6_extra_mask(extra) & ((1u << first_rate) - 1u);
+        memset(extra + 2 + first_rate, 0, SJ6_LFO_COUNT);
+        extra[0] = (uint8_t)mask;
+        extra[1] = (uint8_t)(mask >> 8);
+        if (!mask) flags &= ~ORIGINAL_SJ6_EXTRA_BIT;
+    }
+    if (words->present || (flags & ORIGINAL_SJ6_AUTHORED_LFO_BIT)) {
+        uint8_t *p = extra + ORIGINAL_SJ6_EXTRA_SIZE;
+        unsigned tags = words->present & 7u;
+        for (unsigned i = 0; i < SJ6_LFO_COUNT; ++i) {
+            uint32_t bits = 0;
+            if (words->present & (1u << i)) memcpy(&bits, &words->word[i], sizeof bits);
+            for (unsigned b = 0; b < 4; ++b) p[4 * i + b] = (uint8_t)(bits >> (8 * b));
+            if (words->present & (1u << (SJ6_LFO_COUNT + i))) {
+                memcpy(&bits, &words->word[SJ6_LFO_COUNT + i], sizeof bits);
+                unsigned mode = bits == UINT32_C(0x3f800000) ? 3u : bits == UINT32_C(0x80000000) ? 2u : 1u;
+                tags |= mode << (3u + 2u * i);
+            }
+        }
+        p[12] = (uint8_t)tags;
+        p[13] = (uint8_t)(tags >> 8);
+        flags &= ~ORIGINAL_SJ6_AUTHORED_LFO_BIT;
+        if (tags) flags |= ORIGINAL_SJ6_AUTHORED_LFO_BIT;
+    }
+    original_sound_put_mask(cell, flags);
+}
+
