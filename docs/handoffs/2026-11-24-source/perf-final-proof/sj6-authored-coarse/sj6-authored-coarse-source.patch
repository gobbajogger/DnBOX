+#if X0X_SUPERJ6_BUILTIN_INIT
+static inline unsigned sj6_factory_semi_word(uint32_t bits)
+{
+    if (bits == UINT32_C(0x80000000)) bits = 0; /* -0 */
+    if (bits > UINT32_C(0x3f800000)) return 255u;
+    /* All u < 1/64 round to -12. Every Float32 from 1/64 to 1 is
+     * represented exactly at Q29. Compute 24u at Q26, no FP64 needed.
+     * For u below 1/2 an exact tie rounds towards the lower integer. */
+    unsigned exponent = bits >> 23;
