+    uint32_t scaled = ((UINT32_C(0x00800000) | (bits & UINT32_C(0x007fffff))) <<
+                       (exponent - 121u)) * 3u;
+    return 1u + ((scaled + (1u << 25) - (bits < UINT32_C(0x3f000000))) >> 26);
+}
+#endif
