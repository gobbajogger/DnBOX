+def canonical_column(lengths):
+    """Choose equal-length symbol order to shrink the exact v1 dictionary.
+
+    Keep the same alphabet and prefix lengths. For each Golomb parameter,
+    pick an ascending or descending traversal for each length's rank bin.
+    Two endpoint states per bin suffice; ESC never occupies a dictionary word.
+    """
+    groups = [(width, [x for x in sorted(lengths) if x >= 0 and lengths[x] == width])
+              for width in range(1, max(lengths.values()) + 1)]
+    best = None
+    for k in range(16):
+        def bits(delta):
+            return 2 * (zig(delta) + (1 << k)).bit_length() - 1 - k
+
+        paths = {0: (0, [])}
+        for width, ranks in groups:
+            if not ranks:
+                continue
+            next_paths = {}
+            for walk in (ranks, ranks[::-1]):
+                inside = sum(bits(b - a) for a, b in zip(walk, walk[1:]))
+                candidate = min((cost + bits(walk[0] - end) + inside, history + [(width, walk)])
+                                for end, (cost, history) in paths.items())
+                if walk[-1] not in next_paths or candidate < next_paths[walk[-1]]:
+                    next_paths[walk[-1]] = candidate
+            paths = next_paths
+        candidate = min(paths.values())
+        if best is None or candidate < best:
+            best = candidate
+
+    chosen = dict(best[1])
+    order = []
+    for width in range(1, max(lengths.values()) + 1):
+        if lengths.get(ESC) == width:
+            order.append(ESC)
+        order.extend(chosen.get(width, ()))
+    rank = {symbol: i for i, symbol in enumerate(order)}
+    return canonical(lengths, rank.__getitem__)
