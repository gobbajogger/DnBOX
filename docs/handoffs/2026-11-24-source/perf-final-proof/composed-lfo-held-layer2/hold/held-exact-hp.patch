+/* Actual compact renderer: the next grid tick uses the newly selected
+ * sync rate, without resetting accumulated hold or oscillator phase. */
+static void hold_clock(void)
+{
+    static juno6_t test;
+    float l[64], r[64];
+    juno6_init(&test,16000.f);
+    const uint64_t seed=test.lfo2_entropy_state;
+    juno6_lfo_words words={.present=0x12};
+    words.word[1]=1.f;
+    words.word[4]=1.f;
+    juno6_set_lfo_words(&test,&words,1);
+    juno6_set_lfo2_shape(&test,SJ6_LFO_HELD);
+    CHECK(juno6_render_stereo(&test,l,r,1));
+    CHECK(test.lfo2_hold_elapsed==1.f/80.f && test.lfo2_hold_sample==0.f && test.lfo2_entropy_state!=seed);
+    uint64_t phase=test.lfo_phase_q40[1];
+    juno6_set_lfo_tempo(&test,120.f);
+    juno6_set_panel_lfo(&test,1,-1,0);
+    CHECK(test.lfo2_hold_period==1.f/32.f && test.lfo_phase_q40[1]==phase);
+    for (unsigned n=199;n;) {unsigned span=n>64?64:n;CHECK(juno6_render_stereo(&test,l,r,span));n-=span;}
+    CHECK(test.lfo2_hold_elapsed==1.f/80.f);
+    CHECK(juno6_render_stereo(&test,l,r,1));
+    CHECK(test.lfo2_hold_elapsed==2.f/80.f && test.lfo2_hold_sample==0.f);
+    phase=test.lfo_phase_q40[1];
+    juno6_set_lfo_tempo(&test,240.f);
+    CHECK(test.lfo2_hold_period==1.f/64.f && test.lfo_phase_q40[1]==phase);
+    for (unsigned n=199;n;) {unsigned span=n>64?64:n;CHECK(juno6_render_stereo(&test,l,r,span));n-=span;}
+    CHECK(test.lfo2_hold_sample==0.f);
+    CHECK(juno6_render_stereo(&test,l,r,1));
+    CHECK(test.lfo2_hold_sample!=0.f && test.lfo2_hold_elapsed==0.f);
+    const float held=test.lfo2_hold_sample;phase=test.lfo_phase_q40[1];
+    juno6_set_lfo2_shape(&test,SJ6_LFO_TRI);
+    CHECK(juno6_render_stereo(&test,l,r,64));
+    CHECK(test.lfo2_hold_sample==held && test.lfo2_hold_elapsed==0.f && phase!=test.lfo_phase_q40[1]);
+    juno6_set_lfo_words(&test,&words,1);
+    CHECK(test.lfo2_hold_sample==0.f && test.lfo2_hold_elapsed==0.f && !test.lfo_phase_q40[1]);
+    puts("PASS compact hold elapsed: same-grid-tick sync/rate change, bypass cadence, non-selected hold, reset and independent oscillator phase");
+}
