+/* SPDX-License-Identifier: GPL-3.0-only
+ * Independent host oracle for the Build-9 bounded entropy and compact tick. */
+#include <assert.h>
+#include <stdio.h>
+#include <stdint.h>
+#include "dsp/juno6_lfo_hold.h"
+#include "app/superj6_factory.h"
+
+struct script {const uint64_t *word; unsigned used, length;};
+static uint64_t fixed(void *ctx)
+{
+    struct script *s=ctx;
+    assert(s->used<s->length);
+    return s->word[s->used++];
+}
+static uint64_t roll(uint64_t *state)
+{
+    uint64_t x=*state;
+    x ^= x << 13; x ^= x >> 7; x ^= x << 17;
+    return *state=x;
+}
+int main(void)
+{
+    uint64_t state=UINT64_C(0xf50ddb45c5330df1);
+    const uint64_t span=UINT64_C(9007199254740993);
+    const uint64_t middle=UINT64_C(1)<<52;
+    unsigned rejects=0;
+    for (unsigned i=0;i<16384;i++) {
+        uint64_t x=roll(&state),y=roll(&state);
+        assert(sj6_held_high(x,y)==(uint64_t)(((__uint128_t)x*y)>>64));
+        const uint64_t probe[]={x,y,UINT64_MAX};
+        struct script text={probe,0,3};
+        uint64_t got=0,want=0;
+        unsigned expected=0;
+        do {
+            __uint128_t prod=(__uint128_t)probe[expected++]*span;
+            if((uint64_t)prod>=-span%span){want=(uint64_t)(prod>>64);break;}
+            rejects++;
+        } while(expected<3);
+        assert(sj6_held_bound(fixed,&text,span,-span%span,&got) && got==want && text.used==expected);
+        assert(sj6_held_center(got)==(float)(((double)got-(double)middle)*0x1p-52));
+    }
+    assert(rejects);
+    const uint32_t control_boundary[]={0,0x80000000u,0x3e7fffffu,0x3e800000u,
+        0x3effffffu,0x3f000000u,0x3f3fffffu,0x3f400000u,0x3f7fffffu,0x3f800000u,
+        0x3f800001u,0x80000001u,0x7f800000u,0x7fc00000u};
+    for (unsigned i=0;i<sizeof control_boundary/sizeof *control_boundary;++i) {
+        sj6_factory_row row={0};
+        uint32_t raw=control_boundary[i];
+        union {uint32_t u; float f;} input={.u=raw};
+        unsigned expected=(input.f>=0.f && input.f<=1.f)?(unsigned)((double)input.f*4.)+1u:255u;
+        sj6_factory_add_word(&row,98,raw);
+        assert(row.lfo2_authored==expected);
+        sj6_factory_add_word(&row,98,0x3f800000u);
+        assert(row.lfo2_authored==expected); /* first exact field wins */
+    }
+
+    for (int i=-512;i<=512;i++) {
+        uint64_t x=middle+i;
+        assert(sj6_held_center(x)==(float)(i*0x1p-52));
+    }
+    assert(sj6_held_center(0)==-1.f && sj6_held_center(middle*2)==1.f);
+
+    const uint64_t ticks[]={UINT64_MAX,UINT64_MAX,UINT64_MAX,UINT64_MAX,0,1};
+    struct script tape={ticks,0,6};
+    float elapsed=.375f, held=.25f;
+    /* Same-tick threshold after a rate change: equality refreshes, first
+     * 4 words are discarded table staging, word zero rejected before -1. */
+    assert(sj6_held_tick(&elapsed,&held,.125f,.5f,fixed,&tape));
+    assert(elapsed==0 && held==-1 && tape.used==6);
+    tape.used=0;elapsed=.375f;held=.25f;
+    assert(sj6_held_tick(&elapsed,&held,0,.5f,fixed,&tape) && tape.used==4);
+    assert(elapsed==.375f && held==.25f);
+    tape.used=0;
+    assert(sj6_held_tick(&elapsed,&held,.25f,0,fixed,&tape) && tape.used==4);
+    assert(elapsed==.625f && held==.25f);
+    tape.used=0;
+    assert(sj6_held_tick(&elapsed,&held,.25f,.5f,fixed,&tape));
