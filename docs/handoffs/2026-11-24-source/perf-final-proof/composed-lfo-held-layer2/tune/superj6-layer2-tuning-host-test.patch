@@ -0,0 +1,29 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#define ARP_FIXTURE_MAIN retained_arp_main
+#include "ui_arp_engine_test.c"
+
+int main(void)
+{
+    uint8_t cell[ORIGINAL_SOUND_BYTES], row[NPARAMS_MAX] = {0};
+    CHECK(original_sound_init(cell, ORIGINAL_SOUND_JUNO, 0));
+    enum { link = SJ6_FILTER_LINK - SJ6_OSC_KNOBS };
+    uint8_t positions[SJ6_EXTRA_COUNT] = {[link] = 1};
+    const unsigned expect_new = !!getenv("SJ6_NEW_READER");
+    original_sound_sj6_extra_store(cell, row, 1u << link, positions, 0, 0);
+    row[2] = 0x80; /* Existing ID72 alongside real Filter Link. */
+    CHECK(original_sound_sj6_ext_valid(cell, row));
+    row[2 + link] = (24u << 1) | 1;
+    CHECK(original_sound_sj6_ext_valid(cell, row) == expect_new);
+    CHECK(original_sound_sj6_semi(row) == 0);
+    row[2 + link] = (25u << 1) | 1;
+    CHECK(!original_sound_sj6_ext_valid(cell, row));
+    row[2 + link] = 0x80 | 1;
+    CHECK(!original_sound_sj6_ext_valid(cell, row));
+    row[2] = 0;
+    row[0] = row[1] = 0;
+    row[2 + link] = 2; /* ID73-only. */
+    CHECK(original_sound_sj6_ext_valid(cell, row) == expect_new);
+    puts(expect_new ? "PASS new ID73 extends ID72 reader without dropping filter-link validation" :
+           "PASS previous ID72 reader rejects ID73-only and mixed edited payloads");
+    return 0;
+}
