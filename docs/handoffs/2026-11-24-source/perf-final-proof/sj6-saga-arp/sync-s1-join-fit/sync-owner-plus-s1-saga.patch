+/* The original sorts the pitches across all tiers before choosing a note.
+ * Sort only on an event, with bounded scratch and no second clock/state machine. */
+static NoteNumber saga_note(const NoteNumber *held, int count, int octaves,
+                           int interval, int mode, int index)
+{
+    NoteNumber notes[S1_SEQ_MAX_HELD * 4];
+    int size = 0;
+    for (int h = 0; h < count; ++h) for (int oct = 0; oct < octaves; ++oct) {
+        unsigned pitch = held[h].noteNumber + oct * interval;
+        int slot = size++;
+        while (slot > 0 && notes[slot - 1].noteNumber > pitch) {
+            notes[slot] = notes[slot - 1];
+            --slot;
+        }
+        notes[slot] = (NoteNumber){(uint8_t)pitch, held[h].velocity};
+    }
+    if (mode == ArpeggiatorMode_Down) index = size - 1 - index;
+    else {
+        if (mode == ArpeggiatorMode_UpDownRepeat) index /= 2;
+        if (index >= size) index = 2 * size - 2 - index;
+    }
+    NoteNumber note = notes[index];
+    note.noteNumber = (uint8_t)saga_clip(note.noteNumber);
+    return note;
