+/* Explicit LFO2 first route to live receiver 78. Column 0 of the Build-9
+ * wave row is a 256-entry triangle rotated by 64 entries. Apply its
+ * bipolar amount before the existing PWM conversion. Sample the audio
+ * clock at the nominal 80 Hz control cadence, independent of block size. */
+static int render_lfo2_pwm1(juno6_t *s, float *left, float *right, unsigned frames)
+{
+    const unsigned tick_hz = 80;
+    const unsigned sample_rate = (unsigned)s->sample_rate;
+    dnbx_layer_params *layer = &s->core.layer[0].params;
+    const float base = s->core.raw[78];
+    const float depth = (s->lfo2_pwm1 & SJ6_LFO2_PWM1_DEPTH_MASK) * (1.f / 127.f);
+    const float saved_width = layer->pulse_width, saved_depth = layer->lfo_pwm_depth;
+    unsigned until_tick = s->lfo2_pwm1_until_tick;
+    uint64_t phase = s->lfo_phase_q40[1];
+    int result = DNBX_OK;
+    layer->lfo_pwm_depth = 0.f;
+    while (frames) {
+        if (until_tick < tick_hz) {
+            s->lfo2_pwm1_index = (uint8_t)((phase >> 32) + 64u);
+            until_tick += sample_rate;
+        }
+        unsigned index = s->lfo2_pwm1_index;
+        float wave = index < 128 ? index * (1.f / 64.f) - 1.f : 3.f - index * (1.f / 64.f);
+        float raw = fm_clampf(base + (wave * depth) * .5f, 0.f, 1.f);
+        (void)dnbx_pwm_from_unit(raw, &layer->pulse_width);
+        unsigned count = until_tick / tick_hz;
+        if (count > frames) count = frames;
+        result = dnbx_render(&s->core, left, right, count, 0);
+        if (result != DNBX_OK) break;
+        until_tick -= count * tick_hz;
+        phase += (uint64_t)s->lfo_step_q40[1] * count;
+        frames -= count;
+        left += count;
+        right += count;
+    }
+    s->lfo2_pwm1_until_tick = until_tick;
+    layer->pulse_width = saved_width;
+    layer->lfo_pwm_depth = saved_depth;
+    return result;
+}
