diff --git a/firmware/src/app/original_sound.c b/firmware/src/app/original_sound.c
--- a/firmware/src/app/original_sound.c
+++ b/firmware/src/app/original_sound.c
@@ -571,7 +571,11 @@
 
 /* A zero legacy header was invalid for every marked Synth One record. The
  * wet format uses it without borrowing any more of the 15-byte lock tail. */
-enum { S1_MIX_RADIX = 129, S1_MIX_PAIR = S1_MIX_RADIX * S1_MIX_RADIX };
+enum { S1_MIX_RADIX = 129, S1_MIX_PAIR = S1_MIX_RADIX * S1_MIX_RADIX,
+       S1_REVERB_HP_MARK = 0xf8u };
+/* With high=31, even the shortest nonzero legacy LFO suffix is invalid.
+ * Byte zero can therefore hold an optional Reverb HP stop on the same record. */
+_Static_assert(S1_LFO_GROUP_STATES < 30u * 65535u + 1u, "reverb HP marker must fail legacy decoding");
 #define S1_DIGIT(slot) ((slot) - S1_EXTRA_FIRST)
 static const uint8_t s1_packed_pairs[][2] = {
     {S1_DIGIT(S1_OSC1_MORPH), S1_DIGIT(S1_OSC2_MORPH)},
@@ -609,7 +613,9 @@
 
 static int s1_read_packed(const uint8_t *data, s1_extra_state *state)
 {
-    if (data[S1_EXTRA_BYTES-1] & 0xc0u) return 0;
+    const unsigned reverb_hp = data[1] == S1_REVERB_HP_MARK ? data[0] : 0u;
+    if ((data[1] == S1_REVERB_HP_MARK && !reverb_hp) || reverb_hp >= S1_MIX_RADIX ||
+        (data[S1_EXTRA_BYTES-1] & 0xc0u)) return 0;
     unsigned at = 16;
     for (unsigned i = 0; i < sizeof s1_packed_pairs / sizeof s1_packed_pairs[0]; ++i) {
         unsigned pair = s1_take_bits(data, &at, 15);
@@ -625,16 +631,19 @@
     }
     unsigned ordinal = s1_take_bits(data, &at, 21);
     unsigned wet = s1_take_bits(data, &at, 15);
-    if (ordinal >= S1_LFO_GROUP_STATES || !wet || wet >= S1_MIX_PAIR) return 0;
+    if (ordinal >= S1_LFO_GROUP_STATES || (!wet && !reverb_hp) || wet >= S1_MIX_PAIR) return 0;
     s1_lfo_digits(ordinal, state->lfo);
     state->wet[0] = (uint8_t)(wet / S1_MIX_RADIX);
     state->wet[1] = (uint8_t)(wet % S1_MIX_RADIX);
+    state->wet[S1_REVERB_HP - S1_WET_FIRST] = (uint8_t)reverb_hp;
     return 1;
 }
 
 static void s1_write_packed(uint8_t *dest, const s1_extra_state *state)
 {
     uint8_t data[S1_EXTRA_BYTES] = {0};
+    const uint8_t reverb_hp = state->wet[S1_REVERB_HP - S1_WET_FIRST];
+    if (reverb_hp) { data[0] = reverb_hp; data[1] = S1_REVERB_HP_MARK; }
     unsigned at = 16;
     for (unsigned i = 0; i < sizeof s1_packed_pairs / sizeof s1_packed_pairs[0]; ++i)
         s1_put_bits(data, &at, 15, S1_MIX_RADIX * state->panel[s1_packed_pairs[i][0]] +
@@ -671,7 +680,8 @@
 int s1_extra_read(const uint8_t *data, s1_extra_state *state)
 {
     s1_extra_state next = {0};
-    if (data && !(s1_extra_packed(data) ? s1_read_packed(data, &next) : s1_read_legacy(data, &next)))
+    if (data && !((s1_extra_packed(data) || data[1] == S1_REVERB_HP_MARK) ?
+                     s1_read_packed(data, &next) : s1_read_legacy(data, &next)))
         return 0;
     *state = next;
     return 1;
@@ -718,7 +728,7 @@
         if (position > s1_patch_steps(slot)) return 0;
         state.panel[slot-S1_EXTRA_FIRST] = (uint8_t)(position + 1u);
     }
-    if (state.wet[0] || state.wet[1]) s1_write_packed(extra, &state);
+    if (state.wet[0] || state.wet[1] || state.wet[S1_REVERB_HP - S1_WET_FIRST]) s1_write_packed(extra, &state);
     else if (slot >= S1_LFO_FIRST) s1_extra_lfo_write(extra, state.lfo);
     else {
         unsigned i = slot - S1_EXTRA_FIRST;
@@ -741,7 +751,7 @@
             if (state.lfo[i]) state.lfo[i] = (uint8_t)(S1_LFO_CODE_SYNC + divisions[i]);
     }
     state.lfo[S1_LFO_SYNC - S1_LFO_FIRST] = (uint8_t)code;
-    if (state.wet[0] || state.wet[1]) s1_write_packed(extra, &state);
+    if (state.wet[0] || state.wet[1] || state.wet[S1_REVERB_HP - S1_WET_FIRST]) s1_write_packed(extra, &state);
     else s1_extra_lfo_write(extra, state.lfo);
     original_sound_put_mask(cell, original_sound_edit_mask(cell) | S1_EXTRA_MARK);
     return 1;
