+#if X0X_SUPERJ6_BUILTIN_INIT
+static float sj6_amp_q16_unit(uint16_t q)
+{ return (float)q * (1.f / 65535.f); }
+static int sj6_amp_context(const juno6_t *s,unsigned short_gate)
+{ return s && s->typed && !short_gate && !s->core.filter_link; }
+static float *sj6_amp_parameter(dnbx_envelope_params *a,unsigned stage)
+{
+    switch(stage) {
+    case 0:return &a->attack_s;
+    case 1:return &a->decay_s;
+    case 2:return &a->sustain;
+    default:return &a->release_s;
+    }
+}
+static void sj6_amp_apply(juno6_t *s,unsigned layer,unsigned stage,uint16_t q)
+{
+    const dnbx_layer_params *p=&s->core.layer[layer].params;
+    dnbx_envelope_params a=p->amp;
+    float raw=sj6_amp_q16_unit(q);
+    *sj6_amp_parameter(&a,stage)=amp_stage_from_unit(stage,raw);
+    dnbx_apply_panel_envelopes(&s->core,layer,&a,&p->filter,0);
+    (void)dnbx_store_raw(&s->core,(layer?119u:36u)+stage,raw);
+}
+/* A legacy receiver may still write the same ADSR before it is routed
+ * through typed commands. Do not export a stale exact snapshot afterwards. */
+static void sj6_amp_invalidate(juno6_t *s,unsigned stages)
+{
+    if(s->amp_owner.mask|s->amp_owner.link)
+        s->amp_owner.mask|=(uint8_t)((stages&15u)<<4);
+}
+static void sj6_amp_secondary(juno6_t *s,unsigned stage,uint16_t q)
+{
+    sj6_amp_apply(s,1,stage,q);
+    s->amp_owner.q16[stage]=q;
+    s->amp_owner.mask=(uint8_t)((s->amp_owner.mask & ~(16u<<stage)) | (1u<<stage));
+}
+/* Source ON event inverse-maps the current primary envelope, then
+ * calls SECONDARY in order. Create each normalized word once here. */
+static int sj6_amp_copy_word(unsigned stage,float physical,uint16_t *out)
+{
+    const float min=stage==2u ? 0.f:.002f;
+    const float max=stage==0u ? 16.f:stage==2u ? 1.f:24.f;
+    if (!(physical>=min && physical<=max)) return 0;
+    const float exponent=stage==0u ? (1.f/3.33f):stage==2u ? (1.f/2.5f):(1.f/3.35f);
+    float raw=fm_powf((physical-min)/(max-min),exponent);
+    *out=(uint16_t)(fm_clampf(raw,0.f,1.f)*65535.f+.5f);
+    return 1;
+}
+int juno6_edit_amp_link(juno6_t *s,unsigned enabled,unsigned short_gate)
+{
+    if (!sj6_amp_context(s,short_gate) || enabled>1u || dnbx_active_voices(&s->core)!=0) return 0;
+    uint16_t q[4];
+    if (enabled) {
+        dnbx_envelope_params a=s->core.layer[0].params.amp;
+        for(unsigned i=0;i<4u;++i) if(!sj6_amp_copy_word(i,*sj6_amp_parameter(&a,i),&q[i]))return 0;
+    }
+    s->amp_owner.link=(uint8_t)(enabled+1u);
+    if(enabled) for(unsigned i=0;i<4u;++i) sj6_amp_secondary(s,i,q[i]);
+    return 1;
+}
+int juno6_edit_amp_stage(juno6_t *s,unsigned layer,unsigned stage,uint16_t q,unsigned short_gate)
+{
+    if (!sj6_amp_context(s,short_gate) || layer>1u || stage>3u ||
+        (!layer && !s->amp_owner.link) || dnbx_active_voices(&s->core)!=0) return 0;
+    if(!layer)sj6_amp_apply(s,0,stage,q);
+    if(layer || s->amp_owner.link==2u)sj6_amp_secondary(s,stage,q);
+    return 1;
+}
+int juno6_read_amp_state(const juno6_t *s,juno6_amp_state *out)
+{
+    if(!s || !out || !s->typed) return -1;
+    if ((s->amp_owner.mask & 0xf0u) || ((s->amp_owner.mask|s->amp_owner.link) && s->core.filter_link)) return -1;
+    *out=s->amp_owner;
+    return !!(out->mask|out->link);
+}
+int juno6_restore_amp_state(juno6_t *s,const juno6_amp_state *in,unsigned short_gate)
+{
+    if (!sj6_amp_context(s,short_gate) || !in || in->link>2u || (in->mask&~15u)) return 0;
+    for(unsigned i=0;i<4u;++i) if(!(in->mask&(1u<<i)) && in->q16[i])return 0;
+    s->amp_owner=*in;
+    for(unsigned i=0;i<4u;++i) if(in->mask&(1u<<i))sj6_amp_apply(s,1,i,in->q16[i]);
+    return 1;
+}
