+/* Full bass routing template: first byte high bit marks the current owner.
+ * Fixed global references keep owner zero. No dynamic pref semantics. */
+static __attribute__((noinline,minsize)) void add_routed_bass_page(
+    page_emitter_t *emit,page_title_id_t title,int owner,const uint8_t c[4][3])
+{
+    pref_t refs[4];
+    for(unsigned i=0;i<4;i++)
+        refs[i]=PR(c[i][0]&127u,c[i][1],c[i][0]&128u?owner:0,c[i][2]);
+    add_page_refs(emit,title,refs,0,0);
+}
