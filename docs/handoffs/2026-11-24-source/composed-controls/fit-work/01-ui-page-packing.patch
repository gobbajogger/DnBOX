+/* Fixed typed synth references share T_303 and the committed owner. Pack
+ * only kind and slot for each position; zero still emits a literal NONE. */
+static __attribute__((noinline,minsize)) void add_typed_bass_page(
+    page_emitter_t *emit, page_title_id_t title, int owner,const uint16_t *spec)
+{
+    pref_t refs[4];
+    for(unsigned i=0;i<4;i++){
+        unsigned k=spec[i];
+        refs[i]=k?PR(k>>8,T_303,owner,k&255u):NONE;
+    }
+    add_page_refs(emit,title,refs,0,0);
+}
