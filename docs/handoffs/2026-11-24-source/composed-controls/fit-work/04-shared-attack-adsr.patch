+/* Mono and poly use the same actual attack, including original routed
+ * oscillator masks, envelope retrigger, Vintage, and scale capture. */
+static __attribute__((noinline,minsize)) void note_attack(dnbx_part *s,dnbx_voice *v,unsigned velocity
+#if X0X_SJ6_SEQ_DEST_NATIVE
+    ,unsigned layers
+#endif
+    )
+{
+#if X0X_SJ6_SCALE_NATIVE
+    sj6_scale_attack(s,v);
+#endif
+    v->velocity=(float)velocity/127.0f;
+#if X0X_SJ6_PITCH_ENV_NATIVE
+    if(s->sj6_pitch_depth
+#if X0X_SJ6_AUX_LFO_NATIVE
+       || s->sj6_pitch_routed
+#endif
+      )envelope_on(&v->sj6_pitch,&s->sj6_pitch_param,s->sample_rate);
+#endif
+    for (unsigned l=0;l<DNBX_LAYERS;l++) {
+#if X0X_SJ6_SEQ_DEST_NATIVE
+        if (!(layers&(1u<<l))) continue;
+#endif
+        const dnbx_layer_params *p=&s->layer[l].params;
+#if X0X_SJ6_VINTAGE_NATIVE
+        sj6_vintage_attack(s,v,l);
+#endif
+        v->layer[l].increment=voice_pitch_increment(s,v,l,p->tune_semitones);
+        envelope_on(&v->layer[l].amp,&p->amp,s->sample_rate);
+        dnbx_envelope_params linked;
+        envelope_on(&v->layer[l].filter,filter_params(s,l,&linked),s->sample_rate);
+    }
+}
