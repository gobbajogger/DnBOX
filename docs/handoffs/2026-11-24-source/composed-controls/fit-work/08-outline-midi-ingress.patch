+/* Keep note ownership local to one event, in the existing audio FIFO. */
+__attribute__((noinline))
+static void midi_bass_note(int k,int src,unsigned ty,unsigned d1,unsigned d2)
+{
+    unsigned note=d1, velocity=ty==0x90?d2:0;
+#if X0X_S1_KEYBOARD_HOLD
+    s1_midi_admission_t *admit=0;
+    const unsigned word=d1>>5;
+    const uint32_t bit=UINT32_C(1)<<(d1&31u);
+    unsigned mapped=0,before=0;
+    if (original_bass[k].kind==ORIGINAL_SOUND_SYNTHONE) {
+        original_runtime_part *p=&original_bass[k];
+        admit=&s1_midi_admission[k][src];
+        unsigned down=!!(admit->down[word]&bit);
+        mapped=down?!!(admit->white[word]&bit):!!(proj.set.bt&PROJ_S1_WHITE_KEYS);
+        if (mapped) note=s1_midi_white(d1);
+        before=p->keys[src][note];
+        if (down && !before) {     /* is no longer live after recorder retirement */
+            admit->down[word]&=~bit;
+            down=0;
+            mapped=!!(proj.set.bt&PROJ_S1_WHITE_KEYS);
+            note=mapped?s1_midi_white(d1):d1;
+            before=p->keys[src][note];
+        }
+        if (s1_keyboard_hold[k]) {
+            if (!velocity) return;        /* external physical release */
+            if (down) {
+                if(p->stale_ttl[src][note])--p->stale_timers;
+                p->stale[src][note]=p->stale_ttl[src][note]=0;
+                velocity=0;                 /* explicit strike: toggle this raw key off */
+            }
+        } else if (!!velocity==down) {
+            return;                       /* repeat ON or unowned OFF: app holds a set */
+        }
+        if (velocity && !(proj.set.bt&PROJ_S1_MIDI_VELOCITY)) velocity=127u;
+    }
+#endif
+    /* External MIDI recording: accepted physical edges, as the pads do. */
+    int slide = velocity && live_rec_legato(k, src) && bass_held[k] != note;
+#if X0X_SJ6_VELOCITY_SETTINGS
+    if (sj6_configured_key(k,(unsigned)src,note,velocity) != ORIGINAL_RUNTIME_OK) return;
+#else
+    if (original_runtime_key(&original_bass[k], (unsigned)src, note, velocity) != ORIGINAL_RUNTIME_OK) return;
+#endif
+#if X0X_S1_KEYBOARD_HOLD
+    if(admit) {
+        if(velocity){
+            admit->down[word]|=bit;
+            s1_midi_focus[k]=(uint16_t)(1u+((unsigned)src<<7)+d1);
+            if(mapped)admit->white[word]|=bit;
+            else admit->white[word]&=~bit;
+        } else if(original_bass[k].keys[src][note]<before){
+            admit->down[word]&=~bit;
+            admit->white[word]&=~bit;
+            if(ty==0x80)s1_midi_mono_resume(k,d2);
+        }
+    }
+#endif
+    if (velocity) {
+#ifdef X0X_HOST
+        bass_attacked[k] = (uint8_t)!slide;
+#endif
+        seq_rec_bass(&seq, k, note, (int)velocity, 1, src, (velocity >= 100u ? BS_ACCENT : 0) | (slide ? SEQ_REC_LEGATO : 0));
+        bass_held[k] = note; bass_held_src[k] = (uint8_t)src;
+        bass_held_count[k] = original_bass[k].keys[src][note];
+        live_rec_accept(k, src, note);
+    } else if (seq_bass_poly(&seq,k)) {
+        seq_rec_bass(&seq,k,note,0,0,src,0);
+        if(bass_held_src[k]==src && bass_held[k]==note) {
+            bass_held_count[k]=original_bass[k].keys[src][note];
+            if(!bass_held_count[k])seq.rec_bass[k].own_ok=0;
+        }
+    } else if (bass_held_src[k] == (uint8_t)src && bass_held[k] == note) {
+        bass_held_count[k] = original_bass[k].keys[src][note];
+        if (!bass_held_count[k]) {
+            seq_rec_bass(&seq, k, note, 0, 0, src, 0);
+            seq.rec_bass[k].own_ok = 0;
+            bass_held[k] = 0;
+        }
+    }
+    int held = 0;
+    for (unsigned key = 0; key < 128; ++key) held |= original_bass[k].keys[src][key];
+    if (held) src_held[src] |= (uint16_t)(1u << k);
+    else src_held[src] &= (uint16_t)~(1u << k);
+}
