+/* Main-loop receivers share admission without sharing their state or
+ * mutations. Keep the pre-hold read and second read in exactly that order. */
+static __attribute__((noinline)) int original_typed_scalar_choose(
+    unsigned owner,unsigned value,int (*get)(unsigned),void (*store)(unsigned,unsigned))
+{
+    if(get(owner)<0)return 0;
+    engine_project_hold(1);
+    int before=get(owner);
+    const int ok=before>=0 && (unsigned)before!=value && original_typed_edit_open(owner);
+    if(ok)store(owner,value);
+    engine_project_hold(0);
+    return ok;
+}
+static __attribute__((noinline)) int original_typed_indexed_choose(
+    unsigned owner,unsigned index,unsigned value,int (*get)(unsigned,unsigned),
+    void (*store)(unsigned,unsigned,unsigned))
+{
+    if(get(owner,index)<0)return 0;
+    engine_project_hold(1);
+    int before=get(owner,index);
+    const int ok=before>=0 && (unsigned)before!=value && original_typed_edit_open(owner);
+    if(ok)store(owner,index,value);
+    engine_project_hold(0);
+    return ok;
+}
+static __attribute__((noinline)) int original_typed_live_undo_open(
+    unsigned mask, int (*owner_live)(const sound_t *,unsigned))
+{
+    if(!s1_typed_tuple_editable())return 0;
+    for(unsigned v=0;v<NBASS;v++)
+        if((mask&(1u<<v)) && owner_live(mot_base_snd,v) &&
+           (note_lock_applied[v] || engine_bass_preset_pending(v)))return 0;
+    return 1;
+}
+
