+                     os.environ.get("X0X_SUPERJ6_BUILTIN_INIT") == "1" and
+                     synthone_patch_setting() == "1")
+    value = os.environ.get("X0X_SYNTH_CONTROLS_INIT_ONLY", "1" if dual_controls else "0")
+    if value not in ("0", "1"):
+        raise SystemExit("X0X_SYNTH_CONTROLS_INIT_ONLY: 0 or 1")
+    return value == "1"
