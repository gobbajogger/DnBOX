+static void original_prepare_all(void)
+{
+    float bpm=seq_tempo(&seq);
+    for(int v=0;v<NBASS;++v){
+#if X0X_SJ6_LFO1_WAVE_NATIVE
+        if(original_bass[v].kind==ORIGINAL_SOUND_JUNO && live137(mot_base_snd,v))
+            juno6_lfo1_controls(&original_bass[v].dsp.juno.synth,
+                sj6_lfo1_wave_read(mot_base_snd,v),sj6_lfo1_option(mot_base_snd,v,0),
+                sj6_lfo1_option(mot_base_snd,v,1));
+#endif
+#if X0X_SJ6_LFO1_DELAY_PORT
+        original_runtime_part *part=&original_bass[v];
+        if (part->kind==ORIGINAL_SOUND_JUNO && live137(mot_base_snd,v))
+            juno6_lfo1_delay_set(&part->dsp.juno.synth,sj6_lfo1_delay_read(mot_base_snd,v));
+#endif
+#if X0X_SJ6_NOISE_SUB_NATIVE
+        if (original_bass[v].kind==ORIGINAL_SOUND_JUNO && live137(mot_base_snd,v))
+            dnbx_set_sj6_sources(&original_bass[v].dsp.juno.synth.core,v,sj6_sources_read(mot_base_snd,v));
+#endif
+        (void)original_runtime_prepare(&original_bass[v],bpm);
+#if X0X_SJ6_ALT3_NATIVE
+        if(original_bass[v].kind==ORIGINAL_SOUND_JUNO && live137(mot_base_snd,v)){
+            const uint8_t *p=sj6_trem_read(mot_base_snd,v);
+            unsigned sync=0;
+#if X0X_SJ6_NATIVE_DELAY
+            sync=!!(read137(mot_base_snd,v)[SJ6_DELAY_BYTE]&SJ6_DELAY_SYNC_BIT);
+#endif
+            juno6_alt3_set_panel(&original_bass[v].dsp.juno.synth,
+                sj6_trem_position(p,0u),sj6_trem_position(p,1u),sync);
+        }
+#endif
+#if X0X_SJ6_NATIVE_UNISON
+        sj6_typed_unison_apply(v);
+#endif
+#if X0X_SJ6_NATIVE_J60
+        sj6_typed_j60_apply(v);
+#endif
+#if (defined(X0X_HOST) && defined(X0X_SJ6_DELAY_WITNESS)) || X0X_SJ6_NATIVE_DELAY
+        sj6_typed_delay_apply(v,bpm);
+#endif
+    }
+}
