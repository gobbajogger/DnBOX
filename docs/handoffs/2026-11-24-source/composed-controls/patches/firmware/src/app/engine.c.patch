+    uint32_t flags=plat_cq_lock();
+    unsigned w=live_key_w,next=(w+1u)%LIVE_KEY_Q;
+    if(live_key_owner[voice].blocked || next==live_key_r){
+        /* Follow the normal fail-closed keyboard retirement on overflow. */
+        live_key_cancel|=(uint8_t)(1u<<voice);
