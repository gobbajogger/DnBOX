+    if(live_s1_mod(sound,owner) && original_bass[owner].kind==ORIGINAL_SOUND_SYNTHONE) {
+        unsigned res=*s1_delay_res_read(sound,owner);
+        if(res<=S1_DELAY_RES_MAX)s1_delay_res_apply_one(owner,res);
+        unsigned route=*s1_env_lfo_read(sound,owner);
+        if(route<=S1_ENV_LFO_MAX)s1_env_lfo_apply_one(owner,route);
+        const uint8_t *cell=s1_phase_read(sound,owner);
