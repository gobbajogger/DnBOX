+#if X0X_SJ6_NATIVE_LIMITER
+static void sj6_native_limiter_apply(const sound_t *sound,unsigned owner)
+{
+    if(live137(sound,owner) && original_bass[owner].kind==ORIGINAL_SOUND_JUNO)
+    {
+        original_runtime_sj6_limiter(&original_bass[owner],sj6_limiter_read(sound,owner));
+        const unsigned rage=sj6_rage_read(sound,owner);
+        if(rage && rage<=128u)original_runtime_sj6_rage(&original_bass[owner],rage-1u);
+    }
+}
+int sj6_native_limiter_get(unsigned owner,unsigned slot)
+{
+    if(slot>SJ6_RAGE_SLOT || !live137(mot_base_snd,owner) ||
+       original_bass[owner].kind!=ORIGINAL_SOUND_JUNO)return -1;
+    if(slot==SJ6_RAGE_SLOT){
+        unsigned code=sj6_rage_read(mot_base_snd,owner);
+        return code<=128u?(int)(code?code-1u:0u):-1;
+    }
+    unsigned c=sj6_limiter_read(mot_base_snd,owner)[slot];
+    return c<=128u?(int)sj6_limiter_position(slot,c):-1;
+}
+int sj6_native_limiter_choose(unsigned owner,unsigned slot,unsigned value)
+{
+    if(value>127u || sj6_native_limiter_get(owner,slot)<0)return 0;
+    engine_project_hold(1);
+    int before=sj6_native_limiter_get(owner,slot);
+    int ok=before>=0 && (unsigned)before!=value && original_typed_edit_open(owner);
+    if(ok){
+        if(slot==SJ6_RAGE_SLOT)
+            sj6_rage_write((sound_t *)mot_base_snd,owner,value+1u);
+        else {
+            unsigned init=sj6_limiter_position(slot,0);
+            sj6_limiter_write((sound_t *)mot_base_snd,owner)[slot]=(uint8_t)(value==init?0u:value+1u);
+            /* Both operate one stage. Preserve whichever policy was edited
+             * last rather than silently refusing the separate Bonus knobs. */
+            sj6_rage_write((sound_t *)mot_base_snd,owner,0u);
+        }
+        sj6_native_limiter_apply(mot_base_snd,owner);
+    }
+    engine_project_hold(0);
+    return ok;
+}
+int sj6_native_limiter_undo_ready(unsigned mask)
+{
+    if(!s1_typed_tuple_editable())return 0;
+    for(unsigned v=0;v<NBASS;v++)
+        if((mask&(1u<<v)) && live137(mot_base_snd,v) &&
+           (note_lock_applied[v] || engine_bass_preset_pending(v)))return 0;
+    return 1;
