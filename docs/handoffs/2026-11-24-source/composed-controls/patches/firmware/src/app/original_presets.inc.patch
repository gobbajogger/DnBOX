+/* The three detector/ballistic paths are already independent in s1c_render.
+ * Apply these exact physical DSP IDs rather than synthesizing a master macro. */
+float s1_cmp_physical(unsigned k,unsigned pos)
+{
+    const unsigned param=S1_CMP_FIRST+k;
+    if(pos==s1_cmp_init(k))return s1c_front_init(param);
+    float lo,hi;
+    s1c_front_bounds(param,&lo,&hi);
+    return lo+(hi-lo)*((float)pos*(1.f/127.f));
+}
+static void s1_cmp_set(unsigned owner,unsigned k,unsigned code)
+{
+    (void)s1c_front_set(&original_bass[owner].dsp.synthone.e,S1_CMP_FIRST+k,
+                       s1_cmp_physical(k,s1_cmp_decode(k,code)));
+}
+static void s1_cmp_apply(const sound_t *sound,unsigned owner)
+{
+    if(!live_s1_mod(sound,owner) || original_bass[owner].kind!=ORIGINAL_SOUND_SYNTHONE)return;
+    const uint8_t *row=s1_cmp_read(sound,owner);
+    for(unsigned k=0;k<S1_CMP_COUNT;k++)if(row[k]<=127u)s1_cmp_set(owner,k,row[k]);
+}
+int s1_cmp_position(unsigned owner,unsigned k)
+{
+    if(k>=S1_CMP_COUNT || !live_s1_mod(mot_base_snd,owner) ||
+       original_bass[owner].kind!=ORIGINAL_SOUND_SYNTHONE)return -1;
+    const unsigned code=s1_cmp_read(mot_base_snd,owner)[k];
+    return code<=127u ? (int)s1_cmp_decode(k,code) : -1;
+}
+int s1_cmp_choose(unsigned owner,unsigned k,unsigned pos)
+{
+    if(pos>127u || s1_cmp_position(owner,k)<0)return 0;
+    engine_project_hold(1);
+    int before=s1_cmp_position(owner,k);
+    int ok=before>=0 && (unsigned)before!=pos && original_typed_edit_open(owner);
+    if(ok){
+        const unsigned code=s1_cmp_encode(k,pos);
+        s1_cmp_write((sound_t *)mot_base_snd,owner)[k]=(uint8_t)code;
+        s1_cmp_set(owner,k,code);
+    }
+    engine_project_hold(0);
+    return ok;
+}
+int s1_cmp_undo_ready(unsigned mask)
+{
+    if(!s1_typed_tuple_editable())return 0;
+    for(unsigned v=0;v<NBASS;v++)
+        if((mask&(1u<<v)) && live_s1_mod(mot_base_snd,v) &&
+           (note_lock_applied[v] || engine_bass_preset_pending(v)))return 0;
+    return 1;
+}
+void s1_cmp_undo(unsigned mask)
+{
+    for(unsigned v=0;v<NBASS;v++)if(mask&(1u<<v))s1_cmp_apply(mot_base_snd,v);
+}
+#if X0X_SJ6_NATIVE_ROOM
+static void sj6_crush_apply(const sound_t *sound,unsigned owner)
+{
+    if(!live137(sound,owner) || original_bass[owner].kind!=ORIGINAL_SOUND_JUNO)return;
+    original_runtime_part *p=&original_bass[owner];
+    const uint8_t *b=sj6_crush_code(sound,owner);
+    /* Original conductor ID108: d=.0606*pow(unit,1.23). Map d to
+     * compact fractional sample-and-hold cadence without another control. */
+    const float d=.0606f*fm_powf((float)b[1]/127.f,1.23f);
+    p->dsp.juno.crush.step=1.f/(1.f+(31.f/.0606f)*d);
+    if(b[0] && !p->dsp.juno.crush.active)
+        p->dsp.juno.crush.phase=1.f-p->dsp.juno.crush.step;
+    p->dsp.juno.crush.active=b[0];
+}
+int sj6_crush_get(unsigned owner,unsigned k)
+{
+    if(k>1u || !live137(mot_base_snd,owner) || original_bass[owner].kind!=ORIGINAL_SOUND_JUNO)
+        return -1;
+    unsigned b=sj6_crush_code(mot_base_snd,owner)[k];
+    return b<=(k?127u:1u)?(int)b:-1;
+}
+int sj6_crush_choose(unsigned owner,unsigned k,unsigned pos)
+{
+    if(pos>(k?127u:1u) || sj6_crush_get(owner,k)<0)return 0;
+    engine_project_hold(1);
+    int before=sj6_crush_get(owner,k);
+    int ok=before>=0 && (unsigned)before!=pos && original_typed_edit_open(owner);
+    if(ok){
+        sj6_crush_write((sound_t*)mot_base_snd,owner)[k]=(uint8_t)pos;
+        sj6_crush_apply(mot_base_snd,owner);
+    }
+    engine_project_hold(0);
+    return ok;
+}
+static void sj6_native_room_apply(const sound_t *sound,unsigned owner)
+{
+    sj6_crush_apply(sound,owner);
+    if(live137(sound,owner) && original_bass[owner].kind==ORIGINAL_SOUND_JUNO)
+        original_runtime_sj6_room(&original_bass[owner],sj6_room_read(sound,owner));
+}
+int sj6_native_room_get(unsigned owner,unsigned slot)
+{
+    if(slot>=SJ6_ROOM_COUNT || !live137(mot_base_snd,owner) ||
+       original_bass[owner].kind!=ORIGINAL_SOUND_JUNO)return -1;
