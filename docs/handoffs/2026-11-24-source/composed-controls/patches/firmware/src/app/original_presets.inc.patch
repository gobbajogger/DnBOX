+    return value<=sj6_room_max(slot)?(int)value:-1;
+}
+int sj6_native_room_choose(unsigned owner,unsigned slot,unsigned value)
+{
+    if(slot>=SJ6_ROOM_COUNT || value>sj6_room_max(slot) || sj6_native_room_get(owner,slot)<0)return 0;
+    engine_project_hold(1);
+    int before=sj6_native_room_get(owner,slot);
+    int ok=before>=0 && (unsigned)before!=value && original_typed_edit_open(owner);
+    if(ok){
+        sj6_room_write((sound_t *)mot_base_snd,owner)[slot]=(uint8_t)value;
+        sj6_native_room_apply(mot_base_snd,owner);
+    }
+    engine_project_hold(0);
+    return ok;
+}
+int sj6_native_room_undo_ready(unsigned mask)
+{
+    if(!s1_typed_tuple_editable())return 0;
+    for(unsigned v=0;v<NBASS;v++)
+        if((mask&(1u<<v)) && live137(mot_base_snd,v) &&
+           (note_lock_applied[v] || engine_bass_preset_pending(v)))return 0;
+    return 1;
+}
+void sj6_native_room_undo(unsigned mask)
+{
