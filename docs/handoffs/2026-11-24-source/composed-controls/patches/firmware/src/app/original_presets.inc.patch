+#if X0X_SJ6_VCF_PORT
+/* Original Build9 receives normalized 131/136; compact DnBOX uses its own
+ * low-pass core, with these two independent additional filter inputs. */
+static void sj6_filter_apply_one(unsigned owner,unsigned k,unsigned code)
+{
+    dnbx_part *core=&original_bass[owner].dsp.juno.synth.core;
+    if(!k) {
+        (void)dnbx_store_raw(core,131u,code*(.25f/127.f));
+    } else if (code) {
+        const float normalized=(float)(code-1u)/127.f;
+        const float strength=fm_powf(normalized,3.03f);
+        (void)dnbx_store_raw(core,136u,strength);
+    } else {
+        core->raw_present[136u/32u]&=~(UINT32_C(1)<<(136u%32u));
+    }
+}
+int sj6_filter_control_get(unsigned owner,unsigned k)
+{
+    if(k>1u || !live137(mot_base_snd,owner) || !sj6_vcf_init(mot_base_snd,owner) ||
+       original_bass[owner].kind!=ORIGINAL_SOUND_JUNO)return -1;
+    unsigned code=*sj6_filter_code(mot_base_snd,owner,k);
+    if(code>(k?128u:127u))return -1;
+    if(!k)return (int)code;
+    return code?(int)code-1:(int)(mot_base_snd->v[T_303][owner][4]&127u);
+}
+int sj6_filter_control_choose(unsigned owner,unsigned k,unsigned pos)
+{
+    if(pos>127u || sj6_filter_control_get(owner,k)<0)return 0;
+    engine_project_hold(1);
