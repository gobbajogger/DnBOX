+        !ui_project_busy() && !engine_bass_preset_pending(owner) && !note_lock_applied[owner];
+    if(ok) {
+        const unsigned code=pos+!!k;
+        *(uint8_t *)sj6_filter_code(mot_base_snd,owner,k)=(uint8_t)code;
