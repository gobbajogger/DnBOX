+#if X0X_SJ6_NATIVE_ROOM
+/* Build9 uses an independent AKDecimator with 30 percent wet and 1.3 gain.
+ * This compact receiver preserves the decimation control direction, rate law,
+ * wet path and warm timing without claiming the Apple AU's DSP bit identity. */
+static void sj6_crush_process(original_runtime_part *p,float *left,float *right,unsigned frames)
+{
+    if(!p->dsp.juno.crush.active)return;
+    const float step=p->dsp.juno.crush.step;
+    float phase=p->dsp.juno.crush.phase;
+    float l=p->dsp.juno.crush.hold[0],r=p->dsp.juno.crush.hold[1];
+    for(unsigned i=0;i<frames;++i){
+        phase+=step;
+        if(phase>=1.f){phase-=1.f;l=left[i];r=right[i];}
+        left[i]=1.3f*(.7f*left[i]+.3f*l);
+        right[i]=1.3f*(.7f*right[i]+.3f*r);
+    }
+    p->dsp.juno.crush.phase=phase;
+    p->dsp.juno.crush.hold[0]=l;
+    p->dsp.juno.crush.hold[1]=r;
+}
+#endif
