+#if X0X_SJ6_LFO1_DELAY_PORT
+/* Build9 ID91 setter: 0x1000f73c0..7404 -> 3 * pow(unit,1.21).
+ * Its nominal 80 Hz worker starts the shared phase only once elapsed is
+ * strictly larger than the selected delay; it does not reset on the edit. */
+float juno6_lfo1_delay_seconds(unsigned position)
+{
+    return position ? 3.f*fm_powf((float)position/127.f,1.21f) : 0.f;
+}
+void juno6_lfo1_delay_set(juno6_t *s,unsigned position)
+{
+    if (!s->typed || position>127u || s->lfo1_delay_raw==position) return;
+    s->lfo1_delay_raw=(uint8_t)position;
+    unsigned ticks=(unsigned)(juno6_lfo1_delay_seconds(position)*80.f)+1u;
+    s->lfo1_delay_frames=position?(ticks*(unsigned)s->sample_rate+79u)/80u:0u;
+}
+static int sj6_lfo1_waiting(const juno6_t *s)
+{
+    return s->typed && s->lfo1_delay_raw && !s->lfo1_delay_started;
+}
