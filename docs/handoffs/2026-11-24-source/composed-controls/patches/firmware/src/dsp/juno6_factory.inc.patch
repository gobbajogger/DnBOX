+            s->lfo1_delay_age+=first;
+            if (s->lfo1_delay_age>=s->lfo1_delay_frames) s->lfo1_delay_started=1;
+            if (first==frames) return 1;
+            left+=first;right+=first;frames-=first;
+        }
+    }
+    return sj6_render_with_lfo(s,left,right,frames);
