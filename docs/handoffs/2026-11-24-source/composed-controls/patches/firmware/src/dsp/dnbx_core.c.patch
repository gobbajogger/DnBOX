+#if X0X_SJ6_OTA_NATIVE
+int dnbx_set_sj6_ota(dnbx_part *s,unsigned value)
+{
+    if(!valid(s)||!s->superj6_amp_range||value>1u)return 0;
+    if(s->sj6_ota==value)return 1;
+    s->sj6_ota=(uint8_t)value;
