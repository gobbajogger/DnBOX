+#if X0X_SJ6_PITCH_ENV_NATIVE
+int dnbx_set_sj6_pitch_env(dnbx_part *s,const uint8_t code[5])
+{
+    if(!valid(s)||!s->superj6_amp_range)return 0;
+    for(unsigned k=0;k<4u;k++)if(code[k]>127u)return 0;
+    if(code[4]>60u)return 0;
+    /* Build 9's actual setters: attack, decay and release use x^3.33;
+     * sustain x^2.5; rounded 0..60 semitones comes from parameter 57. */
+    const float a=code[0] ? (float)(code[0]-(code[0]<=64u))/127.f : .5f;
+    const float d=code[1] ? (float)(code[1]-(code[1]<=64u))/127.f : .5f;
+    const float u=(float)code[2]/127.f;
+    const float r=code[3] ? (float)(code[3]-(code[3]<=64u))/127.f : .5f;
+    s->sj6_pitch_param=(dnbx_envelope_params){
+        .attack_s=16.f*fm_powf(a,3.33f),.decay_s=24.f*fm_powf(d,3.33f),
+        .sustain=fm_powf(u,2.5f),.release_s=24.f*fm_powf(r,3.33f)
+    };
+    /* Enabling depth on an already-held note starts a genuine pitch envelope.
+     * Zero depth performs no extra work in the audio hot path. */
+    if(code[4] && !s->sj6_pitch_depth)
+        for(unsigned i=0;i<DNBX_VOICES;i++) {
+            dnbx_voice *v=&s->voice[i];
+            memset(&v->sj6_pitch,0,sizeof v->sj6_pitch);
+            if(v->gate || v->pedal_held)envelope_on(&v->sj6_pitch,&s->sj6_pitch_param,s->sample_rate);
+        }
+    s->sj6_pitch_depth=code[4];
+    return 1;
+}
