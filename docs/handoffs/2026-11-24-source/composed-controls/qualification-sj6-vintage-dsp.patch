+#if X0X_SJ6_VINTAGE_NATIVE
+/* Build9 Vintage knob ID123: fresh symmetric offsets on oscillator note
+ * attack. A change arms subsequent attacks; it doesn't retune held audio. */
+float dnbx_sj6_vintage_cents(unsigned position)
+{ return 5.f*fm_powf((float)position*(1.f/127.f),2.02f); }
+
+void dnbx_set_sj6_vintage(dnbx_part *s,unsigned owner,unsigned position)
+{
+    if(!valid(s)||!s->superj6_amp_range||position>127u)return;
+    s->sj6_vintage_limit=(uint16_t)(256.f*dnbx_sj6_vintage_cents(position)+.5f);
+    if(!s->sj6_vintage_random)
+        s->sj6_vintage_random=owner ? UINT32_C(0x6c8e9cf5) : UINT32_C(0x71da45b3);
+}
+
+static void sj6_vintage_attack(dnbx_part *s,dnbx_voice *v,unsigned l)
+{
+    if(!s->sj6_vintage_limit){v->sj6_vintage_q8[l]=0;return;}
+    uint32_t x=s->sj6_vintage_random;
+    x^=x<<13;x^=x>>17;x^=x<<5;s->sj6_vintage_random=x;
+    /* Two independent draws for two triggered oscillator layers.
+     * Quantization is under 0.004 cents. Never touch noise RNG or bend. */
+    const int32_t u=(int32_t)(x>>16)-32768;
+    v->sj6_vintage_q8[l]=(int16_t)((u*(int32_t)s->sj6_vintage_limit)/32768);
+}
+
+static float voice_pitch_increment(const dnbx_part *s,const dnbx_voice *v,unsigned l,float tune)
+{
+    if(v->sj6_vintage_q8[l])
+        tune+=(float)v->sj6_vintage_q8[l]*(1.f/25600.f);
+    return pitch_increment(s,v->note,tune);
+}
+#else
+#define voice_pitch_increment(s,v,l,tune) pitch_increment(s,(v)->note,tune)
+#endif
