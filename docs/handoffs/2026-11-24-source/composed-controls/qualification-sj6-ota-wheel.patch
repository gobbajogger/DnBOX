+#if X0X_SJ6_OTA_NATIVE
+/* Build9 direct cutoff target 0x1000ee3bc. OTA continues from the normal
+ * Hz target through a rational transfer and both squared end trims. */
+static float sj6_ota_cutoff_hz(float normal)
+{
+#if defined(X0X_HOST) && !DNBOX_TYPED_CONTROLS_NATIVE_TEST
+    const double z=(double)normal-20.0;
+    const double lo=normal<30.f ? (30.0-normal)/10.0 : 0.0;
+    const double hi=normal>10000.f ? (normal-10000.0)/10000.0 : 0.0;
+    return (float)(20.0+(z*1.4795969434284197)/(1.0+(z*.47959694342841974)/19980.0)+
+                   hi*(hi*10000.0)-lo*(lo*17.0));
+#else
+    /* Native destination remains Float; do not link software Double. */
+    const float z=normal-20.f;
+    const float lo=normal<30.f ? (30.f-normal)*.1f : 0.f;
+    const float hi=normal>10000.f ? (normal-10000.f)*.0001f : 0.f;
+    return 20.f+(z*1.4795969434284197f)/(1.f+(z*.47959694342841974f)*(1.f/19980.f))+
+           hi*(hi*10000.f)-lo*(lo*17.f);
+#endif
+}
+#endif
