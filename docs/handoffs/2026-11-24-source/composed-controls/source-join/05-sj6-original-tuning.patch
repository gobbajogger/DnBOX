+#if X0X_SJ6_SCALE_NATIVE
+float s1c_shared_scale_hz(unsigned index,int note,float a4,unsigned custom_npo,
+                          const uint8_t *head,unsigned head_bytes,const uint8_t *tail)
+{
+    const int user=index==S1C_SCALE_USER && custom_npo && head;
+    int npo=user ? (int)custom_npo : (index<S1C_SCALE_COUNT ? s1_scale[index].npo : 12u);
+    if(!user && index>=S1C_SCALE_COUNT)return a4*exp2f((note-69)/12.f);
+    const int steps=note-60; /* shared AudioKit AKTuningTable C4 anchor */
+    int octave=steps/npo, degree=steps%npo;
+    if(degree<0){degree+=npo;--octave;}
+    union {uint32_t u;float v;} q={.u=(uint32_t)(octave+127)<<23};
+    uint32_t word=UINT32_C(0x3f800000);
+    if(user){
+        for(unsigned k=0;k<3u;++k){
+            const unsigned j=3u*(unsigned)degree+k;
+            word|=(uint32_t)(j<head_bytes ? head[j] : tail[j-head_bytes])<<(8u*k);
+        }
+    }else{
+        const uint8_t *p=s1_scale_ratio+3u*(s1_scale[index].offset+(unsigned)degree);
+        word|=((uint32_t)p[2]<<16)|((uint32_t)p[1]<<8)|p[0];
+    }
+    union {uint32_t u;float v;} ratio={.u=word};
+    const float hz=ratio.v*q.v*(a4*0.5946035575013605f);
+    return hz<22050.f ? hz : 22050.f;
+}
