+/* Pin Manager's highest raw MIDI note rule, rather than changing the
+ * compact kernel's newest-note behavior for unrelated local/pattern keys. */
+static void s1_midi_mono_resume(int owner,unsigned off_velocity)
+{
+    original_runtime_part *p=&original_bass[owner];
+    if(p->dsp.synthone.e.t[20]<=0.f)return;             /* original ID20 isMono */
+    for(int word=3;word>=0;--word){
+        uint32_t u=s1_midi_admission[owner][0].down[word] |
+                   s1_midi_admission[owner][1].down[word] |
+                   s1_midi_admission[owner][2].down[word];
+        while(u){
+            const unsigned column=31u-(unsigned)__builtin_clz(u);
+            const uint32_t bit=UINT32_C(1)<<column;
+            const unsigned raw=(unsigned)word*32u+column;
+            u&=~bit;
+            for(unsigned port=0;port<MIDI_NSRC;port++){
+                const s1_midi_admission_t *admit=&s1_midi_admission[owner][port];
+                if(!(admit->down[word]&bit))continue;
+                const unsigned key=(admit->white[word]&bit)?s1_midi_white(raw):raw;
+                if(!p->keys[port][key])continue;        /* cancelled recorder ingress */
+                const unsigned token=1u+(port<<7)+raw;
+                if(s1_midi_focus[owner]!=token){
+                    s1_midi_focus[owner]=(uint16_t)token;
+                    original_runtime_s1_repress(p,key,off_velocity);
+                }
+                return;
+            }
+        }
+    }
+    s1_midi_focus[owner]=0;
+}
