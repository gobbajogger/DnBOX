+    (void)dnbx_read_raw(&s->core,136u,&amount);
+    float lo=0.f,ratio=0.f,inv_cut=0.f,inv_amount=0.f;
+    if(amount>0.f) {
+        lo=sj6_normal_cutoff_hz(s->sj6_live_raw_cutoff);
+        inv_cut=1.f/sj6_ota_cutoff_hz(lo);
+        ratio=(22050.f-lo)*fm_powf(amount,3.03f);
+        inv_amount=1.f/(14.f*amount);
+    }
+    for(unsigned l=0;l<DNBX_LAYERS;++l) {
+        const dnbx_layer_params *p=&s->core.layer[l].params;
+        const float u=s->core.filter_link ? p->amp.sustain : p->filter.sustain;
+        const float v=amount>0.f ?
+            fm_clampf(fm_log2f((lo+ratio*u)*inv_cut)*inv_amount,0.f,1.f) : 0.f;
+        dnbx_set_sj6_ota_filter_sustain(&s->core,l,v);
