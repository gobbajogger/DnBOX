+        if(++at==s->delay24.capacity)at=0;
+        s->delay24.pos=at;
+        if(s->delay24.dry!=1.f && !s->delay24.clock_refused){
+            float wet=1.f-s->delay24.dry;
+            l[i]=fmaf(wet,left,s->delay24.dry*l[i]);
+            r[i]=fmaf(wet,right,s->delay24.dry*r[i]);
+        }
+    }
+}
