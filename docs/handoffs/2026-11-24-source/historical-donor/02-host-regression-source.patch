+/* Independent expected K5-K8 layout for the 16 admitted stock Juno macros.
+ * Use physical SELECT detents and knob inputs, never direct pref_set calls. */
+static void juno_stock_knob_journey(int part)
+{
+    static const signed char ids[4][4]={{0,1,12,15},{2,3,4,9},{5,6,7,8},{10,11,13,14}};
+    static const char *const titles[]={"OSCILLATOR","FILTER","ENVELOPE","LFO/CHORUS"};
+    unsigned owner=(unsigned)(part-PART_303A);
+    setup(V_PART,part);
+    EXPECT(engine_bass_select_preset(owner,ORIGINAL_SOUND_JUNO,0,&proj.sound)==0);
+    for(int n=0;n<1024&&engine_bass_preset_pending(owner);n++)render(1);
