@@ -0,0 +1,36 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+/* Guideline row #22: every synth page whose controls are envelope stages
+ * (Attack/Decay/Sustain/Release) is drawn by draw_adsr_inline, on every
+ * bass engine (Chicago, Miami, Synth One FILTER + AMP when built, SuperJ6/Juno).
+ * A new engine page with stage controls but no graph fails here. */
+#define SMC_UI_MAIN unused_smc_ui_main
+#include "smc_ui_test.c"
+#include <ctype.h>
+static void audio_ms(unsigned ms){int32_t a[512];unsigned left=ms*44100/1000;while(left){unsigned n=left>256?256:left;engine_render(a,n);left-=n;}}
+static int has(const char *h,const char *n){for(;*h;h++){int i=0;while(n[i]&&tolower((unsigned char)h[i])==n[i])i++;if(!n[i])return 1;}return 0;}
+static int stage(const char *n){return n&&(has(n,"attack")||has(n,"decay")||has(n,"sustain")||has(n,"release"));}
+int main(void)
+{
+ const int banks[]={ORIGINAL_SOUND_CHICAGO,ORIGINAL_SOUND_MIAMI,ORIGINAL_SOUND_SYNTHONE,ORIGINAL_SOUND_JUNO};
+ int graphs=0;
+ for(unsigned b=0;b<4;b++){
+  setup(V_PART,PART_303A);
+  if(engine_bass_select_preset(0,banks[b],0,&proj.sound))continue;   /* bank not in this build */
+  for(int i=0;i<1024&&engine_bass_preset_pending(0);i++)audio_ms(6);
+  build_pages();
+  for(int p=0;p<pg.n;p++){
+   int n=0;for(int k=0;k<4;k++)n+=pg.r[p][k].kind!=R_NONE&&stage(pref_name(pg.r[p][k]));
+   if(n>=2){
+    if(!adsr_row(p))printf("bank %d page %d: %d envelope stages without draw_adsr_inline\n",banks[b],p,n);
+    CHECK(adsr_row(p));graphs++;
+   }
+  }
+ }
+#if X0X_SYNTHONE_PATCH
+ CHECK(graphs==4);    /* Chicago, Synth One FILTER and AMP, SuperJ6/Juno */
+#else
+ CHECK(graphs>=2);
+#endif
+ printf("PASS %d envelope rows, all draw_adsr_inline\n",graphs);
+ return 0;
+}
