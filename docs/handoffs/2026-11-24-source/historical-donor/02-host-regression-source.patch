+            pref_t r=pg.r[page][k];
+            int id=ids[page][k];
+            EXPECT(r.kind==R_ENG&&r.a==T_303&&r.b==owner&&r.c==id&&!pref_read_only(r));
+            uint8_t before[ORIGINAL_SOUND_BYTES],peer[ORIGINAL_SOUND_BYTES];
+            memcpy(before,proj.sound.v[T_303][owner],sizeof before);
+            memcpy(peer,proj.sound.v[T_303][1-owner],sizeof peer);
+            int delta=before[id]<64?1:-1;
+            now_ms+=160; turn(k,delta);
+            const uint8_t *after=proj.sound.v[T_303][owner];
+            EXPECT(pref_get(r)==before[id]+delta&&after[id]==before[id]+delta);
+            EXPECT(original_sound_edit_mask(after)==(original_sound_edit_mask(before)|(1u<<id)));
+            EXPECT(!memcmp(after,before,(unsigned)id));
+            EXPECT(!memcmp(after+id+1,before+id+1,22u-(unsigned)id-1u));
+            EXPECT(!memcmp(peer,proj.sound.v[T_303][1-owner],sizeof peer));
+            edits|=1u<<id;
+        }
+        now_ms+=160; enc_acc[EN_SELECT]=1;input();
