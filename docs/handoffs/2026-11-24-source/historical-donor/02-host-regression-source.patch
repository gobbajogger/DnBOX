@@ -0,0 +1,127 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-3.0-only
+"""Test the real renderer's quiet scan and split selection against forward oracles."""
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[2]
+SOURCE = (ROOT / "firmware/src/app/engine.c").read_text()
+
+
+def extract_between(start, end):
+    lo = SOURCE.index(start)
+    return SOURCE[lo:SOURCE.index(end, lo)]
+
+
+enum = extract_between("enum { JB_909,", "\n")
+plan = extract_between("#define ENG_C1_LAT ", "/* post-mix tail")
+scan = extract_between("uint32_t last = n;", "            bfx_shape(p,")
+head = r'''
+#include "fastmath.h"
+#include <assert.h>
+#include <math.h>
+#include <stdio.h>
+#include <stdint.h>
+'''
+plan_state = r'''
+static uint8_t eng_plan;
+static uint32_t eng_job_cost[JB_N];
+enum { ORIGINAL_SOUND_MIAMI = 1 };
+struct { unsigned kind; } original_bass[2];
+static int d909, d808, brk;
+static int drum909_active(const int *a) { return *a; }
+static int drum808_active(const int *a) { return *a; }
+static int breaks_silent(const int *a) { return !*a; }
+'''
+quiet_start = r'''
+static unsigned quiet_after(unsigned start, unsigned n, float *l, float *r)
+{
+    const unsigned bv = 0;
+    float *bb[2] = {l, r};
+    unsigned original_quiet_samples[2] = {start, 0}, bass_quiet_next[2];
+'''
+body = r'''
+    return bass_quiet_next[0];
+}
+
+static uint32_t rng = 0x97u;
+static uint32_t next(void) { return rng = rng * 1664525u + 1013904223u; }
+
+static unsigned all_masks(unsigned allowed, const uint32_t *c, unsigned current)
+{
+    unsigned best = current & allowed, cost = plan_cost(best, c), min = cost;
+    for (unsigned m = 0; m < 1u << JB_N; ++m) {
+        if (m & ~allowed) continue;
+        unsigned k = plan_cost(m, c);
+        if (k < min) { min = k; best = m; }
+    }
+    return min * 8u < cost * 7u || (current & ~allowed) ? best : current & allowed;
+}
+
+int main(void)
+{
+    unsigned checks = 0;
+    const float q = 1.0f / 65536.0f;
+    const float levels[] = {0.0f, -0.0f, q, -q, q * 1.1f, -q * 1.1f, INFINITY, NAN};
+    for (unsigned pattern = 0; pattern < 64; ++pattern) {
+        float l[256], r[256];
+        for (unsigned i = 0; i < 256; ++i) {
+            l[i] = levels[next() >> 29];
+            r[i] = levels[next() >> 29];
+            if (pattern & 1) l[i] = 0.0f;
+            if (pattern & 2) r[i] = 0.0f;
+        }
+        for (unsigned n = 0; n <= 256; ++n) {
+            unsigned start = (pattern & 4) ? 512 : next() % 513, ref = start;
+            for (unsigned i = 0; i < n; ++i) {
+                if (fm_fabsf(l[i]) > q || fm_fabsf(r[i]) > q) ref = 0;
+                else if (ref < 512) ++ref;
+            }
+            assert(quiet_after(start, n, l, r) == ref);
+            ++checks;
+        }
+    }
+    /* All actual activity/affinity combinations, initial schedules (including
+     * stale jobs), short and full spans, ties, and varying stage costs. */
+    const unsigned ns[] = {1, 32, 64, 128, 256};
+    for (unsigned state = 0; state < 32; ++state) {
+        d909 = (state >> 0) & 1u;
+        d808 = (state >> 1) & 1u;
+        brk  = (state >> 2) & 1u;
+        original_bass[0].kind = (state >> 3) & 1u;
+        original_bass[1].kind = (state >> 4) & 1u;
+        const unsigned act = (d909 << JB_909) | (d808 << JB_808) |
+                             (brk << JB_BRK) | (1u << JB_A) | (1u << JB_B);
+        const unsigned mask = act & ((1u << JB_909) | (1u << JB_808) | (1u << JB_BRK) |
+            (original_bass[0].kind << JB_A) | (original_bass[1].kind << JB_B));
+        for (unsigned vector = 0; vector < 16; ++vector) {
+            for (unsigned i = 0; i < JB_N; ++i)
+                eng_job_cost[i] = vector == 0 ? 0 : vector == 1 ? 1800 : next() % 8000;
+            for (unsigned j = 0; j < sizeof ns / sizeof ns[0]; ++j) {
+                const unsigned n = ns[j], nn = n < 64 ? 64 : n;
+                uint32_t c[JB_N];
+                for (unsigned i = 0; i < JB_N; ++i)
+                    c[i] = (act >> i & 1u) ? eng_job_cost[i] * nn / 256u : 0u;
+                for (unsigned old = 0; old < 1u << JB_N; ++old) {
+                    eng_plan = (uint8_t)old;
+                    assert(plan_pick(n) == all_masks(mask, c, old));
+                    ++checks;
+                }
+            }
+        }
+    }
+    printf("PASS %u quiet-frame and split-selection comparisons\n", checks);
+}
+'''
+
+with tempfile.TemporaryDirectory(prefix="render-shortcuts-") as folder:
+    d = Path(folder)
+    source = d / "test.c"
+    output = d / "test"
+    source.write_text(head + enum + plan_state + plan + quiet_start + scan + body)
+    subprocess.run([os.environ.get("CC", "cc"), "-std=c99", "-O2", "-Wall", "-Wextra", "-Werror",
+                    "-DX0X_HOST", "-I" + str(ROOT / "firmware/src/dsp"), str(source), "-o", str(output)],
+                   check=True)
+    subprocess.run([str(output)], check=True)
