index 0000000000000000000000000000000000000000..d3f9fd59c8664f3b7a2582019a7bdba16b3a5237
--- /dev/null
+++ b/tests/host/ui_seq_voice_glyph_test.c
@@ -0,0 +1,43 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+/* Guidelines §3 / audit #44: the 808 and 909 sequencers label each lane with
+ * the voice's own R22 pictogram (the MIX strip's), not a BD/SD abbreviation,
+ * and AC with the accent chevrons. Every lane is distinct, none is the old
+ * text label, the selected lane inverts, and the pixels are pinned. */
+#define SMC_UI_MAIN unused_smc_ui_main
+#include "smc_ui_test.c"
+static uint16_t full[2*BAND_H*240];
+static uint32_t lane_hash(int v, int text)
+{
+    int y = v*DROW + 1, x, yy; uint32_t h = 2166136261u;
+    for (int band = 0; band < 2; band++) {
+        cv_begin(240, BAND_H, C_BLACK);
+        if (!text) draw_drum(band);
+        else cv_text(5, vc(&FONT_XS, y - 1 - band*BAND_H, DROW - 1), &FONT_XS,
+                     v < NDRUM ? engine_voice_name(ui.part == PART_909 ? T_909 : T_808, v) : "AC", C_GRAY);
+        memcpy(full + band*BAND_H*240, cv_px, BAND_H*240*sizeof *full);
+    }
+    for (yy = y - 1; yy < y + DROW - 1; yy++)
+        for (x = 0; x < 25; x++) h = (h ^ full[yy*240 + x])*16777619u;
+    return h;
+}
+int main(void)
+{
+    static const uint32_t pin[2] = {0x2e6afa88u, 0x9a430d91u};
+    int parts[2] = {PART_909, PART_808};
+    for (int k = 0; k < 2; k++) {
+        setup(V_SEQ, parts[k]); ui.sel[parts[k]] = 3; build_pages();
+        uint32_t h[NDRUM + 1], all = 2166136261u;
+        for (int v = 0; v <= NDRUM; v++) {
+            h[v] = lane_hash(v, 0);
+            CHECK(h[v] != lane_hash(v, 1));               /* not the BD/SD text */
+            for (int j = 0; j < v; j++) CHECK(h[v] != h[j]);
+            all = (all ^ h[v])*16777619u;
+        }
+        ui.sel[parts[k]] = 4; uint32_t moved = lane_hash(3, 0);
+        CHECK(moved != h[3]);                        /* selection inverts the lane */
+        printf("SEQ_VOICE_GLYPHS part=%d hash=0x%08x\n", parts[k], all);
+        if (pin[k]) CHECK(all == pin[k]);
+    }
+    puts("PASS 808/909 SEQ lanes use distinct voice pictograms, not BD/SD text");
+    return 0;
+}
