+
+/* Chicago/Miami stay active through release tails; inspect key ownership. */
+
+static int fails, checks;
+#define CHECK(c, ...) do { checks++; if (!(c)) { fails++; printf("  FAIL %s:%d: ", __FILE__, __LINE__); printf(__VA_ARGS__); printf("\n"); } } while (0)
+
+/* ---- the wire, from the spec ---- */
+#define NF 64
+static uint8_t of[NF][256];
+static uint32_t on[NF];
+static int nof;
+static void sink(const uint8_t *f, uint32_t n)
+{
+    if (nof < NF && n <= 256u) { memcpy(of[nof], f, n); on[nof] = n; }
+    nof++;
+}
+static uint32_t crc32_ref(const uint8_t *p, uint32_t n)        /* zlib CRC-32, bitwise */
+{
+    uint32_t c = 0xFFFFFFFFu;
+    while (n--) { c ^= *p++; for (int k = 0; k < 8; k++) c = c & 1u ? c >> 1 ^ 0xEDB88320u : c >> 1; }
+    return ~c;
+}
+static uint8_t P[256];
+static int pn;
+static void p7(uint32_t v) { P[pn++] = (uint8_t)(v & 127u); }
+static void pu(uint32_t v, int k) { while (k--) { p7(v); v >>= 7; } }
+static uint32_t gu(const uint8_t *a, int k) { uint32_t v = 0; while (k--) v = v << 7 | a[k]; return v; }
+static uint32_t frame_mk(uint8_t *f, int major, int op, int sq, const uint8_t *pl, int len)
+{
+    uint32_t c, n;
+    f[0] = 0xF0, f[1] = 0x7D, f[2] = 0x44, f[3] = 0x4E, f[4] = (uint8_t)major, f[5] = (uint8_t)op;
+    f[6] = (uint8_t)(sq & 127), f[7] = (uint8_t)(sq >> 7 & 127), f[8] = (uint8_t)(len & 127), f[9] = (uint8_t)(len >> 7);
+    memcpy(f + 10, pl, (size_t)len);
+    c = crc32_ref(f + 5, 5u + (uint32_t)len);
+    n = 10u + (uint32_t)len;
+    for (int k = 0; k < 5; k++, c >>= 7) f[n++] = (uint8_t)(c & 127u);
+    f[n++] = 0xF7;
+    return n;
+}
+static int tx(const uint8_t *f, uint32_t n) { nof = 0; return remote_dnr3_frame(f + 1, n - 2u); }
+typedef struct { int op, seq, len, status; uint32_t rev; const uint8_t *pl, *fl; int ok; } rep_t;
+static int parse(int i, rep_t *r)                                /* frame i of the capture: 0 = valid */
+{
+    const uint8_t *f = of[i];
+    uint32_t n = on[i], len;
+    memset(r, 0, sizeof *r);
+    if (n < 16u || n > 256u || f[0] != 0xF0 || f[1] != 0x7D || f[2] != 0x44 || f[3] != 0x4E || f[4] != 3 || f[n - 1] != 0xF7)
+        return -1;
+    for (uint32_t k = 1; k + 1 < n; k++) if (f[k] & 0x80u) return -2;
+    len = gu(f + 8, 2);
+    if (len != n - 16u) return -3;
+    if (crc32_ref(f + 5, 5u + len) != gu(f + 10 + len, 5)) return -4;
+    r->op = f[5], r->seq = (int)gu(f + 6, 2), r->len = (int)len, r->pl = f + 10;
+    if (r->op == 0x7F) r->rev = gu(r->pl, 4), r->status = -1, r->fl = r->pl + 5, r->ok = 1;
+    else r->status = r->pl[0], r->rev = gu(r->pl + 1, 4), r->fl = r->pl + 5, r->ok = 1;
+    return 0;
+}
+static uint32_t epoch;
+static int sq_next = 1;
+static uint8_t F[300];
+static uint32_t Fn;
+/* one request (P/pn as payload): exactly one reply, valid, to this op and seq */
+static rep_t req(int op)
+{
+    rep_t r;
+    int sq = sq_next++ & 0x3FFF;
+    Fn = frame_mk(F, 3, op, sq, P, pn);
+    pn = 0;
+    if (tx(F, Fn) != 0 || nof != 1 || parse(0, &r) || r.op != (op | 0x40) || r.seq != sq) {
+        printf("  FAIL op %02X: handled/frames/reply wrong (nof %d)\n", op, nof);
+        fails++;
+        memset(&r, 0, sizeof r);
+        r.status = -9;
+    }
+    return r;
+}
+static void ep(void) { pu(epoch, 4); }
+static int autokeep = 1;                                           /* KEEPALIVE every second, out of the capture */
+static void tick(uint32_t ms)
+{
+    while (ms--) {
+        run_ms(1);
+        if (autokeep && epoch && !(now_ms % 1000u)) {
+            uint8_t f[32], pl[4] = {(uint8_t)(epoch & 127u), (uint8_t)(epoch >> 7 & 127u), (uint8_t)(epoch >> 14 & 127u), (uint8_t)(epoch >> 21 & 127u)};
+            uint32_t n = frame_mk(f, 3, 0x06, 0, pl, 4);
+            int was = nof;
+            (void)remote_dnr3_frame(f + 1, n - 2u);
+            nof = was;
+        }
+        remote_dnr3_tick(now_ms);
+    }
+}
+static uint32_t rev_now(void) { rep_t r = req(0x30); return r.rev; }
+static int notifies(int kind, rep_t *last)                        /* NOTIFYs of a kind in the capture */
+{
+    int c = 0;
+    rep_t r;
+    for (int i = 0; i < nof && i < NF; i++)
+        if (!parse(i, &r) && r.op == 0x7F && r.fl[-1] == kind) { c++; if (last) *last = r; }
+    return c;
+}
+static uint8_t S[300];
+static uint32_t Sn;
+static void open_lease(uint32_t mask)
+{
+    rep_t r;
+    pu(0x1234, 4);
+    r = req(0x01);
+    CHECK(r.status == 0, "OPEN ok (%d)", r.status);
+    epoch = gu(r.fl, 4);
+    CHECK(gu(r.fl + 4, 2) == 2000u, "lease 2000 ms");
+    ep(); pu(mask, 4);
+    r = req(0x08);
+    CHECK(r.status == 0, "WATCH ok");
+}
+static void keep(void) { rep_t r; ep(); r = req(0x06); CHECK(r.status == 0, "KEEPALIVE ok"); }
+static void pset_payload(int kind, int a, int b, int c, int expect, int v)
+{
+    ep(); p7(kind); p7(a); p7(b); p7(c); pu(expect, 2); pu(v, 2);
+}
+static int pset(int kind, int a, int b, int c, int expect, int v, int *out)
+{
+    pset_payload(kind, a, b, c, expect, v);
+    rep_t r = req(0x12);
+    if (out && r.status == 0) *out = (int)gu(r.fl + 4, 2);
+    return r.status;
+}
+static rep_t guarded_pset(int bank, int param, int expect, int value)
+{
+    pset_payload(R_ENG, T_303, 0, param, expect, value);
+    p7(bank);
+    return req(0x12);
+}
+static int pget(int kind, int a, int b, int c, int *max)
+{
+    rep_t r;
+    p7(1); p7(kind); p7(a); p7(b); p7(c);
+    r = req(0x11);
+    if (r.status) return -2;
+    *max = (int)gu(r.fl + 7, 2);
+    return gu(r.fl + 5, 2) == 0x3FFFu ? -1 : (int)gu(r.fl + 5, 2);
+}
+static int sset(int part, int pat, int step, int expect, const uint8_t *rec, int n, rep_t *out)
+{
+    rep_t r;
+    ep(); p7(part); p7(pat); p7(step); pu(expect, 2);
+    for (int i = 0; i < n; i++) p7(rec[i]);
+    r = req(0x21);
+    if (out) *out = r;
+    return r.status;
+}
+static int sget(int part, int pat, int step, int track, uint8_t *rec)
+{
+    rep_t r;
+    p7(part); p7(pat); p7(step); if (track >= 0) p7(track);
+    r = req(0x20);
+    if (r.status) return -1;
+    memcpy(rec, r.fl + 3, (size_t)(r.len - 8));
+    return r.len - 8;
+}
+static void clksrc(int v) { pref_set(PR(R_CLKSRC, 0, 0, 0), v); tick(60); }   /* GLO > MIDI > CLOCK SOURCE (ui_frame applies it) */
+static uint32_t pcrc(int pat) { return crc32_ref((const uint8_t *)&proj.pat[pat], sizeof(pattern_t)) & 0x3FFFu; }
+static void unpack7(const uint8_t *s, uint32_t n, uint8_t *d)     /* ed_put7 */
+{
+    while (n) {
+        uint32_t k = n < 7u ? n : 7u;
+        for (uint32_t j = 0; j < k; j++) d[j] = (uint8_t)(s[1 + j] | ((s[0] >> j & 1u) << 7));
+        s += k + 1, d += k, n -= k;
+    }
+}
+static int hex(const char *h, uint8_t *b) { int n = 0; while (h[0] && h[1]) { unsigned v; sscanf(h, "%2x", &v); b[n++] = (uint8_t)v; h += 2; } return n; }
+
+/* ---- 1 framing ---- */
+static void t1_framing(void)
+{
+    uint8_t v[300];
+    int n, before_bpm = (int)rd_bpm10();
+    uint32_t rev0;
+    rep_t r;
+    /* the Web Remote's vectors (dnr3-vectors.json v1): CRC, pack7 and a HELLO request */
+    CHECK(x0x_crc32("123456789", 9) == 0xCBF43926u && crc32_ref((const uint8_t *)"DNR3", 4) == 0x786BEE7Cu, "[1] CRC-32 vectors");
+    {
+        static const uint8_t raw[8] = {0x80, 0x81, 0x82, 0x83, 0x84, 0x85, 0x86, 0x87};
+        RD_N = 0; rd_put7(raw, 8);
+        n = hex("7f000102030405060107", v);
+        CHECK(RD_N == n && !memcmp(RD_OUT, v, (size_t)n), "[1] ed_put7 vector");
+    }
+    n = hex("f07d444e030001000100031e67262301f7", v);
+    CHECK(tx(v, (uint32_t)n) == 0 && nof == 1 && !parse(0, &r) && r.op == 0x40 && r.status == 0, "[1] Remote's HELLO vector accepted");
+    if (r.ok) {
+        uint8_t want_sha[20], got_sha[20];
+        CHECK(hex("bb1907490080ff0102030405060708090afdfeff", want_sha) == 20, "[1] full SHA fixture length");
+        unpack7(r.fl + 2, 20, got_sha);
+        CHECK(!memcmp(got_sha, want_sha, 20), "[1] HELLO carries all 20 source bytes including zero and high bits");
+        /* reply layout = the vector's (42 B: status rev proto minor sha23 board caps4 NPAT NSTEPS 11 2 clip clk hz) */
+        CHECK(r.len == 42 && r.fl[0] == 3 && r.fl[1] == 0 && r.fl[25] == 3 && r.fl[30] == 32 && r.fl[31] == 64 &&
+              r.fl[32] == 11 && r.fl[33] == 2 && r.fl[36] == 50, "[1] HELLO reply layout as the vector (len %d)", r.len);
+        CHECK(gu(r.fl + 26, 4) == 0x2FFu, "[1] HELLO advertises guarded bass writes, not VOICE");
+    }
+    open_lease(0);
+    rev0 = rev_now();
+    /* a valid TEMPO write, then each malformed copy: BAD, nothing changes, no rev bump */
+    ep(); pu(1337, 2);
+    {
+        uint8_t m[300], F[300];
+        uint32_t k, Fn = frame_mk(F, 3, 0x27, 77, P, pn);
+        pn = 0;
+        memcpy(m, F, Fn); m[4] = 5;                                  /* bad header (major) */
+        CHECK(tx(m, Fn) == 0 && nof == 1 && !parse(0, &r) && r.status == 2, "[1] bad major -> BAD");
+        memcpy(m, F, Fn); m[8]++;                                    /* bad length field */
+        CHECK(tx(m, Fn) == 0 && nof == 1 && !parse(0, &r) && r.status == 2, "[1] bad len -> BAD");
+        memcpy(m, F, Fn); m[12] |= 0x80;                             /* a byte >= 0x80 */
+        CHECK(tx(m, Fn) == 0 && nof == 1 && !parse(0, &r) && r.status == 2, "[1] byte >= 0x80 -> BAD");
+        memcpy(m, F, Fn); m[Fn - 3] ^= 1;                            /* bad CRC */
+        CHECK(tx(m, Fn) == 0 && nof == 1 && !parse(0, &r) && r.status == 2, "[1] bad CRC -> BAD");
+        memset(m, 0x11, sizeof m);                                   /* over-long: 257 B */
+        k = frame_mk(m, 3, 0x27, 78, m + 40, 241);
+        CHECK(k == 257 && tx(m, k) == 0 && nof == 1 && !parse(0, &r) && r.status == 2, "[1] over-long -> BAD");
+        CHECK(tx(m, 10) == 0 && nof == 1 && !parse(0, &r) && r.status == 2, "[1] too short -> BAD");
+        CHECK((int)rd_bpm10() == before_bpm && rev_now() == rev0, "[1] no state change and no rev bump after malformed frames");
+        CHECK(tx(F, Fn) == 0 && nof == 1 && !parse(0, &r) && r.status == 0 && rd_bpm10() == 1337u, "[1] the valid frame applies");
+    }
+}
+/* ---- 2 DNR2 and FL ---- */
+static void t2_dnr2_fl(void)
+{
+    uint8_t f[64] = {0xF0, 0x7D, 0x44, 0x4E, 0x02, 0x10, 0x05};
+    rep_t r;
+    f[50] = 0xF7;
+    CHECK(tx(f, 51) == 0 && nof == 1 && !parse(0, &r) && r.op == 0x50 && r.status == 6 && r.len == 5, "[2] DNR2 frame -> UNSUPPORTED");
+    {
+        static const uint8_t fl[] = {0xF0, 0x7D, 0x46, 0x4C, 0x01, 0xF7};   /* FL INFO */
+        static const uint8_t fl9[] = {0xF0, 0x7D, 0x46, 0x4C, 0x09, 0x41, 0x00, 0xF7}; /* FL PROJECT export */
+        CHECK(tx(fl, sizeof fl) == -1 && nof == 0, "[2] FL INFO is not DNR3's (left for ed_handle)");
+        CHECK(tx(fl9, sizeof fl9) == -1 && nof == 0, "[2] FL PROJECT is not DNR3's");
+    }
+}
+/* ---- 3 lease ---- */
+static void t3_lease(void)
+{
+    rep_t r;
+    uint32_t e;
+    autokeep = 0;
+    tick(2100);                                                      /* the lease of [1] runs out */
+    epoch = 0;
+    ep(); pu(1300, 2);
+    r = req(0x27);
+    CHECK(r.status == 8 && r.len == 5, "[3] write without OPEN -> DENIED (%d)", r.status);
+    open_lease(0);
+    e = epoch;
+    pu(0x999, 4);
+    r = req(0x01);
+    CHECK(r.status == 3, "[3] second client's OPEN while live -> BUSY (%d)", r.status);
+    epoch = e + 1; ep(); pu(1300, 2);
+    r = req(0x27);
+    CHECK(r.status == 4, "[3] wrong epoch -> STALE (%d)", r.status);
+    epoch = e;
+    tick(1500); keep(); tick(1500);
+    ep(); pu(1310, 2);
+    r = req(0x27);
+    CHECK(r.status == 0, "[3] KEEPALIVE renews (3000 ms after OPEN: %d)", r.status);
+    tick(2001);
+    ep(); pu(1320, 2);
+    r = req(0x27);
+    CHECK(r.status == 8, "[3] expiry after 2000 ms -> DENIED (%d)", r.status);
+    pu(0x999, 4);
+    r = req(0x01);
+    CHECK(r.status == 0, "[3] another client may OPEN after expiry");
+    epoch = gu(r.fl, 4);
+    ep(); r = req(0x07);
+    CHECK(r.status == 0, "[3] CLOSE ok");
+    pu(0x1234, 4);
+    r = req(0x01);
+    CHECK(r.status == 0, "[3] CLOSE frees: a new client OPENs");
+    epoch = gu(r.fl, 4);
+    autokeep = 1;
+}
+/* ---- 4 PARAM over every pref_t the pages show ---- */
+static pref_t refs[1500];
+static int nrefs;
+static void add_ref(pref_t r)
+{
+    if (r.kind == R_NONE || r.kind == R_HDR || r.kind == R_SECTION || r.kind == R_ACT) return;
+    for (int i = 0; i < nrefs; i++) if (!memcmp(&refs[i], &r, sizeof r)) return;
+    if (nrefs < 1500) refs[nrefs++] = r;
+}
+static void t4_param(void)
+{
+    static pages_t pgs;
+    int v, max, i, k, unsup = 0, sets = 0;
+    rep_t r;
+    for (int view = 0; view < NVIEWS; view++)
+        for (int part = 0; part < NPARTS; part++)
+            for (int mix = 0; mix < NPARTS; mix++) {
+                if (view == V_GEN && !part_is_303(part)) continue;   /* the panel opens GEN on a 303 only */
+                memset(&pgs, 0, sizeof pgs);
+                describe_pages(&pgs, 0, view, part, mix, ui.sel);
+                for (i = 0; i < pgs.n && i < MAXPAGES; i++) for (k = 0; k < 4; k++) add_ref(pgs.r[i][k]);
+                for (i = 0; i < pgs.nmore && i < MAXMORE; i++) add_ref(pgs.more[i]);
+            }
+    printf("  remote-dnr3: %d page values\n", nrefs);
+    CHECK(nrefs > 100, "[4] the page walk finds the panel's values (%d)", nrefs);
+    for (i = 0; i < nrefs; i++) {
+        pref_t a = refs[i];
+        const x0x_param_t *d = pref_desc(a);
+        if (!d) continue;
+        p7(a.kind); p7(a.a); p7(a.b); p7(a.c);
+        r = req(0x10);
+        if (r.status) { unsup++; printf("  FAIL [4] DESCRIBE kind %d a %d b %d c %d -> %d\n", a.kind, a.a, a.b, a.c, r.status); fails++; continue; }
+        {
+            const uint8_t *q = r.fl;
+            int nl = (int)strlen((const char *)q);
+            int ok = !strncmp((const char *)q, d->name, 6) && (nl == (int)strlen(d->name) || nl == 6);
+            q += nl + 1;
+            ok = ok && gu(q, 2) == d->max && gu(q + 2, 2) == d->def;
+            CHECK(ok, "[4] DESCRIBE == pref_desc for kind %d a %d b %d c %d (%s)", a.kind, a.a, a.b, a.c, d->name);
+        }
+        v = pget(a.kind, a.a, a.b, a.c, &max);
+        CHECK(v == pref_get(a) && max == d->max, "[4] PARAM_GET == pref_get kind %d a %d b %d c %d (%d vs %d)", a.kind, a.a, a.b, a.c, v, pref_get(a));
+        if (rd_pref_ok(a.kind, a.a, a.b, a.c) != 1 || pref_read_only(a)) continue;
+        {
+            int orig = pref_get(a), got = -1, st;
+            keep();
+            st = pset(a.kind, a.a, a.b, a.c, 0x3FFF, 0, &got);
+            CHECK(st == 0 && got == pref_get(a) && pget(a.kind, a.a, a.b, a.c, &max) == got, "[4] PARAM_SET min kind %d a %d b %d c %d", a.kind, a.a, a.b, a.c);
+            st = pset(a.kind, a.a, a.b, a.c, 0x3FFF, d->max, &got);
+            CHECK(st == 0 && got == pref_get(a) && got <= d->max, "[4] PARAM_SET max kind %d a %d b %d c %d", a.kind, a.a, a.b, a.c);
+            st = pset(a.kind, a.a, a.b, a.c, 0x3FFF, d->max + 1, &got);
+            CHECK(st == 0 && got <= d->max && got == pref_get(a), "[4] PARAM_SET max+1 clamps kind %d a %d b %d c %d", a.kind, a.a, a.b, a.c);
+            (void)pset(a.kind, a.a, a.b, a.c, 0x3FFF, orig, 0);
+            sets++;
+        }
+    }
+    printf("  remote-dnr3: %d values set (min, max, max+1)\n", sets);
+    CHECK(!unsup && sets > 50, "[4] every page value is DESCRIBEd and the writable ones set");
+    /* expect mismatch: CONFLICT, nothing applied */
+    {
+        int cur = pref_get(PR(R_SWING, 0, 0, 0)), got;
+        CHECK(pset(R_SWING, 0, 0, 0, (cur + 1) & 0x3FFF, 10, 0) == 5 && pref_get(PR(R_SWING, 0, 0, 0)) == cur, "[4] expect mismatch -> CONFLICT");
+        CHECK(pset(R_SWING, 0, 0, 0, cur, 10, &got) == 0 && got == 10, "[4] expect match applies");
+    }
+    /* flash-writing / radio / device kinds: UNSUPPORTED, unchanged */
+    {
+        static const uint8_t ks[] = {R_AUTOSAVE, R_BT, R_USBFULL, R_CLKSRC, R_SMC_ROLE};
+        for (i = 0; i < (int)sizeof ks; i++) {
+            int was = pref_get(PR(ks[i], 0, 0, 0));
+            CHECK(pset(ks[i], 0, 0, 0, 0x3FFF, was ? 0 : 1, 0) == 6 && pref_get(PR(ks[i], 0, 0, 0)) == was, "[4] kind %d -> UNSUPPORTED", ks[i]);
+        }
+        CHECK(pset(R_MIDICH, 0, 0, 0, 0x3FFF, 3, 0) == 6, "[4] R_MIDICH -> UNSUPPORTED");
+        CHECK(pset(R_ENG, 0, 99, 0, 0x3FFF, 3, 0) == 2 && pset(60, 0, 0, 0, 0x3FFF, 3, 0) == 2, "[4] a bad address -> BAD");
+    }
+    /* one NOTIFY PARAM per write */
+    {
+        rep_t last;
+        int got;
+        ep(); pu(1, 4); (void)req(0x08);
+        tick(200);
+        CHECK(pset(R_ENG, T_909, 0, 0, 0x3FFF, 33, &got) == 0, "[4] PARAM_SET 909 BD");
+        nof = 0;
+        tick(100);
+        CHECK(notifies(0, &last) == 1 && last.fl[0] == R_ENG && last.fl[1] == T_909 && last.fl[2] == 0 && last.fl[3] == 0 &&
+              (int)gu(last.fl + 4, 2) == got, "[4] NOTIFY PARAM once with the stored value (%d)", notifies(0, 0));
+    }
+}
+/* A bank-local numeric parameter and its old value can overlap between banks.
+ * The optional last byte must actually protect the stored sound, not just ACK. */
+static void t4_bass_bank_guard(void)
+{
+    uint8_t *cell = proj.sound.v[T_303][0];
+    uint8_t saved[ORIGINAL_SOUND_BYTES], drift[ORIGINAL_SOUND_BYTES];
+    const int param = 2;                 /* a writable control in both Chicago and Miami */
+    int bank = engine_bass_bank(0), other = bank ^ 1, max, got;
+    int value = pget(R_ENG, T_303, 0, param, &max);
+    int change = value == 0 ? 1 : 0;
+    rep_t r;
+    keep();
+    CHECK(bank == ORIGINAL_SOUND_CHICAGO || bank == ORIGINAL_SOUND_MIAMI, "[4] bass guard fixture has Chicago or Miami");
+    CHECK(value >= 0 && !engine_bass_preset_pending(0), "[4] bass guard fixture has a stable descriptor");
+    r = guarded_pset(bank, param, value, change);
+    CHECK(r.status == 0 && gu(r.fl + 4, 2) == (unsigned)change && cell[param] == change,
+          "[4] matching bank, descriptor and expected value: writes and reads back");
+    r = guarded_pset(bank, param, value, change == 0 ? 1 : 0);
+    CHECK(r.status == 5 && cell[param] == change, "[4] matching bank still checks expected value");
+    CHECK(pset(R_ENG, T_303, 0, param, change, value, &got) == 0 && got == value && cell[param] == value,
+          "[4] legacy 12-byte bass client retains behavior");
+    memcpy(saved, cell, sizeof saved);
+    uint32_t rev = rev_now();
+    r = guarded_pset(other, param, value, change);
+    CHECK(r.status == 5 && !memcmp(saved, cell, sizeof saved) && rev_now() == rev,
+          "[4] wrong bank with identical scalar: conflict, no cell/revision mutation");
+    CHECK(guarded_pset(4, param, value, change).status == 2, "[4] out-of-range guard fails BAD");
+    CHECK(guarded_pset(bank, 127, value, change).status == 2, "[4] invalid parameter fails BAD under hold");
+    pset_payload(R_ENG, T_909, 0, 0, 0x3FFF, 1); p7(bank);
+    CHECK(req(0x12).status == 2, "[4] guard is only legal on bass target");
+    pset_payload(R_ENG, T_303, NBASS, param, 0x3FFF, 1); p7(bank);
+    CHECK(req(0x12).status == 2, "[4] guarded bass voice out of range fails BAD");
+    pset_payload(R_ENG, T_303, 0, param, value, change); p7(bank); p7(0);
+    CHECK(req(0x12).status == 2, "[4] trailing junk after bank guard fails BAD");
+    pset_payload(R_ENG, T_303, 0, param, value, change); P[pn++] = 0x80;
+    CHECK(req(0x12).status == 2 && !memcmp(saved, cell, sizeof saved) && rev_now() == rev,
+          "[4] non-7-bit bank guard fails even with valid CRC, no mutation");
+    CHECK(original_sound_init(cell, (unsigned)other, 0), "[4] forge mismatched persisted cell in fixture only");
+    memcpy(drift, cell, sizeof drift);
+    CHECK(guarded_pset(bank, param, 0x3FFF, change).status == 3 && !memcmp(drift, cell, sizeof drift),
+          "[4] active bank matches but stored bank differs: busy, no mutation");
+    memcpy(cell, saved, sizeof saved);
+    CHECK(!engine_bass_select_preset(0, bank, 1, &proj.sound) && engine_bass_preset_pending(0),
+          "[4] queue same-bank factory replacement");
+    CHECK(guarded_pset(bank, param, 0x3FFF, change).status == 3 && !memcmp(saved, cell, sizeof saved),
+          "[4] pending same-bank replacement blocks write and preserves cell");
+    CHECK(!engine_bass_select_preset(0, other, 0, &proj.sound) && engine_bass_preset_pending(0),
+          "[4] queue other bank");
+    CHECK(guarded_pset(other, param, 0x3FFF, change).status == 3 && !memcmp(saved, cell, sizeof saved),
+          "[4] requested bank is not treated as active");
+    for (int i = 0; i < 1200 && engine_bass_preset_pending(0); i++) tick(1);
+    CHECK(!engine_bass_preset_pending(0) && engine_bass_bank(0) == other, "[4] pending preset applies after guard releases its hold");
+    memcpy(saved, cell, sizeof saved);
+    value = pget(R_ENG, T_303, 0, param, &max);
+    change = value == 0 ? 1 : 0;
+    CHECK(guarded_pset(bank, param, value, change).status == 5 && !memcmp(saved, cell, sizeof saved),
+          "[4] stale old bank cannot edit the new sound at the same parameter ID and matching scalar");
+    CHECK(guarded_pset(other, param, value, change).status == 0 && cell[param] == change,
+          "[4] actual active bank now accepts a guarded write");
+    CHECK(!engine_bass_select_preset(0, bank, 0, &proj.sound), "[4] restore original fixture bank");
+    for (int i = 0; i < 1200 && engine_bass_preset_pending(0); i++) tick(1);
+    CHECK(engine_bass_bank(0) == bank, "[4] original fixture bank restored");
+}
