+/* ---- 5 STEP ---- */
+static int midi_has(FILE *f, int status, int note)                /* the MIDI log: "ms: SS NN VV" */
+{
+    char line[96];
+    unsigned ms, s, n, v;
+    int c = 0;
+    rewind(f);
+    while (fgets(line, sizeof line, f))
+        if (sscanf(line, "%u ms: %x %x %x", &ms, &s, &n, &v) == 4 && (int)s == status && (int)n == note && v) c++;
+    return c;
+}
+static void t5_step(void)
+{
+    uint8_t rec[8], got[8];
+    rep_t r;
+    int pat = 3;
+    keep();
+    /* 909: voice 0 and the accent row, first / last / beyond len */
+    proj.pat[pat].drum[0].len = 16;
+    static const int steps[3] = {0, 63, 40};
+    for (int t = 0; t < 2; t++)
+        for (int i = 0; i < 3; i++) {
+            int tr = t ? NDRUM : 0, s = steps[i];
+            uint32_t *w = (tr == NDRUM ? proj.pat[pat].drum[0].accent : proj.pat[pat].drum[0].hit[tr]);
+            rec[0] = (uint8_t)tr, rec[1] = 1, rec[2] = 127;
+            CHECK(sset(0, pat, s, pcrc(pat), rec, 3, &r) == 0 && sm_get(w, s) && r.fl[3] == tr && r.fl[4] == 1 &&
+                  gu(r.fl + 6, 2) == pcrc(pat), "[5] 909 track %d step %d set (reply pattern_crc)", tr, s);
+            CHECK(sget(0, pat, s, tr, got) == 3 && got[0] == tr && got[1] == 1, "[5] STEP_GET 909 track %d step %d", tr, s);
+            rec[1] = 0;
+            CHECK(sset(0, pat, s, 0x3FFF, rec, 3, 0) == 0 && !sm_get(w, s), "[5] 909 track %d step %d clear", tr, s);
+        }
+    /* drum velocity lane */
+    rec[0] = 2, rec[1] = 1, rec[2] = 40;
+    CHECK(sset(1, pat, 5, 0x3FFF, rec, 3, 0) == 0 && sget(1, pat, 5, 2, got) == 3 && got[1] == 1 && got[2] == 40, "[5] 808 step velocity 40");
+    rec[2] = 0;
+    CHECK(sset(1, pat, 5, 0x3FFF, rec, 3, 0) == 0 && sget(1, pat, 5, 2, got) == 3 && got[2] == 0, "[5] velocity 0 = the accent law");
+    /* 303: flag packing round trip */
+    {
+        static const uint8_t b[6] = {36, G_NOTE, 1, 1, 90, 15};
+        const bstep_t *st = &proj.pat[pat].bass[1].step[63];
+        CHECK(sset(3, pat, 63, 0x3FFF, b, 6, &r) == 0 && st->note == 36 && st->velocity == 90 &&
+              st->flags == (G_NOTE | BS_ACCENT | BS_SLIDE | 15u << BS_END_SHIFT), "[5] 303 B step 63 packs gate/accent/slide/end");
+        CHECK(sget(3, pat, 63, -1, got) == 6 && !memcmp(got, b, 6), "[5] 303 STEP_GET round trip");
+        static const uint8_t t2[6] = {40, G_TIE, 0, 0, 0, 0};
+        CHECK(sset(2, pat, 0, 0x3FFF, t2, 6, 0) == 0 && bstep_gate(&proj.pat[pat].bass[0].step[0]) == G_TIE &&
+              sget(2, pat, 0, -1, got) == 6 && !memcmp(got, t2, 6), "[5] 303 A tie step 0");
+        static const uint8_t bad[6] = {40, 3, 0, 0, 0, 0};
+        CHECK(sset(2, pat, 1, 0x3FFF, bad, 6, 0) == 2, "[5] 303 gate 3 -> BAD");
+    }
+    /* BREAK: step 31, slice on a 16th */
+    {
+        uint8_t b[2] = {1, 0};
+        CHECK(sset(4, pat, 31, 0x3FFF, b, 2, 0) == 0 && (proj.pat[pat].brk.steps >> 31 & 1u), "[5] BREAK step 31 on");
+        b[1] = 32;
+        CHECK(sset(4, pat, 3, 0x3FFF, b, 2, 0) == 0 && proj.pat[pat].brk.slice[3] == 32 && (proj.pat[pat].brk.steps >> 3 & 1u), "[5] BREAK slice 32 on step 3");
+        CHECK(sget(4, pat, 3, -1, got) == 2 && got[0] == 1 && got[1] == 32, "[5] BREAK STEP_GET");
+        b[1] = 5;
+        CHECK(sset(4, pat, 20, 0x3FFF, b, 2, 0) == 2 && sset(4, pat, 32, 0x3FFF, b, 2, 0) == 2, "[5] BREAK slice past 16 / step 32 -> BAD");
+    }
+    /* expect_crc conflict: nothing written */
+    {
+        uint32_t c = pcrc(pat);
+        rec[0] = 4, rec[1] = 1, rec[2] = 127;
+        CHECK(sset(0, pat, 9, (c + 1) & 0x3FFF, rec, 3, 0) == 5 && pcrc(pat) == c && !sm_get(proj.pat[pat].drum[0].hit[4], 9),
+              "[5] expect_crc mismatch -> CONFLICT, nothing written");
+    }
+    /* the sequencer then plays it: 909 BD on step 4 of an empty pattern, 303 A note 48 on step 2 */
+    {
+        FILE *log = tmpfile();
+        int pp = 9;
+        memset(&proj.pat[pp].drum[0], 0, sizeof proj.pat[pp].drum[0]);
+        memset(proj.pat[pp].bass[0].step, 0, sizeof proj.pat[pp].bass[0].step);
+        proj.pat[pp].drum[0].len = 16; proj.pat[pp].bass[0].len = 16;
+        seq.mute = seq.vmute = 0; seq.part_off = 0;
+        for (int k = 0; k < NTRACKS; k++) seq.pcue[k] = (uint8_t)pp;
+        seq.send_notes = 1;
+        clksrc(SEQ_CLK_INT);
+        tick(10);
+        midi_log = log;
+        seq_start(&seq); tick(2500); seq_stop(&seq); tick(20);
+        CHECK(midi_has(log, 0x90 | seq.ch[0], 36) == 0 && midi_has(log, 0x90 | seq.ch[2], 48) == 0, "[5] empty pattern: no notes (control)");
+        rec[0] = 0, rec[1] = 1, rec[2] = 127;
+        CHECK(sset(0, pp, 4, 0x3FFF, rec, 3, 0) == 0, "[5] BD on step 4");
+        {
+            static const uint8_t n48[6] = {48, G_NOTE, 0, 0, 0, 0};
+            CHECK(sset(2, pp, 2, 0x3FFF, n48, 6, 0) == 0, "[5] 303 A note 48 on step 2");
+        }
+        fflush(log);
+        midi_log = 0; log = tmpfile(); midi_log = log;
+        seq_start(&seq); tick(2500); keep(); seq_stop(&seq); tick(20);
+        fflush(log);
+        midi_log = 0;
+        CHECK(midi_has(log, 0x90 | seq.ch[0], 36) >= 1, "[5] the sequencer plays the Remote's 909 step");
+        CHECK(midi_has(log, 0x90 | seq.ch[2], 48) >= 1, "[5] the sequencer plays the Remote's 303 step");
+        fclose(log);
+        seq.send_notes = 0;
+    }
+}
+/* ---- 6 PART_SET ---- */
+static int part_set(int part, int pat, int field, int v, int *out)
+{
+    rep_t r;
+    ep(); p7(part); p7(pat); p7(field); pu(v, 2);
+    r = req(0x22);
+    if (out && !r.status) *out = (int)gu(r.fl + 3, 2);
+    return r.status;
+}
+static void t6_part(void)
+{
+    int got, pat = 4;
+    keep();
+    CHECK(part_set(0, pat, 0, 64, &got) == 0 && got == 64 && proj.pat[pat].drum[0].len == 64, "[6] 909 len 64");
+    CHECK(part_set(1, pat, 0, 1, &got) == 0 && got == 1 && proj.pat[pat].drum[1].len == 1, "[6] 808 len 1");
+    CHECK(part_set(1, pat, 0, 0, 0) == 2 && part_set(1, pat, 0, 65, 0) == 2, "[6] len 0 / 65 -> BAD");
+    CHECK(part_set(0, pat, 1, RATE_8, &got) == 0 && got == RATE_8 && proj.pat[pat].drum[0].rate == RATE_8, "[6] 909 rate");
+    CHECK(part_set(2, pat, 2, DIR_PINGPONG, &got) == 0 && proj.pat[pat].bass[0].dir == DIR_PINGPONG, "[6] 303 A dir");
+    CHECK(part_set(3, pat, 3, 30, &got) == 0 && got == 30 && proj.pat[pat].bass[1].transpose == 30, "[6] 303 B transpose");
+    CHECK(part_set(3, pat, 0, 48, &got) == 0 && proj.pat[pat].bass[1].len == 48, "[6] 303 B len");
+    CHECK(part_set(0, pat, 4, 60, &got) == 0 && got == 60 && proj.pat[pat].swing == 60, "[6] swing on part 0");
+    CHECK(part_set(1, pat, 4, 60, 0) == 6 && part_set(2, pat, 4, 60, 0) == 6, "[6] swing only on part 0");
+    CHECK(part_set(4, pat, 1, RATE_8, &got) == 0 && got == RATE_8 && proj.pat[pat].brk.rate == RATE_8, "[6] BREAK rate");
+    CHECK(part_set(0, pat, 2, 1, 0) == 6, "[6] dir on a drum part -> UNSUPPORTED");
+}
+/* ---- 7 PATTERN_DUMP ---- */
+static void t7_dump(void)
+{
+    static uint8_t buf[sizeof(pattern_t) + 128];
+    uint32_t off = 0, total = 0;
+    int pat = 3, ok = 1, frames = 0;
+    rep_t r;
+    while (1) {
+        p7(pat); pu(off, 2); p7(112);
+        r = req(0x23);
+        if (r.status) { ok = 0; break; }
+        total = gu(r.fl + 3, 2);
+        uint32_t c = r.fl[5];
+        if (r.fl[0] != pat || gu(r.fl + 1, 2) != off) ok = 0;
+        unpack7(r.fl + 6, c, buf + off);
+        if (gu(r.fl + 6 + c + (c + 6) / 7, 2) != pcrc(pat)) ok = 0;
+        off += c; frames++;
+        if (!c || off >= total) break;
+    }
+    CHECK(ok && total == sizeof(pattern_t) && off == total && !memcmp(buf, &proj.pat[pat], sizeof(pattern_t)),
+          "[7] concatenated chunks == proj.pat[%d] (%u B, %d frames), CRC matches", pat, total, frames);
+    p7(pat); pu(sizeof(pattern_t) + 1, 2); p7(10);
+    CHECK(req(0x23).status == 2, "[7] offset past total -> BAD");
+    p7(32); pu(0, 2); p7(10);
+    CHECK(req(0x23).status == 2, "[7] pattern 32 -> BAD");
+    p7(pat); pu(sizeof(pattern_t), 2); p7(10);
+    r = req(0x23);
+    CHECK(r.status == 0 && r.fl[5] == 0, "[7] offset == total: empty chunk");
+}
+/* ---- 8 CUE and Program Change ---- */
+static void pc(int ch, int pp) { host_midi_put(0xCu | (uint32_t)(0xC0 | ch) << 8 | (uint32_t)pp << 16); }
+static void t8_cue(void)
+{
+    rep_t r, last;
+    int k, launched_at = -1;
+    keep();
+    ep(); pu(1u << 2, 4); (void)req(0x08);
+    clksrc(SEQ_CLK_INT);
+    for (k = 0; k < NTRACKS; k++) seq.pcue[k] = 0, proj.pat[0].drum[0].len = 16;
+    tick(10);
+    seq_start(&seq); tick(300);
+    CHECK(seq.playing, "[8] playing");
+    ep(); p7(0); p7(5);
+    r = req(0x24);
+    CHECK(r.status == 0 && r.fl[2] == 0 && r.fl[7] == 5 && seq.pcue[0] == 5, "[8] CUE while playing: pcue in the reply");
+    nof = 0;
+    tick(5);
+    CHECK(seq.ppat[0] == 0, "[8] not launched before the bar");
+    for (k = 0; k < 4000 && launched_at < 0; k++) {
+        int pos = seq.t[0].pos;
+        tick(1);
+        if (seq.ppat[0] == 5) launched_at = pos;
+        if (!(k % 1000)) keep();
+    }
+    tick(40);
+    CHECK(launched_at >= 0 && seq.t[0].pos < 2, "[8] launched at the bar (step %d)", seq.t[0].pos);
+    CHECK(notifies(7, &last) >= 1 && last.fl[0] == 5, "[8] NOTIFY PATTERN on the launch");
+    ep(); p7(1); p7(7); (void)req(0x24);
+    ep(); p7(1); p7(127);
+    r = req(0x24);
+    CHECK(r.status == 0 && seq.pcue[1] == 0xFF && r.fl[8] == 127, "[8] 127 cancels the cue");
+    keep(); tick(1500); keep();
+    CHECK(seq.ppat[1] != 7, "[8] a cancelled cue never launches");
+    seq_stop(&seq); tick(30);
+    ep(); p7(127); p7(9);
+    r = req(0x24);
+    tick(5);
+    CHECK(r.status == 0 && seq.ppat[0] == 9 && seq.ppat[4] == 9, "[8] CUE all while stopped sets ppat");
+    /* Program Change on a part's channel */
+    pc(seq.ch[2], 12); tick(5);
+    CHECK(seq.ppat[2] == 12 && seq.ppat[3] == 9, "[8] PC on 303 A's channel cues 303 A (stopped: now)");
+    seq_start(&seq); tick(50);
+    pc(seq.ch[3], 13); tick(10);
+    CHECK(seq.pcue[3] == 13 && seq.ppat[3] == 9, "[8] PC while playing: cued for the bar");
+    pc(seq.ch[3], 127); tick(10);
+    CHECK(seq.pcue[3] == 0xFF, "[8] PC 127 cancels");
+    pc(seq.ch[3], 40); tick(10);
+    CHECK(seq.pcue[3] == 0xFF, "[8] PC 32..126 ignored");
+    seq_stop(&seq); tick(30);
+    {
+        int ch = 15, used = 0;
+        for (k = 0; k < NTRACKS; k++) used |= seq.ch[k] == ch;
+        CHECK(!used, "[8] channel 16 is no part's");
+        uint8_t before[NTRACKS];
+        for (k = 0; k < NTRACKS; k++) before[k] = seq.ppat[k];
+        pc(ch, 20); tick(5);
+        for (k = 0; k < NTRACKS; k++) CHECK(seq.ppat[k] == before[k] && seq.pcue[k] == 0xFF, "[8] PC on a non-part channel ignored (part %d)", k);
+    }
+#if BOARD_SMK37
+    test_clip_mode = 1;
+    pc(seq.ch[2], 21); tick(5);
+    CHECK(seq.ppat[2] == 12, "[8] PC ignored in clip mode");
+    test_clip_mode = 0;
+#endif
+}
+/* ---- 9 TRANSPORT ---- */
+static int transport(int a) { rep_t r; ep(); p7(a); r = req(0x26); return r.status ? -r.status : r.fl[0]; }
+static void t9_transport(void)
+{
+    keep();
+    clksrc(SEQ_CLK_INT);
+    CHECK(seq.clk_src == SEQ_CLK_INT, "[9] clock source INTERNAL");
+    host_midi_put(0xFu | 0xFAu << 8); tick(20);
+    CHECK(!seq.playing, "[9] INTERNAL drops FA (why TRANSPORT exists)");
+    CHECK(transport(1) == 1, "[9] play: playing 1 in the reply");
+    tick(20);
+    CHECK(seq.playing, "[9] internal clock: play edge");
+    tick(500);
+    CHECK(transport(0) == 0, "[9] stop reply");
+    tick(20);
+    CHECK(!seq.playing, "[9] stop edge");
+    CHECK(transport(2) == 1, "[9] continue");
+    tick(20);
+    CHECK(seq.playing, "[9] continue edge");
+    CHECK(transport(3) == -2, "[9] action 3 -> BAD");
+    transport(0); tick(20);
+    /* external clock running: DENIED; FA/FC still run it */
+    clksrc(SEQ_CLK_EXT);
+    host_midi_put(0xFu | 0xFAu << 8);
+    for (int k = 0; k < 48; k++) { host_midi_put(0xFu | 0xF8u << 8); tick(20); }
+    CHECK(seq.ext && seq.playing, "[9] FA + clock under EXTERNAL: playing");
+    keep();
+    CHECK(transport(0) == -8 && seq.playing, "[9] external clock -> DENIED, still playing");
+    host_midi_put(0xFu | 0xFCu << 8); tick(20);
+    CHECK(!seq.playing, "[9] FC under EXTERNAL stops");
+    tick(1000);
+    clksrc(SEQ_CLK_AUTO);
+}
+/* ---- 10 MUTE ---- */
+static int mute(int bit, int onoff, int queued) { rep_t r; ep(); p7(bit); p7(onoff); p7(queued); r = req(0x28); return r.status; }
+static void t10_mute(void)
+{
+    keep();
+    seq.mute = seq.vmute = seq.mute_q = seq.vmute_q = 0;
+    CHECK(mute(MUTE_BASS0, 1, 0) == 0 && (seq.mute >> MUTE_BASS0 & 1u), "[10] immediate part mute");
+    CHECK(mute(NDRUM + 3, 1, 0) == 0 && (seq.mute >> (NDRUM + 3) & 1u), "[10] immediate 808 voice mute");
+    CHECK(mute(MUTE_BRK + 1, 1, 0) == 2 && mute(32, 1, 0) == 2, "[10] bad bits -> BAD");
+    seq_start(&seq); tick(100);
+    CHECK(mute(MUTE_BRK, 1, 1) == 0 && !(seq.mute >> MUTE_BRK & 1u), "[10] queued: not yet");
+    for (int k = 0; k < 4000 && !(seq.mute >> MUTE_BRK & 1u); k++) { tick(1); if (!(k % 1000)) keep(); }
+    CHECK((seq.mute >> MUTE_BRK & 1u) && seq.t[0].pos < 2, "[10] queued mute lands on the next 909 bar (step %d)", seq.t[0].pos);
+    seq_stop(&seq); tick(30);
+    CHECK(mute(MUTE_BASS0, 0, 0) == 0 && !(seq.mute >> MUTE_BASS0 & 1u), "[10] unmute");
+}
+/* ---- 11 revision: one bump and one NOTIFY per mutation, from every source; reads bump nothing ---- */
+static void t11_rev(void)
+{
+    uint32_t r0, r1;
+    rep_t last;
+    keep();
+    ep(); pu(0x5F, 4); (void)req(0x08);
+    tick(60); keep(); nof = 0;
+    r0 = rev_now();
+    (void)rev_now(); (void)req(0x30);
+    p7(1); p7(R_SWING); p7(0); p7(0); p7(0); (void)req(0x11);
+    (void)sget(0, 0, 0, 0, (uint8_t[8]){0});
+    tick(60);
+    CHECK(rev_now() == r0, "[11] reads (STATE, PARAM_GET, STEP_GET) and time bump nothing");
+#define BUMP(what, kind, act) do { int nn_; keep(); r0 = rev_now(); nof = 0; act; tick(60); nn_ = notifies(kind, &last); r1 = rev_now(); \
+        CHECK(r1 == ((r0 + 1u) & 0x0FFFFFFFu), "[11] %s: rev %u -> %u (want +1)", what, r0, r1); \
+        CHECK(nn_ == 1 && last.rev == r1, "[11] %s: one NOTIFY kind %d at that rev (%d)", what, kind, nn_); } while (0)
+    BUMP("DNR3 PARAM_SET", 0, (void)pset(R_SWING, 0, 0, 0, 0x3FFF, 21, 0));
+    BUMP("panel pref (pref_set)", 0, pref_set(PR(R_SWING, 0, 0, 0), 22));
+    BUMP("DNR3 STEP_SET", 1, (void)sset(0, 2, 7, 0x3FFF, (uint8_t[3]){1, 1, 127}, 3, 0));
+    BUMP("panel step edit (mark_dirty)", 1, mark_dirty());
+    BUMP("MIDI live recording (rec_dirty)", 1, seq.rec_dirty = 1);
+    BUMP("Program Change (stopped: launch)", 7, (pc(seq.ch[0], 6), tick(5)));
+    BUMP("DNR3 TEMPO", 3, ({ ep(); pu(1263, 2); (void)req(0x27); }));
+    BUMP("panel tempo", 3, pref_set(PR(R_TEMPO, 0, 0, 0), 100));
+    BUMP("HOME mute (seq.mute)", 4, seq.mute ^= 1u);
+    BUMP("transport edge (PLAY)", 3, (seq_start(&seq), tick(5)));
+    {
+        /* the cue launch at the bar: CUE (one bump), then the launch (one more) */
+        BUMP("DNR3 CUE", 2, ({ ep(); p7(0); p7(8); (void)req(0x24); }));
+        keep(); r0 = rev_now(); nof = 0;
+        for (int k = 0; k < 4000 && seq.ppat[0] != 8; k++) tick(1);
+        tick(60);
+        {
+            int nn = notifies(7, &last);
+            r1 = rev_now();
+            CHECK(seq.ppat[0] == 8 && r1 == ((r0 + 1u) & 0x0FFFFFFFu), "[11] cue launch: rev %u -> %u", r0, r1);
+            CHECK(nn == 1 && last.rev == r1, "[11] cue launch: one NOTIFY PATTERN (%d)", nn);
+        }
+    }
+    BUMP("transport edge (stop)", 3, (seq_stop(&seq), tick(5)));
+    BUMP("undo", 1, do_undo(0));
+    /* a failed write changes nothing */
+    keep(); r0 = rev_now();
+    CHECK(pset(R_SWING, 0, 0, 0, 99, 5, 0) == 5 && rev_now() == r0, "[11] a CONFLICT write bumps nothing");
+}
+/* ---- 12 busy ---- */
+static void t12_busy(void)
+{
+    uint32_t r0;
+    int sw = pref_get(PR(R_SWING, 0, 0, 0)), tempo = (int)rd_bpm10();
+    rep_t r;
+    keep();
+    r0 = rev_now();
+    host_remote_busy = 1;
+    CHECK(pset(R_SWING, 0, 0, 0, 0x3FFF, sw + 1, 0) == 3, "[12] PARAM_SET while busy -> BUSY");
+    ep(); pu(1500, 2);
+    CHECK(req(0x27).status == 3, "[12] TEMPO while busy -> BUSY");
+    CHECK(sset(0, 0, 1, 0x3FFF, (uint8_t[3]){0, 1, 127}, 3, 0) == 3, "[12] STEP_SET while busy -> BUSY");
+    ep(); p7(0); p7(3);
+    CHECK(req(0x24).status == 3, "[12] CUE while busy -> BUSY");
+    r = req(0x30);
+    CHECK(r.status == 0, "[12] reads still answer");
+    host_remote_busy = 0;
+    project_busy = 1;                                    /* a project transfer (ui_project_begin) */
+    CHECK(pset(R_SWING, 0, 0, 0, 0x3FFF, sw + 1, 0) == 3, "[12] PARAM_SET during a project transfer -> BUSY");
+    project_busy = 0;
+    CHECK(pref_get(PR(R_SWING, 0, 0, 0)) == sw && (int)rd_bpm10() == tempo && !sm_get(proj.pat[0].drum[0].hit[0], 1) &&
+          rev_now() == r0, "[12] nothing changed, no rev bump");
+}
+/* ---- 13 rate ---- */
+static void t13_rate(void)
+{
+    int n, last_v = -1, i, ons0, ons1;
+    rep_t r;
+    keep();
+    ep(); pu(0x5F, 4); (void)req(0x08);
+    seq.send_notes = 1;
+    seq_start(&seq); tick(100);
+    ons0 = (int)note_ons; tick(1000); ons0 = (int)note_ons - ons0;   /* 1 s of notes, no Remote traffic */
+    nof = 0; ons1 = (int)note_ons;
+    for (i = 0; i < 1000; i++) {                       /* 1000 changes in 1 s */
+        pref_set(PR(R_ENG, T_909, 0, 1), i & 127);
+        tick(1);
+    }
+    ons1 = (int)note_ons - ons1;
+    n = nof;
+    for (i = 0; i < nof && i < NF; i++)
+        if (!parse(i, &r) && r.op == 0x7F && r.fl[-1] == 0) last_v = (int)gu(r.fl + 4, 2);
+    tick(100);
+    for (i = 0; i < nof && i < NF; i++)
+        if (!parse(i, &r) && r.op == 0x7F && r.fl[-1] == 0) last_v = (int)gu(r.fl + 4, 2);
+    CHECK(n <= 52, "[13] 1000 changes in 1 s -> %d frames (<= watch_max_hz 50)", n);
+    CHECK(last_v == pref_get(PR(R_ENG, T_909, 0, 1)), "[13] the last NOTIFY carries the latest value (%d vs %d)", last_v, pref_get(PR(R_ENG, T_909, 0, 1)));
+    CHECK(abs(ons1 - ons0) <= 1, "[13] MIDI note output unchanged under the NOTIFY load (%d vs %d notes)", ons1, ons0);
+    seq_stop(&seq); tick(30);
+    seq.send_notes = 0;
+}
+/* ---- 14 idempotent retry ---- */
+static void t14_retry(void)
+{
+    uint8_t first[256], f2[300];
+    uint32_t n1, r0, n2;
+    keep();
+    ep(); pu(1300, 2);
+    n2 = frame_mk(f2, 3, 0x27, 4242, P, pn); pn = 0;
+    CHECK(tx(f2, n2) == 0 && nof == 1, "[14] TEMPO");
+    memcpy(first, of[0], on[0]); n1 = on[0];
+    pref_set(PR(R_TEMPO, 0, 0, 0), 140 - 20);          /* the panel moves it on */
+    tick(30);
+    r0 = rev_now();
+    CHECK(tx(f2, n2) == 0 && nof == 1 && on[0] == n1 && !memcmp(of[0], first, n1), "[14] the same seq again: the same reply bytes");
+    CHECK(rd_bpm10() == 1400u && rev_now() == r0, "[14] one mutation: the retry applied nothing (bpm %u)", rd_bpm10());
+    ep(); pu(1300, 2);
+    n2 = frame_mk(f2, 3, 0x27, 4243, P, pn); pn = 0;
+    CHECK(tx(f2, n2) == 0 && nof == 1 && rd_bpm10() == 1300u, "[14] a new seq applies again");
+}
+/* ---- 15 budgets (the build's limits gate measures .text / RAM; here: the handler's own RAM) ---- */
+static void t15_budget(void)
+{
+    printf("  remote-dnr3: state %u B RAM (+%u B host frame buffer; the device builds in the editor's ed_out)\n",
+           (unsigned)sizeof rd, (unsigned)sizeof rd_outbuf);
+    CHECK(sizeof rd <= 160u, "[15] handler state <= 160 B RAM (%u)", (unsigned)sizeof rd);
+}
+
+int main(void)
+{
+    host_remote_sink = sink;
+    boot();
+    tick(300);
+    t1_framing();
+    t2_dnr2_fl();
+    t3_lease();
+    t4_bass_bank_guard();
+    t4_param();
+    t5_step();
+    t6_part();
+    t7_dump();
+    t8_cue();
+    t9_transport();
+    t10_mute();
+    t11_rev();
+    t12_busy();
+    t13_rate();
+    t14_retry();
+    t15_budget();
+    printf("remote-dnr3: %d checks, %d failed\n", checks, fails);
+    return fails ? 1 : 0;
+}
diff --git a/tests/host/remote_dnr3_test.sh b/tests/host/remote_dnr3_test.sh
new file mode 100755
index 0000000000000000000000000000000000000000..64f727622a451570c6efffaf2ad67579fa992228
--- /dev/null
+++ b/tests/host/remote_dnr3_test.sh
@@ -0,0 +1,70 @@
+#!/bin/sh
+# SPDX-License-Identifier: GPL-3.0-only
+# DNR3 Remote protocol (REMOTE-FW-PROTOCOL v3.0 section 8, items 1-15) on the whole app (host build),
+# the device wiring (editor.c dispatch, usb.c reply hook, x0x.c frame buffer), and mutants that must fail.
+#   X0X_REMOTE_MUTANTS=0 skips the mutant builds (each is a whole-app compile).
+set -eu
+cd "$(dirname "$0")/../.."
+. tests/host/original_build.sh
+OUT=${X0X_REMOTE_TEST_OUT:-build/host/remote-dnr3}
+mkdir -p "$OUT"; OUT=$(cd "$OUT" && pwd)
+[ -f build/gen/x0x_drum_tables.h ] || sh host/build_host.sh --generate-only >"$OUT/assets.log" 2>&1
+# [2] [15] device wiring: DNR3 frames go to remote_dnr3_frame before the FL header check and only a
+# handled frame (0) is consumed; replies never wait (usb.c); the device frame buffer is the editor's.
+python3 - <<'PY'
+import re, sys
+ed = open('firmware/src/app/editor.c').read()
+svc = ed[ed.index('static int ed_service(void)'):]
+svc = svc[:svc.index('\n}\n')]
+i = svc.find('if (!remote_dnr3_frame(p, n)) {')
+j = svc.find('p[0] != ED_HDR0')
+bad = []
+if i < 0 or j < 0 or i > j: bad.append('editor.c: ed_service must offer a frame to remote_dnr3_frame before the FL check and consume it only on 0')
+if 'remote_dnr3_tick(plat_ms())' not in svc: bad.append('editor.c: ed_service must call remote_dnr3_tick')
+usb = open('firmware/src/usb.c').read()
+m = re.search(r'void remote_dnr3_out\(const uint8_t \*frame, uint32_t n\)\n\{(.*?)\n\}', usb, re.S)
+if not m or 'sx_busy' not in m.group(1): bad.append('usb.c: remote_dnr3_out must drop (not wait) when the SysEx ring is busy')
+x = open('firmware/src/x0x.c').read()
+if '#define REMOTE_DNR3_OUTBUF ed_out' not in x: bad.append('x0x.c: the device builds DNR3 frames in ed_out')
+src = open('firmware/src/app/remote_dnr3.c').read()
+for w in ('X0X_POOL', 'psram', 'PSRAM', 'malloc'):
+    if w in src: bad.append('remote_dnr3.c uses ' + w)
+for b in bad: print('  FAIL', b)
+sys.exit(1 if bad else 0)
+PY
+build() {   # build <exe> [extra cc args]
+    exe=$1; shift
+    ${CC:-cc} ${SAN_FLAGS:-} -O1 -g -std=gnu99 -w -DX0X_HOST -DBOARD_SMK37=1 \
+        -Ifirmware/src -Ifirmware/src/dsp -Ibuild/gen $ORIGINAL_FLAGS "$@" \
+        tests/host/remote_dnr3_test.c $ORIGINAL_SOURCES -lm -o "$exe"
+}
+build "$OUT/test"
+"$OUT/test"
+[ "${X0X_REMOTE_MUTANTS:-1}" = 0 ] && exit 0
+# Mutants: each breaks one rule of the spec; the test must fail on every one.
+python3 - "$OUT" <<'PY'
+import sys
+out = sys.argv[1]
+src = open('firmware/src/app/remote_dnr3.c').read()
+muts = {
+  'nocrc':  ('if (len != n - 14u || crc != rd_g(p + n - 5u, 5))', 'if (len != n - 14u)'),
+  'norev':  ('rd.dirty = 0, rd.rev = (rd.rev + 1u) & 0x0FFFFFFFu;', 'rd.dirty = 0;'),
+  'nocache':('if (f & 0x80u && rd.clen &&', 'if (0 && rd.clen &&'),
+  'nolease':('st = !rd.active ? RS_DENIED :', 'st = 0 ? RS_DENIED :'),
+  'nobank': ('else if (engine_bass_bank(q[2]) != q[8])', 'else if (0)'),
+  'nopending': ('if (engine_bass_preset_pending(q[2]))', 'if (0)'),
+}
+for k, (a, b) in muts.items():
+    assert src.count(a) == 1, k
+    open(f'{out}/mut_{k}.c', 'w').write(src.replace(a, b).replace('#include "remote_dnr3.h"', '#include "app/remote_dnr3.h"').replace('#include "../crc32_nibble.h"', '#include "crc32_nibble.h"').replace('#include "version.h"', '#include "app/version.h"'))
+PY
+rc=0
+for m in nocrc norev nocache nolease nobank nopending; do
+    build "$OUT/mut_$m" "-DREMOTE_DNR3_SOURCE=\"$OUT/mut_$m.c\""
+    if "$OUT/mut_$m" >"$OUT/mut_$m.log" 2>&1; then
+        echo "  FAIL mutant $m survived (the test did not notice)"; rc=1
+    else
+        echo "  mutant $m killed"
+    fi
+done
+exit $rc
