@@ -0,0 +1,62 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+/* MASTER displays its live audio history and gain reduction in a single
+ * R22 panel. Updating one peak may write one column, not move the history. */
+#define SMC_UI_MAIN inherited_smc_ui_main
+#include "smc_ui_test.c"
+
+static void draw(int band)
+{
+    cv_begin(240, MAIN_ROWS, C_BLACK);
+    cv_band(band * BAND_H, BAND_H);
+    draw_mix(band);
+}
+
+static int pixel(int x, int y, uint16_t color)
+{
+    return cv_px[(y - HDR_H) * 240 + x] == swap16(color);
+}
+
+int main(void)
+{
+    setup(V_MIX, PART_909);
+    ui.page[V_MIX][0] = MIX_FIRST_KIT_PAGE + NKIT;
+    build_pages();
+    for (int p = 0; p < NPARTS; ++p) eng_peak[p] = 0;
+    /* At most setup touched two canvas bands; advance past the whole ring. */
+    for (int i = 0; i < 98; ++i) { now_ms += 21; draw(0); }
+    draw(1);
+    for (int x = 4; x < 200; ++x) CHECK(pixel(x, 106, part_col()));
+    draw(0);
+    CHECK(pixel(80, 46, SOUND_FACE)); /* same panel behind waveform and reduction */
+    eng_peak[PART_808] = 24576;
+    now_ms += 21;
+    draw(0);
+    int peak = -1;
+    for (int x = 4; x < 200; x += 2) {
+        if (pixel(x, 65, part_col())) { CHECK(peak < 0); peak = x; }
+    }
+    CHECK(peak >= 0);
+    eng_peak[PART_808] = 0;
+    now_ms += 21;
+    draw(0);
+    CHECK(pixel(peak, 65, part_col()));
+    for (int x = 4; x < 200; x += 2)
+        if (x != peak) CHECK(!pixel(x, 65, part_col()));
+    draw(1);
+    CHECK(pixel(120, 140, SOUND_FACE));
+    /* Both layouts reuse the same bounded meter at their own baseline. */
+    for (int y = 5; y <= 25; y += 20) {
+        cv_begin(240, MAIN_ROWS, C_BLACK);
+        cv_band(0, BAND_H);
+        mix_gr_meter(y, y - 1, 30);
+        CHECK(pixel(211, HDR_H + y + 9, RGB(255,80,60)));
+        CHECK(pixel(211, HDR_H + y + 33, C_LINE));
+        if (y == 5) {
+            mix_gr_meter(y, y - 1, 123);
+            CHECK(pixel(211, HDR_H + y + 55, RGB(255,80,60)));
+            CHECK(pixel(211, HDR_H + y + 61, C_BLACK));
+        }
+    }
+    puts("PASS R22 MASTER panel: fixed columns, two bands and bounded live gain reduction");
+    return 0;
+}
