index 0000000000000000000000000000000000000000..7a4ce105e59c58215ed38dbc5dc8a48576043c89
--- /dev/null
+++ b/tests/host/remote_dnr3_ble_test.c
@@ -0,0 +1,186 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+/* The generator includes the real firmware app and real peripheral glue.
+ * Mock only the chip IRQ boundary and the outbound HCI radio mailbox. */
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#define X0X_REMOTE_BLE 1
+static int ble_dnr3_live(uint32_t wire);
+static void ble_dnr3_out(uint32_t wire, const uint8_t *p, uint32_t n);
+#include "remote_dnr3_app.inc"
+
+static void ble_dnr3_reset(void);
+#define BLEH_LINK_RESET() ble_dnr3_reset()
+#include "ble/ble_midi_host.c"
+#undef BLEH_LINK_RESET
+
+static struct { struct { bleh_t h; } host; uint32_t sysex_drops; } ble_r;
+static uint8_t ble_up = 1, ble_host_on = 1, ble_want = 1, ble_central_role;
+static uint32_t fm1_ms;
+static unsigned apc_handshakes;
+static unsigned irq_depth;
+static uint32_t irq_save(void) { return irq_depth++; }
+static void irq_restore(uint32_t v) { assert(irq_depth == v + 1u); irq_depth = v; }
+int smc_ble_role_get(void) { return 0; }
+static void smk_apc_ble_host_seen(void) { apc_handshakes++; }
+static void smk_apc_host_generic(uint8_t flag) { assert(flag); }
+void smc_mmc_host(uint8_t cmd, uint8_t src) { (void)cmd; assert(src == 1); }
+#define RING_PUBLISH() __asm__ volatile("" ::: "memory")
+#include "remote_dnr3_radio.inc"
+
+static uint8_t captured[256];
+static unsigned nc, notifications;
+static int radio_send(uint8_t type, const uint8_t *p, uint16_t n, void *unused)
+{
+    (void)unused;
+    if (type != BLEH_H4_ACL || n < 12 || p[8] != 0x1B) return 0;
+    assert(p[9] == 6 && p[10] == 0 && (p[11] & 0xC0) == 0x80);
+    /* Decode the documented real BLE-MIDI notification wire before DNR3. */
+    unsigned i = 12;
+    if (nc == 0) {
+        assert(i + 1 < n && (p[i] & 0x80) && p[i + 1] == 0xF0);
+        i++;
+        captured[nc++] = p[i++];
+    }
+    while (i < n) {
+        if (p[i] & 0x80) {
+            assert(i + 1 == n - 1 && p[i + 1] == 0xF7);
+            i++;
+        }
+        assert(nc < sizeof captured);
+        captured[nc++] = p[i++];
+    }
+    notifications++;
+    return 0;
+}
+
+static void att_write(const uint8_t *att, uint16_t n)
+{
+    uint8_t pkt[31] = {1, 0x30, (uint8_t)(n + 4), 0, (uint8_t)n, 0, 4, 0};
+    assert(n <= 23);
+    memcpy(pkt + 8, att, n);
+    bleh_rx(&ble_r.host.h, BLEH_H4_ACL, pkt, n + 8);
+}
+static void radio_connect(void)
+{
+    const uint8_t up[] = {0x3E, 5, 1, 0, 1, 0, 1};
+    const uint8_t cccd[] = {0x12, 7, 0, 1, 0};
+    bleh_rx(&ble_r.host.h, BLEH_H4_EVT, up, sizeof up);
+    att_write(cccd, sizeof cccd);
+    assert(bleh_notifying(&ble_r.host.h));
+}
+static void radio_disconnect(void)
+{
+    const uint8_t down[] = {0x05, 4, 0, 1, 0, 0x13};
+    bleh_rx(&ble_r.host.h, BLEH_H4_EVT, down, sizeof down);
+    assert(!bleh_connected(&ble_r.host.h));
+}
+static void midi_frame(const uint8_t *f, unsigned n)
+{
+    uint8_t att[23] = {0x52, 6, 0, 0x80, 0x81, 0xF0};
+    unsigned at = 1, off = 6;
+    assert(n >= 2 && f[0] == 0xF0 && f[n - 1] == 0xF7);
+    for (;;) {
+        /* Deliberately fragment at small sizes, including within the CRC. */
+        unsigned amount = 5;
+        while (amount-- && at < n - 1) att[off++] = f[at++];
+        if (at == n - 1) { att[off++] = 0x81; att[off++] = 0xF7; }
+        att_write(att, (uint16_t)off);
+        if (at == n - 1) break;
+        off = 4;
+    }
+}
+static void radio_drain(void)
+{
+    const uint8_t credit[] = {0x13, 5, 1, 1, 0, 1, 0};
+    nc = notifications = 0;
+    for (unsigned i = 0; i < 32 && ble_r.host.h.sx_on; i++) {
+        bleh_poll(&ble_r.host.h);
+        bleh_rx(&ble_r.host.h, BLEH_H4_EVT, credit, sizeof credit);
+    }
+    assert(!ble_r.host.h.sx_on);
+}
+static rep_t ble_request(int op, unsigned seqnum)
+{
+    uint8_t f[256];
+    unsigned n = frame_mk(f, 3, op, (int)seqnum, P, pn);
+    pn = 0;
+    nof = 0;
+    midi_frame(f, n);
+    assert(!ble_r.host.h.sx_on && !nof);         /* parsing is never in the radio ISR */
+    ble_dnr3_service();
+    radio_drain();
+    if (!nc) {
+        fprintf(stderr, "FAIL BLE DNR3: no native response to op %02x\n", op);
+        exit(1);
+    }
+    assert(!nof);                              /* incoming BLE is never answered over USB */
+    memcpy(of[0], captured, nc);
+    on[0] = nc;
+    rep_t r;
+    assert(!parse(0, &r) && r.op == (op | 0x40) && r.seq == (int)seqnum);
+    return r;
+}
+
+int main(void)
+{
+    host_remote_sink = sink;                   /* exact app's USB transport oracle */
+    boot();
+    bleh_init(&ble_r.host.h, radio_send, 0, "DnBOX test", 0);
+    ble_r.host.h.sx = ble_dnr3_tx;
+    bleh_set_sysex(&ble_r.host.h, ble_sysex_in);
+    radio_connect();
+
+    const uint8_t inquiry[] = {0xF0, 0x7E, 0x7F, 0x06, 0x01, 0xF7};
+    midi_frame(inquiry, sizeof inquiry);        /* existing BLE peripheral APC path stays live */
+    ble_sx_answer(&ble_r.host.h);
+    radio_drain();
+    assert(apc_handshakes == 1 && nc == 35 && captured[1] == 0x7E);
+
+    p7(3);
+    rep_t r = ble_request(0x00, 110);
+    assert(!r.status && r.fl[0] == 3 && notifications > 1);
+    pu(0x1234, 4);
+    r = ble_request(0x01, 111);
+    assert(!r.status);
+    uint32_t radio_epoch = gu(r.fl, 4);
+    pu(0x1234, 4);
+    r = req(0x01);
+    assert(r.status == 3);                      /* same USB client ID cannot steal BLE lease */
+    pu(radio_epoch, 4); pu(1300, 2);
+    r = req(0x27);
+    assert(r.status == 8 && !ble_r.host.h.sx_on);
+
+    pu(radio_epoch, 4); pu(1260, 2);
+    r = ble_request(0x27, 112);
+    assert(!r.status && rd_bpm10() == 1260);
+    p7(0); pu(0, 2); p7(112);
+    r = ble_request(0x23, 113);
+    assert(!r.status && r.fl[5] == 112 && nc > 66 && notifications > 4);
+
+    pu(radio_epoch, 4); pu(8, 4);
+    assert(!ble_request(0x08, 114).status);
+    pref_set(PR(R_TEMPO, 0, 0, 0), 110);
+    nof = 0;
+    remote_dnr3_tick(100);
+    radio_drain();
+    assert(!nof && nc && captured[5] == 0x7F);  /* WATCH goes only to its owning radio link */
+
+    uint8_t stale[256];
+    pu(radio_epoch, 4); pu(1800, 2);
+    unsigned n = frame_mk(stale, 3, 0x27, 115, P, pn);
+    pn = 0;
+    midi_frame(stale, n);                       /* queued before disconnect and handle reuse */
+    assert(ble_dnr3_n && rd_bpm10() != 1800);
+    radio_disconnect();
+    radio_connect();                            /* same connection handle, new epoch */
+    ble_dnr3_service();
+    assert(!ble_r.host.h.sx_on && rd_bpm10() != 1800);
+    pu(radio_epoch, 4); pu(1800, 2);
+    assert(ble_request(0x27, 116).status == 8);  /* new link cannot use old lease */
+    pu(0x5678, 4);
+    assert(!req(0x01).status);                  /* USB is still independently functional */
+
+    puts("PASS BLE DNR3: actual split ATT ingress, HELLO, lease, write, long dump, WATCH, link reset, isolated USB");
+    return 0;
+}
