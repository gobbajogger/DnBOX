@@ -0,0 +1,63 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+/* The hi-hat pictograms keep the R22 fix: paired cymbals, pull-rod + clutch above, the
+ * lower support (stem) below, and for OPEN the rod between the separated cymbals.
+ * Source: web/product-site/HIHAT-SOURCE-PATCH.json (sharedSHA256 2d234b1e..., nightly
+ * APPROVED-PRESENTATION.json R22HiHat), in firmware since 76040daa5 (#970).
+ * 1) the packed paths decode to those exact source coordinates (909 and 808 share them);
+ * 2) each pictogram's pixels at the MIX-strip (.26) and voice-header (.32) scales are pinned. */
+#define SMC_UI_MAIN retained_smc_main
+#include "smc_ui_test.c"
+
+typedef struct { int n; int xy[40]; } hh_poly;
+/* R22 source (x1000): CLOSED = row 7 "after", OPEN = row 8 "after"; curves as sampled. */
+static const int CH_RODS[4][4] = {{11500,200,11500,2400},{10500,2500,12500,2500},{10300,8100,12700,8100},{11500,8200,11500,11600}};
+static const int OH_RODS[5][4] = {{11500,100,11500,900},{10500,1100,12500,1100},{11500,5100,11500,6700},{10300,10000,12700,10000},{11500,10100,11500,11700}};
+static int decode(int t,int v,hh_poly *out,int max)
+{
+    const dv_body_t *b=&DV_BODY[t==T_808][v]; int np=b->npoly<max?b->npoly:max;
+    for(int p=0;p<np;p++){unsigned path=dv_path(b->first+p),off=path&2047u,n=path>>11;out[p].n=(int)n;
+        for(unsigned i=0;i<n && i<20;i++){out[p].xy[2*i]=(int)dv_coordinate_next(&off);out[p].xy[2*i+1]=(int)dv_coordinate_next(&off);}}
+    return np;
+}
+static void check_paths(int t,int ch,int oh)
+{
+    hh_poly P[8]; int n=decode(t,ch,P,8);
+    CHECK(n==6); CHECK(P[0].n==18 && P[0].xy[0]==3500 && P[0].xy[1]==5400 && P[0].xy[8]==11500 && P[0].xy[9]==3350 && P[0].xy[16]==19500);
+    CHECK(P[1].n==9 && P[1].xy[0]==3800 && P[1].xy[1]==6500 && P[1].xy[16]==19200 && P[1].xy[17]==6500);
+    for(int r=0;r<4;r++){CHECK(P[2+r].n==2);for(int k=0;k<4;k++)CHECK(P[2+r].xy[k]==CH_RODS[r][k]);}
+    n=decode(t,oh,P,8);
+    CHECK(n==7); CHECK(P[0].n==18 && P[0].xy[1]==3600 && P[0].xy[9]==1600); CHECK(P[1].n==18 && P[1].xy[1]==8300 && P[1].xy[9]==6950);
+    for(int r=0;r<5;r++){CHECK(P[2+r].n==2);for(int k=0;k<4;k++)CHECK(P[2+r].xy[k]==OH_RODS[r][k]);}
+}
+static const struct { const char *name; uint32_t hash; } expected[] = {
+#include "ui_hihat_glyph_refs.inc"
+};
+static unsigned witnessed, failures;
+static void pin(const char *name,int t,int v,float scale)
+{
+    cv_begin(240,40,C_BLACK); dv_body_pictogram(t,v,40,6,scale,0,C_HI);
+    uint32_t h=2166136261u; int lit=0;
+    for(int i=0;i<240*40;i++){h=(h^cv_px[i])*16777619u;lit|=cv_px[i]!=swap16(C_BLACK);}
+    CHECK(lit);
+    if(getenv("HIHAT_DUMP")){printf("    {\"%s\", 0x%08lxu},\n",name,(unsigned long)h);return;}
+    for(unsigned i=0;i<sizeof expected/sizeof expected[0];i++) if(!strcmp(expected[i].name,name)){witnessed++;
+        if(expected[i].hash!=h){fprintf(stderr,"FAIL %s: %08lx != %08lx (pinned R22 hi-hat)\n",name,(unsigned long)h,(unsigned long)expected[i].hash);failures++;}return;}
+    fprintf(stderr,"FAIL %s has no pinned reference\n",name);failures++;
+}
+int main(void)
+{
+    setup(V_MIX,0);
+    check_paths(T_909,DR_CH,DR_OH); check_paths(T_808,D8_CH,D8_OH);
+    static const float sc[2]={.26f,.32f}; static const char *sn[2]={"strip","header"}; char n[48];
+    for(int s=0;s<2;s++){
+        snprintf(n,sizeof n,"909-ch-%s",sn[s]);pin(n,T_909,DR_CH,sc[s]);
+        snprintf(n,sizeof n,"909-oh-%s",sn[s]);pin(n,T_909,DR_OH,sc[s]);
+        snprintf(n,sizeof n,"808-ch-%s",sn[s]);pin(n,T_808,D8_CH,sc[s]);
+        snprintf(n,sizeof n,"808-oh-%s",sn[s]);pin(n,T_808,D8_OH,sc[s]);
+    }
+    if(getenv("HIHAT_DUMP")) return 0;
+    CHECK(witnessed==sizeof expected/sizeof expected[0]);
+    if(failures) return 1;
+    printf("PASS R22 hi-hat: exact source paths (909+808 CH/OH) and %u pinned pictograms\n",witnessed);
+    return 0;
+}
