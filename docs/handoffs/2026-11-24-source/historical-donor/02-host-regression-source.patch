new file mode 100644
index 0000000000000000000000000000000000000000..db77c8fb87c66fa740469df7b5956d6bdaa49230
--- /dev/null
+++ b/tests/host/font_unit_case_test.py
@@ -0,0 +1,21 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-3.0-only
+"""Units keep their case: every lower-case letter in a ui.c unit literal must have its own
+lower-case bitmap in XS/S/B (tools/gen_font.py LOWER_KEEP), else the face folds it to the
+upper-case bitmap and "16 steps" draws as "16 stEps"."""
+import re, sys
+from pathlib import Path
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT / 'tools'))
+import gen_font  # noqa: E402
+
+src = (ROOT / 'firmware' / 'src' / 'app' / 'ui.c').read_text()
+units = sorted(set(re.findall(r'put_s\(\s*unit\s*,\s*"([^"]*)"', src)))
+bad = {u: ''.join(c for c in u if c.islower() and c not in gen_font.LOWER_KEEP) for u in units}
+bad = {u: c for u, c in bad.items() if c}
+if not units:
+    print('FAIL: no unit literals found in ui.c'); sys.exit(1)
+if bad:
+    for u, c in bad.items(): print(f'FAIL unit "{u}": lower-case {c!r} folds to upper case in XS/S/B')
+    sys.exit(1)
+print(f'PASS {len(units)} unit literals keep their lower case ({", ".join(units)})')
