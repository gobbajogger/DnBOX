@@ -46,12 +47,31 @@ def generate(source, output):
             packed.extend(data[offset+9:end])
         if len(packed) > 65535:
             raise ValueError('offset overflow')
-        for suffix, values, ctype in [('data', packed, 'uint8_t'), ('offset', new_offsets, 'uint16_t')]:
+        # Interpolate over a power-of-two group to keep exact index lookup
+        # constant-time. Neither the coefficient nor its packed block changes.
+        bases, strides, residuals = [], [], []
+        for i in range(0, len(new_offsets), 32):
+            group = new_offsets[i:i+32]
+            last = len(group)-1
+            base = group[0]
+            stride = (group[-1]-base+last//2)//last if last else 0
+            residual = [value-base-j*stride for j, value in enumerate(group)]
+            if stride > 255 or any(not -128 <= r <= 127 for r in residual):
+                raise ValueError('offset index cannot be represented losslessly')
+            bases.append(base)
+            strides.append(stride)
+            residuals.extend(residual)
+        for suffix, values, ctype in [('data', packed, 'uint8_t'),
+                                       ('offset_base', bases, 'uint16_t'),
+                                       ('offset_stride', strides, 'uint8_t'),
+                                       ('offset_residual', residuals, 'int8_t')]:
             lines.append('static const %s %s_%s[%d]={' % (ctype, stem, suffix, len(values)))
             lines.extend(','.join(map(str, values[i:i+24])) + ',' for i in range(0, len(values), 24))
             lines.append('};')
         lines.append('#define %s_prefix 0x%08xu' % (stem, prefix))
