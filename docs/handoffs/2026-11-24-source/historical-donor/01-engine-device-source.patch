+/* p: the frame without F0/F7. 0: a DNR frame (answered or dropped), -1: not one (the editor's, OTA) */
+#if X0X_REMOTE_BLE
+__attribute__((noinline)) int remote_dnr3_frame_on(const uint8_t *p, uint32_t n, uint32_t wire)
+#else
+__attribute__((noinline)) int remote_dnr3_frame(const uint8_t *p, uint32_t n)
+#endif
+{
+    uint32_t i = 0, op, sq, len = 0, crc = 0, f = 0;
+    int st;
+    if (n < 4u || p[0] != 0x7Du || p[1] != 0x44u || p[2] != 0x4Eu)
+        return -1;
+    if (n < 7u || p[4] > 0x3Fu || p[5] > 0x7Fu || p[6] > 0x7Fu)
+        return 0;                                         /* no readable op/seq (or a reply/notify echo): dropped */
+#if X0X_REMOTE_BLE
+    rd_wire = wire;
+#endif
+    op = p[4];
+    sq = rd_g(p + 5, 2);
+    st = p[3] == 2u ? RS_UNSUPPORTED : RS_BAD;            /* DNR2: the old page fails clearly; other majors: header */
+    if (p[3] != 3u)
+        goto reply;
+    while (i < n && p[i] < 0x80u)
+        i++;
+    if (i < n || n < 14u || n > 254u)
+        goto reply;                                       /* range, length */
+    len = rd_g(p + 7, 2);
+    crc = x0x_crc32(p + 4, n - 9u);
+    if (len != n - 14u || crc != rd_g(p + n - 5u, 5))
+        goto reply;                                       /* length, crc */
+    f = RD_OPS[op <= RD_STATE ? op : 2u];                 /* (op 2: none) */
+    st = RS_UNSUPPORTED;
+    if (!f)
+        goto reply;
+    st = RS_BAD;
+    if (len + 1u < (f & 63u))
+        goto reply;
+    if (f & 0x80u && rd.clen && rd.cop == op && rd.cseq == sq && rd.ccrc == crc
+#if X0X_REMOTE_BLE
+        && rd_wire == rd_lease_wire
+#endif
+       ) {
+        rd_out(rd.cache, rd.clen);               /* an exact retry: the same reply, no second write */
+        return 0;
+    }
+    rd_lease(plat_ms());                                  /* panel edits first: rev and expect are current */
+    st = RS_BUSY;
+    if ((f & 0x80u || op == RD_OPEN) && REMOTE_DNR3_BUSY())
+        goto reply;
+    if (f & 0x40u) {
+#if X0X_REMOTE_BLE
+        if (rd_wire != rd_lease_wire) goto denied;
+#endif
+        st = !rd.active ? RS_DENIED : rd_g(p + 9, 4) != rd.epoch ? RS_STALE : RS_OK;
+        if (st)
+            goto reply;
+        rd.deadline = plat_ms() + RD_LEASE_MS;            /* any write or KEEPALIVE renews */
+    }
+    RD_N = RD_HEAD;
+    st = rd_op(op, p + 9, len);
+    rd_sync();
+reply:
+    if (st)
+        RD_N = RD_HEAD;
+    rd_send((int)(op | 0x40u), sq, st);
+    if (!st && f & 0x80u && RD_N <= sizeof rd.cache) {
+        memcpy(rd.cache, RD_OUT, RD_N);
+        rd.clen = (uint8_t)RD_N;
+        rd.cop = (uint8_t)op;
+        rd.cseq = (uint16_t)sq;
+        rd.ccrc = crc;
+    }
+    return 0;
+#if X0X_REMOTE_BLE
+denied:
+    st = RS_DENIED;
+    goto reply;
+#endif
+}
+
+#if X0X_REMOTE_BLE
+int remote_dnr3_frame(const uint8_t *p, uint32_t n)
+{
+    return remote_dnr3_frame_on(p, n, 0);
+}
+#endif
