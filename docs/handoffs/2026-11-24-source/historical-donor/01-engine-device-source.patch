diff --git a/firmware/src/app/remote_dnr3.c b/firmware/src/app/remote_dnr3.c
new file mode 100644
index 0000000000000000000000000000000000000000..bf8a6c6db6f45fffc12e1c2c718c47d1f9d2dbb0
--- /dev/null
+++ b/firmware/src/app/remote_dnr3.c
@@ -0,0 +1,731 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+/* DNR3: the DnBOX Remote's SysEx protocol (Web Remote spec REMOTE-FW-PROTOCOL.md v3.0, sections 3-5).
+ * Part of the UI's translation unit: x0x.c includes it after editor.c, host/x0x_host.c after ui.c, so
+ * it uses the panel's own (static) pattern, lane and pref code. It runs in the main loop only
+ * (ed_service, the UI's context): pattern writes are single bytes / aligned words, as the panel's.
+ *
+ *   F0 7D 44 4E 03  op  seq u14  len u14  payload[len]  crc u32  F7
+ *
+ * Numbers are 7-bit groups, low first; crc = CRC-32 of op .. payload end. A reply is op | 0x40 with
+ * "status u7, rev u28, fields" (fields only for OK); a notification is op 0x7F, seq 0, "rev u28, kind u7,
+ * fields". Lean on purpose (XIP and RAM budgets): one frame buffer (the editor's on the device), static
+ * tables, a 4-entry PARAM queue and fingerprints instead of copies of the sequencer state. */
+#include "remote_dnr3.h"
+#include "../crc32_nibble.h"
+/* Native nightly builds supply the validated full source SHA as 20 bytes;
+ * the editor/About screen still uses its separate short display identity. */
+#ifndef X0X_DNR3_GIT_SHA_BYTES
+#define X0X_DNR3_GIT_SHA_BYTES {0}
+#endif
+
+#ifndef REMOTE_DNR3_BUSY
+#define REMOTE_DNR3_BUSY() 0
+#endif
+#ifdef REMOTE_DNR3_OUTBUF
+#define RD_OUT REMOTE_DNR3_OUTBUF
+#define RD_N ed_n
+#define rd_b ed_b
+#define rd_u ed_u
+#define rd_g ed_g
+#define rd_str ed_str
+#define rd_put7 ed_put7
+#else
+static uint8_t rd_outbuf[256];
+#define RD_OUT rd_outbuf
+static uint32_t rd_n;
+#define RD_N rd_n
+#endif
+enum { RD_HELLO = 0, RD_OPEN = 1, RD_KEEP = 6, RD_CLOSE = 7, RD_WATCH = 8, RD_DESCRIBE = 0x10, RD_PGET, RD_PSET,
+       RD_SGET = 0x20, RD_SSET, RD_PART, RD_DUMP, RD_CUE, RD_TRANSPORT = 0x26, RD_TEMPO, RD_MUTE, RD_STATE = 0x30 };
+enum { RS_OK, RS_QUEUED, RS_BAD, RS_BUSY, RS_STALE, RS_CONFLICT, RS_UNSUPPORTED, RS_FULL, RS_DENIED };
+enum { RN_PARAM, RN_STEP, RN_CUE, RN_TRANSPORT, RN_MUTE, RN_VOICE, RN_POSITION, RN_PATTERN, RN_N };
+#define RD_WBIT(k) ((k) == RN_PATTERN ? 4u : 1u << (k))   /* the WATCH bit of a NOTIFY kind */
+#define RD_CAPS 0x2FFu       /* PARAM..PC (bits 0..7), no VOICE (8), guarded bass PARAM_SET (9) */
+#define RD_WATCHABLE 0x5Fu   /* WATCH bits served: all but VOICE (5) */
+#define RD_LEASE_MS 2000u
+#define RD_GAP_MS 20u        /* >= 20 ms between notifications: <= 50 frames/s (HELLO watch_max_hz) */
+#define RD_HEAD 15u          /* F0 7D 44 4E 03 op seq2 len2 status rev4 */
+#define RD_ANY 127u          /* a wildcard address in a NOTIFY: the Remote re-reads */
+#define RD_MAXOUT 254u       /* + crc and F7 stay inside 256 */
+
+static struct {
+    uint32_t rev, epoch, client, deadline, last_tx, ccrc, fp[4], par[4], step;   /* par: PARAM changes waiting, kind|a|b|c */
+    uint16_t cseq;
+    uint8_t active, watch, dirty, pend, cop, clen, np;
+    uint8_t pos[NTRACKS], cache[48];   /* the last write's reply: an exact retry gets it again */
+} rd;
+#if X0X_REMOTE_BLE
+/* 0 = USB. A nonzero BLE token is only valid for one connection epoch. */
+static uint32_t rd_wire, rd_lease_wire;
+static void rd_out(const uint8_t *p, uint32_t n)
+{
+    if (rd_wire) ble_dnr3_out(rd_wire, p, n);
+    else remote_dnr3_out(p, n);
+}
+#else
+#define rd_out remote_dnr3_out
+#endif
+
+/* ---- what changed ----------------------------------------------------------------------------- */
+__attribute__((noinline)) void remote_touch(int kind, uint32_t at)
+{
+    int i = 0;
+    rd.dirty = 1;
+    if (kind == REMOTE_TOUCH_ALL) {                       /* a project load, an undo: every value */
+        rd.np = 0;
+        remote_touch(RN_PARAM, 0x7F7F7F7Fu);
+        kind = RN_STEP, at = 0x7F7F7Fu;
+    }
+    if (kind == RN_PARAM) {
+        while (i < rd.np && rd.par[i] != at)
+            i++;
+        if (i == rd.np) {                                 /* full: one wildcard for all of them */
+            if (i == 4)
+                rd.np = 0, at = 0x7F7F7F7Fu;
+            rd.par[rd.np++] = at;
+        }
+    } else if (kind == RN_STEP) {
+        if (rd.pend & 1u << RN_STEP)                      /* two different steps: RD_ANY = re-read */
+            for (; i < 24; i += 8)
+                if ((rd.step ^ at) >> i & 255u)
+                    at |= RD_ANY << i;
+        rd.step = at;
+    }
+    rd.pend |= (uint8_t)(1u << kind);
+}
+static int rd_playing(void) { return !seq.req_stop && (seq.playing || seq.req_start || seq.req_cont); }
+__attribute__((noinline)) static uint32_t rd_bpm10(void) { return (uint32_t)(seq.bpm * 10.0f + 0.5f); }
+static int rd_clip(void)
+{
+#if BOARD_SMK37
+    extern uint8_t smk_clip_mode_on(void);
+    return smk_clip_mode_on() != 0;
+#else
+    return 0;
+#endif
+}
+/* Sequencer state that changes outside the UI (the audio ISR: the bar's cue launch, transport edges,
+ * MIDI Start/Stop and Program Change, queued mutes; also HOME pads and SMC): a CRC fingerprint per
+ * NOTIFY kind, checked every main-loop pass. Then one rev step for everything that changed. */
+__attribute__((noinline)) static void rd_sync(void)
+{
+    static const uint8_t kind[4] = {RN_CUE, RN_PATTERN, RN_TRANSPORT, RN_MUTE};
+    uint32_t v[5];
+    int k;
+    v[0] = (uint32_t)rd_playing() | (uint32_t)seq.clk_src << 1, v[1] = rd_bpm10();
+    v[2] = seq.mute, v[3] = seq.vmute, v[4] = seq.mute_q ^ seq.vmute_q * 3u ^ (uint32_t)seq.part_off << 25;
+    {
+        uint32_t f[4] = {x0x_crc32((const uint8_t *)seq.pcue, NTRACKS), x0x_crc32((const uint8_t *)seq.ppat, NTRACKS),
+                         x0x_crc32(v, 8), x0x_crc32(v + 2, 12)};
+        for (k = 0; k < 4; k++)
+            if (f[k] != rd.fp[k])
+                rd.fp[k] = f[k], remote_touch(kind[k], 0);
+    }
+    if (rd.dirty)
+        rd.dirty = 0, rd.rev = (rd.rev + 1u) & 0x0FFFFFFFu;
+}
+__attribute__((noinline)) static void rd_lease(uint32_t now)
+{
+    if (rd.active && ((int32_t)(now - rd.deadline) >= 0
+#if X0X_REMOTE_BLE
+                      || (rd_lease_wire && !ble_dnr3_live(rd_lease_wire))
+#endif
+                     ))
+        rd.active = 0;                                    /* the lease ran out: read only */
+    rd_sync();
+}
+
+/* ---- frames out ------------------------------------------------------------------------------- */
+#ifndef REMOTE_DNR3_OUTBUF
+static void rd_b(uint32_t v)
+{
+    if (RD_N < RD_MAXOUT - 5u)
+        RD_OUT[RD_N++] = (uint8_t)(v & 127u);
+}
+static void rd_u(uint32_t v, int k)
+{
+    for (; k > 0; k--, v >>= 7)
+        rd_b(v);
+}
+#endif
+/* the header (status < 0: a notification of kind -1 - status) and the crc; then out */
+__attribute__((noinline)) static void rd_send(int op, uint32_t sq, int status)
+{
+    static const uint8_t h[5] = {0xF0, 0x7D, 0x44, 0x4E, 0x03};
+    uint32_t n = RD_N;
+    memcpy(RD_OUT, h, 5);
+    RD_N = 5;
+    rd_b((uint32_t)op);
+    rd_u(sq, 2);
+    rd_u(n - 10u, 2);
+    if (status < 0)
+        rd_u(rd.rev, 4), rd_b((uint32_t)(-1 - status));
+    else
+        rd_b((uint32_t)status), rd_u(rd.rev, 4);
+    RD_N = n;
+    rd_u(x0x_crc32(RD_OUT + 5, n - 5u), 5);
+    RD_OUT[RD_N++] = 0xF7;
+    rd_out(RD_OUT, RD_N);
+}
+#ifndef REMOTE_DNR3_OUTBUF
+/* ed_put7: per 7 bytes one byte of their high bits, then the 7 low parts */
+static void rd_put7(const uint8_t *s, uint32_t n)
+{
+    while (n) {
+        uint32_t k = n < 7u ? n : 7u, j, hi = 0;
+        for (j = 0; j < k; j++)
+            hi |= (uint32_t)(s[j] >> 7) << j;
+        rd_b(hi);
+        for (j = 0; j < k; j++)
+            rd_b(s[j]);
+        s += k;
+        n -= k;
+    }
+}
+static void rd_str(const char *s, int max)
+{
+    for (int k = 0; s && s[k] && k < max; k++)
+        rd_b((uint8_t)s[k]);
+    rd_b(0);
+}
+#endif
+static uint32_t rd_pcrc(int pat) { return x0x_crc32(&proj.pat[pat], sizeof(pattern_t)) & 0x3FFFu; }
+__attribute__((noinline)) static void rd_bytes(const volatile uint8_t *s, int n, int none)
+{
+    while (n-- > 0) {
+        uint32_t b = *s++;                         /* one snapshot of each ISR-owned byte */
+        rd_b(b < (uint32_t)none ? b : 127u);
+    }
+}
+__attribute__((noinline)) static void rd_cues(void) { rd_bytes(seq.ppat, NTRACKS, 128); rd_bytes(seq.pcue, NTRACKS, NPAT); }
+__attribute__((noinline)) static void rd_mutes(void) { rd_u(seq.mute, 5); rd_u(seq.vmute, 5); }
+
+/* ---- the panel's values (pref_t), checked before ui.c indexes a table with them ----------------
+ * 0: no such value, 1: the Remote may set it, 2: readable only (settings that write flash, change
+ * radios or run the device; 4.1) */
+__attribute__((noinline)) static int rd_pref_ok(unsigned kind, unsigned a, unsigned b, unsigned c)
+{
+    enum { G = 1, PA, FP, BB, SW, KP, BP, GN, BS, SL, BR, SP, SR, EN, RO = 0x80 };
+    static const uint8_t LIM[EN][3] = {    /* the highest a, b, c of each kind of address (255: any) */
+        {0}, {0, 0, 0}, {NPARTS - 1, 255, 255}, {NBASS - 1, 255, 255}, {255, NBASS - 1, 255},
+        {0, NPAT, 255}, {NKIT - 1, NPAT, 255}, {NBASS - 1, NPAT, 255}, {NBASS - 1, NPAT, NGEN - 1},
+        {255, NPAT, BRK_NSET - 1}, {1, NPAT, 255}, {255, NPAT, 255}, {NPARTS - 1, NSONG, 255}, {255, NSONG, 255}};
+    static const uint8_t KIND[R_NOTELOCK + 1] = {
+        [R_ENG] = EN, [R_SWING] = SW, [R_DLEN] = KP, [R_DRATE] = KP, [R_BLEN] = BP, [R_BRATE] = BP, [R_BDIR] = BP,
+        [R_BTRANS] = BP, [R_GEN] = GN, [R_BRKSET] = BS, [R_BRKSLICE] = SL, [R_BRKSLOT] = SL, [R_BRKRATE] = BR,
+        [R_SPAT] = SP, [R_SREP] = SR, [R_PARTON] = PA, [R_MIDICH] = PA | RO, [R_FREEPLAY] = FP, [R_BENGINE] = BB,
+        [R_BPRESET] = BB, [R_BPATSND] = BB, [R_BSTATUS] = BB | RO, [R_TEMPO] = G, [R_ACCENT] = G, [R_CLKOUT] = G,
+        [R_NOTEOUT] = G, [R_PALETTE] = G, [R_KEYLED] = G, [R_KEYSOUND] = G, [R_SBAR] = G, [R_SLEN] = G, [R_TAPE] = G,
+        [R_OUTLOUD] = G, [R_CKCH] = G, [R_FINETUNE] = G, [R_QUEUEMUTE] = G, [R_NOTELOCK] = G,
+        [R_AUTOSAVE] = G | RO, [R_STALLS] = G | RO, [R_BATT] = G | RO, [R_USBFULL] = G | RO, [R_BT] = G | RO,
+        [R_BTSTAT] = G | RO, [R_BTNAME] = G | RO, [R_CLKSRC] = G | RO, [R_SMC_ROLE] = G | RO, [R_SMC_MAP] = G | RO};
+    unsigned k = kind <= R_NOTELOCK ? KIND[kind] : 0u, l = k & 15u;
+    if (l == EN)
+        return a < NTARGETS && (int)b < engine_nvoices((int)a) && (int)c < engine_nparams((int)a, (int)b);
+    if (!l || a > LIM[l][0] || b > LIM[l][1] || c > LIM[l][2])
+        return 0;
+    return k & RO ? 2 : 1;
+}
+/* ui.c; e: kind, a, b, c. -1: no such value (or set and read only); *d: its descriptor */
+int ui_remote_pref(const uint8_t *e, int set, int v, const x0x_param_t **d);
+__attribute__((noinline)) static int rd_pget(const uint8_t *e, const x0x_param_t **d)
+{
+    *d = 0;
+    return rd_pref_ok(e[0], e[1], e[2], e[3]) ? ui_remote_pref(e, 0, 0, d) : -1;
+}
+
+/* ---- step records (4.2), the same bytes in and out --------------------------------------------
+ *   909/808: track (11 = accent row), on, vel (the T_VEL lane: get 0 = none; set 0 = none, 127 = keep)
+ *   303:     note, gate, accent, slide, velocity, end
+ *   BREAK:   on, slice (0 = the generator, 1..32; steps 0..15 only)
+ * the record length, -1 for a bad address */
+__attribute__((noinline)) static int rd_step_get(int part, int pat, int step, int track, uint8_t *rec)
+{
+    const pattern_t *p = &proj.pat[pat & (NPAT - 1)];
+    if ((unsigned)part >= NPARTS || (unsigned)pat >= NPAT || (unsigned)step >= NSTEPS)
+        return -1;
+    if (part < NKIT) {
+        int lane = motion_find(proj.arr.lane, pat, part, T_VEL, part << 4 | track, 0), v;
+        if ((unsigned)track > NDRUM)
+            return -1;
+        rec[0] = (uint8_t)track;
+        rec[1] = (uint8_t)sm_get(track == NDRUM ? p->drum[part].accent : p->drum[part].hit[track], step);
+        v = track < NDRUM && lane >= 0 ? proj.arr.lane[lane].val[step] : MOT_NONE;
+        rec[2] = (uint8_t)(v == MOT_NONE ? 0 : v);
+        return 3;
+    }
+    if (part == PART_BRK) {
+        if (step >= 32)
+            return -1;
+        rec[0] = (uint8_t)(p->brk.steps >> step & 1u);
+        rec[1] = step < 16 ? p->brk.slice[step] : 0;
+        return 2;
+    }
+    {
+        const bstep_t *s = &p->bass[part - NKIT].step[step];
+        rec[0] = s->note & 127u;
+        rec[1] = (uint8_t)bstep_gate(s);
+        rec[2] = !!(s->flags & BS_ACCENT);
+        rec[3] = !!(s->flags & BS_SLIDE);
+        rec[4] = s->velocity & 127u;
+        rec[5] = (uint8_t)(s->flags >> BS_END_SHIFT);
+        return 6;
+    }
+}
+/* 0 written, RS_BAD a bad record, RS_FULL no room for a velocity lane or the note's sound */
+__attribute__((noinline)) static int rd_step_set(int part, int pat, int step, const uint8_t *rec)
+{
+    pattern_t *p = &proj.pat[pat & (NPAT - 1)];
+    uint8_t now[6];
+    if (rd_step_get(part, pat, step, rec[0], now) < 0)
+        return RS_BAD;
+    if (part < NKIT) {                                    /* as the SEQ pads and drum_vel_*_step */
+        int t = rec[0], voice = part << 4 | t, lane = motion_find(proj.arr.lane, pat, part, T_VEL, voice, 0);
+        uint32_t *w = (t == NDRUM ? p->drum[part].accent : p->drum[part].hit[t]) + (step >> 5), m = 1u << (step & 31);
+        if (rec[1] > 1u)
+            return RS_BAD;
+        if (t < NDRUM && rec[1] && rec[2] && rec[2] < 127u) {
+            if (lane < 0 && (lane = motion_alloc(proj.arr.lane, pat, part, T_VEL, voice, 0)) < 0)
+                return RS_FULL;
+            proj.arr.lane[lane].val[step] = rec[2];
+        } else if (t < NDRUM && lane >= 0 && (!rec[1] || !rec[2])) {
+            lane_t *l = &proj.arr.lane[lane];
+            int j, any = 0;
+            l->val[step] = MOT_NONE;
+            for (j = 0; j < NSTEPS; j++)
+                any |= l->val[j] != MOT_NONE;
+            if (!any)
+                engine_motion_clear(lane);
+        }
+        *w = rec[1] ? *w | m : *w & ~m;
+    } else if (part == PART_BRK) {
+        if (rec[0] > 1u || rec[1] > 32u || (step >= 16 && rec[1]))
+            return RS_BAD;
+        if (step < 16)
+            p->brk.slice[step] = rec[1];
+        p->brk.steps = rec[0] ? p->brk.steps | 1u << step : p->brk.steps & ~(1u << step);
+    } else {                                              /* as bass_write */
+        int b = part - NKIT;
+        bstep_t *s = &p->bass[b].step[step];
+        if (rec[1] > G_TIE || (rec[2] | rec[3]) > 1u || rec[5] > 15u)
+            return RS_BAD;
+#if X0X_BASS_NOTE_SOUND
+        if (rec[1] == G_NOTE && now[1] != G_NOTE && engine_bass_note_capture(proj.arr.lane, pat, b, step, &proj.sound) < 0)
+            return RS_FULL;
+        if (rec[1] != G_NOTE)
+            bass_note_clear(proj.arr.lane, pat, b, step);
+#endif
+        if (now[0] != rec[0] || now[1] != rec[1])
+            (void)held_chord_set(proj.arr.lane, pat, b, step, 0, 0);   /* a chord follows its own key gestures */
+        s->velocity = rec[4];
+        s->note = rec[0];
+        s->flags = (uint8_t)(rec[1] | (rec[2] ? BS_ACCENT : 0u) | (rec[3] ? BS_SLIDE : 0u) | rec[5] << BS_END_SHIFT);
+    }
+    ui.dirty = 1;                                         /* SAVE has work to do; the change is the Remote's */
+    remote_touch(RN_STEP, (uint32_t)part | (uint32_t)pat << 8 | (uint32_t)step << 16);
+    return 0;
+}
+__attribute__((noinline)) static int rd_step(int part, int pat, int step, int track)
+{
+    uint8_t r[6];
+    int n = rd_step_get(part, pat, step, track, r);
+    rd_b((uint32_t)part); rd_b((uint32_t)pat); rd_b((uint32_t)step);
+    for (int i = 0; i < n; i++)
+        rd_b(r[i]);
+    return n;
+}
+
+/* ---- notifications (only to the lease holder, for its WATCH bits) ------------------------------ */
+__attribute__((noinline)) void remote_dnr3_tick(uint32_t now)
+{
+    const x0x_param_t *d;
+    int k, v;
+    rd_lease(now);
+    if (!rd.active) {
+        rd.pend = rd.np = 0;
+        return;
+    }
+    for (k = 0; k < NTRACKS; k++) {                       /* POSITION: not a state change, no rev */
+        uint8_t p = seq.playing ? seq.t[k].pos & 127u : 127u;
+        if (p != rd.pos[k])
+            rd.pos[k] = p, rd.pend |= 1u << RN_POSITION;
+    }
+    if (now - rd.last_tx < RD_GAP_MS)
+        return;
+    for (k = 0; k < RN_N; k++) {
+        if (!(rd.pend >> k & 1u))
+            continue;
+        rd.pend &= (uint8_t)~(1u << k);
+        if (!(rd.watch & RD_WBIT(k))) {
+            if (!k)
+                rd.np = 0;
+            continue;
+        }
+        RD_N = RD_HEAD;
+        if (k == RN_PARAM) {
+            const uint8_t *e = (const uint8_t *)rd.par;   /* little-endian: kind, a, b, c */
+            v = rd_pget(e, &d);
+            rd_bytes(e, 4, 128);
+            rd_u(v < 0 ? 0x3FFFu : (uint32_t)v, 2);
+            rd.par[0] = rd.par[1], rd.par[1] = rd.par[2], rd.par[2] = rd.par[3];
+            if (--rd.np)
+                rd.pend |= 1u << RN_PARAM;
+        } else if (k == RN_STEP) {
+            rd_bytes((const uint8_t *)&rd.step, 3, 128);
+            v = rd.step >> 8 & 255u;
+            rd_u(v < NPAT ? rd_pcrc(v) : 0x3FFFu, 2);
+        } else if (k == RN_TRANSPORT) {
+            rd_b((uint32_t)rd_playing()); rd_u(rd_bpm10(), 2); rd_b(seq.clk_src);
+        } else if (k == RN_MUTE) {
+            rd_mutes(); rd_b(seq.part_off);
+        } else if (k == RN_POSITION)
+            rd_bytes(rd.pos, NTRACKS, 128);
+        else
+            rd_cues();                                    /* CUE, PATTERN */
+#if X0X_REMOTE_BLE
+        rd_wire = rd_lease_wire;
+#endif
+        rd_send(0x7F, 0, -1 - k);
+        rd.last_tx = now;
+        return;
+    }
+}
+
+/* ---- requests --------------------------------------------------------------------------------- */
+#ifndef REMOTE_DNR3_OUTBUF
+__attribute__((noinline)) static uint32_t rd_g(const uint8_t *a, int k)
+{
+    uint32_t v = 0;
+    while (k--)
+        v = v << 7 | a[k];
+    return v;
+}
+#endif
+/* 1 + the payload bytes a request needs (0: no such op); 0x40: a lease op (epoch first), 0x80: a write */
+#define RL 0x40u
+#define RW 0xC0u
+static const uint8_t RD_OPS[RD_STATE + 1] = {
+    [RD_HELLO] = 2, [RD_OPEN] = 5, [RD_KEEP] = RL | 5, [RD_CLOSE] = RL | 5, [RD_WATCH] = RL | 9,
+    [RD_DESCRIBE] = 5, [RD_PGET] = 2, [RD_PSET] = RW | 13, [RD_SGET] = 4, [RD_SSET] = RW | 10, [RD_PART] = RW | 10,
+    [RD_DUMP] = 5, [RD_CUE] = RW | 7, [RD_TRANSPORT] = RW | 6, [RD_TEMPO] = RW | 7, [RD_MUTE] = RW | 8, [RD_STATE] = 1};
+
+static int rd_pset(const uint8_t *q)
+{
+    const x0x_param_t *d;
+    int v;
+    if ((v = rd_pget(q, &d)) < 0)
+        return RS_BAD;
+    if (rd_pref_ok(q[0], q[1], q[2], q[3]) > 1)
+        return RS_UNSUPPORTED;
+    if (rd_g(q + 4, 2) != 0x3FFFu && rd_g(q + 4, 2) != (uint32_t)v)
+        return RS_CONFLICT;
+    if ((v = ui_remote_pref(q, 1, (int)rd_g(q + 6, 2), &d)) < 0)
+        return RS_UNSUPPORTED;                        /* read only here (a performance value, BSTATUS) */
+    rd_bytes(q, 4, 128);
+    rd_u((uint32_t)v, 2);
+    return 0;
+}
+
+__attribute__((noinline)) static int rd_op(uint32_t op, const uint8_t *a, uint32_t len)
+{
+    const uint8_t *q = a + 4;                             /* a write's fields, after its epoch */
+    const x0x_param_t *d;
+    int k, v;
+    switch (op) {
+    case RD_HELLO: {
+        static const uint8_t t[8] = {RD_CAPS & 127u, RD_CAPS >> 7, 0, 0, NPAT, NSTEPS, NDRUM, NKIT};
+        static const uint8_t sha[20] = X0X_DNR3_GIT_SHA_BYTES;
+        if (a[0] != 3u)
+            return RS_UNSUPPORTED;
+        rd_b(3);
+        rd_b(0);
+        rd_put7(sha, 20);
+#if defined(X0X_HOST)
+        rd_b(3);
+#elif defined(SMK_MODEL)
+        rd_b(SMK_MODEL[7] == 'E' ? 1u : 2u);
+#else
+        rd_b(0);
+#endif
+        rd_bytes(t, 8, 128);                              /* caps u28, NPAT, NSTEPS, drum tracks, drum machines */
+        rd_b((uint32_t)rd_clip()); rd_b(seq.clk_src); rd_b(1000u / RD_GAP_MS);
+        return 0;
+    }
+    case RD_OPEN:
+        if (rd.active && (rd_g(a, 4) != rd.client
+#if X0X_REMOTE_BLE
+                          || rd_wire != rd_lease_wire
+#endif
+                         ))         /* another client's lease is live */
+            return RS_BUSY;
+        rd.client = rd_g(a, 4);
+        rd.epoch = (rd.epoch + 1u + (plat_ms() << 3)) & 0x0FFFFFFFu;
+        rd.epoch += !rd.epoch;
+        rd.active = 1;
+#if X0X_REMOTE_BLE
+        rd_lease_wire = rd_wire;
+#endif
+        rd.watch = rd.clen = 0;
+        rd.deadline = plat_ms() + RD_LEASE_MS;
+        rd_u(rd.epoch, 4);
+        rd_u(RD_LEASE_MS, 2);
+        return 0;
+    case RD_CLOSE:
+        rd.active = 0;
+        /* fall through */
+    case RD_KEEP:
+        return 0;
+    case RD_WATCH:
+        rd.watch = (uint8_t)(rd_g(q, 4) & RD_WATCHABLE);
+        rd_u(rd.watch, 4);
+        return 0;
+    case RD_DESCRIBE: {
+        if (rd_pget(a, &d) < 0)
+            return RS_UNSUPPORTED;
+        rd_str(d->name, 6);
+        rd_u(d->max, 2);
+        rd_u(d->def, 2);
+        rd_b(0);                                          /* unit: the Remote formats it */
+        v = d->names && d->max < 32u ? d->max + 1 : 0;    /* more switch names than fit: numbers */
+        rd_b((uint32_t)v);
+        for (k = 0; k < v; k++)
+            rd_str(d->names[k], 5);
+        return 0;
+    }
+    case RD_PGET:
+        if (!a[0] || a[0] > 16u || len < 1u + 4u * a[0])
+            return RS_BAD;
+        rd_b(a[0]);
+        for (k = 0; k < a[0]; k++) {
+            const uint8_t *e = a + 1 + 4 * k;
+            v = rd_pget(e, &d);
+            rd_bytes(e, 4, 128);
+            rd_u(v < 0 ? 0x3FFFu : (uint32_t)v, 2);       /* 0x3FFF, max 0: not a value here */
+            rd_u(v < 0 ? 0u : d->max, 2);
+        }
+        return 0;
+    case RD_PSET:
+        if (len == 12u)                                  /* legacy parameter writes */
+            return rd_pset(q);
+        if (len != 13u || q[0] != R_ENG || q[1] != T_303 || q[2] >= NBASS || q[8] > ORIGINAL_SOUND_JUNO)
+            return RS_BAD;
+        /* Match the active engine, not R_BENGINE's requested bank. Keep the
+         * descriptor, compare-and-set and readback on that same audio owner.
+         * A queued preset (even in the same bank) may replace the whole cell. */
+        engine_bass_edit_hold(1);
+        if (engine_bass_preset_pending(q[2]))
+            v = RS_BUSY;
+        else if (engine_bass_bank(q[2]) != q[8])
+            v = RS_CONFLICT;
+        else {
+            const uint8_t *cell = proj.sound.v[T_303][q[2]];
+            /* The persisted engine kind is byte 29 (original_sound.h).
+             * Use a non-mutating check; legacy project adoption is not an edit. */
+            v = cell[29] == q[8] && original_sound_valid(cell) ? rd_pset(q) : RS_BUSY;
+        }
+        engine_bass_edit_hold(0);
+        return v;
+    case RD_SGET:                                         /* a 4th byte: the drum track (default 0) */
+        return rd_step(a[0], a[1], a[2], len > 3u ? a[3] : 0) < 0 ? RS_BAD : 0;
+    case RD_SSET: {
+        int part = q[0], need = part < NKIT ? 3 : part == PART_BRK ? 2 : 6;
+        if (len < 9u + (uint32_t)need || (unsigned)q[1] >= NPAT)
+            return RS_BAD;
+        if (rd_g(q + 3, 2) != 0x3FFFu && rd_g(q + 3, 2) != rd_pcrc(q[1]))
+            return RS_CONFLICT;
+        if ((k = rd_step_set(part, q[1], q[2], q + 5)) != 0)
+            return k;
+        rd_step(part, q[1], q[2], q[5]);
+        rd_u(rd_pcrc(q[1]), 2);
+        return 0;
+    }
+    case RD_PART: {
+        /* field: 0 len 1..64, 1 rate RATE_*, 2 dir (303), 3 transpose (303), 4 swing (909) */
+        static const uint8_t KIND[3][5] = {{R_DLEN, R_DRATE, 0, 0, R_SWING}, {R_BLEN, R_BRATE, R_BDIR, R_BTRANS, 0},
+                                           {0, R_BRKRATE, 0, 0, 0}};
+        uint8_t e[4];
+        int part = q[0], f = q[2], kind;
+        if ((unsigned)part >= NTRACKS || (unsigned)q[1] >= NPAT || f > 4)
+            return RS_BAD;
+        kind = KIND[part < NKIT ? 0 : part == PART_BRK ? 2 : 1][f];
+        if (!kind || (kind == R_SWING && part))
+            return RS_UNSUPPORTED;
+        e[0] = (uint8_t)kind, e[1] = (uint8_t)(kind == R_SWING || kind == R_BRKRATE ? 0 : part < NKIT ? part : part - NKIT);
+        e[2] = (uint8_t)(q[1] + 1), e[3] = 0;
+        v = (int)rd_g(q + 3, 2) - !f;                     /* len: the pref counts from 0 */
+        _Static_assert(RATE_16 == 0 && RATE_4 == RATE_8 + 1, "R_BRKRATE: 0 16th, 1 8th, 2 4th");
+        if (kind == R_BRKRATE)
+            v = !v ? 0 : v == RATE_8 || v == RATE_4 ? v - (RATE_8 - 1) : -1;
+        if (rd_pget(e, &d) < 0 || v < 0 || v > d->max)
+            return RS_BAD;
+        v = ui_remote_pref(e, 1, v, &d) + !f;
+        if (kind == R_BRKRATE && v)
+            v += RATE_8 - 1;
+        rd_bytes(q, 3, 128);
+        rd_u((uint32_t)v, 2);
+        return 0;
+    }
+    case RD_DUMP: {
+        uint32_t off = rd_g(a + 1, 2), c = a[3];
+        if (a[0] >= NPAT || c > 112u || off > sizeof(pattern_t))
+            return RS_BAD;
+        if (c > sizeof(pattern_t) - off)
+            c = sizeof(pattern_t) - off;
+        rd_b(a[0]);
+        rd_u(off, 2);
+        rd_u(sizeof(pattern_t), 2);
+        rd_b(c);
+        rd_put7((const uint8_t *)&proj.pat[a[0]] + off, c);
+        rd_u(rd_pcrc(a[0]), 2);
+        return 0;
+    }
+    case RD_CUE:
+        if ((q[0] >= NTRACKS && q[0] != 127u) || (q[1] >= NPAT && q[1] != 127u))
+            return RS_BAD;
+        if (q[1] < NPAT)
+            seq_chain(&seq, 0, 0);                        /* as the PRESET encoder: a cue ends a chain */
+        for (k = 0; k < NTRACKS; k++)
+            if (q[0] == 127u || q[0] == k)
+                seq.pcue[k] = q[1] < NPAT ? q[1] : 0xFFu;
+        rd_bytes(q, 2, 128);
+        rd_cues();
+        return 0;
+    case RD_TRANSPORT:                                    /* the PLAY key's requests, plus CONTINUE */
+        if (q[0] > 2u)
+            return RS_BAD;
+        if (seq.clk_src == SEQ_CLK_EXT && seq.ext)        /* an external clock runs it: FA/FB/FC */
+            return RS_DENIED;
+        if (!q[0]) {
+            if (rd_playing())
+                seq_stop(&seq);
+        } else if (!rd_playing()) {
+            memset(bass_rec_step, 0, sizeof bass_rec_step);
+            if (q[0] == 1) {
+                seq.song_start = ui.song_sel < song()->len ? ui.song_sel : 0;
+                seq_start(&seq);
+            } else
+                seq_continue(&seq);
+        }
+        rd_b((uint32_t)rd_playing());
+        return 0;
+    case RD_TEMPO:
+        v = (int)rd_g(q, 2);
+        if (v < 200 || v > 3000)
+            return RS_BAD;
+        seq.bpm = (float)v / 10.0f;
+        ui.dirty = 1;
+        rd_u(rd_bpm10(), 2);
+        return 0;
+    case RD_MUTE: {
+        /* bit: MUTE_* (0 .. MUTE_BRK: the drum voices, the 303s, BREAK); queued: the next 909 bar */
+        uint32_t m = 1u << (q[0] & 31u), want = q[1] ? m : 0u;
+        if (q[1] > 1u || q[2] > 1u || q[0] > MUTE_BRK)
+            return RS_BAD;
+        seq.mute_q &= ~m;                                 /* mute_q: bits that flip at the bar */
+        if (!q[2])
+            seq.mute = (seq.mute & ~m) | want;
+        else if ((seq.mute & m) != want)
+            seq.mute_q |= m;
+        rd_mutes();
+        return 0;
+    }
+    default:                                              /* RD_STATE */
+        rd_b((uint32_t)rd_playing()); rd_b(seq.clk_src); rd_b((uint32_t)rd_clip()); rd_b(seq.send_notes);
+        rd_u(rd_bpm10(), 2);
+        rd_cues();
+        rd_mutes();
+        rd_b(seq.part_off); rd_b(seq.song_on); rd_u(seq.song_pos, 2);
+        rd_bytes(seq.ch, NTRACKS, 16);
+        for (k = 0; k < NTRACKS; k++)
+            rd_b(seq.playing ? seq.t[k].pos : 127u);
+        for (k = 0; k < NPAT; k++)
+            rd_u(rd_pcrc(k), 2);
+        return 0;
+    }
+}
