--- a/firmware/src/dsp/dnbx_core.c
+++ b/firmware/src/dsp/dnbx_core.c
@@ -432,2 +432,20 @@
 }
+#if defined(X0X_SJ6_MONO32_PROBE) && X0X_SJ6_MONO32_PROBE
+int dnbx_superj6_mono_voice(dnbx_part *s,unsigned note,unsigned vel)
+{
+    if(!valid(s)||note>127u||!vel||vel>127u)return -1;
+    dnbx_voice *v=&s->voice[0];
+    if(!voice_active(v))memset(v,0,sizeof *v);
+    v->note=(uint8_t)note;v->gate=1;v->pedal_held=0;v->age_rank=0;
+    v->velocity=(float)vel/127.f;
+    for(unsigned l=0;l<DNBX_LAYERS;l++){
+        const dnbx_layer_params *p=&s->layer[l].params;
+        v->layer[l].increment=pitch_increment(s,note,p->tune_semitones);
+        envelope_on(&v->layer[l].amp,&p->amp,s->sample_rate);
+        dnbx_envelope_params linked;
+        envelope_on(&v->layer[l].filter,filter_params(s,l,&linked),s->sample_rate);
+    }
+    return 0;
+}
+#endif
