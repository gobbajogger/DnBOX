+#if X0X_SUPERJ6_BUILTIN_INIT
+int juno6_apply_sj6_primary_attack(juno6_t *s, float raw, unsigned layer_link)
+{
+    float physical;
+    dnbx_layer_params primary, secondary;
+    if (!s || !s->typed || layer_link>1u || s->core.filter_link ||
+        dnbx_active_voices(&s->core)!=0 ||
+        dnbx_attack_from_unit(raw,&physical)!=DNBX_OK ||
+        dnbx_get_layer(&s->core,0,&primary)!=DNBX_OK ||
+        (layer_link && dnbx_get_layer(&s->core,1,&secondary)!=DNBX_OK))
+        return 0;
+    primary.amp.attack_s=physical;
+    dnbx_apply_panel_envelopes(&s->core,0,&primary.amp,&primary.filter,0);
+    (void)dnbx_store_raw(&s->core,36u,raw);
+    if (layer_link) {
+        /* Original 36 forwards the same normalized word to 119.
+         * The two qualified Attack laws agree; other stages are untouched. */
+        secondary.amp.attack_s=physical;
+        dnbx_apply_panel_envelopes(&s->core,1,&secondary.amp,&secondary.filter,0);
+        (void)dnbx_store_raw(&s->core,119u,raw);
+    }
+    return 1;
+}
+#endif
