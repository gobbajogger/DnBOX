+}
+void engine_superj6_mod_selector_edit_host(unsigned owner,int value,unsigned relative)
+{
+    if(!sj6_mod_selector_owner(owner) ||
+       (relative ? (value!=-1&&value!=1):(value<0||value>5)))return;
+    cq_put(C_MOD,owner,relative?(value<0?2u:1u):3u,relative?0u:(uint32_t)value);
+}
+static void sj6_mod_selector_apply(unsigned owner,int value,unsigned relative)
+{
+    juno6_t *s=sj6_mod_selector_owner(owner);
+    if(!s)return;
+    if(!relative) { (void)juno6_set_mod_destination(s,(unsigned)value);return; }
+    for(int next=(int)s->mod_destination+value;0<=next&&next<=5;next+=value)
+        if(juno6_set_mod_destination(s,(unsigned)next))return;
+}
