+def tanh_split_decl(tab):
+    split=400
+    bits=[bits32(x) for x in tab]
+    assert len(bits)==1026 and all(b&0xffff0000==0x3f7f0000 for b in bits[split:])
+    head=b"".join(struct.pack("<I",b) for b in bits[:split])
+    tail=b"".join(struct.pack("<H",b&0xffff) for b in bits[split:])
+    assert hashlib.sha256(head).hexdigest()=="9cce98ce40e37b6b28e389229844eca61b153116956a1d9afc350f5c5c4defea"
+    assert hashlib.sha256(tail).hexdigest()=="6f4f3d420d74dc070615a53c0aeca829dbe778619041ac122f9b12872a5f9a27"
+    assert head+b"".join(struct.pack("<I",0x3f7f0000|(b&0xffff)) for b in bits[split:])==b"".join(struct.pack("<I",b) for b in bits)
+    return "\n".join(["#define X0X_TANH_LAB_SPLIT 400",
+        arr("float","x0x_tanh_lab_head",tab[:split],cfloat,per=6,shared=True),
+        arr("uint16_t","x0x_tanh_lab_tail",[b&0xffff for b in bits[split:]],lambda b:f"0x{b:04x}u",per=10,shared=True)])
+
