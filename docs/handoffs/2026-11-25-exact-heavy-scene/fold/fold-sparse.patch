diff --git a/firmware/src/dsp/s1c/s1c.c b/firmware/src/dsp/s1c/s1c.c
index 2aaa48d..aca3322 100644
--- a/firmware/src/dsp/s1c/s1c.c
+++ b/firmware/src/dsp/s1c/s1c.c
@@ -701,6 +701,10 @@ static float dl_tick_c(s1c_dline *d, float in, float del, float fb, float c)
 static float xl_read(const s1c_dline *d, float del)
 {
     float pos = (float)d->w - del;
+    /* Exactly fold whole 16-word steps in the small warm history ring.
+     * Movement toward zero preserves binary32 fractional bits here. */
+    if(d->len==16 && pos < -16.0f && pos >= -0x1p23f)
+        pos += (float)(((unsigned)(-pos)>>4)<<4);
     while (pos < 0.0f) pos += (float)d->len;
     int i = (int)pos; float f = pos - (float)i;
     int j = i + 1 == d->len ? 0 : i + 1;
@@ -1115,11 +1119,34 @@ void s1c_render(s1c *s, float *outl, float *outr, unsigned n)
 #endif
 #endif
     (void)cr; (void)cw;
+#if S1C_FAST && S1C_CSM && S1C_NO_SEQ
+    /* Shared arp/lock ingress still runs outside this render span. A lane
+     * whose rounded recurrence already equals its current word remains
+     * fixed through this span, including sign bit on zero. */
+    float port_target[sizeof s1c_smid];
+    uint8_t port_id[sizeof s1c_smid];
+    unsigned port_n=0;
+    for(i=0;i<sizeof s1c_smid;i++){
+        const float t=c1*s->t[s1c_smid[i]];
+        const s1c_fb cur={.f=s->c[i]}, next={.f=t+c2*cur.f};
+        if(next.u!=cur.u){
+            port_target[port_n]=t;
+            port_id[port_n++]=(uint8_t)i;
+        }
+    }
+#endif
     for (f = 0; f < n; f++) {
 #if S1C_FAST
         int cu = (f & 3) == 0;
 #if S1C_CSM
+#if S1C_NO_SEQ
+        for(i=0;i<port_n;i++){
+            const unsigned id=port_id[i];
+            s->c[id]=port_target[i]+c2*s->c[id];
+        }
+#else
         for (i = 0; i < (int)sizeof s1c_smid; i++) s->c[i] = c1 * s->t[s1c_smid[i]] + c2 * s->c[i];
+#endif
 #else
         for (i = 0; i < s1c_nsm; i++) { unsigned q = s1c_sm[i]; s->c[q] = c1 * s->t[q] + c2 * s->c[q]; }
 #endif
