+/* Consume only non-event internal clock samples. An impending overflow,
+ * malformed threshold or held-key boundary stays on the existing scalar
+ * path. Never crosses a beat or live early gate, even for an empty step. */
+int S1Sequencer_skipQuiet(S1Sequencer *s,const S1SequencerParams *p,int held,unsigned cap)
+{
+    if ((held==0) != (s->previousHeldNoteNumbersAECount==0)) return 0;
+    if (p->arpIsOn==1 || s->sequencerLastNotesCount) {
+        /* All runtime providers use S1_SAMPLE_TICKS. Leave other
+         * configurations on the original per-sample path. */
+        if (p->arpBeatsPerSample!=S1_SAMPLE_TICKS || cap>256u) return 0;
+        const uint32_t from=s->mBeatTime, to=from+cap*S1_SAMPLE_TICKS;
+        if (to<from || to>=p->arpSeqTempoMultiplier ||
+            (s->gateOpen && to>=gateLength(s,p))) return 0;
+        s->mBeatTime=to;
+    }
+    if (cap) s->previousHeldNoteNumbersAECount=held;
+    return (int)cap;
+}
